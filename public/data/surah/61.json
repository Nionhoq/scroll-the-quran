","translation":"We","transliteration":"naḥnu"},{"position":20,"text":"أَنصَارُ","translation":"(are) the helpers","transliteration":"anṣāru"},{"position":21,"text":"ٱللَّهِ ۖ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":22,"text":"فَـَٔامَنَت","translation":"Then believed","transliteration":"faāmanat"},{"position":23,"text":"طَّآئِفَةٌۭ","translation":"a group","transliteration":"ṭāifatun"},{"position":24,"text":"مِّنۢ","translation":"of","transliteration":"min"},{"position":25,"text":"بَنِىٓ","translation":"Children","transliteration":"banī"},{"position":26,"text":"إِسْرَٰٓءِيلَ","translation":"(of) Israel","transliteration":"is'rāīla"},{"position":27,"text":"وَكَفَرَت","translation":"and disbelieved","transliteration":"wakafarat"},{"position":28,"text":"طَّآئِفَةٌۭ ۖ","translation":"a group","transliteration":"ṭāifatun"},{"position":29,"text":"فَأَيَّدْنَا","translation":"So We supported","transliteration":"fa-ayyadnā"},{"position":30,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":31,"text":"ءَامَنُوا۟","translation":"believed","transliteration":"āmanū"},{"position":32,"text":"عَلَىٰ","translation":"against","transliteration":"ʿalā"},{"position":33,"text":"عَدُوِّهِمْ","translation":"their enemy","transliteration":"ʿaduwwihim"},{"position":34,"text":"فَأَصْبَحُوا۟","translation":"and they became","transliteration":"fa-aṣbaḥū"},{"position":35,"text":"ظَـٰهِرِينَ","translation":"dominant","transliteration":"ẓāhirīna"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
