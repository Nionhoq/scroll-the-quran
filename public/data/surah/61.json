0,11,9720,12190]],"words":[{"position":1,"text":"يُرِيدُونَ","translation":"They intend","transliteration":"yurīdūna"},{"position":2,"text":"لِيُطْفِـُٔوا۟","translation":"to put out","transliteration":"liyuṭ'fiū"},{"position":3,"text":"نُورَ","translation":"(the) light","transliteration":"nūra"},{"position":4,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":5,"text":"بِأَفْوَٰهِهِمْ","translation":"with their mouths","transliteration":"bi-afwāhihim"},{"position":6,"text":"وَٱللَّهُ","translation":"but Allah","transliteration":"wal-lahu"},{"position":7,"text":"مُتِمُّ","translation":"will perfect","transliteration":"mutimmu"},{"position":8,"text":"نُورِهِۦ","translation":"His Light","transliteration":"nūrihi"},{"position":9,"text":"وَلَوْ","translation":"although","transliteration":"walaw"},{"position":10,"text":"كَرِهَ","translation":"dislike","transliteration":"kariha"},{"position":11,"text":"ٱلْكَـٰفِرُونَ","translation":"the disbelievers","transliteration":"l-kāfirūna"}]},{"id":5172,"verseKey":"61:9","verseNumber":9,"arabic":"هُوَ ٱلَّذِىٓ أَرْسَلَ رَسُولَهُۥ بِٱلْهُدَىٰ وَدِينِ ٱلْحَقِّ لِيُظْهِرَهُۥ عَلَى ٱلدِّينِ كُلِّهِۦ وَلَوْ كَرِهَ ٱلْمُشْرِكُونَ","translation":"It is He who sent His Messenger with guidance and the religion of truth to manifest it over all religion, although those who associate others with Allāh dislike it.","transliteration":"huwa alladhī arsala rasūlahu bil-hudā wadīni l-ḥaqi liyuẓ'hirahu ʿalā l-dīni kullihi walaw kariha l-mush'rikūna","audioUrl":"/audio/7/061009.mp3","segments":[[0,1,40,400],[1,2,410,2540],[2,3,2550,3290],[3,4,3300,4450],[4,5,4460,5480],[5,6,5490,6320],[6,7,6330,7100],[7,8,7110,8370],[8,9,8380,9040],[9,10,9050,9560],[10,11,9570,10660],[11,12,10670,11230],[12,13,11240,11910],[13,14,11920,15140]],"words":[{"position":1,"text":"هُوَ","translation":"He","transliteration":"huwa"},{"position":2,"text":"ٱلَّذِىٓ","translation":"(is) the One Who","transliteration":"alladhī"},{"position":3,"text":"أَرْسَلَ","translation":"sent","transliteration":"arsala"},{"position":4,"text":"رَسُولَهُۥ","translation":"His Messenger","transliteration":"rasūlahu"},{"position":5,"text":"بِٱلْهُدَىٰ","translation":"with guidance","transliteration":"bil-hudā"},{"position":6,"text":"وَدِينِ","translation":"and (the) religion","transliteration":"wadīni"},{"position":7,"text":"ٱلْحَقِّ","translation":"(of) the truth","transliteration":"l-ḥaqi"},{"position":8,"text":"لِيُظْهِرَهُۥ","translation":"to make it prevail","transliteration":"liyuẓ'hirahu"},{"position":9,"text":"عَلَى","translation":"over","transliteration":"ʿalā"},{"position":10,"text":"ٱلدِّينِ","translation":"the religion","transliteration":"l-dīni"},{"position":11,"text":"كُلِّهِۦ","translation":"all of them","transliteration":"kullihi"},{"position":12,"text":"وَلَوْ","translation":"although","transliteration":"walaw"},{"position":13,"text":"كَرِهَ","translation":"dislike (it)","transliteration":"kariha"},{"position":14,"text":"ٱلْمُشْرِكُونَ","translation":"the polytheists","transliteration":"l-mush'rikūna"}]},{"id":5173,"verseKey":"61:10","verseNumber":10,"arabic":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ هَلْ أَدُلُّكُمْ عَلَىٰ تِجَـٰرَةٍ تُنجِيكُم مِّنْ عَذَابٍ أَلِيمٍ","translation":"O you who have believed, shall I guide you to a transaction that will save you from a painful punishment?","transliteration":"yāayyuhā alladhīna āmanū hal adullukum ʿalā tijāratin tunjīkum min ʿadhābin alīmin","audioUrl":"/audio/7/061010.mp3","segments":[[0,1,100,2950],[1,2,2960,3880],[2,3,3890,4790],[3,4,4800,5150],[4,5,5160,6270],[5,6,6280,6840],[6,7,6850,8720],[7,8,8730,11530],[8,9,11540,11950],[9,10,11960,13090],[10,11,13100,14880]],"words":[{"position":1,"text":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلَّذِينَ","translation":"(you) who","transliteration":"alladhīna"},{"position":3,"text":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"text":"هَلْ","transla