{"chapter":{"id":61,"nameSimple":"As-Saf","nameArabic":"الصف","translatedName":"The Ranks","versesCount":14,"revelationPlace":"madinah"},"verses":[{"id":5164,"verseKey":"61:1","verseNumber":1,"arabic":" سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","translation":"Whatever is in the heavens and whatever is on the earth exalts Allāh, and He is the Exalted in Might, the Wise.","transliteration":"sabbaḥa lillahi mā fī l-samāwāti wamā fī l-arḍi wahuwa l-ʿazīzu l-ḥakīmu","audioUrl":"/audio/7/061001.mp3","segments":[[0,1,170,960],[1,2,970,1910],[2,3,1920,2290],[3,4,2300,2470],[4,5,2480,3890],[5,6,3900,4410],[6,7,4420,4660],[7,8,4670,5480],[8,9,5490,6010],[9,10,6020,7070],[10,11,7080,9510]],"words":[{"position":1,"text":"سَبَّحَ","translation":"Glorifies","transliteration":"sabbaḥa"},{"position":2,"text":"لِلَّهِ","translation":"Allah","transliteration":"lillahi"},{"position":3,"text":"مَا","translation":"whatever","transliteration":"mā"},{"position":4,"text":"فِى","translation":"(is) in","transliteration":"fī"},{"position":5,"text":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":6,"text":"وَمَا","translation":"and whatever","transliteration":"wamā"},{"position":7,"text":"فِى","translation":"(is) in","transliteration":"fī"},{"position":8,"text":"ٱلْأَرْضِ ۖ","translation":"the earth","transliteration":"l-arḍi"},{"position":9,"text":"وَهُوَ","translation":"And He","transliteration":"wahuwa"},{"position":10,"text":"ٱلْعَزِيزُ","translation":"(is) the All-Mighty","transliteration":"l-ʿazīzu"},{"position":11,"text":"ٱلْحَكِيمُ","translation":"the All-Wise","transliteration":"l-ḥakīmu"}]},{"id":5165,"verseKey":"61:2","verseNumber":2,"arabic":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لِمَ تَقُولُونَ مَا لَا تَفْعَلُونَ","translation":"O you who have believed, why do you say what you do not do?","transliteration":"yāayyuhā alladhīna āmanū lima taqūlūna mā lā tafʿalūna","audioUrl":"/audio/7/061002.mp3","segments":[[0,1,50,2640],[1,2,2650,3620],[2,3,3630,4620],[3,4,4630,4950],[4,5,4960,6210],[5,6,6220,6650],[6,7,6660,6950],[7,8,6960,9670]],"words":[{"position":1,"text":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلَّذِينَ","translation":"(you) who","transliteration":"alladhīna"},{"position":3,"text":"ءَامَنُوا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"text":"لِمَ","translation":"Why","transliteration":"lima"},{"position":5,"text":"تَقُولُونَ","translation":"(do) you say","transliteration":"taqūlūna"},{"position":6,"text":"مَا","translation":"what","transliteration":"mā"},{"position":7,"text":"لَا","translation":"not","transliteration":"lā"},{"position":8,"text":"تَفْعَلُونَ","translation":"you do","transliteration":"tafʿalūna"}]},{"id":5166,"verseKey":"61:3","verseNumber":3,"arabic":"كَبُرَ مَقْتًا عِندَ ٱللَّهِ أَن تَقُولُوا۟ مَا لَا تَفْعَلُونَ","translation":"Greatly hateful in the sight of Allāh is that you say what you do not do.","transliteration":"kabura maqtan ʿinda l-lahi an taqūlū mā lā tafʿalūna","audioUrl":"/audio/7/061003.mp3","segments":[[0,1,30,590],[1,2,600,1320],[2,3,1330,2810],[3,4,2820,3670],[4,5,3680,4550],[5,6,4560,5640],[6,7,5650,6050],[7,8,6060,6420],[8,9,6430,9020]],"words":[{"position":1,"text":"كَبُرَ","translation":"Great is","transliteration":"kabura"},{"position":2,"text":"مَقْتًا","translation":"hatred","transliteration":"maqtan"},{"position":3,"text":"عِندَ","translation":"with","transliteration":"ʿinda"},{"position":4,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":5,"text":"أَن","translation":"that","transliteration":"an"},{"position":6,"text":"تَقُولُوا۟","translation":"you say","transliteration":"taqūlū"},{"position":7,"text":"مَا","translation":"what","transliteration":"mā"},{"position":8,"text":"لَا","translation":"not","transliteration":"lā"},{"position":9,"text":"تَفْعَلُونَ","translation":"you do","transliteration":"tafʿalūna"}]},{"id":5167,"verseKey":"61:4","verseNumber":4,"arabic":"إِنَّ ٱللَّهَ يُحِبُّ ٱلَّذِينَ يُقَـٰتِلُونَ فِى سَبِيلِهِۦ صَفًّا كَأَنَّهُم بُنْيَـٰنٌ مَّرْصُوصٌ","translation":"Indeed, Allāh loves those who fight in His cause in a row as though they are a [single] structure joined firmly.","transliteration":"inna l-laha yuḥibbu alladhīna yuqātilūna fī sabīlihi ṣaffan ka-annahum bun'yānun marṣūṣun","audioUrl":"/audio/7/061004.mp3","segments":[[0,1,30,1180],[1,2,1190,1910],[2,3,1920,2760],[3,4,2770,3710],[4,5,3720,5090],[5,6,5100,5490],[6,7,5500,6620],[7,8,6630,7960],[8,9,7970,10450],[9,10,10460,12520],[10,11,12530,14990]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":3,"text":"يُحِبُّ","translation":"loves","transliteration":"yuḥibbu"},{"position":4,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":5,"text":"يُقَـٰتِلُونَ","translation":"fight","transliteration":"yuqātilūna"},{"position":6,"text":"فِى","translation":"in","transliteration":"fī"},{"position":7,"text":"سَبِيلِهِۦ","translation":"His Way","transliteration":"sabīlihi"},{"position":8,"text":"صَفًّۭا","translation":"(in) a row","transliteration":"ṣaffan"},{"position":9,"text":"كَأَنَّهُم","translation":"as if they","transliteration":"ka-annahum"},{"position":10,"text":"بُنْيَـٰنٌۭ","translation":"(were) a structure","transliteration":"bun'yānun"},{"position":11,"text":"مَّرْصُوصٌۭ","translation":"joined firmly","transliteration":"marṣūṣun"}]},{"id":5168,"verseKey":"61:5","verseNumber":5,"arabic":"وَإِذْ قَالَ مُوسَىٰ لِقَوْمِهِۦ يَـٰقَوْمِ لِمَ تُؤْذُونَنِى وَقَد تَّعْلَمُونَ أَنِّى رَسُولُ ٱللَّهِ إِلَيْكُمْ ۖ فَلَمَّا زَاغُوٓا۟ أَزَاغَ ٱللَّهُ قُلُوبَهُمْ ۚ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلْفَـٰسِقِينَ","translation":"And [mention, O Muḥammad], when Moses said to his people, \"O my people, why do you harm me while you certainly know that 