transliteration":"dhunūbakum"},{"position":4,"text":"وَيُدْخِلْكُمْ","translation":"and admit you","transliteration":"wayud'khil'kum"},{"position":5,"text":"جَنَّـٰتٍۢ","translation":"(in) Gardens","transliteration":"jannātin"},{"position":6,"text":"تَجْرِى","translation":"flow","transliteration":"tajrī"},{"position":7,"text":"مِن","translation":"from","transliteration":"min"},{"position":8,"text":"تَحْتِهَا","translation":"underneath it","transliteration":"taḥtihā"},{"position":9,"text":"ٱلْأَنْهَـٰرُ","translation":"the rivers","transliteration":"l-anhāru"},{"position":10,"text":"وَمَسَـٰكِنَ","translation":"and dwellings","transliteration":"wamasākina"},{"position":11,"text":"طَيِّبَةًۭ","translation":"pleasant","transliteration":"ṭayyibatan"},{"position":12,"text":"فِى","translation":"in","transliteration":"fī"},{"position":13,"text":"جَنَّـٰتِ","translation":"Gardens","transliteration":"jannāti"},{"position":14,"text":"عَدْنٍۢ ۚ","translation":"(of) Eternity","transliteration":"ʿadnin"},{"position":15,"text":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":16,"text":"ٱلْفَوْزُ","translation":"(is) the success","transliteration":"l-fawzu"},{"position":17,"text":"ٱلْعَظِيمُ","translation":"the great","transliteration":"l-ʿaẓīmu"}]},{"id":5176,"verseKey":"61:13","verseNumber":13,"arabic":"وَأُخْرَىٰ تُحِبُّونَهَا ۖ نَصْرٌ مِّنَ ٱللَّهِ وَفَتْحٌ قَرِيبٌ ۗ وَبَشِّرِ ٱلْمُؤْمِنِينَ","translation":"And [you will obtain] another [favor] that you love - victory from Allāh and an imminent conquest; and give good tidings to the believers.","transliteration":"wa-ukh'rā tuḥibbūnahā naṣrun mina l-lahi wafatḥun qarībun wabashiri l-mu'minīna","audioUrl":"/audio/7/061013.mp3","segments":[[0,1,30,890],[1,2,900,3070],[2,3,3080,4630],[3,4,4640,4940],[4,5,4950,5700],[5,6,5710,7600],[6,7,7610,10550],[7,8,10560,11430],[8,9,11440,13780]],"words":[{"position":1,"text":"وَأُخْرَىٰ","translation":"And another","transliteration":"wa-ukh'rā"},{"position":2,"text":"تُ