{"chapter":{"id":104,"nameSimple":"Al-Humazah","nameArabic":"الهمزة","translatedName":"The Traducer","versesCount":9,"revelationPlace":"makkah"},"verses":[{"id":6180,"verseKey":"104:1","verseNumber":1,"arabic":" وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","translation":"Woe to every scorner and mocker","transliteration":"waylun likulli humazatin lumazatin","audioUrl":"/audio/7/104001.mp3","segments":[[0,1,30,810],[1,2,820,1820],[2,3,1830,2820],[3,4,2830,3830]],"words":[{"position":1,"text":"وَيْلٌۭ","translation":"Woe","transliteration":"waylun"},{"position":2,"text":"لِّكُلِّ","translation":"to every","transliteration":"likulli"},{"position":3,"text":"هُمَزَةٍۢ","translation":"slanderer","transliteration":"humazatin"},{"position":4,"text":"لُّمَزَةٍ","translation":"backbiter","transliteration":"lumazatin"}]},{"id":6181,"verseKey":"104:2","verseNumber":2,"arabic":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","translation":"Who collects wealth and [continuously] counts it.","transliteration":"alladhī jamaʿa mālan waʿaddadahu","audioUrl":"/audio/7/104002.mp3","segments":[[0,1,30,1060],[1,2,1070,1800],[2,3,1810,2490],[3,4,2500,4580]],"words":[{"position":1,"text":"ٱلَّذِى","translation":"The one who","transliteration":"alladhī"},{"position":2,"text":"جَمَعَ","translation":"collects","transliteration":"jamaʿa"},{"position":3,"text":"مَالًۭا","translation":"wealth","transliteration":"mālan"},{"position":4,"text":"وَعَدَّدَهُۥ","translation":"and counts it","transliteration":"waʿaddadahu"}]},{"id":6182,"verseKey":"104:3","verseNumber":3,"arabic":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","translation":"He thinks that his wealth will make him immortal.","transliteration":"yaḥsabu anna mālahu akhladahu","audioUrl":"/audio/7/104003.mp3","segments":[[0,1,60,910],[1,2,920,2350],[2,3,2360,4860],[3,4,4870,5840]],"words":[{"position":1,"text":"يَحْسَبُ","translation":"Thinking","transliteration":"yaḥsabu"},{"position":2,"text":"أَنَّ","translation":"that","transliteration":"anna"},{"position":3,"text":"مَالَهُۥٓ","translation":"his wealth","transliteration":"mālahu"},{"position":4,"text":"أَخْلَدَهُۥ","translation":"will make him immortal","transliteration":"akhladahu"}]},{"id":6183,"verseKey":"104:4","verseNumber":4,"arabic":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","translation":"No! He will surely be thrown into the Crusher.","transliteration":"kallā layunbadhanna fī l-ḥuṭamati","audioUrl":"/audio/7/104004.mp3","segments":[[0,1,30,1590],[1,2,1600,4790],[2,3,4800,5050],[3,4,5060,6070]],"words":[{"position":1,"text":"كَلَّا ۖ","translation":"Nay","transliteration":"kallā"},{"position":2,"text":"لَيُنۢبَذَنَّ","translation":"Surely he will be thrown","transliteration":"layunbadhanna"},{"position":3,"text":"فِى","translation":"in","transliteration":"fī"},{"position":4,"text":"ٱلْحُطَمَةِ","translation":"the Crusher","transliteration":"l-ḥuṭamati"}]},{"id":6184,"verseKey":"104:5","verseNumber":5,"arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","translation":"And what can make you know what is the Crusher?","transliteration":"wamā adrāka mā l-ḥuṭamatu","audioUrl":"/audio/7/104005.mp3","segments":[[0,1,30,1400],[1,2,1410,3070],[2,3,3080,3230],[3,4,3240,4290]],"words":[{"position":1,"text":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"text":"أَدْرَىٰكَ","translation":"will make you know","transliteration":"adrāka"},{"position":3,"text":"مَا","translation":"what","transliteration":"mā"},{"position":4,"text":"ٱلْحُطَمَةُ","translation":"the Crusher (is)","transliteration":"l-ḥuṭamatu"}]},{"id":6185,"verseKey":"104:6","verseNumber":6,"arabic":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","translation":"It is the fire of Allāh, [eternally] fueled,","transliteration":"nāru l-lahi l-mūqadatu","audioUrl":"/audio/7/104006.mp3","segments":[[0,1,50,660],[1,2,670,1610],[2,3,1620,2830]],"words":[{"position":1,"text":"نَارُ","translation":"A Fire","transliteration":"nāru"},{"position":2,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":3,"text