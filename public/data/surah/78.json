:"And full-breasted [companions] of equal age.","transliteration":"wakawāʿiba atrāban","audioUrl":"/audio/7/078033.mp3","segments":[[0,1,80,1490],[1,2,1500,2490]],"words":[{"position":1,"text":"وَكَوَاعِبَ","translation":"And splendid companions","transliteration":"wakawāʿiba"},{"position":2,"text":"أَتْرَابًۭا","translation":"well-matched","transliteration":"atrāban"}]},{"id":5706,"verseKey":"78:34","verseNumber":34,"arabic":"وَكَأْسًا دِهَاقًا","translation":"And a full cup.","transliteration":"wakasan dihāqan","audioUrl":"/audio/7/078034.mp3","segments":[[0,1,30,1670],[1,2,1680,3020]],"words":[{"position":1,"text":"وَكَأْسًۭا","translation":"And a cup","transliteration":"wakasan"},{"position":2,"text":"دِهَاقًۭا","translation":"full","transliteration":"dihāqan"}]},{"id":5707,"verseKey":"78:35","verseNumber":35,"arabic":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا","translation":"No ill speech will they hear therein or any falsehood -","transliteration":"lā yasmaʿūna fīhā laghwan walā kidhāban","audioUrl":"/audio/7/078035.mp3","segments":[[0,1,40,460],[1,2,470,1820],[2,3,1830,2760],[3,4,2770,4410],[4,5,4420,4960],[5,6,4970,5960]],"words":[{"position":1,"text":"لَّا","translation":"Not","transliteration":"lā"},{"position":2,"text":"يَسْمَعُونَ","translation":"they will hear","transliteration":"yasmaʿūna"},{"position":3,"text":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":4,"text":"لَغْوًۭا","translation":"any vain talk","transliteration":"laghwan"},{"position":5,"text":"وَلَا","translation":"and not","transliteration":"walā"},{"position":6,"text":"كِذَّٰبًۭا","translation":"any falsehood","transliteration":"kidhāban"}]},{"id":5708,"verseKey":"78:36","verseNumber":36,"arabic":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا","translation":"[As] reward from your Lord, [a generous] gift [made due by] account,","transliteration":"jazāan min rabbika ʿaṭāan ḥisāban","audioUrl":"/audio/7/078036.mp3","segments":[[0,1,40,2690],[1,2,2700,2760],[2,3,2770,3970],[3,4,3980,6480],[4,5,6490,7520]],"words":[{"position":1,"text":"جَزَآءًۭ","translation":"(As) a reward","transliteration":"jazāan"},{"position":2,"text":"مِّن","translation":"from","transliteration":"min"},{"position":3,"text":"رَّبِّكَ","translation":"your Lord","transliteration":"rabbika"},{"position":4,"text":"عَطَآءً","translation":"a gift","transliteration":"ʿaṭāan"},{"position":5,"text":"حِسَابًۭا","translation":"(according to) account","transliteration":"ḥisāban"}]},{"id":5709,"verseKey":"78:37","verseNumber":37,"arabic":"رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","translation":"[From] the Lord of the heavens and the earth and whatever is between them, the Most Merciful. They possess not from Him [authority for] speech.","transliteration":"rabbi l-samāwāti wal-arḍi wamā baynahumā l-raḥmāni lā yamlikūna min'hu khiṭāban","audioUrl":"/audio/7/078037.mp3","segments":[[0,1,40,700],[1,2,710,2460],[2,3,2470,3560],[3,4,3570,4270],[4,5,4280,6840],[5,6,6850,8860],[6,7,8870,9290],[7,8,9300,10790],[8,9,10800,11420],[9,10,11430,12410]],"words":[{"position":1,"text":"رَّبِّ","translation":"Lord","transliteration":"rabbi"},{"position":2,"text":"ٱلسَّمَـٰوَٰتِ","translation":"(of) the heavens","transliteration":"l-samāwāti"},{"position":3,"text":"وَٱلْأَرْضِ","translation":"and the earth","transliteration":"wal-arḍi"},{"position":4,"text":"وَمَا","translation":"and whatever","transliteration":"wamā"},{"position":5,"text":"بَيْنَهُمَا","translation":"(is) between both of them","transliteration":"baynahumā"},{"position":6,"text":"ٱلرَّحْمَـٰنِ ۖ","translation":"the Most Gracious","transliteration":"l-raḥmāni"},{"position":7,"text":"لَا","translation":"not","transliteration":"lā"},{"position":8,"text":"يَمْلِكُونَ","translation":"they have power","transliteration":"yamlikūna"},{"position":9,"text":"مِنْهُ","translation":"from Him","transliteration":"min'hu"},{"position":10,"text":"خِطَابًۭا","translation":"(to) address","transliteration":"khiṭāban"}]},{"id":5710,"verseKey":"78:38","verseNumber":38,"arabic":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا","translation":"The Day that the Spirit [i.e., Gabriel] and the angels will stand in rows, they will not speak except for one whom the Most Merciful permits, and he will say what is correct.","transliteration":"yawma yaqūmu l-rūḥu wal-malāikatu ṣaffan lā yatakallamūna illā man adhina lahu l-raḥmānu waqāla ṣawāban","audioUrl":"/audio/7/078038.mp3","segments":[[0,1,40,680],[1,2,690,1890],[2,3,1900,2620],[3,4,2630,5510],[4,5,5520,6100],[5,6,6110,6940],[6,7,6950,12680],[7,8,12690,13700],[8,9,13710,14130],[9,10,14140,14880],[10,11,14890,15290],[11,12,15300,16800],[12,13,16810,17640],[13,14,17650,18710]],"words":[{"position":1,"text":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"text":"يَقُومُ","translation":"will stand","transliteration":"yaqūmu"},{"position":3,"text":"ٱلرُّوحُ","translation":"the Spirit","transliteration":"l-rūḥu"},{"position":4,"text":"وَٱلْمَلَـٰٓئِكَةُ","translation":"and the Angels","transliteration":"wal-malāikatu"},{"position":5,"text":"صَفًّۭا ۖ","translation":"(in) rows","transliteration":"ṣaffan"},{"position":6,"text":"لَّا","translation":"not","transliteration":"lā"},{"position":7,"text":"يَتَكَلَّمُونَ","translation":"they will speak","transliteration":"yatakallamūna"},{"position":8,"text":"إِلَّا","translation":"except","transliteration":"illā"},{"position":9,"text":"مَنْ","translation":"(one) who ","transliteration":"man"},{"position":10,"text":"أَذِنَ","translation":"permits","transliteration":"adhina"},{"position":11,"text":"لَهُ","translation":"[for] him","transliteration":"lahu"},{"position":12,"text":"ٱلرَّحْمَـٰنُ","translation":"the Most Gracious","transliteration":"l-raḥmānu"},{"position":13,"text":"وَقَالَ","translation":"and he (will) say","transliteration":"waqāla"},{"position":