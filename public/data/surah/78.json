30],[1,2,1440,2610],[2,3,2620,3770],[3,4,3780,5240]],"words":[{"position":1,"text":"وَسُيِّرَتِ","translation":"And are moved","transliteration":"wasuyyirati"},{"position":2,"text":"ٱلْجِبَالُ","translation":"the mountains","transliteration":"l-jibālu"},{"position":3,"text":"فَكَانَتْ","translation":"and become","transliteration":"fakānat"},{"position":4,"text":"سَرَابًا","translation":"a mirage","transliteration":"sarāban"}]},{"id":5693,"verseKey":"78:21","verseNumber":21,"arabic":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا","translation":"Indeed, Hell has been lying in wait","transliteration":"inna jahannama kānat mir'ṣādan","audioUrl":"/audio/7/078021.mp3","segments":[[0,1,30,1190],[1,2,1200,2880],[2,3,2890,3880],[3,4,3890,5480]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"جَهَنَّمَ","translation":"Hell","transliteration":"jahannama"},{"position":3,"text":"كَانَتْ","translation":"is","transliteration":"kānat"},{"position":4,"text":"مِرْصَادًۭا","translation":"lying in wait","transliteration":"mir'ṣādan"}]},{"id":5694,"verseKey":"78:22","verseNumber":22,"arabic":"لِّلطَّـٰغِينَ مَـَٔابًا","translation":"For the transgressors, a place of return,","transliteration":"lilṭṭāghīna maāban","audioUrl":"/audio/7/078022.mp3","segments":[[0,1,30,1740],[1,2,1750,3080]],"words":[{"position":1,"text":"لِّلطَّـٰغِينَ","translation":"For the transgressors","transliteration":"lilṭṭāghīna"},{"position":2,"text":"مَـَٔابًۭا","translation":"a place of return","transliteration":"maāban"}]},{"id":5695,"verseKey":"78:23","verseNumber":23,"arabic":"لَّـٰبِثِينَ فِيهَآ أَحْقَابًا","translation":"In which they will remain for ages [unending].","transliteration":"lābithīna fīhā aḥqāban","audioUrl":"/audio/7/078023.mp3","segments":[[0,1,70,1420],[1,2,1430,2880],[2,3,2890,5695]],"words":[{"position":1,"text":"لَّـٰبِثِينَ","translation":"(They will) be remaining","transliteration":"lābithīna"},{"position":2,"text":"فِيهَآ","translati