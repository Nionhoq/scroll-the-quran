{"chapter":{"id":49,"nameSimple":"Al-Hujurat","nameArabic":"الحجرات","translatedName":"The Rooms","versesCount":18,"revelationPlace":"madinah"},"verses":[{"id":4613,"verseKey":"49:1","verseNumber":1,"arabic":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تُقَدِّمُواْ بَيۡنَ يَدَيِ ٱللَّهِ وَرَسُولِهِۦۖ وَٱتَّقُواْ ٱللَّهَۚ إِنَّ ٱللَّهَ سَمِيعٌ عَلِيمٞ","translation":"O you who have believed, do not put [yourselves] before Allāh and His Messenger but fear Allāh. Indeed, Allāh is Hearing and Knowing.","transliteration":"yāayyuhā alladhīna āmanū lā tuqaddimū bayna yadayi l-lahi warasūlihi wa-ittaqū l-laha inna l-laha samīʿun ʿalīmun","audioUrl":"/audio/7/049001.mp3","segments":[[0,1,80,3060],[1,2,3070,4090],[2,3,4100,5110],[3,4,5120,5430],[4,5,5440,6690],[5,6,6700,7250],[6,7,7260,7960],[7,8,7970,8690],[8,9,8700,10140],[9,10,10150,11200],[10,11,11210,13720],[11,12,13730,14880],[12,13,14890,15670],[13,14,15680,16700],[14,15,16710,18870]],"words":[{"position":1,"text":"يَٰٓأَيُّهَا","translation":"O you who believe","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلَّذِينَ","translation":"O you who believe","transliteration":"alladhīna"},{"position":3,"text":"ءَامَنُواْ","translation":"O you who believe","transliteration":"āmanū"},{"position":4,"text":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":5,"text":"تُقَدِّمُواْ","translation":"put (yourselves) forward ","transliteration":"tuqaddimū"},{"position":6,"text":"بَيۡنَ","translation":"before Allah","transliteration":"bayna"},{"position":7,"text":"يَدَيِ","translation":"before Allah","transliteration":"yadayi"},{"position":8,"text":"ٱللَّهِ","translation":"before Allah","transliteration":"l-lahi"},{"position":9,"text":"وَرَسُولِهِۦۖ","translation":"and His Messenger","transliteration":"warasūlihi"},{"position":10,"text":"وَٱتَّقُواْ","translation":"and fear Allah","transliteration":"wa-ittaqū"},{"position":11,"text":"ٱللَّهَۚ","translation":"and fear Allah","transliteration":"l-laha"},{"position":12,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":13,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":14,"text":"سَمِيعٌ","translation":"(is) All-Hearer","transliteration":"samīʿun"},{"position":15,"text":"عَلِيمٞ","translation":"All-Knower","transliteration":"ʿalīmun"}]},{"id":4614,"verseKey":"49:2","verseNumber":2,"arabic":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَرۡفَعُوٓاْ أَصۡوَٰتَكُمۡ فَوۡقَ صَوۡتِ ٱلنَّبِيِّ وَلَا تَجۡهَرُواْ لَهُۥ بِٱلۡقَوۡلِ كَجَهۡرِ بَعۡضِكُمۡ لِبَعۡضٍ أَن تَحۡبَطَ أَعۡمَٰلُكُمۡ وَأَنتُمۡ لَا تَشۡعُرُونَ","translation":"O you who have believed, do not raise your voices above the voice of the Prophet or be loud to him in speech like the loudness of some of you to others, lest your deeds become worthless while you perceive not.","transliteration":"yāayyuhā alladhīna āmanū lā tarfaʿū aṣwātakum fawqa ṣawti l-nabiyi walā tajharū lahu bil-qawli kajahri baʿḍikum libaʿḍin an taḥbaṭa aʿmālukum wa-antum lā tashʿurūna","audioUrl":"/audio/7/049002.mp3","segments":[[0,1,70,2880],[1,2,2890,3930],[2,3,3940,4920],[3,4,4930,5280],[4,5,5290,7730],[5,6,7740,9110],[6,7,9120,9680],[7,8,9690,10430],[8,9,10440,12070],[9,10,12080,12590],[10,11,12600,13720],[11,12,13730,14320],[12,13,14330,20190],[13,14,20200,21060],[14,15,21070,22130],[15,16,22140,23120],[16,17,23130,24140],[17,18,24150,25020],[18,19,25030,26410],[19,20,26420,28240],[20,21,28250,28610],[21,22,28620,30950]],"words":[{"position":1,"text":"يَٰٓأَيُّهَا","translation":"O you who believe","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلَّذِينَ","translation":"O you who believe","transliteration":"alladhīna"},{"position":3,"text":"ءَامَنُواْ","translation":"O you who believe","transliteration":"āmanū"},{"position":4,"text":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":5,"text":"تَرۡفَعُوٓاْ","translation":"raise","transliteration":"tarfaʿū"},{"position":6,"text":"أَصۡوَٰتَكُمۡ","translation":"your voices","transliteration":"a