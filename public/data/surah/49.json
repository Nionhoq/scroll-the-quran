ʿaẓīmun","audioUrl":"/audio/7/049003.mp3","segments":[[0,1,90,1590],[1,2,1600,2640],[2,3,2650,3890],[3,4,3900,5320],[4,5,5330,6460],[5,6,6470,7340],[6,7,7350,8180],[7,8,8190,11020],[8,9,11030,12070],[9,10,12080,12900],[10,11,12910,13760],[11,12,13770,15050],[12,13,15060,16910],[13,14,16920,18290],[14,15,18300,19340],[15,16,19350,21170],[16,17,21180,23440]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"text":"يَغُضُّونَ","translation":"lower","transliteration":"yaghuḍḍūna"},{"position":4,"text":"أَصۡوَٰتَهُمۡ","translation":"their voices","transliteration":"aṣwātahum"},{"position":5,"text":"عِندَ","translation":"(in) presence","transliteration":"ʿinda"},{"position":6,"text":"رَسُولِ","translation":"(of the) Messenger of Allah ","transliteration":"rasūli"},{"position":7,"text":"ٱللَّهِ","translation":"(of the) Messenger of Allah ","transliteration":"l-lahi"},{"position":8,"text":"أُوْلَٰٓئِكَ","translation":"those","transliteration":"ulāika"},{"position":9,"text":"ٱلَّذِينَ","translation":"(are) the ones","transliteration":"alladhīna"},{"position":10,"text":"ٱمۡتَحَنَ","translation":"Allah has tested","transliteration":"im'taḥana"},{"position":11,"text":"ٱللَّهُ","translation":"Allah has tested","transliteration":"l-lahu"},{"position":12,"text":"قُلُوبَهُمۡ","translation":"their hearts","transliteration":"qulūbahum"},{"position":13,"text":"لِلتَّقۡوَىٰۚ","translation":"for righteousness","transliteration":"lilttaqwā"},{"position":14,"text":"لَهُم","translation":"For them","transliteration":"lahum"},{"position":15,"text":"مَّغۡفِرَةٞ","translation":"(is) forgiveness","transliteration":"maghfiratun"},{"position":16,"text":"وَأَجۡرٌ","translation":"and a reward","transliteration":"wa-ajrun"},{"position":17,"text":"عَظِيمٌ","translation":"great","transliteration":"ʿaẓīmun"}]},{"id":4616,"verseKey":"49:4","verseNumber":4,"arabic"