"translation":"O you who believe","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلَّذِينَ","translation":"O you who believe","transliteration":"alladhīna"},{"position":3,"text":"ءَامَنُوٓاْ","translation":"O you who believe","transliteration":"āmanū"},{"position":4,"text":"إِن","translation":"If","transliteration":"in"},{"position":5,"text":"جَآءَكُمۡ","translation":"comes to you","transliteration":"jāakum"},{"position":6,"text":"فَاسِقُۢ","translation":"a wicked person","transliteration":"fāsiqun"},{"position":7,"text":"بِنَبَإٖ","translation":"with information","transliteration":"binaba-in"},{"position":8,"text":"فَتَبَيَّنُوٓاْ","translation":"investigate","transliteration":"fatabayyanū"},{"position":9,"text":"أَن","translation":"lest","transliteration":"an"},{"position":10,"text":"تُصِيبُواْ","translation":"you harm","transliteration":"tuṣībū"},{"position":11,"text":"قَوۡمَۢا","translation":"a people","transliteration":"qawman"},{"position":12,"text":"بِجَهَٰلَةٖ","translation":"in ignorance","transliteration":"bijahālatin"},{"position":13,"text":"فَتُصۡبِحُواْ","translation":"then you become","transliteration":"fatuṣ'biḥū"},{"position":14,"text":"عَلَىٰ","translation":"over","transliteration":"ʿalā"},{"position":15,"text":"مَا","translation":"what","transliteration":"mā"},{"position":16,"text":"فَعَلۡتُمۡ","translation":"you have done","transliteration":"faʿaltum"},{"position":17,"text":"نَٰدِمِينَ","translation":"regretful","transliteration":"nādimīna"}]},{"id":4619,"verseKey":"49:7","verseNumber":7,"arabic":"وَٱعۡلَمُوٓاْ أَنَّ فِيكُمۡ رَسُولَ ٱللَّهِۚ لَوۡ يُطِيعُكُمۡ فِي كَثِيرٖ مِّنَ ٱلۡأَمۡرِ لَعَنِتُّمۡ وَلَٰكِنَّ ٱللَّهَ حَبَّبَ إِلَيۡكُمُ ٱلۡإِيمَٰنَ وَزَيَّنَهُۥ فِي قُلُوبِكُمۡ وَكَرَّهَ إِلَيۡكُمُ ٱلۡكُفۡرَ وَٱلۡفُسُوقَ وَٱلۡعِصۡيَانَۚ أُوْلَٰٓئِكَ هُمُ ٱلرَّٰشِدُونَ","translation":"And know that among you is the Messenger of Allāh. If he were to obey you in much of the matter, you would be in difficulty, but Allāh has endeared to you the faith and has made it pleasing in your hearts and has made hateful to you disbelief, defiance and disobedience. Those are the [rightly] guided.","transliteration":"wa-iʿ'lamū anna fīkum rasūla l-lahi law yuṭīʿukum fī kathīrin mina l-amri laʿanittum walākinna l-laha ḥabbaba ilaykumu l-īmāna wazayyanahu fī qulūbikum wakarraha ilaykumu l-kuf'ra wal-fusūqa wal-ʿiṣ'yāna ulāika humu l-rāshidūna","audioUrl":"/audio/7/049007.mp3","segments":[[0,1,100,2570],[1,2,2580,3650],[2,3,3660,4530],[3,4,4540,5380],[4,5,5390,8280],[5,6,8290,8630],[6,7,8640,9960],[7,8,9970,10380],[8,9,10390,12310],[9,10,12320,12600],[10,11,12610,13460],[11,12,13470,14710],[12,13,14720,16480],[13,14,16490,17300],[14,15,17310,18180],[15,16,18190,19220],[16,17,19230,20450],[17,18,20460,21880],[18,19,21890,22300],[19,20,22310,23660],[20,21,23670,24710],[21,22,24720,25760],[22,23,25770,26610],[23,24,26620,27810],[24,25,27820,31030],[25,26,31040,33670],[26,27,33680,34400],[27,28,34410,36710]],"words":[{"position":1,"text":"وَٱعۡلَمُوٓاْ","translation":"And know","transliteration":"wa-iʿ'lamū"},{"position":2,"text":"أَنَّ","translation":"that","transliteration":"anna"},{"position":3,"text":"فِيكُمۡ","translation":"among you","transliteration":"fīkum"},{"position":4,"text":"رَسُولَ","translation":"(is the) Messenger of Allah","transliteration":"rasūla"},{"position":5,"text":"ٱللَّهِۚ","translation":"(is the) Messenger of Allah","transliteration":"l-lahi"},{"position":6,"text":"لَوۡ","translation":"If","transliteration":"law"},{"position":7,"text":"يُطِيعُكُمۡ","translation":"he were to obey you","transliteration":"yuṭīʿukum"},{"position":8,"text":"فِي","translation":"in","transliteration":"fī"},{"position":9,"text":"كَثِيرٖ","translation":"much","transliteration":"kathīrin"},{"position":10,"text":"مِّنَ","translation":"of","transliteration":"mina"},{"position":11,"text":"ٱلۡأَمۡرِ","translation":"the matter","transliteration":"l-amri"},{"position":12,"text":"لَعَنِتُّمۡ","translation":"surely you would be in difficulty","transliteration":"laʿanittum"},{"position":13,"text":"وَلَٰكِنَّ","translation":"but","transliteration":"walākinna"},{"position":14,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":15,"text":"حَبَّبَ","translation":"has endeared","transliteration":"ḥabbaba"},{"position":16,"text":"إِلَيۡكُمُ","translation":"to you","transliteration":"ilaykumu"},{"position":17,"text":"ٱلۡإِيمَٰنَ","translation":"the Faith","transliteration":"l-īmāna"},{"position":18,"text":"وَزَيَّنَهُۥ","translation":"and has made it pleasing","transliteration":"wazayyanahu"},{"position":19,"text":"فِي","translation":"in","transliteration":"fī"},{"position":20,"text":"قُلُوبِكُمۡ","translation":"your hearts","transliteration":"qulūbikum"},{"position":21,"text":"وَكَرَّهَ","translation":"and has made hateful","transliteration":"wakarraha"},{"position":22,"text":"إِلَيۡكُمُ","translation":"to you","transliteration":"ilaykumu"},{"position":23,"text":"ٱلۡكُفۡرَ","translation":"disbelief","transliteration":"l-kuf'ra"},{"position":24,"text":"وَٱلۡفُسُوقَ","translation":"and defiance","transliteration":"wal-fusūqa"},{"position":25,"text":"وَٱلۡعِصۡيَانَۚ","translation":"and disobedience","transliteration":"wal-ʿiṣ'yāna"},{"position":26,"text":"أُوْلَٰٓئِكَ","translation":"Those","transliteration":"ulāika"},{"position":27,"text":"هُمُ","translation":"(are) they ","transliteration":"humu"},{"position":28,"text":"ٱلرَّٰشِدُونَ","translation":"the guided ones","transliteration":"l-rāshidūna"}]},{"id":4620,"verseKey":"49:8","verseNumber":8,"arabic":"فَضۡلٗا مِّنَ ٱللَّهِ وَنِعۡمَةٗۚ وَٱللَّهُ عَلِيمٌ حَكِيمٞ","translation":"[It is] as bounty from Allāh and favor. And Allāh is Knowing and Wise.","transliteration":"faḍlan mina l-lahi waniʿ'matan wal-lahu ʿalīmun ḥakīmun","audioUrl":"/audio/7/049008.mp3","segments":[[0,1,30,620],[1,2,630,1900],[2,3,1910,2740],[3,4,2750,4150],[4,5,4160,5140],[5,6,5150,6150],[6,7,6160,9200]],"words":[{"position":1,"text":"فَضۡلٗا","translation":"A Bounty","transliteration":"faḍlan"},{"position":2,"text":"مِّنَ","translation":"from Allah","transliteration":"mina"},{"position":3,"text":"ٱللَّهِ","translation":"from Allah","transliteration":"l-lahi"},{"position":4,"text":"وَنِعۡمَةٗۚ","translation":"and favor","transliteration":"waniʿ'matan"},{"position":5,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":6,"text":"عَلِيمٌ","translation":"(is) All-Knower","transliteration":"ʿalīmun"},{"position":7,"text":"حَكِيمٞ","translation":"All-Wise","transliteration":"ḥakīmun"}]},{"id":4621,"verseKey":"49:9","verseNumber":9,"arabic":"وَإِن طَآئِفَتَانِ مِنَ ٱلۡمُؤۡمِنِينَ ٱقۡتَتَلُواْ فَأَصۡلِحُواْ بَيۡنَهُمَاۖ فَإِنۢ بَغَتۡ إِحۡدَىٰهُمَا عَلَى ٱلۡأُخۡرَىٰ فَقَٰتِلُواْ ٱلَّتِي تَبۡغِي حَتَّىٰ تَفِيٓءَ إِلَىٰٓ أَمۡرِ ٱللَّهِۚ فَإِن فَآءَتۡ فَأَصۡلِحُواْ بَيۡنَهُمَا بِٱلۡعَدۡلِ وَأَقۡسِطُوٓاْۖ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُقۡسِطِينَ","translation":"And if two factions among the believers should fight, then make settlement between the two. But if one of them oppresses the other, then fight against the one that oppresses until it returns to the ordinance of Allāh. And if it returns, then make settlement between them in justice and act justly. Indeed, Allāh loves those who act justly.","transliteration":"wa-in ṭāifatāni mina l-mu'minīna iq'tatalū fa-aṣliḥū baynahumā fa-in baghat iḥ'dāhumā ʿalā l-ukh'rā faqātilū allatī tabghī ḥattā tafīa ilā amri l-lahi fa-in fāat fa-aṣliḥū baynahumā bil-ʿadli wa-aqsiṭū inna l-laha yuḥibbu l-muq'siṭīna","audioUrl":"/audio/7/049009.mp3","segments":[[0,1,40,1500],[1,2,1510,4690],[2,3,4700,5100],[3,4,5110,6530],[4,5,6540,7570],[5,6,7580,8850],[6,7,8860,10780],[7,8,10790,12210],[8,9,12220,12850],[9,10,12860,14290],[10,11,14300,14740],[11,12,14750,15730],[12,13,15740,16860],[13,14,16870,17700],[14,15,17710,18550],[15,16,18560,19360],[16,17,19370,21800],[17,18,21810,23810],[18,19,23820,24320],[19,20,24330,27370],[20,21,27380,28490],[21,22,28500,30950],[22,23,30960,32220],[23,24,32230,33500],[24,25,33510,34590],[25,26,34600,36430],[26,27,36440,37790],[27,28,37800,38620],[28,29,38630,39520],[29,30,39530,42180]],"words":[{"position":1,"text":"وَإِن","translation":"And if","transliteration":"wa-in"},{"position":2,"text":"طَآئِفَتَانِ","translation":"two parties","transliteration":"ṭāifatāni"},{"position":3,"text":"مِنَ","translation":"among","transliteration":"mina"},{"position":4,"text":"ٱلۡمُؤۡمِنِينَ","translation":"the believers","transliteration":"l-mu'minīna"},{"position":5,"text":"ٱقۡتَتَلُواْ","translation":"fight","transliteration":"iq'tatalū"},{"position":6,"text":"فَأَصۡلِحُواْ","translation":"then make peace","transliteration":"fa-aṣliḥū"},{"position":7,"text":"بَيۡنَهُمَاۖ","translation":"between both of them","transliteration":"baynahumā"},{"position":8,"text":"فَإِنۢ","translation":"But if","transliteration":"fa-in"},{"position":9,"text":"بَغَتۡ","translation":"oppresses","transliteration":"baghat"},{"position":10,"text":"إِحۡدَىٰهُمَا","translation":"one of them","transliteration":"iḥ'dāhumā"},{"position":11,"text":"عَلَى","translation":"on","transliteration":"ʿalā"},{"position":12,"text":"ٱلۡأُخۡرَىٰ","translation":"the other","transliteration":"l-ukh'rā"},{"position":13,"text":"فَقَٰتِلُواْ","translation":"then fight","transliteration":"faqātilū"},{"position":14,"text":"ٱلَّتِي","translation":"one which","transliteration":"allatī"},{"position":15,"text":"تَبۡغِي","translation":"oppresses","transliteration":"tabghī"},{"position":16,"text":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":17,"text":"تَفِيٓءَ","translation":"it returns","transliteration":"tafīa"},{"position":18,"text":"إِلَىٰٓ","translation":"to","transliteration":"ilā"},{"position":19,"text":"أَمۡرِ","translation":"(the) command","transliteration":"amri"},{"position":20,"text":"ٱللَّهِۚ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":21,"text":"فَإِن","translation":"Then if","transliteration":"fa-in"},{"position":22,"text":"فَآءَتۡ","translation":"it returns","transliteration":"fāat"},{"position":23,"text":"فَأَصۡلِحُواْ","translation":"then make peace","transliteration":"fa-aṣliḥū"},{"position":24,"text":"بَيۡنَهُمَا","translation":"between them","transliteration":"baynahumā"},{"position":25,"text":"بِٱلۡعَدۡلِ","translation":"with justice","transliteration":"bil-ʿadli"},{"position":26,"text":"وَأَقۡسِطُوٓاْۖ","translation":"and act justly","transliteration":"wa-aqsiṭū"},{"position":27,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":28,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":29,"text":"يُحِبُّ","translation":"loves","transliteration":"yuḥibbu"},{"position":30,"text":"ٱلۡمُقۡسِطِينَ","translation":"those who act justly","transliteration":"l-muq'siṭīna"}]},{"id":4622,"verseKey":"49:10","verseNumber":10,"arabic":"إِنَّمَا ٱلۡمُؤۡمِنُونَ إِخۡوَةٞ فَأَصۡلِحُواْ بَيۡنَ أَخَوَيۡكُمۡۚ وَٱتَّقُواْ ٱللَّهَ لَعَلَّكُمۡ تُرۡحَمُونَ","translation":"The believers are but brothers, so make settlement between your brothers. And fear Allāh that you may receive mercy.","transliteration":"innamā l-mu'minūna ikh'watun fa-aṣliḥū bayna akhawaykum wa-ittaqū l-laha laʿallakum tur'ḥamūna","audioUrl":"/audio/7/049010.mp3","segments":[[0,1,30,1830],[1,2,1840,3350],[2,3,3360,5290],[3,4,5300,6620],[4,5,6630,7270],[5,6,7280,9070],[6,7,9080,9930],[7,8,9940,10850],[8,9,10860,12190],[9,10,12200,16670]],"words":[{"position":1,"text":"إِنَّمَا","translation":"Only","transliteration":"innamā"},{"position":2,"text":"ٱلۡمُؤۡمِنُونَ","translation":"the believers","transliteration":"l-mu'minūna"},{"position":3,"text":"إِخۡوَةٞ","translation":"(are) brothers","transliteration":"ikh'watun"},{"position":4,"text":"فَأَصۡلِحُواْ","translation":"so make peace","transliteration":"fa-aṣliḥū"},{"position":5,"text":"بَيۡنَ","translation":"between","transliteration":"bayna"},{"position":6,"text":"أَخَوَيۡكُمۡۚ","translation":"your brothers","transliteration":"akhawaykum"},{"position":7,"text":"وَٱتَّقُواْ","translation":"and fear Allah","transliteration":"wa-ittaqū"},{"position":8,"text":"ٱللَّهَ","translation":"and fear Allah","transliteration":"l-laha"},{"position":9,"text":"لَعَلَّكُمۡ","translation":"so that you may","transliteration":"laʿallakum"},{"position":10,"text":"تُرۡحَمُونَ","translation":"receive mercy","transliteration":"tur'ḥamūna"}]},{"id":4623,"verseKey":"49:11","verseNumber":11,"arabic":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا يَسۡخَرۡ قَوۡمٞ مِّن قَوۡمٍ عَسَىٰٓ أَن يَكُونُواْ خَيۡرٗا مِّنۡهُمۡ وَلَا نِسَآءٞ مِّن نِّسَآءٍ عَسَىٰٓ أَن يَكُنَّ خَيۡرٗا مِّنۡهُنَّۖ وَلَا تَلۡمِزُوٓاْ أَنفُسَكُمۡ وَلَا تَنَابَزُواْ بِٱلۡأَلۡقَٰبِۖ بِئۡسَ ٱلِٱسۡمُ ٱلۡفُسُوقُ بَعۡدَ ٱلۡإِيمَٰنِۚ وَمَن لَّمۡ يَتُبۡ فَأُوْلَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ","translation":"O you who have believed, let not a people ridicule [another] people; perhaps they may be better than them; nor let women ridicule [other] women; perhaps they may be better than them. And do not insult one another and do not call each other by [offensive] nicknames. Wretched is the name [i.e., mention] of disobedience after [one's] faith. And whoever does not repent - then it is those who are the wrongdoers.","transliteration":"yāayyuhā alladhīna āmanū lā yaskhar qawmun min qawmin ʿasā an yakūnū khayran min'hum walā nisāon min nisāin ʿasā an yakunna khayran min'hunna walā talmizū anfusakum walā tanābazū bil-alqābi bi'sa l-s'mu l-fusūqu baʿda l-īmāni waman lam yatub fa-ulāika humu l-ẓālimūna","audioUrl":"/audio/7/049011.mp3","segments":[[0,1,150,3180],[1,2,3190,4290],[2,3,4300,5350],[3,4,5360,5820],[4,5,5830,6700],[5,6,6710,8330],[6,7,8340,9430],[7,8,9440,10230],[8,9,10240,12500],[9,10,12510,13410],[10,11,13420,14400],[11,12,14410,15140],[12,13,15150,16910],[13,14,16920,17490],[14,15,17500,20860],[15,16,20870,21790],[16,17,21800,24200],[17,18,24210,26580],[18,19,26590,27550],[19,20,27560,29010],[20,21,29020,29750],[21,22,29760,32880],[22,23,32890,33490],[23