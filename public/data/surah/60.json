]],"words":[{"position":1,"text":"يَٰٓأَيُّهَا","translation":"O you","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلَّذِينَ","translation":"who","transliteration":"alladhīna"},{"position":3,"text":"ءَامَنُواْ","translation":"believe","transliteration":"āmanū"},{"position":4,"text":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":5,"text":"تَتَوَلَّوۡاْ","translation":"make allies","transliteration":"tatawallaw"},{"position":6,"text":"قَوۡمًا","translation":"(of) a people","transliteration":"qawman"},{"position":7,"text":"غَضِبَ","translation":"(The) wrath","transliteration":"ghaḍiba"},{"position":8,"text":"ٱللَّهُ","translation":"(of) Allah","transliteration":"l-lahu"},{"position":9,"text":"عَلَيۡهِمۡ","translation":"(is) upon them","transliteration":"ʿalayhim"},{"position":10,"text":"قَدۡ","translation":"Indeed","transliteration":"qad"},{"position":11,"text":"يَئِسُواْ","translation":"they despair","transliteration":"ya-isū"},{"position":12,"text":"مِنَ","translation":"of","transliteration":"mina"},{"position":13,"text":"ٱلۡأٓخِرَةِ","translation":"the Hereafter","transliteration":"l-ākhirati"},{"position":14,"text":"كَمَا","translation":"as","transliteration":"kamā"},{"position":15,"text":"يَئِسَ","translation":"despair","transliteration":"ya-isa"},{"position":16,"text":"ٱلۡكُفَّارُ","translation":"the disbelievers","transliteration":"l-kufāru"},{"position":17,"text":"مِنۡ","translation":"of","transliteration":"min"},{"position":18,"text":"أَصۡحَٰبِ","translation":"(the) companions","transliteration":"aṣḥābi"},{"position":19,"text":"ٱلۡقُبُورِ","translation":"(of) the graves","transliteration":"l-qubūri"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
