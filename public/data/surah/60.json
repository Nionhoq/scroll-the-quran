turn","transliteration":"l-maṣīru"}]},{"id":5155,"verseKey":"60:5","verseNumber":5,"arabic":"رَبَّنَا لَا تَجۡعَلۡنَا فِتۡنَةٗ لِّلَّذِينَ كَفَرُواْ وَٱغۡفِرۡ لَنَا رَبَّنَآۖ إِنَّكَ أَنتَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ","translation":"Our Lord, make us not [objects of] torment for the disbelievers and forgive us, our Lord. Indeed, it is You who is the Exalted in Might, the Wise.\"","transliteration":"rabbanā lā tajʿalnā fit'natan lilladhīna kafarū wa-igh'fir lanā rabbanā innaka anta l-ʿazīzu l-ḥakīmu","audioUrl":"/audio/7/060005.mp3","segments":[[0,1,170,1120],[1,2,1130,1450],[2,3,1460,2620],[3,4,2630,3460],[4,5,3470,4690],[5,6,4700,5540],[6,7,5550,6240],[7,8,6250,6850],[8,9,6860,8260],[9,10,8270,9790],[10,11,9800,11270],[11,12,11280,12450],[12,13,12460,15250]],"words":[{"position":1,"text":"رَبَّنَا","translation":"Our Lord","transliteration":"rabbanā"},{"position":2,"text":"لَا","translation":"(do) not","transliteration":"lā"},{"position":3,"text":"تَجۡعَلۡنَا","translation":"make us","transliteration":"tajʿalnā"},{"position":4,"text":"فِتۡنَةٗ","translation":"a trial","transliteration":"fit'natan"},{"position":5,"text":"لِّلَّذِينَ","translation":"for those who","transliteration":"lilladhīna"},{"position":6,"text":"كَفَرُواْ","translation":"disbelieve","transliteration":"kafarū"},{"position":7,"text":"وَٱغۡفِرۡ","translation":"and forgive","transliteration":"wa-igh'fir"},{"position":8,"text":"لَنَا","translation":"us","transliteration":"lanā"},{"position":9,"text":"رَبَّنَآۖ","translation":"our Lord","transliteration":"rabbanā"},{"position":10,"text":"إِنَّكَ","translation":"Indeed You","transliteration":"innaka"},{"position":11,"text":"أَنتَ","translation":"[You]","transliteration":"anta"},{"position":12,"text":"ٱلۡعَزِيزُ","translation":"(are) the All-Mighty","transliteration":"l-ʿazīzu"},{"position":13,"text":"ٱلۡحَكِيمُ","translation":"the All-Wise","transliteration":"l-ḥakīmu"}]},{"id":5156,"verseKey":"60:6","verseNumber":6,"arabic":"لَقَدۡ كَانَ لَكُمۡ فِيهِمۡ أُسۡوَةٌ حَسَنَةٞ لِّمَن كَانَ يَرۡجُواْ ٱللَّهَ وَٱلۡيَوۡمَ ٱلۡأٓخِرَۚ وَمَن يَتَوَلَّ فَإِنَّ ٱللَّهَ هُوَ ٱلۡغَنِيُّ ٱلۡحَمِيدُ","translation":"There has certainly been for you in them an excellent pattern for anyone whose hope is in Allāh and the Last Day. And whoever turns away - then indeed, Allāh is the Free of need, the Praiseworthy.","transliteration":"laqad kāna lakum fīhim us'watun ḥasanatun liman kāna yarjū l-laha wal-yawma l-ākhira waman yatawalla fa-inna l-laha huwa l-ghaniyu l-ḥamīdu","audioUrl":"/audio/7/060006.mp3","segments":[[0,1,90,580],[1,2,590,1190],[2,3,1200,1710],[3,4,1720,2530],[4,5,2540,3380],[5,6,3390,4250],[6,7,4260,5490],[7,8,5500,6110],[8,9,6120,7010],[9,10,7020,7560],[10,11,7570,8480],[11,12,8490,9890],[12,13,9900,11090],[13,14,11100,11930],[14,15,11940,13160],[15,16,13170,13900],[16,17,13910,14310],[17,18,14320,15270],[18,19,15280,17590]],"words":[{"position":1,"text":"لَقَدۡ","translation":"Certainly","transliteration":"laqad"},{"position":2,"text":"كَانَ","translation":"(there) is","transliteration":"kāna"},{"position":3,"text":"لَكُمۡ","translation":"for you","transliteration":"lakum"},{"position":4,"text":"فِيهِمۡ","translation":"in them","transliteration":"fīhim"},{"position":5,"text":"أُسۡوَةٌ","translation":"an example","transliteration":"us'watun"},{"position":6,"text":"حَسَنَةٞ","translation":"good","transliteration":"ḥasanatun"},{"position":7,"text":"لِّمَن","translation":"for (he) who","transliteration":"liman"},{"position":8,"text":"كَانَ","translation":"is","transliteration":"kāna"},{"position":9,"text":"يَرۡجُواْ","translation":"hopeful","transliteration":"yarjū"},{"position":10,"text":"ٱللَّهَ","translation":"(in) Allah","transliteration":"l-laha"},{"position":11,"text":"وَٱلۡيَوۡمَ","translation":"and the Day","transliteration":"wal-yawma"},{"position":12,"text":"ٱلۡأٓخِرَۚ","translation":"the Last","transliteration":"l-ākhira"},{"position":13,"text":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":14,"text":"يَتَوَلَّ","translation":"turns away","transliteration":"yatawalla"},{"position":15,"text":"فَإِنَّ","translation":"then indeed","transliteration":"fa-inna"},{"position":16,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":17,"text":"هُوَ","translation":"He","transliteration":"huwa"},{"position":18,"text":"ٱلۡغَنِيُّ","translation":"(is) Free of need","transliteration":"l-ghaniyu"},{"position":19,"text":"ٱلۡحَمِيدُ","translation":"the Praiseworthy","transliteration":"l-ḥamīdu"}]},{"id":5157,"verseKey":"60:7","verseNumber":7,"arabic":"۞ عَسَى ٱللَّهُ أَن يَجۡعَلَ بَيۡنَكُمۡ وَبَيۡنَ ٱلَّذِينَ عَادَيۡتُم مِّنۡهُم مَّوَدَّةٗۚ وَٱللَّهُ قَدِيرٞۚ وَٱللَّهُ غَفُورٞ رَّحِيمٞ","translation":"Perhaps Allāh will put, between you and those to whom you have been enemies among them, affection. And Allāh is competent, and Allāh is Forgiving and Merciful.","transliteration":"ʿasā l-lahu an yajʿala baynakum wabayna alladhīna ʿādaytum min'hum mawaddatan wal-lahu qadīrun wal-lahu ghafūrun raḥīmun","audioUrl":"/audio/7/060007.mp3","segments":[[0,1,80,570],[1,2,580,1340],[2,3,1350,2410],[3,4,2420,2980],[4,5,2990,3970],[5,6,3980,4730],[6,7,4740,5640],[7,8,5650,6580],[8,9,6590,9170],[9,10,9180,10510],[10,11,10520,11440],[11,12,11450,13980],[12,13,13990,14870],[13,14,14880,15970],[14,15,15980,17870]],"words":[{"position":1,"text":"۞ عَسَى","translation":"Perhaps","transliteration":"ʿasā"},{"position":2,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":3,"text":"أَن","translation":"[that]","transliteration":"an"},{"position":4,"text":"يَجۡعَلَ","translation":"will put","transliteration":"yajʿala"},{"position":5,"text":"بَيۡنَكُمۡ","translation":"between you","transliteration":"baynakum"},{"position":6,"text":"وَبَيۡنَ","translation":"and between","transliteration":"wabayna"},{"position":7,"text":"ٱلَّذِينَ","translation":"those (to) whom","transliteration":"alladhīna"},{"position":8,"text":"عَادَيۡتُم","translation":"you have been enemies","transliteration":"ʿādaytum"},{"position":9,"text":"مِّنۡهُم","translation":"among them","transliteration":"min'hum"},{"position":10,"text":"مَّوَدَّةٗۚ","translation":"love","transliteration":"mawaddatan"},{"position":11,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":12,"text":"قَدِيرٞۚ","translation":"(is) All-Powerful","transliteration":"qadīrun"},{"position":13,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":14,"text":"غَفُورٞ","translation":"(is) Oft-Forgiving","transliteration":"ghafūrun"},{"position":15,"text":"رَّحِيمٞ","translation":"Most Merciful","transliteration":"raḥīmun"}]},{"id":5158,"verseKey":"60:8","verseNumber":8,"arabic":"لَّا يَنۡهَىٰكُمُ ٱللَّهُ عَنِ ٱلَّذِينَ لَمۡ يُقَٰتِلُوكُمۡ فِي ٱلدِّينِ وَلَمۡ يُخۡرِجُوكُم مِّن دِيَٰرِكُمۡ أَن تَبَرُّوهُمۡ وَتُقۡسِطُوٓاْ إِلَيۡهِمۡۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُقۡسِطِينَ","translation":"Allāh does not forbid you from those who do not fight you because of religion and do not expel you from your homes - from being righteous toward them and acting justly toward them. Indeed, Allāh loves those who act justly.","transliteration":"lā yanhākumu l-lahu ʿani alladhīna lam yuqātilūkum fī l-dīni walam yukh'rijūkum min diyārikum an tabarrūhum watuq'siṭū ilayhim inna l-laha yuḥibbu l-muq'siṭīna","audioUrl":"/audio/7/060008.mp3","segments":[[0,1,80,500],[1,2,510,1880],[2,3,1890,2380],[3,4,2390,2840],[4,5,2850,3840],[5,6,3850,4140],[6,7,4150,5730],[7,8,5740,5990],[8,9,6000,6780],[9,10,6790,7300],[10,11,7310,9820],[11,12,9830,10650],[12,13,10660,11770],[13,14,11780,12830],[14,15,12840,14230],[15,16,14240,16730],[16,17,16740,18160],[17,18,18170,19440],[18,19,19450,20210],[19,20,20220,21020],[20,21,21030,23590]],"words":[{"position":1,"text":"لَّا","translation":"Not","transliteration":"lā"},{"position":2,"text":"يَنۡهَىٰكُمُ","translation":"(does) forbid you","transliteration":"yanhākumu"},{"position":3,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":4,"text":"عَنِ","translation":"from","transliteration":"ʿani"},{"position":5,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":6,"text":"لَمۡ","translation":"(do) not","transliteration":"lam"},{"position":7,"text":"يُقَٰتِلُوكُمۡ","translation":"fight you","transliteration":"yuqātilūkum"},{"position":8,"text":"فِي","translation":"in","transliteration":"fī"},{"position":9,"text":"ٱلدِّينِ","translation":"the religion","transliteration":"l-dīni"},{"position":10,"text":"وَلَمۡ","translation":"and (do) not","transliteration":"walam"},{"position":11,"text":"يُخۡرِجُوكُم","translation":"drive you out","transliteration":"yukh'rijūkum"},{"position":12,"text":"مِّن","translation":"of","transliteration":"min"},{"position":13,"text":"دِيَٰرِكُمۡ","translation":"your homes","transliteration":"diyārikum"},{"position":14,"text":"أَن","translation":"that","transliteration":"an"},{"position":15,"text":"تَبَرُّوهُمۡ","translation":"you deal kindly","transliteration":"tabarrūhum"},{"position":16,"text":"وَتُقۡسِطُوٓاْ","translation":"and deal justly","transliteration":"watuq'siṭū"},{"position":17,"text":"إِلَيۡهِمۡۚ","translation":"with them","transliteration":"ilayhim"},{"position":18,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":19,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":20,"text":"يُحِبُّ","translation":"loves","transliteration":"yuḥibbu"},{"position":21,"text":"ٱلۡمُقۡسِطِينَ","translation":"those who act justly","transliteration":"l-muq'siṭīna"}]},{"id":5159,"verseKey":"60:9","verseNumber":9,"arabic":"إِنَّمَا يَنۡهَىٰكُمُ ٱللَّهُ عَنِ ٱلَّذِينَ قَٰتَلُوكُمۡ فِي ٱلدِّينِ وَأَخۡرَجُوكُم مِّن دِيَٰرِكُمۡ وَظَٰهَرُواْ عَلَىٰٓ إِخۡرَاجِكُمۡ أَن تَوَلَّوۡهُمۡۚ وَمَن يَتَوَلَّهُمۡ فَأُوْلَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ","translation":"Allāh only forbids you from those who fight you because of religion and expel you from your homes and aid in your expulsion - [forbids] that you make allies of them. And whoever makes allies of them, then it is those who are the wrongdoers.","transliteration":"innamā yanhākumu l-lahu ʿani alladhīna qātalūkum fī l-dīni wa-akhrajūkum min diyārikum waẓāharū ʿalā ikh'rājikum an tawallawhum waman yatawallahum fa-ulāika humu l-ẓālimūna","audioUrl":"/audio/7/060009.mp3","segments":[[0,1,150,1780],[1,2,1790,2970],[2,3,2980,3640],[3,4,3650,4060],[4,5,4070,5030],[5,6,5040,6410],[6,7,6420,6690],[7,8,6700,7440],[8,9,7450,8670],[9,10,8680,10470],[10,11,10480,11590],[11,12,11600,12720],[12,13,12730,13080],[13,14,13090,15840],[14,15,15850,17070],[15,16,17080,18990],[16,17,19000,20350],[17,18,20360,21580],[18,19,21590,24190],[19,20,24200,24620],[20,21,24630,27050]],"words":[{"position":1,"text":"إِنَّمَا","translation":"Only","transliteration":"innamā"},{"position":2,"text":"يَنۡهَىٰكُمُ","translation":"forbids you","transliteration":"yanhākumu"},{"position":3,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":4,"text":"عَنِ","translation":"from","transliteration":"ʿani"},{"position":5,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":6,"text":"قَٰتَلُوكُمۡ","translation":"fight you","transliteration":"qātalūkum"},{"position":7,"text":"فِي","translation":"in","transliteration":"fī"},{"position":8,"text":"ٱلدِّينِ","translation":"the religion","transliteration":"l-dīni"},{"position":9,"text":"وَأَخۡرَجُوكُم","translation":"and drive you out","transliteration":"wa-akhrajūkum"},{"position":10,"text":"مِّن","translation":"of","transliteration":"min"},{"position":11,"text":"دِيَٰرِكُمۡ","translation":"your homes","transliteration":"diyārikum"},{"position":12,"text":"وَظَٰهَرُواْ","translation":"and support","transliteration":"waẓāharū"},{"position":13,"text":"عَلَىٰٓ","translation":"in","transliteration":"ʿalā"},{"position":14,"text":"إِخۡرَاجِكُمۡ","translation":"your expulsion","transliteration":"ikh'rājikum"},{"position":15,"text":"أَن","translation":"that","transliteration":"an"},{"position":16,"text":"تَوَلَّوۡهُمۡۚ","translation":"you make them allies","transliteration":"tawallawhum"},{"position":17,"text":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":18,"text":"يَتَوَلَّهُمۡ","translation":"makes them allies","transliteration":"yatawallahum"},{"position":19,"text":"فَأُوْلَٰٓئِكَ","translation":"then those","transliteration":"fa-ulāika"},{"position":20,"text":"هُمُ","translation":"[they]","transliteration":"humu"},{"position":21,"text":"ٱلظَّٰلِمُونَ","translation":"(are) the wrongdoers","transliteration":"l-ẓālimūna"}]},{"id":5160,"verseKey":"60:10","verseNumber":10,"arabic":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا جَآءَكُمُ ٱلۡمُؤۡمِنَٰتُ مُهَٰجِرَٰتٖ فَٱمۡتَحِنُوهُنَّۖ ٱللَّهُ أَعۡلَمُ بِإِيمَٰنِهِنَّۖ فَإِنۡ عَلِمۡتُمُوهُنَّ مُؤۡمِنَٰتٖ فَلَا تَرۡجِعُوهُنَّ إِلَى ٱلۡكُفَّارِۖ لَا هُنَّ حِلّٞ لَّهُمۡ وَلَا هُمۡ يَحِلُّونَ لَهُنَّۖ وَءَاتُوهُم مَّآ أَنفَقُواْۚ وَلَا جُنَاحَ عَلَيۡكُمۡ أَن تَنكِحُوهُنَّ إِذَآ ءَاتَيۡتُمُوهُنَّ أُجُورَهُنَّۚ وَلَا تُمۡسِكُواْ بِعِصَمِ ٱلۡكَوَافِرِ وَسۡـَٔلُواْ مَآ أَنفَقۡتُمۡ وَلۡيَسۡـَٔلُواْ مَآ أَنفَقُواْۚ ذَٰلِكُمۡ حُكۡمُ ٱللَّهِ يَحۡكُمُ بَيۡنَكُمۡۖ وَٱللَّهُ عَلِيمٌ حَكِيمٞ","translation":"O you who have believed, when the believing women come to you as emigrants, examine [i.e., test] them. Allāh is most knowing as to their faith. And if you know them to be believers, then do not return them to the disbelievers; they are not lawful [wives] for them, nor are they lawful [husbands] for them. But give them [i.e., the disbelievers] what they have spent. And there is no blame upon you if you marry them when you have given them their due compensation [i.e., mahr]. And hold not to marriage bonds with disbelieving women, but ask for what you have spent and let them [i.e., the disbelievers] ask for what they have spent. That is the judgement of Allāh; He judges between you. And Allāh is Knowing and Wise.","transliteration":"yāayyuhā alladhīna āmanū idhā jāakumu l-mu'minātu muhājirātin fa-im'taḥinūhunna l-lahu aʿlamu biīmānihinna fa-in ʿalim'tumūhunna mu'minātin falā tarjiʿūhunna ilā l-kufāri lā hunna ḥillun lahum walā hum yaḥillūna lahunna waātūhum mā anfaqū walā junāḥa ʿalaykum an tankiḥūhunna idhā ātaytumūhunna ujūrahunna walā tum'sikū biʿiṣami l-kawāfiri wasalū mā anfaqtum walyasalū mā anfaqū dhālikum ḥuk'mu l-lahi yaḥkumu baynakum wal-lahu ʿalīmun ḥakīmun","audioUrl":"/audio/7/060010.mp3","segments":[[0,1,200,2850],[1,2,2860,3830],[2,3,3840,6430],[3,4,6440,7000],[4,5,7010,9560],[5,6,9570,10880],[6,7,10890,12980],[7,8,12990,16110],[8,9,16120,16940],[9,10,16950,17660],[10,11,17670,20390],[11,12,20400,20920],[12,13,20930,23290],[13,14,23300,25410],[14,15,25420,26000],[15,16,26010,28120],[16,17,28130,28460],[17,18,28470,32070],[18,19,32080,32370],[19,20,32380,33490],[20,21,33500,34350],[21,22,34360,34890],[22,23,34900,35420],[23,24,35430,35830],[24,25,35840,37030],[25,26,37040,38820],[26,27,38830,41070],[27,28,41080,42880],[28,29,42890,45130],[29,30,45140,45670],[30,31,45680,46460],[31,32,46470,47520],[32,33,47530,48460],[33,34,48470,51390],[34,35,51400,52120],[35,36,52130,56050],[36,37,56060,58790],[37,38,58800,59280],[38,39,59290,60300],[39,40,60310,61120],[40,41,61130,62320],[41,42,62330,63240],[42,43,63250,64900],[43,44,64910,66770],[44,45,66780,68110],[45,46,68120,68320],[46,47,68330,72510],[47,48,72520,73450],[48,49,73460,74080],[49,50,74090,74820],[50,51,74830,75580],[51,52,75590,76950],[52,53,76960,77840],[53,54,77850,78790],[54,55,78800,81070]],"words":[{"position":1,"text":"يَٰٓأَيُّهَا","translation":"O you","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلَّذِينَ","translation":"who","transliteration":"alladhīna"},{"position":3,"text":"ءَامَنُوٓاْ","translation":"believe","transliteration":"āmanū"},{"position":4,"text":"إِذَا","translation":"When","transliteration":"idhā"},{"position":5,"text":"جَآءَكُمُ","translation":"come to you","transliteration":"jāakumu"},{"position":6,"text":"ٱلۡمُؤۡمِنَٰتُ","translation":"the believing women","transliteration":"l-mu'minātu"},{"position":7,"text":"مُهَٰجِرَٰتٖ","translation":"(as) emigrants","transliteration":"muhājirātin"},{"position":8,"text":"فَٱمۡتَحِنُوهُنَّۖ","translation":"then examine them","transliteration":"fa-im'taḥinūhunna"},{"position":9,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":10,"text":"أَعۡلَمُ","translation":"(is) most knowing","transliteration":"aʿlamu"},{"position":11,"text":"بِإِيمَٰنِهِنَّۖ","translation":"of their faith","transliteration":"biīmānihinna"},{"position":12,"text":"فَإِنۡ","translation":"And if","transliteration":"fa-in"},{"position":13,"text":"عَلِمۡتُمُوهُنَّ","translation":"you know them","transliteration":"ʿalim'tumūhunna"},{"position":14,"text":"مُؤۡمِنَٰتٖ","translation":"(to be) believers","transliteration":"mu'minātin"},{"position":15,"text":"فَلَا","translation":"then (do) not","transliteration":"falā"},{"position":16,"text":"تَرۡجِعُوهُنَّ","translation":"return them","transliteration":"tarjiʿūhunna"},{"position":17,"text":"إِلَى","translation":"to","transliteration":"ilā"},{"position":18,"text":"ٱلۡكُفَّارِۖ","translation":"the disbelievers","transliteration":"l-kufāri"},{"position":19,"text":"لَا","translation":"Not","transliteration":"lā"},{"position":20,"text":"هُنَّ","translation":"they","transliteration":"hunna"},{"position":21,"text":"حِلّٞ","translation":"(are) lawful","transliteration":"ḥillun"},{"position":22,"text":"لَّهُمۡ","translation":"for them","transliteration":"lahum"},{"position":23,"text":"وَلَا","translation":"and not","transliteration":"walā"},{"position":24,"text":"هُمۡ","translation":"they","transliteration":"hum"},{"position":25,"text":"يَحِلُّونَ","translation":"are lawful","transliteration":"yaḥillūna"},{"position":26,"text":"لَهُنَّۖ","translation":"for them","transliteration":"lahunna"},{"position":27,"text":"وَءَاتُوهُم","translation":"But give them","trans