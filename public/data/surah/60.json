eration":"jāakum"},{"position":16,"text":"مِّنَ","translation":"of","transliteration":"mina"},{"position":17,"text":"ٱلۡحَقِّ","translation":"the truth","transliteration":"l-ḥaqi"},{"position":18,"text":"يُخۡرِجُونَ","translation":"driving out","transliteration":"yukh'rijūna"},{"position":19,"text":"ٱلرَّسُولَ","translation":"the Messenger","transliteration":"l-rasūla"},{"position":20,"text":"وَإِيَّاكُمۡ","translation":"and yourselves","transliteration":"wa-iyyākum"},{"position":21,"text":"أَن","translation":"because","transliteration":"an"},{"position":22,"text":"تُؤۡمِنُواْ","translation":"you believe","transliteration":"tu'minū"},{"position":23,"text":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":24,"text":"رَبِّكُمۡ","translation":"your Lord","transliteration":"rabbikum"},{"position":25,"text":"إِن","translation":"If","transliteration":"in"},{"position":26,"text":"كُنتُمۡ","translation":"you","transliteration":"kuntum"},{"position":27,"text":"خَرَجۡتُمۡ","translation":"come forth","transliteration":"kharajtum"},{"position":28,"text":"جِهَٰدٗا","translation":"(to) strive","transliteration":"jihādan"},{"position":29,"text":"فِي","translation":"in","transliteration":"fī"},{"position":30,"text":"سَبِيلِي","translation":"My way","transliteration":"sabīlī"},{"position":31,"text":"وَٱبۡتِغَآءَ","translation":"and (to) seek","transliteration":"wa-ib'tighāa"},{"position":32,"text":"مَرۡضَاتِيۚ","translation":"My Pleasure","transliteration":"marḍātī"},{"position":33,"text":"تُسِرُّونَ","translation":"You confide","transliteration":"tusirrūna"},{"position":34,"text":"إِلَيۡهِم","translation":"to them","transliteration":"ilayhim"},{"position":35,"text":"بِٱلۡمَوَدَّةِ","translation":"love","transliteration":"bil-mawadati"},{"position":36,"text":"وَأَنَا۠","translation":"but I Am","transliteration":"wa-anā"},{"position":37,"text":"أَعۡلَمُ","translation":"most knowing","transliteration":"aʿlamu"},{"position":38,"text":"بِمَآ","translation":"of what","transliteration":"bimā"},{"position":39,"text":"أَخۡفَيۡتُمۡ","translation":"you conceal","transliteration":"akhfaytum"},{"position":40,"text":"وَمَآ","translation":"and what","transliteration":"wamā"},{"position":41,"text":"أَعۡلَنتُمۡۚ","translation":"you declare","transliteration":"aʿlantum"},{"position":42,"text":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":43,"text":"يَفۡعَلۡهُ","translation":"does it","transliteration":"yafʿalhu"},{"position":44,"text":"مِنكُمۡ","translation":"among you","transliteration":"minkum"},{"position":45,"text":"فَقَدۡ","translation":"then certainly","transliteration":"faqad"},{"position":46,"text":"ضَلَّ","translation":"he has strayed","transliteration":"ḍalla"},{"position":47,"text":"سَوَآءَ","translation":"(from the) straight","transliteration":"sawāa"},{"position":48,"text":"ٱلسَّبِيلِ","translation":"path","transliteration":"l-sabīli"}]},{"id":5152,"verseKey":"60:2","verseNumber":2,"arabic":"إِن يَثۡقَفُوكُمۡ يَكُونُواْ لَكُمۡ أَعۡدَآءٗ وَيَبۡسُطُوٓاْ إِلَيۡكُمۡ أَيۡدِيَهُمۡ وَأَلۡسِنَتَهُم بِٱلسُّوٓءِ وَوَدُّواْ لَوۡ تَكۡفُرُونَ","translation":"If they gain dominance over you, they would be [i.e., behave] to you as enemies and extend against you their hands and their tongues with evil, and they wish you would disbelieve.","transliteration":"in yathqafūkum yakūnū lakum aʿdāan wayabsuṭū ilaykum aydiyahum wa-alsinatahum bil-sūi wawaddū law takfurūna","audioUrl":"/audio/7/060002.mp3","segments":[[0,1,30,1130],[1,2,1140,2310],[2,3,2320,3260],[3,4,3270,3840],[4,5,3850,6650],[5,6,6660,9330],[6,7,9340,10250],[7,8,10260,11410],[8,9,11420,13530],[9,10,13540,15710],[10,11,15720,16650],[11,12,16660,16950],[12,13,16960,19230]],"words":[{"position":1,"text":"إِن","translation":"If","transliteration":"in"},{"position":2,"text":"يَثۡقَفُوكُمۡ","translation":"they gain dominance over you","transliteration":"yathqafūkum"},{"position":3,"text":"يَكُونُواْ","translation":"they would be","transliteration":"yakūnū"},{"position":4,"text":"لَكُمۡ","translation":"to you","transliteration":"lakum"},{"position":5,"text":"أَعۡدَآءٗ","translation":"enemies","transliteration":"aʿdāan"},{"position":6,"text":"وَيَبۡسُطُوٓاْ","translation":"and extend","transliteration":"wayabsuṭū"},{"position":7,"text":"إِلَيۡكُمۡ","translation":"against you","transliteration":"ilaykum"},{"position":8,"text":"أَيۡدِيَهُمۡ","translation":"their hands","transliteration":"aydiyahum"},{"position":9,"text":"وَأَلۡسِنَتَهُم","translation":"and their tongues","transliteration":"wa-alsinatahum"},{"position":10,"text":"بِٱلسُّوٓءِ","translation":"with evil","transliteration":"bil-sūi"},{"position":11,"text":"وَوَدُّواْ","translation":"and they desire","transliteration":"wawaddū"},{"position":12,"text":"لَوۡ","translation":"that","transliteration":"law"},{"position":13,"text":"تَكۡفُرُونَ","translation":"you would disbelieve","transliteration":"takfurūna"}]},{"id":5153,"verseKey":"60:3","verseNumber":3,"arabic":"لَن تَنفَعَكُمۡ أَرۡحَامُكُمۡ وَلَآ أَوۡلَٰدُكُمۡۚ يَوۡمَ ٱلۡقِيَٰمَةِ يَفۡصِلُ بَيۡنَكُمۡۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ بَصِيرٞ","translation":"Never will your relatives or your children benefit you; the Day of Resurrection He will judge between you. And Allāh, of what you do, is Seeing.","transliteration":"lan tanfaʿakum arḥāmukum walā awlādukum yawma l-qiyāmati yafṣilu baynakum wal-lahu bimā taʿmalūna baṣīrun","audioUrl":"/audio/7/060003.mp3","segments":[[0,1,90,1220],[1,2,1230,3250],[2,3,3260,4520],[3,4,4530,6230],[4,5,6240,8190],[5,6,8200,8720],[6,7,8730,9890],[7,8,9900,10710],[8,9,10720,12000],[9,10,12010,12950],[10,11,12960,13480],[11,12,13490,14680],[12,13,14690,16630]],"words":[{"position":1,"text":"لَن","translation":"Never","transliteration":"lan"},{"position":2,"text":"تَنفَعَكُمۡ","translation":"will benefit you","transliteration":"tanfaʿakum"},{"position":3,"text":"أَرۡحَامُكُمۡ","translation":"your relatives","transliteration":"arḥāmukum"},{"position":4,"text":"وَلَآ","translation":"and not","transliteration":"walā"},{"position":5,"text":"أَوۡلَٰدُكُمۡۚ","translation":"your children","transliteration":"awlādukum"},{"position":6,"text":"يَوۡمَ","translation":"(on the) Day","transliteration":"yawma"},{"position":7,"text":"ٱلۡقِيَٰمَةِ","translation":"(of) the Resurrection","transliteration":"l-qiyāmati"},{"position":8,"text":"يَفۡصِلُ","translation":"He will judge","transliteration":"yafṣilu"},{"position":9,"text":"بَيۡنَكُمۡۚ","translation":"between you","transliteration":"baynakum"},{"position":10,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":11,"text":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":12,"text":"تَعۡمَلُونَ","translation":"you do","transliteration":"taʿmalūna"},{"position":13,"text":"بَصِيرٞ","translation":"(is) All-Seer","transliteration":"baṣīrun"}]},{"id":5154,"verseKey":"60:4","verseNumber":4,"arabic":"قَدۡ كَانَتۡ لَكُمۡ أُسۡوَةٌ حَسَنَةٞ فِيٓ إِبۡرَٰهِيمَ وَٱلَّذِينَ مَعَهُۥٓ إِذۡ قَالُواْ لِقَوۡمِهِمۡ إِنَّا بُرَءَٰٓؤُاْ مِنكُمۡ وَمِمَّا تَعۡبُدُونَ مِن دُونِ ٱللَّهِ كَفَرۡنَا بِكُمۡ وَبَدَا بَيۡنَنَا وَبَيۡنَكُمُ ٱلۡعَدَٰوَةُ وَٱلۡبَغۡضَآءُ أَبَدًا حَتَّىٰ تُؤۡمِنُواْ بِٱللَّهِ وَحۡدَهُۥٓ إِلَّا قَوۡلَ إِبۡرَٰهِيمَ لِأَبِيهِ لَأَسۡتَغۡفِرَنَّ لَكَ وَمَآ أَمۡلِكُ لَكَ مِنَ ٱللَّهِ مِن شَيۡءٖۖ رَّبَّنَا عَلَيۡكَ تَوَكَّلۡنَا وَإِلَيۡكَ أَنَبۡنَا وَإِلَيۡكَ ٱلۡمَصِيرُ","translation":"There has already been for you an excellent pattern in Abraham and those with him, when they said to their people, \"Indeed, we are disassociated from you and from whatever you worship other than Allāh. We have denied you, and there has appeared between us and you animosity and hatred forever until you believe in Allāh alone\" - except for the saying of Abraham to his father, \"I will surely ask forgiveness for you, but I have not [power to do] for you anything against Allāh. Our Lord, upon You we have relied, and to You we have returned, and to You is the destination.","trans