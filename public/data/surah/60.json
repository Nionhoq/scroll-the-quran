iteration":"ḥuk'mu"},{"position":50,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":51,"text":"يَحۡكُمُ","translation":"He judges","transliteration":"yaḥkumu"},{"position":52,"text":"بَيۡنَكُمۡۖ","translation":"between you","transliteration":"baynakum"},{"position":53,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":54,"text":"عَلِيمٌ","translation":"(is) All-Knowing","transliteration":"ʿalīmun"},{"position":55,"text":"حَكِيمٞ","translation":"All-Wise","transliteration":"ḥakīmun"}]},{"id":5161,"verseKey":"60:11","verseNumber":11,"arabic":"وَإِن فَاتَكُمۡ شَيۡءٞ مِّنۡ أَزۡوَٰجِكُمۡ إِلَى ٱلۡكُفَّارِ فَعَاقَبۡتُمۡ فَـَٔاتُواْ ٱلَّذِينَ ذَهَبَتۡ أَزۡوَٰجُهُم مِّثۡلَ مَآ أَنفَقُواْۚ وَٱتَّقُواْ ٱللَّهَ ٱلَّذِيٓ أَنتُم بِهِۦ مُؤۡمِنُونَ","translation":"And if you have lost any of your wives to the disbelievers and you subsequently obtain [something], then give those whose wives have gone the equivalent of what they had spent. And fear Allāh, in whom you are believers.","transliteration":"wa-in fātakum shayon min azwājikum ilā l-kufāri faʿāqabtum faātū alladhīna dhahabat azwājuhum mith'la mā anfaqū wa-ittaqū l-laha alladhī antum bihi mu'minūna","audioUrl":"/audio/7/060011.mp3","segments":[[0,1,150,1370],[1,2,1380,2340],[2,3,2350,3800],[3,4,3810,4090],[4,5,4100,5470],[5,6,5480,5840],[6,7,5850,6950],[7,8,6960,8320],[8,9,8330,9140],[9,10,9150,10060],[10,11,10070,10830],[11,12,10840,13000],[12,13,13010,13480],[13,14,13490,15160],[14,15,15170,17220],[15,16,17230,17940],[16,17,17950,18680],[17,18,18690,21060],[18,19,21070,23260],[19,20,23270,23870],[20,21,23880,26170]],"words":[{"position":1,"text":"وَإِن","translation":"And if","transliteration":"wa-in"},{"position":2,"text":"فَاتَكُمۡ","translation":"have gone from you","transliteration":"fātakum"},{"position":3,"text":"شَيۡءٞ","translation":"any","transliteration":"shayon"},{"position":4,"text":"مِّنۡ","translation":"of","transliteration":"min"},{"pos