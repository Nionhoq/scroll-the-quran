{"chapter":{"id":110,"nameSimple":"An-Nasr","nameArabic":"النصر","translatedName":"The Divine Support","versesCount":3,"revelationPlace":"madinah"},"verses":[{"id":6214,"verseKey":"110:1","verseNumber":1,"arabic":"إِذَا جَآءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ","translation":"When the victory of Allāh has come and the conquest,","transliteration":"idhā jāa naṣru l-lahi wal-fatḥu","audioUrl":"/audio/7/110001.mp3","segments":[[0,1,200,680],[1,2,690,3590],[2,3,3600,4210],[3,4,4220,5140],[4,5,5150,6210]],"words":[{"position":1,"text":"إِذَا","translation":"When","transliteration":"idhā"},{"position":2,"text":"جَآءَ","translation":"comes","transliteration":"jāa"},{"position":3,"text":"نَصۡرُ","translation":"(the) Help","transliteration":"naṣru"},{"position":4,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":5,"text":"وَٱلۡفَتۡحُ","translation":"and the Victory","transliteration":"wal-fatḥu"}]},{"id":6215,"verseKey":"110:2","verseNumber":2,"arabic":"وَرَأَيۡتَ ٱلنَّاسَ يَدۡخُلُونَ فِي دِينِ ٱللَّهِ أَفۡوَاجٗا","translation":"And you see the people entering into the religion of Allāh in multitudes,","transliteration":"wara-ayta l-nāsa yadkhulūna fī dīni l-lahi afwājan","audioUrl":"/audio/7/110002.mp3","segments":[[0,1,30,1070],[1,2,1080,2620],[2,3,2630,3870],[3,4,3880,4330],[4,5,4340,5080],[5,6,5090,5920],[6,7,5930,7430]],"words":[{"position":1,"text":"وَرَأَيۡتَ","translation":"And you see","transliteration":"wara-ayta"},{"position":2,"text":"ٱلنَّاسَ","translation":"the people","transliteration":"l-nāsa"},{"position":3,"text":"يَدۡخُلُونَ","translation":"entering","transliteration":"yadkhulūna"},{"position":4,"text":"فِي","translation":"into","transliteration":"fī"},{"position":5,"text":"دِينِ","translation":"(the) religion","transliteration":"dīni"},{"position":6,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":7,"text":"أَفۡوَاجٗا","translation":"(in) multitudes","transliteration":"afwājan"}]},{"id":6216,"