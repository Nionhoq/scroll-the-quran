{"chapter":{"id":86,"nameSimple":"At-Tariq","nameArabic":"الطارق","translatedName":"The Nightcommer","versesCount":17,"revelationPlace":"makkah"},"verses":[{"id":5932,"verseKey":"86:1","verseNumber":1,"arabic":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","translation":"By the sky and the night comer","transliteration":"wal-samāi wal-ṭāriqi","audioUrl":"/audio/7/086001.mp3","segments":[[0,1,30,3170],[1,2,3180,4400]],"words":[{"position":1,"text":"وَٱلسَّمَآءِ","translation":"By the sky","transliteration":"wal-samāi"},{"position":2,"text":"وَٱلطَّارِقِ","translation":"and the night comer","transliteration":"wal-ṭāriqi"}]},{"id":5933,"verseKey":"86:2","verseNumber":2,"arabic":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ","translation":"And what can make you know what is the night comer?","transliteration":"wamā adrāka mā l-ṭāriqu","audioUrl":"/audio/7/086002.mp3","segments":[[0,1,30,2080],[1,2,2090,3180],[2,3,3190,3350],[3,4,3360,4410]],"words":[{"position":1,"text":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"text":"أَدۡرَىٰكَ","translation":"can make you know","transliteration":"adrāka"},{"position":3,"text":"مَا","translation":"what","transliteration":"mā"},{"position":4,"text":"ٱلطَّارِقُ","translation":"the night comer (is)","transliteration":"l-ṭāriqu"}]},{"id":5934,"verseKey":"86:3","verseNumber":3,"arabic":"ٱلنَّجۡمُ ٱلثَّاقِبُ","translation":"It is the piercing star","transliteration":"al-najmu l-thāqibu","audioUrl":"/audio/7/086003.mp3","segments":[[0,1,30,1960],[1,2,1970,3060]],"words":[{"position":1,"text":"ٱلنَّجۡمُ","translation":"(It is) the star","transliteration":"al-najmu"},{"position":2,"text":"ٱلثَّاقِبُ","translation":"the piercing","transliteration":"l-thāqibu"}]},{"id":5935,"verseKey":"86:4","verseNumber":4,"arabic":"إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ","translation":"There is no soul but that it has over it a protector.","transliteration":"in kullu nafsin lammā ʿalayhā ḥāfiẓun","audioUrl":"/audio/7/086004.mp3","segments":[[0,1,30,1010],[1,2,1020,1750],[2,3,1760,2440],[3,4,2450,4270],[4,5,4280,5380],[5,6,5390,6320]],"words":[{"position":1,"text":"إِن","translation":"Not","transliteration":"in"},{"position":2,"text":"كُلُّ","translation":"(is) every","transliteration":"kullu"},{"position":3,"text":"نَفۡسٖ","translation":"soul","transliteration":"nafsin"},{"position":4,"text":"لَّمَّا","translation":"but","transliteration":"lammā"},{"position":5,"text":"عَلَيۡهَا","translation":"over it","transliteration":"ʿalayhā"},{"position":6,"text":"حَافِظٞ","translation":"(is) a protector","transliteration":"ḥāfiẓun"}]},{"id":5936,"verseKey":"86:5","verseNumber":5,"arabic":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","translation":"So let man observe from what he was created.","transliteration":"falyanẓuri l-insānu mimma khuliqa","audioUrl":"/audio/7/086005.mp3","segments":[[0,1,30,2090],[1,2,2100,4190],[2,3,4200,5600],[3,4,5610,6270]],"words":[{"position":1,"text":"فَلۡيَنظُرِ","translation":"So let see","transliteration":"falyanẓuri"},{"position":2,"text":"ٱلۡإِنسَٰنُ","translation":"man","transliteration":"l-insānu"},{"position":3,"text":"مِمَّ","translation":"from what","transliteration":"mimma"},{"position":4,"text":"خُلِقَ","translation":"he is created","transliteration":"khuliqa"}]},{"id":5937,"verseKey":"86:6","verseNumber":6,"arabic":"خُلِقَ مِن مَّآءٖ دَافِقٖ","translation":"He was created from a fluid, ejected,","transliteration":"khuliqa min māin dāfiqin","audioUrl":"/audio/7/086006.mp3","segments":[[0,1,30,660],[1,2,670,1680],[2,3,1690,4770],[3,4,4780,5620]],"words":[{"position":1,"text":"خُلِقَ","translation":"He is created","transliteration":"khuliqa"},{"position":2,"text":"مِن","translation":"from","transliteration":"min"},{"position":3,"text":"مَّآءٖ","translation":"a water","transliteration":"māin"},{"position":4,"text":"دَافِقٖ","translation":"ejected","transliteration":"dāfiqin"}]},{"id":5938,"verseKey":"86:7","verseNumber":7,"arabic":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","translati