e statement,","transliteration":"innahu laqawlun faṣlun","audioUrl":"/audio/7/086013.mp3","segments":[[0,1,30,1840],[1,2,1850,3700],[2,3,3710,4320]],"words":[{"position":1,"text":"إِنَّهُۥ","translation":"Indeed, it","transliteration":"innahu"},{"position":2,"text":"لَقَوۡلٞ","translation":"(is) surely a Word","transliteration":"laqawlun"},{"position":3,"text":"فَصۡلٞ","translation":"decisive","transliteration":"faṣlun"}]},{"id":5945,"verseKey":"86:14","verseNumber":14,"arabic":"وَمَا هُوَ بِٱلۡهَزۡلِ","translation":"And it is not amusement.","transliteration":"wamā huwa bil-hazli","audioUrl":"/audio/7/086014.mp3","segments":[[0,1,30,620],[1,2,630,1100],[2,3,1110,2000]],"words":[{"position":1,"text":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"text":"هُوَ","translation":"it","transliteration":"huwa"},{"position":3,"text":"بِٱلۡهَزۡلِ","translation":"(is) for amusement","transliteration":"bil-hazli"}]},{"id":5946,"verseKey":"86:15","verseNumber":15,"arabic":"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا","translation":"Indeed, they are planning a plan,","transliteration":"innahum yakīdūna kaydan","audioUrl":"/audio/7/086015.mp3","segments":[[0,1,30,1800],[1,2,1810,3170],[2,3,3180,4230]],"words":[{"position":1,"text":"إِنَّهُمۡ","translation":"Indeed, they","transliteration":"innahum"},{"position":2,"text":"يَكِيدُونَ","translation":"are plotting","transliteration":"yakīdūna"},{"position":3,"text":"كَيۡدٗا","translation":"a plot","transliteration":"kaydan"}]},{"id":5947,"verseKey":"86:16","verseNumber":16,"arabic":"وَأَكِيدُ كَيۡدٗا","translation":"But I am planning a plan.","transliteration":"wa-akīdu kaydan","audioUrl":"/audio/7/086016.mp3","segments":[[0,1,30,1050],[1,2,1060,2180]],"words":[{"position":1,"text":"وَأَكِيدُ","translation":"But I am planning","transliteration":"wa-akīdu"},{"position":2,"text":"كَيۡدٗا","translation":"a plan","transliteration":"kaydan"}]},{"id":5948,"verseKey":"86:17","verseNumber":17,"arabic":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِ