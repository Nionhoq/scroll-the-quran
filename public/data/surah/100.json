8","verseNumber":8,"arabic":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ","translation":"And indeed he is, in love of wealth, intense.","transliteration":"wa-innahu liḥubbi l-khayri lashadīdun","audioUrl":"/audio/7/100008.mp3","segments":[[0,1,80,2080],[1,2,2090,2940],[2,3,2950,3800],[3,4,3810,6620]],"words":[{"position":1,"text":"وَإِنَّهُۥ","translation":"And indeed he","transliteration":"wa-innahu"},{"position":2,"text":"لِحُبِّ","translation":"in (the) love","transliteration":"liḥubbi"},{"position":3,"text":"ٱلۡخَيۡرِ","translation":"(of) wealth","transliteration":"l-khayri"},{"position":4,"text":"لَشَدِيدٌ","translation":"(is) surely intense","transliteration":"lashadīdun"}]},{"id":6155,"verseKey":"100:9","verseNumber":9,"arabic":"۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ","translation":"But does he not know that when the contents of the graves are scattered","transliteration":"afalā yaʿlamu idhā buʿ'thira mā fī l-qubūri","audioUrl":"/audio/7/100009.mp3","segments":[[0,1,100,870],[1,2,880,1780],[2,3,1790,2450],[3,4,2460,3360],[4,5,3370,3720],[5,6,3730,3940],[6,7,3950,6710]],"words":[{"position":1,"text":"۞ أَفَلَا","translation":"But does not","transliteration":"afalā"},{"position":2,"text":"يَعۡلَمُ","translation":"he know","transliteration":"yaʿlamu"},{"position":3,"text":"إِذَا","translation":"when","transliteration":"idhā"},{"position":4,"text":"بُعۡثِرَ","translation":"will be scattered","transliteration":"buʿ'thira"},{"position":5,"text":"مَا","translation":"what","transliteration":"mā"},{"position":6,"text":"فِي","translation":"(is) in","transliteration":"fī"},{"position":7,"text":"ٱلۡقُبُورِ","translation":"the graves","transliteration":"l-qubūri"}]},{"id":6156,"verseKey":"100:10","verseNumber":10,"arabic":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ","translation":"And that within the breasts is obtained,","transliteration":"waḥuṣṣila mā fī l-ṣudūri","audioUrl":"/audio/7/100010.mp3","segments":[[0,1,30,1080],[1,2,1090,1470],[2,3,1480,1680],[3,4,1690,4440]],"wor