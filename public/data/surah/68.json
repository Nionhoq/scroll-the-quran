iṣ'bir"},{"position":2,"text":"لِحُكۡمِ","translation":"for (the) decision","transliteration":"liḥuk'mi"},{"position":3,"text":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"text":"وَلَا","translation":"and (do) not","transliteration":"walā"},{"position":5,"text":"تَكُن","translation":"be","transliteration":"takun"},{"position":6,"text":"كَصَاحِبِ","translation":"like (the) companion","transliteration":"kaṣāḥibi"},{"position":7,"text":"ٱلۡحُوتِ","translation":"(of) the fish","transliteration":"l-ḥūti"},{"position":8,"text":"إِذۡ","translation":"when","transliteration":"idh"},{"position":9,"text":"نَادَىٰ","translation":"he called out","transliteration":"nādā"},{"position":10,"text":"وَهُوَ","translation":"while he","transliteration":"wahuwa"},{"position":11,"text":"مَكۡظُومٞ","translation":"(was) distressed","transliteration":"makẓūmun"}]},{"id":5320,"verseKey":"68:49","verseNumber":49,"arabic":"لَّوۡلَآ أَن تَدَٰرَكَهُۥ نِعۡمَةٞ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلۡعَرَآءِ وَهُوَ مَذۡمُومٞ","translation":"If not that a favor [i.e., mercy] from his Lord overtook him, he would have been thrown onto the naked shore while he was censured.","transliteration":"lawlā an tadārakahu niʿ'matun min rabbihi lanubidha bil-ʿarāi wahuwa madhmūmun","audioUrl":"/audio/7/068049.mp3","segments":[[0,1,50,2230],[1,2,2240,3240],[2,3,3250,4700],[3,4,4710,6340],[4,5,6350,6390],[5,6,6400,7640],[6,7,7650,8400],[7,8,8410,11360],[8,9,11370,11920],[9,10,11930,14300]],"words":[{"position":1,"text":"لَّوۡلَآ","translation":"If not","transliteration":"lawlā"},{"position":2,"text":"أَن","translation":"that","transliteration":"an"},{"position":3,"text":"تَدَٰرَكَهُۥ","translation":"overtook him","transliteration":"tadārakahu"},{"position":4,"text":"نِعۡمَةٞ","translation":"a Favor","transliteration":"niʿ'matun"},{"position":5,"text":"مِّن","translation":"from","transliteration":"min"},{"position":6,"text":"رَّبِّهِۦ","translation":"his Lord","transliteration":"rabbihi"},{"position":7,"text":"لَنُبِذَ","translation":"surely he would have been thrown","transliteration":"lanubidha"},{"position":8,"text":"بِٱلۡعَرَآءِ","translation":"onto (the) naked shore","transliteration":"bil-ʿarāi"},{"position":9,"text":"وَهُوَ","translation":"while he","transliteration":"wahuwa"},{"position":10,"text":"مَذۡمُومٞ","translation":"(was) blamed","transliteration":"madhmūmun"}]},{"id":5321,"verseKey":"68:50","verseNumber":50,"arabic":"فَٱجۡتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ","translation":"And his Lord chose him and made him of the righteous.","transliteration":"fa-ij'tabāhu rabbuhu fajaʿalahu mina l-ṣāliḥīna","audioUrl":"/audio/7/068050.mp3","segments":[[0,1,30,1120],[1,2,1130,2140],[2,3,2150,3340],[3,4,3350,3720],[4,5,3730,6830]],"words":[{"position":1,"text":"فَٱجۡتَبَٰهُ","translation":"But chose him","transliteration":"fa-ij'tabāhu"},{"position":2,"text":"رَبُّهُۥ","translation":"his Lord","transliteration":"rabbuhu"},{"position":3,"text":"فَجَعَلَهُۥ","translation":"and made him","transliteration":"fajaʿalahu"},{"position":4,"text":"مِنَ","translation":"of","transliteration":"mina"},{"position":5,"text":"ٱلصَّٰلِحِينَ","translation":"the righteous","transliteration":"l-ṣāliḥīna"}]},{"id":5322,"verseKey":"68:51","verseNumber":51,"arabic":"وَإِن يَكَادُ ٱلَّذِينَ كَفَرُواْ لَيُزۡلِقُونَكَ بِأَبۡصَٰرِهِمۡ لَمَّا سَمِعُواْ ٱلذِّكۡرَ وَيَقُولُونَ إِنَّهُۥ لَمَجۡنُونٞ","translation":"And indeed, those who disbelieve would almost make you slip with their eyes [i.e., looks] when they hear the message, and they say, \"Indeed, he is mad.\"","transliteration":"wa-in yakādu alladhīna kafarū layuz'liqūnaka bi-abṣārihim lammā samiʿū l-dhik'ra wayaqūlūna innahu lamajnūnun","audioUrl":"/audio/7/068051.mp3","segments":[[0,1,30,1250],[1,2,1260,1890],[2,3,1900,2850],[3,4,2860,3690],[4,5,3700,5290],[5,6,5300,6930],[6,7,6940,8160],[7,8,8170,8790],[8,9,8800,9610],[9,10,9620,10980],[10,11,10990,12510],[11,12,12520,15490]],"words":[{"position":1,"text":"وَإِن","translation":"And indeed","transliteration":"wa-in"},{"position":2,"text":"يَكَادُ","translation":"would almost","transliteration":"yakādu"},{"position":3,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":4,"text":"كَفَرُواْ","translation":"disbelieve","transliteration":"kafarū"},{"position":5,"text":"لَيُزۡلِقُونَكَ","translation":"surely make you slip","transliteration":"layuz'liqūnaka"},{"position":6,"text":"بِأَبۡصَٰرِهِمۡ","translation":"with their look","transliteration":"bi-abṣārihim"},{"position":7,"text":"لَمَّا","translation":"when","transliteration":"lammā"},{"position":8,"text":"سَمِعُواْ","translation":"they hear","transliteration":"samiʿū"},{"position":9,"text":"ٱلذِّكۡرَ","translation":"the Message","transliteration":"l-dhik'ra"},{"position":10,"text":"وَيَقُولُونَ","translation":"and they say","transliteration":"wayaqūlūna"},{"position":11,"text":"إِنَّهُۥ","translation":"Indeed, he","transliteration":"innahu"},{"position":12,"text":"لَمَجۡنُونٞ","translation":"(is) surely mad","transliteration":"lamajnūnun"}]},{"id":5323,"verseKey":"68:52","verseNumber":52,"arabic":"وَمَا هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ","translation":"But it is not except a reminder to the worlds.","transliteration":"wamā huwa illā dhik'run lil'ʿālamīna","audioUrl":"/audio/7/068052.mp3","segments":[[0,1,30,600],[1,2,610,1040],[2,3,1050,1880],[3,4,1890,2740],[4,5,2750,6650]],"words":[{"position":1,"text":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"text":"هُوَ","translation":"it (is)","transliteration":"huwa"},{"position":3,"text":"إِلَّا","translation":"but","transliteration":"illā"},{"position":4,"text":"ذِكۡرٞ","translation":"a Reminder","transliteration":"dhik'run"},{"position":5,"text":"لِّلۡعَٰلَمِينَ","translation":"to the worlds","transliteration":"lil'ʿālamīna"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
