īna","audioUrl":"/audio/7/068035.mp3","segments":[[0,1,100,1130],[1,2,1140,2400],[2,3,2410,6090]],"words":[{"position":1,"text":"أَفَنَجۡعَلُ","translation":"Then will We treat","transliteration":"afanajʿalu"},{"position":2,"text":"ٱلۡمُسۡلِمِينَ","translation":"the Muslims","transliteration":"l-mus'limīna"},{"position":3,"text":"كَٱلۡمُجۡرِمِينَ","translation":"like the criminals","transliteration":"kal-muj'rimīna"}]},{"id":5307,"verseKey":"68:36","verseNumber":36,"arabic":"مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ","translation":"What is [the matter] with you? How do you judge?","transliteration":"mā lakum kayfa taḥkumūna","audioUrl":"/audio/7/068036.mp3","segments":[[0,1,80,430],[1,2,440,960],[2,3,970,1540],[3,4,1550,4520]],"words":[{"position":1,"text":"مَا","translation":"What","transliteration":"mā"},{"position":2,"text":"لَكُمۡ","translation":"(is) for you","transliteration":"lakum"},{"position":3,"text":"كَيۡفَ","translation":"How","transliteration":"kayfa"},{"position":4,"text":"تَحۡكُمُونَ","translation":"(do) you judge","transliteration":"taḥkumūna"}]},{"id":5308,"verseKey":"68:37","verseNumber":37,"arabic":"أَمۡ لَكُمۡ كِتَٰبٞ فِيهِ تَدۡرُسُونَ","translation":"Or do you have a scripture in which you learn","transliteration":"am lakum kitābun fīhi tadrusūna","audioUrl":"/audio/7/068037.mp3","segments":[[0,1,30,320],[1,2,330,870],[2,3,880,2430],[3,4,2440,3040],[4,5,3050,5650]],"words":[{"position":1,"text":"أَمۡ","translation":"Or","transliteration":"am"},{"position":2,"text":"لَكُمۡ","translation":"(is) for you","transliteration":"lakum"},{"position":3,"text":"كِتَٰبٞ","translation":"a book","transliteration":"kitābun"},{"position":4,"text":"فِيهِ","translation":"wherein","transliteration":"fīhi"},{"position":5,"text":"تَدۡرُسُونَ","translation":"you learn","transliteration":"tadrusūna"}]},{"id":5309,"verseKey":"68:38","verseNumber":38,"arabic":"إِنَّ لَكُمۡ فِيهِ لَمَا تَخَيَّرُونَ","translation":"That indeed for you is whatever you choose?","transliteration":"inna 