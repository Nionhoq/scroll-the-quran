},{"position":2,"text":"كَانَ","translation":"(he) is","transliteration":"kāna"},{"position":3,"text":"ذَا","translation":"a possessor","transliteration":"dhā"},{"position":4,"text":"مَالٖ","translation":"(of) wealth","transliteration":"mālin"},{"position":5,"text":"وَبَنِينَ","translation":"and children","transliteration":"wabanīna"}]},{"id":5286,"verseKey":"68:15","verseNumber":15,"arabic":"إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ","translation":"When Our verses are recited to him, he says, \"Legends of the former peoples.\"","transliteration":"idhā tut'lā ʿalayhi āyātunā qāla asāṭīru l-awalīna","audioUrl":"/audio/7/068015.mp3","segments":[[0,1,30,540],[1,2,550,1370],[2,3,1380,2220],[3,4,2230,3660],[4,5,3670,4330],[5,6,4340,5540],[6,7,5550,8770]],"words":[{"position":1,"text":"إِذَا","translation":"When","transliteration":"idhā"},{"position":2,"text":"تُتۡلَىٰ","translation":"are recited","transliteration":"tut'lā"},{"position":3,"text":"عَلَيۡهِ","translation":"to him","transliteration":"ʿalayhi"},{"position":4,"text":"ءَايَٰتُنَا","translation":"Our Verses","transliteration":"āyātunā"},{"position":5,"text":"قَالَ","translation":"he says","transliteration":"qāla"},{"position":6,"text":"أَسَٰطِيرُ","translation":"Stories","transliteration":"asāṭīru"},{"position":7,"text":"ٱلۡأَوَّلِينَ","translation":"(of) the former (people)","transliteration":"l-awalīna"}]},{"id":5287,"verseKey":"68:16","verseNumber":16,"arabic":"سَنَسِمُهُۥ عَلَى ٱلۡخُرۡطُومِ","translation":"We will brand him upon the snout.","transliteration":"sanasimuhu ʿalā l-khur'ṭūmi","audioUrl":"/audio/7/068016.mp3","segments":[[0,1,30,1140],[1,2,1150,1610],[2,3,1620,4740]],"words":[{"position":1,"text":"سَنَسِمُهُۥ","translation":"We will brand him","transliteration":"sanasimuhu"},{"position":2,"text":"عَلَى","translation":"on","transliteration":"ʿalā"},{"position":3,"text":"ٱلۡخُرۡطُومِ","translation":"the snout","transliteration":"l-khur'ṭūmi"}]},{"id":5288,"verseKey":"68:17",