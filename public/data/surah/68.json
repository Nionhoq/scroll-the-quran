{"chapter":{"id":68,"nameSimple":"Al-Qalam","nameArabic":"القلم","translatedName":"The Pen","versesCount":52,"revelationPlace":"makkah"},"verses":[{"id":5272,"verseKey":"68:1","verseNumber":1,"arabic":"نٓۚ وَٱلۡقَلَمِ وَمَا يَسۡطُرُونَ","translation":"Nūn. By the pen and what they inscribe,","transliteration":"noon wal-qalami wamā yasṭurūna","audioUrl":"/audio/7/068001.mp3","segments":[[0,1,420,4160],[1,2,4170,5180],[2,3,5190,5800],[3,4,5810,8950]],"words":[{"position":1,"text":"نٓۚ","translation":"Nun","transliteration":"noon"},{"position":2,"text":"وَٱلۡقَلَمِ","translation":"By the pen","transliteration":"wal-qalami"},{"position":3,"text":"وَمَا","translation":"and what","transliteration":"wamā"},{"position":4,"text":"يَسۡطُرُونَ","translation":"they write","transliteration":"yasṭurūna"}]},{"id":5273,"verseKey":"68:2","verseNumber":2,"arabic":"مَآ أَنتَ بِنِعۡمَةِ رَبِّكَ بِمَجۡنُونٖ","translation":"You are not, [O Muḥammad], by the favor of your Lord, a madman.","transliteration":"mā anta biniʿ'mati rabbika bimajnūnin","audioUrl":"/audio/7/068002.mp3","segments":[[0,1,30,2180],[1,2,2190,3400],[2,3,3410,4390],[3,4,4400,5230],[4,5,5240,7740]],"words":[{"position":1,"text":"مَآ","translation":"Not","transliteration":"mā"},{"position":2,"text":"أَنتَ","translation":"you (are)","transliteration":"anta"},{"position":3,"text":"بِنِعۡمَةِ","translation":"by (the) Grace","transliteration":"biniʿ'mati"},{"position":4,"text":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":5,"text":"بِمَجۡنُونٖ","translation":"a madman","transliteration":"bimajnūnin"}]},{"id":5274,"verseKey":"68:3","verseNumber":3,"arabic":"وَإِنَّ لَكَ لَأَجۡرًا غَيۡرَ مَمۡنُونٖ","translation":"And indeed, for you is a reward uninterrupted.","transliteration":"wa-inna laka la-ajran ghayra mamnūnin","audioUrl":"/audio/7/068003.mp3","segments":[[0,1,30,1580],[1,2,1590,1990],[2,3,2000,2950],[3,4,2960,3550],[4,5,3560,6190]],"words":[{"position":1,"text":"وَإِنَّ","translation":"And indeed","transliteration":"wa-inna"},{"position":2,"text":"لَكَ","translation":"for you","transliteration":"laka"},{"position":3,"text":"لَأَجۡرًا","translation":"surely (is) a reward","transliteration":"la-ajran"},{"position":4,"text":"غَيۡرَ","translation":"without","transliteration":"ghayra"},{"position":5,"text":"مَمۡنُونٖ","translation":"end","transliteration":"mamnūnin"}]},{"id":5275,"verseKey":"68:4","verseNumber":4,"arabic":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٖ","translation":"And indeed, you are of a great moral character.","transliteration":"wa-innaka laʿalā khuluqin ʿaẓīmin","audioUrl":"/audio/7/068004.mp3","segments":[[0,1,50,1740],[1,2,1750,2460],[2,3,2470,3290],[3,4,3300,6090]],"words":[{"position":1,"text":"وَإِنَّكَ","translation":"And indeed, you","transliteration":"wa-innaka"},{"position":2,"text":"لَعَلَىٰ","translation":"surely (are)","transliteration":"laʿalā"},{"position":3,"text":"خُلُقٍ","translation":"(of) a moral character","transliteration":"khuluqin"},{"position":4,"text":"عَظِيمٖ","translation":"great","transliteration":"ʿaẓīmin"}]},{"id":5276,"verseKey":"68:5","verseNumber":5,"arabic":"فَسَتُبۡصِرُ وَيُبۡصِرُونَ","translation":"So you will see and they will see.","transliteration":"fasatub'ṣiru wayub'ṣirūna","audioUrl":"/audio/7/068005.mp3","segments":[[0,1,30,1180],[1,2,1190,3890]],"words":[{"position":1,"text":"فَسَتُبۡصِرُ","translation":"So you will see","transliteration":"fasatub'ṣiru"},{"position":2,"text":"وَيُبۡصِرُونَ","translation":"and they will see","transliteration":"wayub'ṣirūna"}]},{"id":5277,"verseKey":"68:6","verseNumber":6,"arabic":"بِأَييِّكُمُ ٱلۡمَفۡتُونُ","translation":"Which of you is the afflicted [by a devil].","transliteration":"bi-ayyikumu l-maftūnu","audioUrl":"/audio/7/068006.mp3","segments":[[0,1,30,1190],[1,2,1200,3900]],"words":[{"position":1,"text":"بِأَييِّكُمُ","translation":"Which of you","transliteration":"bi-ayyikumu"},{"position":2,"text":"ٱلۡمَفۡتُونُ","translation":"(is) the afflicted one","transliteration":"l-maftūnu"}]},{"id":5278,"verseKey":"68:7","verseNumber":7,"arabic":"إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعۡلَمُ بِٱلۡمُهۡتَدِينَ","translation":"Indeed, your Lord is most knowing of who has gone astray from His way, and He is most knowing of the [rightly] guided.","transliteration":"inna rabbaka huwa aʿlamu biman ḍalla ʿan sabīlihi wahuwa aʿlamu bil-muh'tadīna","audioUrl":"/audio/7/068007.mp3","segments":[[0,1,70,1320],[1,2,1330,2140],[2,3,2150,2540],[3,4,2550,3330],[4,5,3340,4720],[5,6,4730,5220],[6,7,5230,6280],[7,8,6290,7600],[8,9,7610,8240],[9,10,8250,9020],[10,11,9030,11730]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"رَبَّكَ","translation":"your Lord","transliteration":"rabbaka"},{"position":3,"text":"هُوَ","translation":"He","transliteration":"huwa"},{"position":4,"text":"أَعۡلَمُ","translation":"(is) most knowing","transliteration":"aʿlamu"},{"position":5,"text":"بِمَن","translation":"of (he) who","transliteration":"biman"},{"position":6,"text":"ضَلَّ","translation":"has strayed","transliteration":"ḍalla"},{"position":7,"text":"عَن","translation":"from","transliteration":"ʿan"},{"position":8,"text":"سَبِيلِهِۦ","translation":"His way","transliteration":"sabīlihi"},{"position":9,"text":"وَهُوَ","translation":"and He","transliteration":"wahuwa"},{"position":10,"text":"أَعۡلَمُ","translation":"(is) most knowing","transliteration":"aʿlamu"},{"position":11,"text":"بِٱلۡمُهۡتَدِينَ","translation":"of the guided ones","transliteration":"bil-muh'tadīna"}]},{"id":5279,"verseKey":"68:8","verseNumber":8,"arabic":"فَلَا تُطِعِ ٱلۡمُكَذِّبِينَ","translation":"Then do not obey the deniers.","transliteration":"falā tuṭiʿi l-mukadhibīna","audioUrl":"/audio/7/068008.mp3","segments":[[0,1,30,540],[1,2,550,1190],[2,3,1200,4140]],"words":[{"position":1,"text":"فَلَا","translation":"So (do) not","transliteration":"falā"},{"position":2,"text":"تُطِعِ","translation":"obey","transliteration":"tuṭiʿi"},{"position":3,"text":"ٱلۡمُكَذِّبِينَ","translation":"the deniers","transliteration":"l-mukadhibīna"}]},{"id":5280,"verseKey":"68:9","verseNumber":9,"arabic":"وَدُّواْ لَوۡ تُدۡهِنُ فَيُدۡهِنُونَ","translation":"They wish that you would soften [in your position], so they would soften [toward you].","transliteration":"waddū law tud'hinu fayud'hinūna","audioUrl":"/audio/7/068009.mp3","segments":[[0,1,30,820],[1,2,830,1160],[2,3,1170,1960],[3,4,1970,4820]],"words":[{"position":1,"text":"وَدُّواْ","translation":"They wish","transliteration":"waddū"},{"position":2,"text":"لَوۡ","translation":"that","transliteration":"law"},{"position":3,"text":"تُدۡهِنُ","translation":"you should compromise","transliteration":"tud'hinu"},{"position":4,"text":"فَيُدۡهِنُونَ","translation":"so they would compromise","transliteration":"fayud'hinūna"}]},{"id":5281,"verseKey":"68:10","verseNumber":10,"arabic":"وَلَا تُطِعۡ كُلَّ حَلَّافٖ مَّهِينٍ","translation":"And do not obey every worthless habitual swearer","transliteration":"walā tuṭiʿ kulla ḥallāfin mahīnin","audioUrl":"/audio/7/068010.mp3","segments":[[0,1,30,500],[1,2,510,1150],[2,3,1160,1760],[3,4,1770,3990],[4,5,4000,6130]],"words":[{"position":1,"text":"وَلَا","translation":"And (do) not","transliteration":"walā"},{"position":2,"text":"تُطِعۡ","translation":"obey","transliteration":"tuṭiʿ"},{"position":3,"text":"كُلَّ","translation":"every","transliteration":"kulla"},{"position":4,"text":"حَلَّافٖ","translation":"habitual swearer","transliteration":"ḥallāfin"},{"position":5,"text":"مَّهِينٍ","translation":"worthless","transliteration":"mahīnin"}]},{"id":5282,"verseKey":"68:11","verseNumber":11,"arabic":"هَمَّازٖ مَّشَّآءِۭ بِنَمِيمٖ","translation":"[And] scorner, going about with malicious gossip -","transliteration":"hammāzin mashāin binamīmin","audioUrl":"/audio/7/068011.mp3","segments":[[0,1,50,2910],[1,2,2920,6340],[2,3,6350,8590]],"words":[{"position":1,"text":"هَمَّازٖ","translation":"Defamer",