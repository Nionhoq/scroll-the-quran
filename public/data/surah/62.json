{"chapter":{"id":62,"nameSimple":"Al-Jumu'ah","nameArabic":"الجمعة","translatedName":"The Congregation, Friday","versesCount":11,"revelationPlace":"madinah"},"verses":[{"id":5178,"verseKey":"62:1","verseNumber":1,"arabic":" يُسَبِّحُ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ٱلْمَلِكِ ٱلْقُدُّوسِ ٱلْعَزِيزِ ٱلْحَكِيمِ","translation":"Whatever is in the heavens and whatever is on the earth is exalting Allāh, the Sovereign, the Pure, the Exalted in Might, the Wise.","transliteration":"yusabbiḥu lillahi mā fī l-samāwāti wamā fī l-arḍi l-maliki l-qudūsi l-ʿazīzi l-ḥakīmi","audioUrl":"/audio/7/062001.mp3","segments":[[0,1,50,950],[1,2,960,1830],[2,3,1840,2120],[3,4,2130,2310],[4,5,2320,3600],[5,6,3610,4060],[6,7,4070,4310],[7,8,4320,5060],[8,9,5070,5810],[9,10,5820,6900],[10,11,6910,7880],[11,12,7890,10210]],"words":[{"position":1,"text":"يُسَبِّحُ","translation":"Glorifies","transliteration":"yusabbiḥu"},{"position":2,"text":"لِلَّهِ","translation":"Allah","transliteration":"lillahi"},{"position":3,"text":"مَا","translation":"whatever","transliteration":"mā"},{"position":4,"text":"فِى","translation":"(is) in","transliteration":"fī"},{"position":5,"text":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":6,"text":"وَمَا","translation":"and whatever","transliteration":"wamā"},{"position":7,"text":"فِى","translation":"(is) in","transliteration":"fī"},{"position":8,"text":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":9,"text":"ٱلْمَلِكِ","translation":"the Sovereign","transliteration":"l-maliki"},{"position":10,"text":"ٱلْقُدُّوسِ","translation":"the Holy","transliteration":"l-qudūsi"},{"position":11,"text":"ٱلْعَزِيزِ","translation":"the All-Mighty","transliteration":"l-ʿazīzi"},{"position":12,"text":"ٱلْحَكِيمِ","translation":"the All-Wise","transliteration":"l-ḥakīmi"}]},{"id":5179,"verseKey":"62:2","verseNumber":2,"arabic":"هُوَ ٱلَّذِى بَعَثَ فِى ٱلْأُمِّيِّـۧنَ رَسُولًا مِّنْهُمْ يَتْلُوا۟ عَلَيْهِمْ ءَايَـٰتِهِۦ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ وَإِن كَانُوا۟ مِن قَبْلُ لَفِى ضَلَـٰلٍ مُّبِينٍ","translation":"It is He who has sent among the unlettered [Arabs] a Messenger from themselves reciting to them His verses and purifying them and teaching them the Book [i.e., the Qur’ān] and wisdom [i.e., the sunnah] - although they were before in clear error -","transliteration":"huwa alladhī baʿatha fī l-umiyīna rasūlan min'hum yatlū ʿalayhim āyātihi wayuzakkīhim wayuʿallimuhumu l-kitāba wal-ḥik'mata wa-in kānū min qablu lafī ḍalālin mubīnin","audioUrl":"/audio/7/062002.mp3","segments":[[0,1,40,330],[1,2,340,1060],[2,3,1070,1610],[3,4,1620,1810],[4,5,1820,3720],[5,6,3730,5210],[6,7,5220,5840],[7,8,5850,6470],[8,9,6480,7470],[9,10,7480,8780],[10,11,8790,12110],[11,12,12120,13620],[12,13,13630,14520],[13,14,14530,15620],[14,15,15630,16630],[15,16,16640,17410],[16,17,17420,18460],[17,18,18470,19040],[18,19,19050,19500],[19,20,19510,20310],[20,21,20320,23340]],"words":[{"position":1,"text":"هُوَ","translation":"He","transliteration":"huwa"},{"position":2,"text":"ٱلَّذِى","translation":"(is) the One Who","transliteration":"alladhī"},{"position":3,"text":"بَعَثَ","translation":"sent","transliteration":"baʿatha"},{"position":4,"text":"فِى","translation":"among","transliteration":"fī"},{"position":5,"text":"ٱلْأُمِّيِّـۧنَ","translation":"the unlettered","transliteration":"l-umiyīna"},{"position":6,"text":"رَسُولًۭا","translation":"a Messenger","transliteration":"rasūlan"},{"position":7,"text":"مِّنْهُمْ","translation":"from themselves","transliteration":"min'hum"},{"position":8,"text":"يَتْلُوا۟","translation":"reciting","transliteration":"yatlū"},{"position":9,"text":"عَلَيْهِمْ","translation":"to them","transliteration":"ʿalayhim"},{"position":10,"text":"ءَايَـٰتِهِۦ","translation":"His Verses","transliteration":"āyātihi"},{"position":11,"text":"وَيُزَكِّيهِمْ","translation":"and purifying them","transliteration":"wayuzakkīhim"},{"position":12,"text":"وَيُعَلِّمُهُمُ","translation":"and teaching them","transliteration":"wayuʿallimuhumu"},{"position":13,"text":"ٱلْكِتَـٰبَ","translation":"the Book","transliteration":"l-kitāba"},{"position":14,"text":"وَٱلْحِكْمَةَ","translation":"and the wisdom","transliteration":"wal-ḥik'mata"},{"position":15,"text":"وَإِن","translation":"although","transliteration":"wa-in"},{"position":16,"text":"كَانُوا۟","translation":"they were","transliteration":"kānū"},{"position":17,"text":"مِن","translation":"from","transliteration":"min"},{"position":18,"text":"قَبْلُ","translation":"before","transliteration":"qablu"},{"position":19,"text":"لَفِى","translation":"surely in","transliteration":"lafī"},{"position":20,"text":"ضَلَـٰلٍۢ","translation":"an error","transliteration":"ḍalālin"},{"position":21,"text":"مُّبِينٍۢ","translation":"clear","transliteration":"mubīnin"}]},{"id":5180,"verseKey":"62:3","verseNumber":3,"arabic":"وَءَاخَرِينَ مِنْهُمْ لَمَّا يَلْحَقُوا۟ بِهِمْ ۚ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","translation":"And [to] others of them who have not yet joined them. And He is the Exalted in Might, the Wise.","transliteration":"waākharīna min'hum lammā yalḥaqū bihim wahuwa l-ʿazīzu l-ḥakīmu","audioUrl":"/audio/7/062003.mp3","segments":[[0,1,40,1350],[1,2,1360,2040],[2,3,2050,3390],[3,4,3400,4340],[4,5,4350,5340],[5,6,5350,5870],[6,7,5880,6850],[7,8,6860,9070]],"words":[{"position":1,"text":"وَءَاخَرِينَ","translation":"And others","transliteration":"waākharīna"},{"position":2,"text":"مِنْهُمْ","translation":"among them","transliteration":"min'hum"},{"position":3,"text":"لَمَّا","translation":"who have not yet","transliteration":"lammā"},{"position":4,"text":"يَلْحَقُوا۟","translation":"joined","transliteration":"yalḥaqū"},{"position":5,"text":"بِهِمْ ۚ","translation":"them","transliteration":"bihim"},{"position":6,"text":"وَهُوَ","translation":"and He","transliteration":"wahuwa"},{"position":7,"text":"ٱلْعَزِيزُ","translation":"(is) the All-Mighty","transliteration":"l-ʿazīzu"},{"position":8,"text":"ٱلْحَكِيمُ","translation":"the All-Wise","transliteration":"l-ḥakīmu"}]},{"id":5181,"verseKey":"62:4","verseNumber":4,"arabic":"ذَٰلِكَ فَضْلُ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُ ۚ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ","translation":"That is the bounty of Allāh, which He gives to whom He wills, and Allāh is the possessor of great bounty.","transliteration":"dhālika faḍlu l-lahi yu'tīhi man yashāu wal-lahu dhū l-faḍli l-ʿaẓīmi","audioUrl":"/audio/7/062004.mp3","segments":[[0,1,50,760],[1,2,770,1390],[2,3,1400,2230],[3,4,2240,3130],[4,5,3140,4530],[5,6,4540,7190],[6,7,7200,8140],[7,8,8150,8350],[8,9,8360,9120],[9,10,9130,11230]],"words":[{"position":1,"text":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":2,"text":"فَضْلُ","translation":"(is the) Bounty","transliteration":"faḍlu"},{"position":3,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":4,"text":"يُؤْتِيهِ","translation":"He gives it","transliteration":"yu'tīhi"},{"position":5,"text":"مَن","translation":"(to) whom","transliteration":"man"},{"position":6,"text":"يَشَآءُ ۚ","translation":"He wills","transliteration":"yashāu"},{"position":7,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":8,"text":"ذُو","translation":"(is the) Possessor","transliteration":"dhū"},{"position":9,"text":"ٱلْفَضْلِ","translation":"(of) Bounty","transliteration":"l-faḍli"},{"position":10,"text":"ٱلْعَظِيمِ","translation":"the Great","transliteration":"l-ʿaẓīmi"}]},{"id":5182,"verseKey":"62:5","verseNumber":5,"arabic":"مَثَلُ ٱلَّذِينَ حُمِّلُوا۟ ٱلتَّوْرَىٰةَ ثُمَّ لَمْ يَحْمِلُوهَا كَمَثَلِ ٱلْحِمَارِ يَحْمِلُ أَسْفَارًۢا ۚ بِئْسَ مَثَلُ ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِ ٱللَّهِ ۚ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّـٰلِمِينَ","translation":"The example of those who were entrusted with the Torah and then did not take it on is like that of a donkey who carries volumes [of books]. Wretched is the example of the people who deny the signs of Allāh. And Allāh does not guide the wrongdoing people.","transliteration":"mathalu alladhīna ḥummilū l-tawrāta thumma lam yaḥmilūhā kamathali l-ḥimāri yaḥmilu asfāran bi'sa mathalu l-qawmi alladhīna kadhabū biāyāti l-lahi wal-lahu lā yahdī l-qawma l-ẓālimīna","audioUrl":"/audio/7/062005.mp3","segments":[[0,1,120,600],[1,2,610,1500],[2,3,1510,2730],[3,4,2740,3890],[4,5,3900,5060],[5,6,5070,5390],[6,7,5400,6680],[7,8,6690,7460],[8,9,7470,8420],[9,10,8430,9190],[10,11,9200,10950],[11,12,10960,11460],[12,13,11470,11990],[13,14,12000,12750],[14,15,12760,13660],[15,16,13670,14630],[16,17,14640,16090],[17,18,16100,18150],[18,19,18160,19090],[19,20,19100,19420],[20,21,19430,20030],[21,22,20040,20730],[22,23,20740,23160]],"words":[{"position":1,"text":"مَثَلُ","translation":"(The) likeness","transliteration":"mathalu"},{"position":2,"text":"ٱلَّذِينَ","translation":"(of) those who","transliteration":"alladhīna"},{"position":3,"text":"حُمِّلُوا۟","translation":"were entrusted","transliteration":"ḥummilū"},{"position":4,"text":"ٱلتَّوْرَىٰةَ","translation":"(with) the Taurat","transliteration":"l-tawrāta"},{"position":5,"text":"ثُمَّ","translation":"then","transliteration":"thumma"},{"position":6,"text":"لَمْ","translation":"not","transliteration":"lam"},{"position":7,"text":"يَحْمِلُوهَا","translation":"they bore it","transliteration":"yaḥmilūhā"},{"position":8,"text":"كَمَثَلِ","translation":"(is) like","transliteration":"kamathali"},{"position":9,"text":"ٱلْحِمَارِ","translation":"the donkey","transliteration":"l-ḥimāri"},{"position":10,"text":"يَحْمِلُ","translation":"who carries","transliteration":"yaḥmilu"},{"position":11,"text":"أَسْفَارًۢا ۚ","translation":"books","transliteration":"asfāran"},{"position":12,"text":"بِئْسَ","translation":"Wretched is","transliteration":"bi'sa"},{"position":13,"text":"مَثَلُ","translation":"(the) example","transliteration":"mathalu"},{"position":14,"text":"ٱلْقَوْمِ","translation":"(of) the people","transliteration":"l-qawmi"},{"position":15,"text":"ٱلَّذِينَ","translation":"who","transliteration":"alladhīna"},{"position":16,"text":"كَذَّبُوا۟","translation":"deny","transliteration":"kadhabū"},{"position":17,"text":"بِـَٔايَـٰتِ","translation":"(the) Signs","transliteration":"biāyāti"},{"position":18,"text":"ٱللَّهِ ۚ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":19,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":20,"text":"لَا","translation":"(does) not","transliteration":"lā"},{"position":21,"text":"يَهْدِى","translation":"guide","transliteration":"yahdī"},{"position":22,"text":"ٱلْقَوْمَ","translation":"the people","transliteration":"l-qawma"},{"position":23,"text":"ٱلظَّـٰلِمِينَ","translation":"the wrongdoers","transliteration":"l-ẓālimīna"}]},{"id":5183,"verseKey":"62:6","verseNumber":6,"arabic":"قُلْ يَـٰٓأَيُّهَا ٱلَّذِينَ هَادُوٓا۟ إِن زَعَمْتُمْ أَنَّكُمْ أَوْلِيَآءُ لِلَّهِ مِن دُونِ ٱلنَّاسِ فَتَمَنَّوُا۟ ٱلْمَوْتَ إِن كُنتُمْ صَـٰدِقِينَ","translation":"Say, \"O you who are Jews, if you claim that you are allies of Allāh, excluding the [other] people, then wish for death, if you should be truthful.\"","transliteration":"qul yāayyuhā alladhīna hādū in zaʿamtum annakum awliyāu lillahi min dūni l-nāsi fatamannawū l-mawta in kuntum ṣādiqīna","audioUrl":"/audio/7/062006.mp3","segments":[[0,1,30,210],[1,2,220,2840],[2,3,2850,3830],[3,4,3840,5650],[4,5,5660,6540],[5,6,6550,7550],[6,7,7560,9080],[7,8,9090,11500],[8,9,11510,12450],[9,10,12460,13330],[10,11,13340,13950],[11,12,13960,15290],[12,13,15300,19330],[13,14,19340,20090],[14,15,20100,20940],[15,16,20950,22450],[16,17,22460,24710]],"words":[{"position":1,"text":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"text":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":3,"text":"ٱلَّذِينَ","translation":"you (who)","transliteration":"alladhīna"},{"position":4,"text":"هَادُوٓا۟","translation":"(are) Jews","transliteration":"hādū"},{"position":5,"text":"إِن","translation":"If","transliteration":"in"},{"position":6,"text":"زَعَمْتُمْ","translation":"you claim","transliteration":"zaʿamtum"},{"position":7,"text":"أَنَّكُمْ","translation":"that you","transliteration":"annakum"},{"position":8,"text":"أَوْلِيَآءُ","translation":"(are) allies","transliteration":"awliyāu"},{"position":9,"text":"لِلَّهِ","translation":"of Allah","transliteration":"lillahi"},{"position":10,"text":"مِن","translation":"from","transliteration":"min"},{"position":11,"text":"دُونِ","translation":"excluding","transliteration":"dūni"},{"position":12,"text":"ٱلنَّاسِ","translation":"the people","transliteration":"l-nāsi"},{"position":13,"text":"فَتَمَنَّوُا۟","translation":"then wish","transliteration":"fatamannawū"},{"position":14,"text":"ٱلْمَوْتَ","translation":"(for) the death","transliteration":"l-mawta"},{"position":15,"text":"إِن","translation":"if","transliteration":"in"},{"position":16,"text":"كُنتُمْ","translation":"you are","transliteration":"kuntum"},{"position":17,"text":"صَـٰدِقِينَ","translation":"truthful","transliteration":"ṣādiqīna"}]},{"id":5184,"verseKey":"62:7","verseNumber":7,"arabic":"وَلَا يَتَمَنَّوْنَهُۥٓ أَبَدًۢا بِمَا قَدَّمَتْ أَيْدِيهِمْ ۚ وَٱللَّهُ عَلِيمٌۢ بِٱلظَّـٰلِمِينَ","translation":"But they will not wish for it, ever, because of what their hands have put forth. And Allāh is Knowing of the wrongdoers.","transliteration":"walā yatamannawnahu abadan bimā qaddamat aydīhim wal-lahu ʿalīmun bil-ẓālimīna","audioUrl":"/audio/7/062007.mp3","segments":[[0,1,40,530],[1,2,540,4480],[2,3,4490,5760],[3,4,5770,6320],[4,5,6330,7330],[5,6,7340,8880],[6,7,8890,9770],[7,8,9780,11530],[8,9,11540,14210]],"words":[{"position":1,"text":"وَلَا","translation":"But not","transliteration":"walā"},{"position":2,"text":"يَتَمَنَّوْنَهُۥٓ","translation":"they will wish for it","transliteration":"yatamannawnahu"},{"position":3,"text":"أَبَدًۢا","translation":"ever","transliteration":"abadan"},{"position":4,"text":"بِمَا","translation":"for what","transliteration":"bimā"},{"position":5,"text":"قَدَّمَتْ","translation":"(have) sent forth","transliteration":"qaddamat"},{"position":6,"text":"أَيْدِيهِمْ ۚ","translation":"their hands","transliteration":"aydīhim"},{"position":7,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":8,"text":"عَلِيمٌۢ","translation":"(is) All-Knowing","transliteration":"ʿalīmun"},{"position":9,"text":"بِٱلظَّـٰلِمِينَ","translation":"of the wrongdoers","transliteration":"bil-ẓālimīna"}]},{"id":5185,"verseKey":"62:8","verseNumber":8,"arabic":"قُلْ إِنَّ ٱلْمَوْتَ ٱلَّذِى تَفِرُّونَ مِنْهُ فَإِنَّهُۥ مُلَـٰقِيكُمْ ۖ ثُمَّ تُرَدُّونَ إِلَىٰ عَـٰلِمِ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ فَيُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ","translation":"Say, \"Indeed, the death from which you flee - indeed, it will meet you. Then you will be returned to the Knower of the unseen and the witnessed, and He will inform you about what you used to do.\"","transliteration":"qul inna l-mawta alladhī tafirrūna min'hu fa-innahu mulāqīkum thumma turaddūna ilā ʿālimi l-ghaybi wal-shahādati fayunabbi-ukum bimā kuntum taʿmalūna","audioUrl":"/audio/7/062008.mp3","segments":[[0,1,30,330],[1,2,340,1450],[2,3,1460,2250],[3,4,2260,2960],[4,5,2970,4200],[5,6,4210,4700],[6,7,4710,6500],[7,8,6510,8420],[8,9,8430,9840],[9,10,9850,11000],[10,11,11010,11510],[11,12,11520,12370],[12,13,12380,13210],[13,14,13220,14470],[14,15,14480,16460],[15,16,16470,17010],[16,17,17020,18580],[17,18,18590,21320]],"words":[{"position":1,"text":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":3,"text":"ٱلْمَوْتَ","translation":"the death","transliteration":"l-mawta"},{"position":4,"text":"ٱلَّذِى","translation":"which","transliteration":"alladhī"},{"position":5,"text":"تَفِرُّونَ","translation":"you flee","transliteration":"tafirrūna"},{"position":6,"text":"مِنْهُ","translation":"from it","transliteration":"min'hu"},{"position":7,"text":"فَإِنَّهُۥ","translation":"then surely it","transliteration":"fa-innahu"},{"position":8,"text":"مُلَـٰقِيكُمْ ۖ","translation":"(will) meet you","transliteration":"mulāqīkum"},{"position":9,"text":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":10,"text":"تُرَدُّونَ","translation":"you will be sent back","transliteration":"turaddūna"},{"position":11,"text":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":12,"text":"عَـٰلِمِ","translation":"(the) All-Knower","transliteration":"ʿālimi"},{"position":13,"text":"ٱلْغَيْبِ","translation":"(of) the unseen","transliteration":"l-ghaybi"},{"position":14,"text":"وَٱلشَّهَـٰدَةِ","translation":"and the witnessed","transliteration":"wal-shahādati"},{"position":15,"text":"فَيُنَبِّئُكُم","translation":"and He will inform you","transliteration":"fayunabbi-ukum"},{"position":16,"text":"بِمَا","translation":"[of] what","transliteration":"bimā"},{"position":17,"text":"كُنتُمْ","translation":"you used to","transliteration":"kuntum"},{"position":18,"text":"تَعْمَلُونَ","translation":"do","transliteration":"taʿmalūna"}]},{"id":5186,"verseKey":"62:9","verseNumber":9,"arabic":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا نُودِىَ لِلصَّلَوٰةِ مِن يَوْمِ ٱلْجُمُعَةِ فَٱسْعَوْا۟ إِلَىٰ ذِكْرِ ٱللَّهِ وَذَرُوا۟ ٱلْبَيْعَ ۚ ذَٰلِكُمْ خَيْرٌ لَّكُمْ إِن كُنتُمْ تَعْلَمُونَ","translation":"O you who have believed, when [the adhān] is called for the prayer on the day of Jumuʿah [Friday], then proceed to the remembrance of Allāh and leave trade. That is better for you, if you only knew.","transliteration":"yāayyuhā alladhīna āmanū idhā nūdiya lilṣṣalati min yawmi l-jumuʿati fa-is'ʿaw ilā dhik'ri l-lahi wadharū l-bayʿa dhālikum khayrun lakum in kuntum taʿlamūna","audioUrl":"/audio/7/062009.mp3","segments":[[0,1,40,2830],[1,2,2840,3740],[2,3,3750,6220],[3,4,6230,6780],[4,5,6790,7540],[5,6,7550,8720],[6,7,8730,9780],[7,8,9790,10320],[8,9,10330,11290],[9,10,11300,12090],[10,11,12100,12580],[11,12,12590,13210],[12,13,13220,13910],[13,14,13920,14570],[14,15,14580,17140],[15,16,17150,18010],[16,17,18020,18660],[17,18,18670,19380],[18,19,19390,20420],[19,20,20430,22070],[20,21,22080,24940]],"words":[{"position":1,"text":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلَّذِينَ","translation":"(you) who","transliteration":"alladhīna"},{"position":3,"text":"ءَامَنُوٓا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"text":"إِذَا","translation":"When","transliteration":"idhā"},{"position":5,"text":"نُودِىَ","translation":"(the) call is made","transliteration":"nūdiya"},{"position":6,"text":"لِلصَّلَوٰةِ","translation":"for (the) prayer","transliteration":"lilṣṣalati"},{"position":7,"text":"مِن","translation":"on","transliteration":"min"},{"position":8,"text":"يَوْمِ","translation":"(the) day","transliteration":"yawmi"},{"position":9,"text":"ٱلْجُمُعَةِ","translation":"(of) Friday","transliteration":"l-jumuʿati"},{"position":10,"text":"فَٱسْعَوْا۟","translation":"then hasten","transliteration":"fa-is'ʿaw"},{"position":11,"text":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":12,"text":"ذِكْرِ","translation":"(the) remembrance","transliteration":"dhik'ri"},{"position":13,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":14,"text":"وَذَرُوا۟","translation":"and leave","transliteration":"wadharū"},{"position":15,"text":"ٱلْبَيْعَ ۚ","translation":"the business","transliteration":"l-bayʿa"},{"position":16,"text":"ذَٰلِكُمْ","translation":"That","transliteration":"dhālikum"},{"position":17,"text":"خَيْرٌۭ","translation":"(is) better","transliteration":"khayrun"},{"position":18,"text":"لَّكُمْ","translation":"for you","transliteration":"lakum"},{"position":19,"text":"إِن","translation":"if","transliteration":"in"},{"position":20,"text":"كُنتُمْ","translation":"you","transliteration":"kuntum"},{"position":21,"text":"تَعْلَمُونَ","translation":"know","transliteration":"taʿlamūna"}]},{"id":5187,"verseKey":"62:10","verseNumber":10,"arabic":"فَإِذَا قُضِيَتِ ٱلصَّلَوٰةُ فَٱنتَشِرُوا۟ فِى ٱلْأَرْضِ وَٱبْتَغُوا۟ مِن فَضْلِ ٱللَّهِ وَٱذْكُرُوا۟ ٱللَّهَ كَثِيرًا لَّعَلَّكُمْ تُفْلِحُونَ","translation":"And when the prayer has been concluded, disperse within the land and seek from the bounty of Allāh, and remember Allāh often that you may succeed.","transliteration":"fa-idhā quḍiyati l-ṣalatu fa-intashirū fī l-arḍi wa-ib'taghū min faḍli l-lahi wa-udh'kurū l-laha kathīran laʿallakum tuf'liḥūna","audioUrl":"/audio/7/062010.mp3","segments":[[0,1,30,680],[1,2,690,1460],[2,3,1470,2390],[3,4,2400,4160],[4,5,4170,4400],[5,6,4410,5190],[6,7,5200,6120],[7,8,6130,6960],[8,9,6970,7660],[9,10,7670,8410],[10,11,8420,9340],[11,12,9350,9900],[12,13,9910,10680],[13,14,10690,12000],[14,15,12010,14450]],"words":[{"position":1,"text":"فَإِذَا","translation":"Then when","transliteration":"fa-idhā"},{"position":2,"text":"قُضِيَتِ","translation":"is concluded","transliteration":"quḍiyati"},{"position":3,"text":"ٱلصَّلَوٰةُ","translation":"the prayer","transliteration":"l-ṣalatu"},{"position":4,"text":"فَٱنتَشِرُوا۟","translation":"then disperse","transliteration":"fa-intashirū"},{"position":5,"text":"فِى","translation":"in","transliteration":"fī"},{"position":6,"text":"ٱلْأَرْضِ","translation":"the land","transliteration":"l-arḍi"},{"position":7,"text":"وَٱبْتَغُوا۟","translation":"and seek","transliteration":"wa-ib'taghū"},{"position":8,"text":"مِن","translation":"from","transliteration":"min"},{"position":9,"text":"فَضْلِ","translation":"(the) Bounty","transliteration":"faḍli"},{"position":10,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":11,"text":"وَٱذْكُرُوا۟","translation":"and remember","transliteration":"wa-udh'kurū"},{"position":12,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":13,"text":"كَثِيرًۭا","translation":"much","transliteration":"ka