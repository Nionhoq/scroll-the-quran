sition":9,"text":"قَآئِمًۭا ۚ","translation":"standing","transliteration":"qāiman"},{"position":10,"text":"قُلْ","translation":"Say","transliteration":"qul"},{"position":11,"text":"مَا","translation":"What","transliteration":"mā"},{"position":12,"text":"عِندَ","translation":"(is) with","transliteration":"ʿinda"},{"position":13,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":14,"text":"خَيْرٌۭ","translation":"(is) better","transliteration":"khayrun"},{"position":15,"text":"مِّنَ","translation":"than","transliteration":"mina"},{"position":16,"text":"ٱللَّهْوِ","translation":"the sport","transliteration":"l-lahwi"},{"position":17,"text":"وَمِنَ","translation":"and from","transliteration":"wamina"},{"position":18,"text":"ٱلتِّجَـٰرَةِ ۚ","translation":"(any) transaction","transliteration":"l-tijārati"},{"position":19,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":20,"text":"خَيْرُ","translation":"(is the) Best","transliteration":"khayru"},{"position":21,"text":"ٱلرَّٰزِقِينَ","translation":"(of) the Providers","transliteration":"l-rāziqīna"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
