tion":19,"text":"إِلَّآ","translation":"except","transliteration":"illā"},{"position":20,"text":"أَن","translation":"that","transliteration":"an"},{"position":21,"text":"يَأْتِينَ","translation":"they commit","transliteration":"yatīna"},{"position":22,"text":"بِفَـٰحِشَةٍۢ","translation":"an immorality","transliteration":"bifāḥishatin"},{"position":23,"text":"مُّبَيِّنَةٍۢ ۚ","translation":"clear","transliteration":"mubayyinatin"},{"position":24,"text":"وَتِلْكَ","translation":"And these","transliteration":"watil'ka"},{"position":25,"text":"حُدُودُ","translation":"(are the) limits","transliteration":"ḥudūdu"},{"position":26,"text":"ٱللَّهِ ۚ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":27,"text":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":28,"text":"يَتَعَدَّ","translation":"transgresses","transliteration":"yataʿadda"},{"position":29,"text":"حُدُودَ","translation":"(the) limits","transliteration":"ḥudūda"},{"position":30,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":31,"text":"فَقَدْ","translation":"then certainly","transliteration":"faqad"},{"position":32,"text":"ظَلَمَ","translation":"he has wronged","transliteration":"ẓalama"},{"position":33,"text":"نَفْسَهُۥ ۚ","translation":"himself","transliteration":"nafsahu"},{"position":34,"text":"لَا","translation":"Not","transliteration":"lā"},{"position":35,"text":"تَدْرِى","translation":"you know","transliteration":"tadrī"},{"position":36,"text":"لَعَلَّ","translation":"Perhaps","transliteration":"laʿalla"},{"position":37,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":38,"text":"يُحْدِثُ","translation":"will bring about","transliteration":"yuḥ'dithu"},{"position":39,"text":"بَعْدَ","translation":"after","transliteration":"baʿda"},{"position":40,"text":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":41,"text":"أَمْرًۭا","translation":"a matter","transliteration":"amran"}]},{"id":5219,"verseKey":"65:2","verseNumber":2,"arabic":"فَإِذَا بَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ فَارِقُوهُنَّ بِمَعْرُوفٍ وَأَشْهِدُوا۟ ذَوَىْ عَدْلٍ مِّنكُمْ وَأَقِيمُوا۟ ٱلشَّهَـٰدَةَ لِلَّهِ ۚ ذَٰلِكُمْ يُوعَظُ بِهِۦ مَن كَانَ يُؤْمِنُ بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۚ وَمَن يَتَّقِ ٱللَّهَ يَجْعَل لَّهُۥ مَخْرَجًا","translation":"And when they have [nearly] fulfilled their term, either retain them according to acceptable terms or part with them according to acceptable terms. And bring to witness two just men from among you and establish the testimony for [the acceptance of] Allāh. That is instructed to whoever should believe in Allāh and the Last Day. And whoever fears Allāh - He will make for him a way out","transliteration":"fa-idhā balaghna ajalahunna fa-amsikūhunna bimaʿrūfin aw fāriqūhunna bimaʿrūfin wa-ashhidū dhaway ʿadlin minkum wa-aqīmū l-shahādata lillahi dhālikum yūʿaẓu bihi man kāna yu'minu bil-lahi wal-yawmi l-ākhiri waman yattaqi l-laha yajʿal lahu makhrajan","audioUrl":"/audio/7/065002.mp3","segments":[[0,1,30,680],[1,2,690,1440],[2,3,1450,2970],[3,4,2980,5140],[4,5,5150,6440],[5,6,6450,6750],[6,7,6760,8800],[7,8,8810,10090],[8,9,10100,11900],[9,10,11910,12460],[10,11,12470,13870],[11,12,13880,15280],[12,13,15290,16180],[13,14,16190,17990],[14,15,18000,20050],[15,16,20060,21030],[16,17,21040,21790],[17,18,21800,22380],[18,19,22390,23300],[19,20,23310,23950],[20,21,23960,24730],[21,22,24740,25720],[22,23,25730,26680],[23,24,26690,28110],[24,25,28120,29510],[25,26,29520,30170],[26,27,30180,30890],[27,28,30900,31800],[28,29,31810,32310],[29,30,32320,33430]],"words":[{"position":1,"text":"فَإِذَا","translation":"Then when","transliteration":"fa-idhā"},{"position":2,"text":"بَلَغْنَ","translation":"they have reached","transliteration":"balaghna"},{"position":3,"text":"أَجَلَهُنَّ","translation":"their term","transliteration":"ajalahunna"},{"position":4,"text":"فَأَمْسِكُوهُنَّ","translation":"then retain them","transliteration":"