ْعَلُ ٱللَّهُ بَعْدَ عُسْرٍ يُسْرًا","translation":"Let a man of wealth spend from his wealth, and he whose provision is restricted - let him spend from what Allāh has given him. Allāh does not charge a soul except [according to] what He has given it. Allāh will bring about, after hardship, ease [i.e., relief].","transliteration":"liyunfiq dhū saʿatin min saʿatihi waman qudira ʿalayhi riz'quhu falyunfiq mimmā ātāhu l-lahu lā yukallifu l-lahu nafsan illā mā ātāhā sayajʿalu l-lahu baʿda ʿus'rin yus'ran","audioUrl":"/audio/7/065007.mp3","segments":[[0,1,30,1830],[1,2,1840,2170],[2,3,2180,3870],[3,4,3880,4730],[4,5,4740,6140],[5,6,6150,7200],[6,7,7210,7770],[7,8,7780,8590],[8,9,8600,9510],[9,10,9520,11400],[10,11,11410,14430],[11,12,14440,15600],[12,13,15610,18030],[13,14,18040,18380],[14,15,18390,19660],[15,16,19670,20240],[16,17,20250,20930],[17,18,20940,21740],[18,19,21750,23020],[19,20,23030,25230],[20,21,25240,26280],[21,22,26290,27100],[22,23,27110,27650],[23,24,27660,29500],[24,25,29510,30520]],"words":[{"position":1,"text":"لِيُنفِقْ","translation":"Let spend","transliteration":"liyunfiq"},{"position":2,"text":"ذُو","translation":"owner","transliteration":"dhū"},{"position":3,"text":"سَعَةٍۢ","translation":"(of) ample means","transliteration":"saʿatin"},{"position":4,"text":"مِّن","translation":"from","transliteration":"min"},{"position":5,"text":"سَعَتِهِۦ ۖ","translation":"his ample means","transliteration":"saʿatihi"},{"position":6,"text":"وَمَن","translation":"and (he) who","transliteration":"waman"},{"position":7,"text":"قُدِرَ","translation":"is restricted","transliteration":"qudira"},{"position":8,"text":"عَلَيْهِ","translation":"on him","transliteration":"ʿalayhi"},{"position":9,"text":"رِزْقُهُۥ","translation":"his provision","transliteration":"riz'quhu"},{"position":10,"text":"فَلْيُنفِقْ","translation":"let him spend","transliteration":"falyunfiq"},{"position":11,"text":"مِمَّآ","translation":"from what","transliteration":"mimmā"},{"position":12,"tex