{"chapter":{"id":67,"nameSimple":"Al-Mulk","nameArabic":"الملك","translatedName":"The Sovereignty","versesCount":30,"revelationPlace":"makkah"},"verses":[{"id":5242,"verseKey":"67:1","verseNumber":1,"arabic":"تَبَٰرَكَ ٱلَّذِي بِيَدِهِ ٱلۡمُلۡكُ وَهُوَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ","translation":"Blessed is He in whose hand is dominion, and He is over all things competent -","transliteration":"tabāraka alladhī biyadihi l-mul'ku wahuwa ʿalā kulli shayin qadīrun","audioUrl":"/audio/7/067001.mp3","segments":[[0,1,60,1070],[1,2,1080,1940],[2,3,1950,2790],[3,4,2800,3650],[4,5,3660,4220],[5,6,4230,4900],[6,7,4910,5530],[7,8,5540,7150],[8,9,7160,9700]],"words":[{"position":1,"text":"تَبَٰرَكَ","translation":"Blessed is","transliteration":"tabāraka"},{"position":2,"text":"ٱلَّذِي","translation":"He","transliteration":"alladhī"},{"position":3,"text":"بِيَدِهِ","translation":"in Whose Hand","transliteration":"biyadihi"},{"position":4,"text":"ٱلۡمُلۡكُ","translation":"(is) the Dominion","transliteration":"l-mul'ku"},{"position":5,"text":"وَهُوَ","translation":"and He","transliteration":"wahuwa"},{"position":6,"text":"عَلَىٰ","translation":"(is) over","transliteration":"ʿalā"},{"position":7,"text":"كُلِّ","translation":"every","transliteration":"kulli"},{"position":8,"text":"شَيۡءٖ","translation":"thing","transliteration":"shayin"},{"position":9,"text":"قَدِيرٌ","translation":"All-Powerful","transliteration":"qadīrun"}]},{"id":5243,"verseKey":"67:2","verseNumber":2,"arabic":"ٱلَّذِي خَلَقَ ٱلۡمَوۡتَ وَٱلۡحَيَوٰةَ لِيَبۡلُوَكُمۡ أَيُّكُمۡ أَحۡسَنُ عَمَلٗاۚ وَهُوَ ٱلۡعَزِيزُ ٱلۡغَفُورُ","translation":"[He] who created death and life to test you [as to] which of you is best in deed - and He is the Exalted in Might, the Forgiving -","transliteration":"alladhī khalaqa l-mawta wal-ḥayata liyabluwakum ayyukum aḥsanu ʿamalan wahuwa l-ʿazīzu l-ghafūru","audioUrl":"/audio/7/067002.mp3","segments":[[0,1,150,970],[1,2,980,1620],[2,3,1630,2430],[3,4,2440,3700],[4,5,3710,5100],[5,6,5110,6170],[6,7,6180,6890],[7,8,6900,8330],[8,9,8340,8930],[9,10,8940,10010],[10,11,10020,12980]],"words":[{"position":1,"text":"ٱلَّذِي","translation":"The One Who","transliteration":"alladhī"},{"position":2,"text":"خَلَقَ","translation":"created","transliteration":"khalaqa"},{"position":3,"text":"ٱلۡمَوۡتَ","translation":"death","transliteration":"l-mawta"},{"position":4,"text":"وَٱلۡحَيَوٰةَ","translation":"and life","transliteration":"wal-ḥayata"},{"position":5,"text":"لِيَبۡلُوَكُمۡ","translation":"that He may test you","transliteration":"liyabluwakum"},{"position":6,"text":"أَيُّكُمۡ","translation":"which of you","transliteration":"ayyukum"},{"position":7,"text":"أَحۡسَنُ","translation":"(is) best","transliteration":"aḥsanu"},{"position":8,"text":"عَمَلٗاۚ","translation":"(in) deed","transliteration":"ʿamalan"},{"position":9,"text":"وَهُوَ","translation":"And He","transliteration":"wahuwa"},{"position":10,"text":"ٱلۡعَزِيزُ","translation":"(is) the All-Mighty","transliteration":"l-ʿazīzu"},{"position":11,"text":"ٱلۡغَفُورُ","translation":"the Oft-Forgiving","transliteration":"l-ghafūru"}]},{"id":5244,"verseKey":"67:3","verseNumber":3,"arabic":"ٱلَّذِي خَلَقَ سَبۡعَ سَمَٰوَٰتٖ طِبَاقٗاۖ مَّا تَرَىٰ فِي خَلۡقِ ٱلرَّحۡمَٰنِ مِن تَفَٰوُتٖۖ فَٱرۡجِعِ ٱلۡبَصَرَ هَلۡ تَرَىٰ مِن فُطُورٖ","translation":"[And] who created seven heavens in layers. You do not see in the creation of the Most Merciful any inconsistency. So return [your] vision [to the sky]; do you see any breaks?","transliteration":"alladhī khalaqa sabʿa samāwātin ṭibāqan mā tarā fī khalqi l-raḥmāni min tafāwutin fa-ir'jiʿi l-baṣara hal tarā min fuṭūrin","audioUrl":"/audio/7/067003.mp3","segments":[[0,1,50,920],[1,2,930,1550],[2,3,1560,2150],[3,4,2160,4360],[4,5,4370,6230],[5,6,6240,6550],[6,7,6560,7210],[7,8,7220,7610],[8,9,7620,8260],[9,10,8270,9590],[10,11,9600,10550],[11,12,10560,12240],[12,13,12250,13030],[13,14,13040,13850],[14,15,13860,14240],[15,16,14250,14920],[16,17,14930,15690],[17,18,15700,18300]],"words":[{"position":1,"text":"ٱلَّذِي","translation":"The One Who","transliteration":"alladhī"},{"position":2,"text":"خَلَقَ","translation":"created","transliteration":"khalaqa"},{"position":3,"text":"سَبۡعَ","translation":"seven","transliteration":"sabʿa"},{"position":4,"text":"سَمَٰوَٰتٖ","translation":"heavens","transliteration":"samāwātin"},{"position":5,"text":"طِبَاقٗاۖ","translation":"one above another","transliteration":"ṭibāqan"},{"position":6,"text":"مَّا","translation":"Not","transliteration":"mā"},{"position":7,"text":"تَرَىٰ","translation":"you see","transliteration":"tarā"},{"position":8,"text":"فِي","translation":"in","transliteration":"fī"},{"position":9,"text":"خَلۡقِ","translation":"(the) creation","transliteration":"khalqi"},{"position":10,"text":"ٱلرَّحۡمَٰنِ","translation":"(of) the Most Gracious","transliteration":"l-raḥmāni"},{"position":11,"text":"مِن","translation":"any","transliteration":"min"},{"position":12,"text":"تَفَٰوُتٖۖ","translation":"fault","transliteration":"tafāwutin"},{"position":13,"text":"فَٱرۡجِعِ","translation":"So return","transliteration":"fa-ir'jiʿi"},{"position":14,"text":"ٱلۡبَصَرَ","translation":"the vision","transliteration":"l-baṣara"},{"position":15,"text":"هَلۡ","translation":"can","transliteration":"hal"},{"position":16,"text":"تَرَىٰ","translation":"you see","transliteration":"tarā"},{"position":17,"text":"مِن","translation":"any","transliteration":"min"},{"position":18,"text":"فُطُورٖ","translation":"flaw","transliteration":"fuṭūrin"}]},{"id":5245,"verseKey":"67:4","verseNumber":4,"arabic":"ثُمَّ ٱرۡجِعِ ٱلۡبَصَرَ كَرَّتَيۡنِ يَنقَلِبۡ إِلَيۡكَ ٱلۡبَصَرُ خَاسِئٗا وَهُوَ حَسِيرٞ","translation":"Then return [your] vision twice again. [Your] vision will return to you humbled while it is fatigued.","transliteration":"thumma ir'jiʿi l-baṣara karratayni yanqalib ilayka l-baṣaru khāsi-an wahuwa ḥasīrun","audioUrl":"/audio/7/067004.mp3","segments":[[0,1,30,1450],[1,2,1460,2170],[2,3,2180,3000],[3,4,3010,4260],[4,5,4270,6080],[5,6,6090,6900],[6,7,6910,7690],[7,8,7700,8580],[8,9,8590,9990],[9,10,10000,12100]],"words":[{"position":1,"text":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"text":"ٱرۡجِعِ","translation":"return","transliteration":"ir'jiʿi"},{"position":3,"text":"ٱلۡبَصَرَ","translation":"the vision","transliteration":"l-baṣara"},{"position":4,"text":"كَرَّتَيۡنِ","translation":"twice (again)","transliteration":"karratayni"},{"position":5,"text":"يَنقَلِبۡ","translation":"Will return","transliteration":"yanqalib"},{"position":6,"text":"إِلَيۡكَ","translation":"to you","transliteration":"ilayka"},{"position":7,"text":"ٱلۡبَصَرُ","translation":"the vision","transliteration":"l-baṣaru"},{"position":8,"text":"خَاسِئٗا","translation":"humbled","transliteration":"khāsi-an"},{"position":9,"text":"وَهُوَ","translation":"while it","transliteration":"wahuwa"},{"position":10,"text":"حَسِيرٞ","translation":"(is) fatigued","transliteration":"ḥasīrun"}]},{"id":5246,"verseKey":"67:5","verseNumber":5,"arabic":"وَلَقَدۡ زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِمَصَٰبِيحَ وَجَعَلۡنَٰهَا رُجُومٗا لِّلشَّيَٰطِينِۖ وَأَعۡتَدۡنَا لَهُمۡ عَذَابَ ٱلسَّعِيرِ","translation":"And We have certainly beautified the nearest heaven with lamps [i.e., stars] and have made [from] them what is thrown at the devils and have prepared for them the punishment of the Blaze.","transliteration":"walaqad zayyannā l-samāa l-dun'yā bimaṣābīḥa wajaʿalnāhā rujūman lilshayāṭīni wa-aʿtadnā lahum ʿadhāba l-saʿīri","audioUrl":"/audio/7/067005.mp3","segments":[[0,1,100,760],[1,2,770,2400],[2,3,2410,5070],[3,4,5080,6130],[4,5,6140,7600],[5,6,7610,9250],[6,7,9260,10080],[7,8,10090,13860],[8,9,13870,15240],[9,10,15250,15740],[10,11,15750,16600],[11,12,16610,19120]],"words":[{"position":1,"text":"وَلَقَدۡ","translation":"And certainly","transliteration":"walaqad"},{"position":2,"text":"زَيَّنَّا","translation":"We have beautified","transliteration":"zayyannā"},{"position":3,"text":"ٱلسَّمَآءَ","translation":"the heaven","transliteration":"l-samāa"},{"position":4,"text":"ٱلدُّنۡيَا","translation":"nearest","transliteration":"l-dun'yā"},{"position":5,"text":"بِمَصَٰبِيحَ","translation":"with lamps","transliteration":"bimaṣābīḥa"},{"position":6,"text":"وَجَعَلۡنَٰهَا","translation":"and We have made them","transliteration":"wajaʿalnāhā"},{"position":7,"text":"رُجُومٗا","translation":"(as) missiles","transliteration":"rujūman"},{"position":8,"text":"لِّلشَّيَٰطِينِۖ","translation":"for the devils","transliteration":"lilshayāṭīni"},{"position":9,"text":"وَأَعۡتَدۡنَا","translation":"and We have prepared","transliteration":"wa-aʿtadnā"},{"position":10,"text":"لَهُمۡ","translation":"for them","transliteration":"lahum"},{"position":11,"text":"عَذَابَ","translation":"punishment","transliteration":"ʿadhāba"},{"position":12,"text":"ٱلسَّعِيرِ","translation":"(of) the Blaze","transliteration":"l-saʿīri"}]},{"id":5247,"verseKey":"67:6","verseNumber":6,"arabic":"وَلِلَّذِينَ كَفَرُواْ بِرَبِّهِمۡ عَذَابُ جَهَنَّمَۖ وَبِئۡسَ ٱلۡمَصِيرُ","translation":"And for those who disbelieved in their Lord is the punishment of Hell, and wretched is the destination.","transliteration":"walilladhīna kafarū birabbihim ʿadhābu jahannama wabi'sa l-maṣīru","audioUrl":"/audio/7/067006.mp3","segments":[[0,1,130,1390],[1,2,1400,2220],[2,3,2230,3380],[3,4,3390,4260],[4,5,4270,6030],[5,6,6040,6840],[6,7,6850,9440]],"words":[{"position":1,"text":"وَلِلَّذِينَ","translation":"And for those who","transliteration":"walilladhīna"},{"position":2,"text":"كَفَرُواْ","translation":"disbelieved","transliteration":"kafarū"},{"position":3,"text":"بِرَبِّهِمۡ","translation":"in their Lord","transliteration":"birabbihim"},{"position":4,"text":"عَذَابُ","translation":"(is the) punishment","transliteration":"ʿadhābu"},{"position":5,"text":"جَهَنَّمَۖ","translation":"(of) Hell","transliteration":"jahannama"},{"position":6,"text":"وَبِئۡسَ","translation":"and wretched is","transliteration":"wabi'sa"},{"position":7,"text":"ٱلۡمَصِيرُ","translation":"the destination","transliteration":"l-maṣīru"}]},{"id":5248,"verseKey":"67:7","verseNumber":7,"arabic":"إِذَآ أُلۡقُواْ فِيهَا سَمِعُواْ لَهَا شَهِيقٗا وَهِيَ تَفُورُ","translation":"When they are thrown into it, they hear from it a [dreadful] inhaling while it boils up.","transliteration":"idhā ul'qū fīhā samiʿū lahā shahīqan wahiya tafūru","audioUrl":"/audio/7/067007.mp3","segments":[[0,1,30,1980],[1,2,1990,2800],[2,3,2810,3650],[3,4,3660,4580],[4,5,4590,5110],[5,6,5120,5990],[6,7,6000,7590],[7,8,7600,10290]],"words":[{"position":1,"text":"إِذَآ","translation":"When","transliteration":"idhā"},{"position":2,"text":"أُلۡقُواْ","translation":"they are thrown","transliteration":"ul'qū"},{"position":3,"text":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":4,"text":"سَمِعُواْ","translation":"they will hear","transliteration":"samiʿū"},{"position":5,"text":"لَهَا","translation":"from it","transliteration":"lahā"},{"position":6,"text":"شَهِيقٗا","translation":"an inhaling","transliteration":"shahīqan"},{"position":7,"text":"وَهِيَ","translation":"while it","transliteration":"wahiya"},{"position":8,"text":"تَفُورُ","translation":"boils up","transliteration":"tafūru"}]},{"id":5249,"verseKey":"67:8","verseNumber":8,"arabic":"تَكَادُ تَمَيَّزُ مِنَ ٱلۡغَيۡظِۖ كُلَّمَآ أُلۡقِيَ فِيهَا فَوۡجٞ سَأَلَهُمۡ خَزَنَتُهَآ أَلَمۡ يَأۡتِكُمۡ نَذِيرٞ","translation":"It almost bursts with rage. Every time a company is thrown into it, its keepers ask them, \"Did there not come to you a warner?\"","transliteration":"takādu tamayyazu mina l-ghayẓi kullamā ul'qiya fīhā fawjun sa-alahum khazanatuhā alam yatikum nadhīrun","audioUrl":"/audio/7/067008.mp3","segments":[[0,1,40,810],[1,2,820,1900],[2,3,1910,2280],[3,4,2290,5150],[4,5,5400,7630],[5,6,7640,8430],[6,7,8440,9290],[7,8,9300,10750],[8,9,10760,11760],[9,10,11770,13040],[10,11,13050,14880],[11,12,14890,15890],[12,13,15900,17900]],"words":[{"position":1,"text":"تَكَادُ","translation":"It almost","transliteration":"takādu"},{"position":2,"text":"تَمَيَّزُ","translation":"bursts","transliteration":"tamayyazu"},{"position":3,"text":"مِنَ","translation":"from","transliteration":"mina"},{"position":4,"text":"ٱلۡغَيۡظِۖ","translation":"rage","transliteration":"l-ghayẓi"},{"position":5,"text":"كُلَّمَآ","translation":"Every time","transliteration":"kullamā"},{"position":6,"text":"أُلۡقِيَ","translation":"is thrown","transliteration":"ul'qiya"},{"position":7,"text":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":8,"text":"فَوۡجٞ","translation":"a group","transliteration":"fawjun"},{"position":9,"text":"سَأَلَهُمۡ","translation":"(will) ask them","transliteration":"sa-alahum"},{"position":10,"text":"خَزَنَتُهَآ","translation":"its keepers","transliteration":"khazanatuhā"},{"position":11,"text":"أَلَمۡ","translation":"Did not","transliteration":"alam"},{"position":12,"text":"يَأۡتِكُمۡ","translation":"come to you","transliteration":"yatikum"},{"position":13,"text":"نَذِيرٞ","translation":"a warner","transliteration":"nadhīrun"}]},{"id":5250,"verseKey":"67:9","verseNumber":9,"arabic":"قَالُواْ بَلَىٰ قَدۡ جَآءَنَا نَذِيرٞ فَكَذَّبۡنَا وَقُلۡنَا مَا نَزَّلَ ٱللَّهُ مِن شَيۡءٍ إِنۡ أَنتُمۡ إِلَّا فِي ضَلَٰلٖ كَبِيرٖ","translation":"They will say, \"Yes, a warner had come to us, but we denied and said, 'Allāh has not sent down anything. You are not but in great error.'\"","transliteration":"qālū balā qad jāanā nadhīrun fakadhabnā waqul'nā mā nazzala l-lahu min shayin in antum illā fī ḍalālin kabīrin","audioUrl":"/audio/7/067009.mp3","segments":[[0,1,30,730],[1,2,740,1350],[2,3,1360,1770],[3,4,1780,4270],[4,5,4280,5780],[5,6,5790,7250],[6,7,7260,8280],[7,8,8290,8720],[8,9,8730,9480],[9,10,9490,10330],[10,11,10340,11510],[11,12,11520,12370],[12,13,12380,12780],[13,14,12790,14360],[14,15,14370,15100],[15,16,15110,15540],[16,17,15550,17200],[17,18,17210,19740]],"words":[{"position":1,"text":"قَالُواْ","translation":"They will say","transliteration":"qālū"},{"position":2,"text":"بَلَىٰ","translation":"Yes","transliteration":"balā"},{"position":3,"text":"قَدۡ","translation":"indeed","transliteration":"qad"},{"position":4,"text":"جَآءَنَا","translation":"came to us","transliteration":"jāanā"},{"position":5,"text":"نَذِيرٞ","translation":"a warner","transliteration":"nadhīrun"},{"position":6,"text":"فَكَذَّبۡنَا","translation":"but we denied","transliteration":"fakadhabnā"},{"position":7,"text":"وَقُلۡنَا","translation":"and we said","transliteration":"waqul'nā"},{"position":8,"text":"مَا","translation":"Not","transliteration":"mā"},{"position":9,"text":"نَزَّلَ","translation":"has sent down","transliteration":"nazzala"},{"position":10,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":11,"text":"مِن","translation":"any","transliteration":"min"},{"position":12,"text":"شَيۡءٍ","translation":"thing","transliteration":"shayin"},{"position":13,"text":"إِنۡ","translation":"Not","transliteration":"in"},{"position":14,"text":"أَنتُمۡ","translation":"you (are)","transliteration":"antum"},{"position":15,"text":"إِلَّا","translation":"but","transliteration":"illā"},{"position":16,"text":"فِي","translation":"in","transliteration":"fī"},{"position":17,"text":"ضَلَٰلٖ","translation":"error","transliteration":"ḍalālin"},{"position":18,"text":"كَبِيرٖ","translation":"great","transliteration":"kabīrin"}]},{"id":5251,"verseKey":"67:10","verseNumber":10,"arabic":"وَقَالُواْ لَوۡ كُنَّا نَسۡمَعُ أَوۡ نَعۡقِلُ مَا كُنَّا فِيٓ أَصۡحَٰبِ ٱلسَّعِيرِ","translation":"And they will say, \"If only we had been listening or reasoning, we would not be among the companions of the Blaze.\"","transliteration":"waqālū law kunnā nasmaʿu aw naʿqilu mā kunnā fī aṣḥābi l-saʿīri","audioUrl":"/audio/7/067010.mp3","segments":[[0,1,150,1070],[1,2,1080,1370],[2,3,1380,3260],[3,4,3270,4050],[4,5,4060,4430],[5,6,4440,5230],[6,7,5240,5560],[7,8,5570,7010],[8,9,7020,8840],[9,10,8850,9780],[10,11,9790,12190]],"words":[{"position":1,"text":"وَقَالُواْ","translation":"And they will say","transliteration":"waqālū"},{"position":2,"text":"لَوۡ","translation":"If","transliteration":"law"},{"position":3,"text":"كُنَّا","translation":"we had","transliteration":"kunnā"},{"position":4,"text":"نَسۡمَعُ","translation":"listened","transliteration":"nasmaʿu"},{"position":5,"text":"أَوۡ","translation":"or","transliteration":"aw"},{"position":6,"text":"نَعۡقِلُ","translation":"reasoned","transliteration":"naʿqilu"},{"position":7,"text":"مَا","translation":"not","transliteration":"mā"},{"position":8,"text":"كُنَّا","translation":"we (would) have been","transliteration":"kunnā"},{"position":9,"text":"فِيٓ","translation":"among","transliteration":"fī"},{"position":10,"text":"أَصۡحَٰبِ","translation":"(the) companions","transliteration":"aṣḥābi"},{"position":11,"text":"ٱلسَّعِيرِ","translation":"(of) the Blaze","transliteration":"l-saʿīri"}]},{"id":5252,"verseKey":"67:11","verseNumber":11,"arabic":"فَٱعۡتَرَفُواْ بِذَنۢبِهِمۡ فَسُحۡقٗا لِّأَصۡحَٰبِ ٱلسَّعِيرِ","translation":"And they will admit their sin, so [it is] alienation for the companions of the Blaze.","transliteration":"fa-iʿ'tarafū bidhanbihim fasuḥ'qan li-aṣḥābi l-saʿīri","audioUrl":"/audio/7/067011.mp3","segments":[[0,1,30,1220],[1,2,1230,3180],[2,3,3190,3940],[3,4,3950,5460],[4,5,5470,8200]],"words":[{"position":1,"text":"فَٱعۡتَرَفُواْ","translation":"Then they (will) confess","transliteration":"fa-iʿ'tarafū"},{"position":2,"text":"بِذَنۢبِهِمۡ","translation":"their sins","transliteration":"bidhanbihim"},{"position":3,"text":"فَسُحۡقٗا","translation":"so away with","transliteration":"fasuḥ'qan"},{"position":4,"text":"لِّأَصۡحَٰبِ","translation":"(the) companions","transliteration":"li-aṣḥābi"},{"position":5,"text":"ٱلسَّعِيرِ","translation":"(of) the Blaze","transliteration":"l-saʿīri"}]},{"id":5253,"verseKey":"67:12","verseNumber":12,"arabic":"إِنَّ ٱلَّذِينَ يَخۡشَوۡنَ رَبَّهُم بِٱلۡغَيۡبِ لَهُم مَّغۡفِرَةٞ وَأَجۡرٞ كَبِيرٞ","translation":"Indeed, those who fear their Lord unseen will have forgiveness and great reward.","transliteration":"inna alladhīna yakhshawna rabbahum bil-ghaybi lahum maghfiratun wa-ajrun kabīrun","audioUrl":"/audio/7/067012.mp3","segments":[[0,1,30,1240],[1,2,1250,2240],[2,3,2250,3230],[3,4,3240,4930],[4,5,4940,5940],[5,6,5950,7330],[6,7,7340,8320],[7,8,8330,10920],[8,9,10930,13430]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"text":"يَخۡشَوۡنَ","translation":"fear","transliteration":"yakhshawna"},{"position":4,"text":"رَبَّهُم","translation":"their Lord","transliteration":"rabbahum"},{"position":5,"text":"بِٱلۡغَيۡبِ","translation":"unseen","transliteration":"bil-ghaybi"},{"position":6,"text":"لَهُم","translation":"for them","transliteration":"lahum"},{"position":7,"text":"مَّغۡفِرَةٞ","translation":"(is) forgiveness","transliteration":"maghfiratun"},{"position":8,"text":"وَأَجۡرٞ","translation":"and a reward","transliteration":"wa-ajrun"},{"position":9,"text":"كَبِيرٞ","translation":"great","transliteration":"kabīrun"}]},{"id":5254,"verseKey":"67:13","verseNumber":13,"arabic":"وَأَسِرُّواْ قَوۡلَكُمۡ أَوِ ٱجۡهَرُواْ بِهِۦٓۖ إِنَّهُۥ عَلِيمُۢ بِذَاتِ ٱلصُّدُورِ","translation":"And conceal your speech or publicize it; indeed, He is Knowing of that within the breasts.","transliteration":"wa-asirrū qawlakum awi ij'harū bihi innahu ʿalīmun bidhāti l-ṣudūri","audioUrl":"/audio/7/067013.mp3","segments":[[0,1,50,1210],[1,2,1220,2230],[2,3,2240,2570],[3,4,2580,3410],[4,5,3420,5650],[5,6,5660,7210],[6,7,7220,9210],[7,8,9220,9970],[8,9,9980,12790]],"words":[{"position":1,"text":"وَأَسِرُّواْ","translation":"And conceal","transliteration":"wa-asirrū"},{"position":2,"text":"قَوۡلَكُمۡ","translation":"your speech","transliteration":"qawlakum"},{"position":3,"text":"أَوِ","translation":"or","transliteration":"awi"},{"position":4,"text":"ٱجۡهَرُواْ","translation":"proclaim","transliteration":"ij'harū"},{"position":5,"text":"بِهِۦٓۖ","translation":"it","transliteration":"bihi"},{"position":6,"text":"إِنَّهُۥ","translation":"Indeed, He","transliteration":"innahu"},{"position":7,"text":"عَلِيمُۢ","translation":"(is the) All-Knower","transliteration":"ʿalīmun"},{"position":8,"text":"بِذَاتِ","translation":"of what (is in)","transliteration":"bidhāti"},{"position":9,"text":"ٱلصُّدُورِ","translation":"the breasts","transliteration":"l-ṣudūri"}]},{"id":5255,"verseKey":"67:14","verseNumber":14,"arabic":"أَلَا يَعۡلَمُ مَنۡ خَلَقَ وَهُوَ ٱللَّطِيفُ ٱلۡخَبِيرُ","translation":"Does He who created not know, while He is the Subtle, the Aware?","transliteration":"alā yaʿlamu man khalaqa wahuwa l-laṭīfu l-khabīru","audioUrl":"/audio/7/067014.mp3","segments":[[0,1,70,570],[1,2,580,1490],[2,3,1500,1760],[3,4,1770,2500],[4,5,2510,3070],[5,6,3080,4120],[6,7,4130,6640]],"words":[{"position":1,"text":"أَلَا","translation":"Does not","transliteration":"alā"},{"position":2,"text":"يَعۡلَمُ","translation":"know","transliteration":"yaʿlamu"},{"position":3,"text":"مَنۡ","translation":"(the One) Who","transliteration":"man"},{"position":4,"text":"خَلَقَ","translation":"created","transliteration":"khalaqa"},{"position":5,"text":"وَهُوَ","translation":"And He","transliteration":"wahuwa"},{"position":6,"text":"ٱللَّطِيفُ","translation":"(is) the Subtle","transliteration":"l-laṭīfu"},{"position":7,"text":"ٱلۡخَبِيرُ","translation":"the All-Aware","transliteration":"l-khabīru"}]},{"id":5256,"verseKey":"67:15","verseNumber":15,"arabic":"هُوَ ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَرۡضَ ذَلُولٗا فَٱمۡشُواْ فِي مَنَاكِبِهَا وَكُلُواْ مِن رِّزۡقِهِۦۖ وَإِلَيۡهِ ٱلنُّشُورُ","translation":"It is He who made the earth tame for you - so walk among its slopes and eat of His provision - and to Him is the resurrection.","transliteration":"huwa alladhī jaʿala lakumu l-arḍa dhalūlan fa-im'shū fī manākibihā wakulū min riz'qihi wa-ilayhi l-nushūru","audioUrl":"/audio/7/067015.mp3","segments":[[0,1,40,350],[1,2,360,1160],[2,3,1170,1840],[3,4,1850,2380],[4,5,2390,3160],[5,6,3170,4700],[6,7,4710,5530],[7,8,5540,5960],[8,9,5970,7360],[9,10,7370,8220],[10,11,8230,8430],[11,12,8440,9940],[12,13,9950,10990],[13,14,11000,14540]],"words":[{"position":1,"text":"هُوَ","translation":"He","transliteration":"huwa"},{"position":2,"text":"ٱلَّذِي","translation":"(is) the One Who","transliteration":"alladhī"},{"position":3,"text":"جَعَلَ","translation":"made","transliteration":"jaʿala"},{"position":4,"text":"لَكُمُ","translation":"for you","transliteration":"lakumu"},{"position":5,"text":"ٱلۡأَرۡضَ","translation":"the earth","transliteration":"l-arḍa"},{"position":6,"text":"ذَلُولٗا","translation":"subservient","transliteration":"dhalūlan"},{"position":7,"text":"فَٱمۡشُواْ","translation":"so walk","transliteration":"fa-im'shū"},{"position":8,"text":"فِي","translation":"in","transliteration":"fī"},{"position":9,"text":"مَنَاكِبِهَا","translation":"(the) paths thereof","transliteration":"manākibihā"},{"position":10,"text":"وَكُلُواْ","translation":"and eat","transliteration":"wakulū"},{"position":11,"text":"مِن","translation":"of","transliteration":"min"},{"position":12,"text":"رِّزۡقِهِۦۖ","translation":"His provision","transliteration":"riz'qihi"},{"position":13,"text":"وَإِلَيۡهِ","translation":"and to Him","transliteration":"wa-ilayhi"},{"position":14,"text":"ٱلنُّشُورُ","translation":"(is) the Resurrection","transliteration":"l-nushūru"}]},{"id":5257,"verseKey":"67:16","verseNumber":16,"arabic":"ءَأَمِنتُم مَّن فِي ٱلسَّمَآءِ أَن يَخۡسِفَ بِكُمُ ٱلۡأَرۡضَ فَإِذَا هِيَ تَمُورُ","translation":"Do you feel secure that He who is above would not cause the earth to swallow you and suddenly it would sway?","transliteration":"a-amintum man fī l-samāi an yakhsifa bikumu l-arḍa fa-idhā hiya tamūru","audioUrl":"/audio/7/067016.mp3","segments":[[0,1,30,2600],[1,2,2610,3500],[2,3,3510,3740],[3,4,3750,6050],[4,5,6060,7130],[5,6,7140,7770],[6,7,7780,8380],[7,8,8390,9160],[8,9,9170,9970],[9,10,9980,10330],[10,11,10340,13030]],"words":[{"position":1,"text":"ءَأَمِنتُم","translation":"Do you feel secure","transliteration":"a-amintum"},{"position":2,"text":"مَّن","translation":"(from Him) Who","transliteration":"man"},{"position":3,"text":"فِي","translation":"(is) in","transliteration":"fī"},{"position":4,"text":"ٱلسَّمَآءِ","translation":"the heaven","transliteration":"l-samāi"},{"position":5,"text":"أَن","translation":"not","transliteration":"an"},{"position":6,"text":"يَخۡسِفَ","translation":"He will cause to swallow","transliteration":"yakhsifa"},{"position":7,"text":"بِكُمُ","translation":"you","transliteration":"bikumu"},{"position":8,"text":"ٱلۡأَرۡضَ","translation":"the earth","transliteration":"l-arḍa"},{"position":9,"text":"فَإِذَا","translation":"when","transliteration":"fa-idhā"},{"position":10,"text":"هِيَ","translation":"it","transliteration":"hiya"},{"position":11,"text":"تَمُورُ","translation":"sways","transliteration":"tamūru"}]},{"id":5258,"verseKey":"67:17","verseNumber":17,"arabic":"أَمۡ أَمِنتُم مَّن فِي ٱلسَّمَآءِ أَن يُرۡسِلَ عَلَيۡكُمۡ حَاصِبٗاۖ فَسَتَعۡلَمُونَ كَيۡفَ نَذِيرِ","translation":"Or do you feel secure that He who is above would not send against you a storm of stones? Then you would know how [severe] was My warning.","transliteration":"am amintum man fī l-samāi an yur'sila ʿalaykum ḥāṣiban fasataʿlamūna kayfa nadhīri","audioUrl":"/audio/7/067017.mp3","segments":[[0,1,40,360],[1,2,370,2880],[2,3,2890,3940],[3,4,3950,4170],[4,5,4180,6610],[5,6,6620,7550],[6,7,7560,8180],[7,8,8190,9210],[8,9,9220,11050],[9,10,11060,12600],[10,11,12610,13280],[11,12,13290,13720]],"words":[{"position":1,"text":"أَمۡ","translation":"Or","transliteration":"am"},{"position":2,"text":"أَمِنتُم","translation":"do you feel secure","transliteration":"amintum"},{"position":3,"text":"مَّن","translation":"(from Him) Who","transliteration":"man"},{"position":4,"text":"فِي","translation":"(is) in","transliteration":"fī"},{"position":5,"text":"ٱلسَّمَآءِ","translation":"the heaven","transliteration":"l-samāi"},{"position":6,"text":"أَن","translation":"that","transliteration":"an"},{"position":7,"text":"يُرۡسِلَ","translation":"He will send","transliteration":"yur'sila"},{"position":8,"text":"عَلَيۡكُمۡ","translation":"against you","transliteration":"ʿalaykum"},{"position":9,"text":"حَاصِبٗاۖ","translation":"a storm of stones","transliteration":"ḥāṣiban"},{"position":10,"text":"فَسَتَعۡلَمُونَ","translation":"Then you would know","transliteration":"fasataʿlamūna"},{"position":11,"text":"كَيۡفَ","translation":"how","transliteration":"kayfa"},{"position":12,"text":"نَذِيرِ","translation":"(was) My warning","transliteration":"nadhīri"}]},{"id":5259,"verseKey":"67:18","verseNumber":18,"arabic":"وَلَقَدۡ كَذَّبَ ٱلَّذِينَ مِن قَبۡلِهِمۡ فَكَيۡفَ كَانَ نَكِيرِ","translation":"And already had those before them denied, and how [terrible] was My reproach.","transliteration":"walaqad kadhaba alladhīna min qablihim fakayfa kāna nakīri","audioUrl":"/audio/7/067018.mp3","segments":[[0,1,40,770],[1,2,780,1570],[2,3,1580,2570],[3,4,2580,3660],[4,5,3670,4620],[5,6,4630,5460],[6,7,5470,5930],[7,8,5940,8590]],"words":[{"position":1,"text":"وَلَقَدۡ","translation":"And indeed","transliteration":"walaqad"},{"position":2,"text":"كَذَّبَ","translation":"denied","transliteration":"kadhaba"},{"position":3,"text":"ٱلَّذِينَ","translation":"those","transliteration":"alladhīna"},{"position":4,"text":"مِن","translation":"from","transliteration":"min"},{"position":5,"text":"قَبۡلِهِمۡ","translation":"before them","transliteration":"qablihim"},{"position":6,"text":"فَكَيۡفَ","translation":"and how","transliteration":"fakayfa"},{"position":7,"text":"كَانَ","translation":"was","transliteration":"kāna"},{"position":8,"text":"نَكِيرِ","translation":"My rejection","transliteration":"nakīri"}]},{"id":5260,"verseKey":"67:19","verseNumber":19,"arabic":"أَوَلَمۡ يَرَوۡاْ إِلَى ٱلطَّيۡرِ فَوۡقَهُمۡ صَٰٓفَّٰتٖ وَيَقۡبِضۡنَۚ مَا يُمۡسِكُهُنَّ إِلَّا ٱلرَّحۡمَٰنُۚ إِنَّهُۥ بِكُلِّ شَيۡءِۭ بَصِيرٌ","translation":"Do they not see the birds above them with wings outspread and [sometimes] folded in? None holds them [aloft] except the Most Merciful. Indeed He is, of all things, Seeing.","transliteration":"awalam yaraw ilā l-ṭayri fawqahum ṣāffātin wayaqbiḍ'na mā yum'sikuhunna illā l-raḥmānu innahu bikulli shayin baṣīrun","audioUrl":"/audio/7/067019.mp3","segments":[[0,1,100,770],[1,2,780,1400],[2,3,1410,1970],[3,4,1980,2530],[4,5,2540,3540],[5,6,3550,7980],[6,7,7990,10750],[7,8,10760,11090],[8,9,11100,13340],[9,10,13350,13900],[10,11,13910,17630],[11,12,17640,19290],[12,13,19300,20100],[13,14,20110,21660],[14,15,21670,24240]],"words":[{"position":1,"text":"أَوَلَمۡ","translation":"Do not","transliteration":"awalam"},{"position":2,"text":"يَرَوۡاْ","translation":"they see","transliteration":"yaraw"},{"position":3,"text":"إِلَى","translation":"[to]","transliteration":"ilā"},{"position":4,"text":"ٱلطَّيۡرِ","translation":"the birds","transliteration":"l-ṭayri"},{"position":5,"text":"فَوۡقَهُمۡ","translation":"above them","transliteration":"fawqahum"},{"position":6,"text":"صَٰٓفَّٰتٖ","translation":"spreading (their wings)","transliteration":"ṣāffātin"},{"position":7,"text":"وَيَقۡبِضۡنَۚ","translation":"and folding","transliteration":"wayaqbiḍ'na"},{"position":8,"text":"مَا","translation":"Not","transliteration":"mā"},{"position":9,"text":"يُمۡسِكُهُنَّ","translation":"holds them","transliteration":"yum'sikuhunna"},{"position":10,"text":"إِلَّا","translation":"except","transliteration":"illā"},{"position":11,"text":"ٱلرَّحۡمَٰنُۚ","translation":"the Most Gracious","transliteration":"l-raḥmānu"},{"position":12,"text":"إِنَّهُۥ","translation":"Indeed, He","transliteration":"innahu"},{"position":13,"text":"بِكُلِّ","translation":"(is) of every","transliteration":"bikulli"},{"position":14,"text":"شَيۡءِۭ","translation":"thing","transliteration":"shayin"},{"position":15,"text":"بَصِيرٌ","translation":"All-Seer","transliteration":"baṣīrun"}]},{"id":5261,"verseKey":"67:20","verseNumber":20,"arabic":"أَمَّنۡ هَٰذَا ٱلَّذِي هُوَ جُندٞ لَّكُمۡ يَنصُرُكُم مِّن دُونِ ٱلرَّحۡمَٰنِۚ إِنِ ٱلۡكَٰفِرُونَ إِلَّا فِي غُرُورٍ","translation":"Or who is it that could be an army for you to aid you other than the Most Merciful? The disbelievers are not but in delusion.","transliteration":"amman hādhā alladhī huwa jundun lakum yanṣurukum min dūni l-raḥmāni ini l-kāfirūna illā fī ghurūrin","audioUrl":"/audio/7/067020.mp3","segments":[[0,1,150,1450],[1,2,1460,2090],[2,3,2100,2940],[3,4,2950,3310],[4,5,3320,4900],[5,6,4910,5520],[6,7,5530,8410],[7,8,8420,9340],[8,9,9350,9870],[9,10,9880,13610],[10,11,13620,13970],[11,12,13980,15400],[12,13,15410,16190],[13,14,16200,16570],[14,15,16580,19260]],"words":[{"position":1,"text":"أَمَّنۡ","translation":"Who is","transliteration":"amman"},{"position":2,"text":"هَٰذَا","translation":"this","transliteration":"hādhā"},{"position":3,"text":"ٱلَّذِي","translation":"the one","transliteration":"alladhī"},{"position":4,"text":"هُوَ","translation":"he","transliteration":"huwa"},{"position":5,"text":"جُندٞ","translation":"(is) an army","transliteration":"jundun"},{"position":6,"text":"لَّكُمۡ","translation":"for you","transliteration":"lakum"},{"position":7,"text":"يَنصُرُكُم","translation":"to help you","transliteration":"yanṣurukum"},{"position":8,"text":"مِّن","translation":"from","transliteration":"min"},{"position":9,"text":"دُونِ","translation":"besides","transliteration":"dūni"},{"position":10,"text":"ٱلرَّحۡمَٰنِۚ","translation":"the Most Gracious","transliteration":"l-raḥmāni"},{"position":11,"text":"إِنِ","translation":"Not","transliteration":"ini"},{"position":12,"text":"ٱلۡكَٰفِرُونَ","translation":"(are) the disbelievers","transliteration":"l-kāfirūna"},{"position":13,"text":"إِلَّا","translation":"but","transliteration":"illā"},{"position":14,"text":"فِي","translation":"in","transliteration":"fī"},{"position":15,"text":"غُرُورٍ","transl