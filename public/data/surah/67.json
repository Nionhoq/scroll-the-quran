in","transliteration":"fī"},{"position":6,"text":"ٱلۡأَرۡضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":7,"text":"وَإِلَيۡهِ","translation":"and to Him","transliteration":"wa-ilayhi"},{"position":8,"text":"تُحۡشَرُونَ","translation":"you will be gathered","transliteration":"tuḥ'sharūna"}]},{"id":5266,"verseKey":"67:25","verseNumber":25,"arabic":"وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلۡوَعۡدُ إِن كُنتُمۡ صَٰدِقِينَ","translation":"And they say, \"When is this promise, if you should be truthful?\"","transliteration":"wayaqūlūna matā hādhā l-waʿdu in kuntum ṣādiqīna","audioUrl":"/audio/7/067025.mp3","segments":[[0,1,30,1420],[1,2,1430,2020],[2,3,2030,2600],[3,4,2610,3420],[4,5,3430,4360],[5,6,4370,5930],[6,7,5940,8970]],"words":[{"position":1,"text":"وَيَقُولُونَ","translation":"And they say","transliteration":"wayaqūlūna"},{"position":2,"text":"مَتَىٰ","translation":"When","transliteration":"matā"},{"position":3,"text":"هَٰذَا","translation":"(is) this","transliteration":"hādhā"},{"position":4,"text":"ٱلۡوَعۡدُ","translation":"promise","transliteration":"l-waʿdu"},{"position":5,"text":"إِن","translation":"if","transliteration":"in"},{"position":6,"text":"كُنتُمۡ","translation":"you are","transliteration":"kuntum"},{"position":7,"text":"صَٰدِقِينَ","translation":"truthful","transliteration":"ṣādiqīna"}]},{"id":5267,"verseKey":"67:26","verseNumber":26,"arabic":"قُلۡ إِنَّمَا ٱلۡعِلۡمُ عِندَ ٱللَّهِ وَإِنَّمَآ أَنَا۠ نَذِيرٞ مُّبِينٞ","translation":"Say, \"The knowledge is only with Allāh, and I am only a clear warner.\"","transliteration":"qul innamā l-ʿil'mu ʿinda l-lahi wa-innamā anā nadhīrun mubīnun","audioUrl":"/audio/7/067026.mp3","segments":[[0,1,50,380],[1,2,390,2070],[2,3,2080,2810],[3,4,2820,3940],[4,5,3950,4740],[5,6,4750,8360],[6,7,8370,8780],[7,8,8790,10530],[8,9,10540,12770]],"words":[{"position":1,"text":"قُلۡ","translation":"Say","transliteration":"qul"},{"position":2,"text":"إِنَّمَا","translation":"Only","transliteration":"innamā"},{"posit