ation":"and it will be said","transliteration":"waqīla"},{"position":9,"text":"هَٰذَا","translation":"This","transliteration":"hādhā"},{"position":10,"text":"ٱلَّذِي","translation":"(is) that which","transliteration":"alladhī"},{"position":11,"text":"كُنتُم","translation":"you used to","transliteration":"kuntum"},{"position":12,"text":"بِهِۦ","translation":"for it","transliteration":"bihi"},{"position":13,"text":"تَدَّعُونَ","translation":"call","transliteration":"taddaʿūna"}]},{"id":5269,"verseKey":"67:28","verseNumber":28,"arabic":"قُلۡ أَرَءَيۡتُمۡ إِنۡ أَهۡلَكَنِيَ ٱللَّهُ وَمَن مَّعِيَ أَوۡ رَحِمَنَا فَمَن يُجِيرُ ٱلۡكَٰفِرِينَ مِنۡ عَذَابٍ أَلِيمٖ","translation":"Say, [O Muḥammad], \"Have you considered: whether Allāh should cause my death and those with me or have mercy upon us, who can protect the disbelievers from a painful punishment?\"","transliteration":"qul ara-aytum in ahlakaniya l-lahu waman maʿiya aw raḥimanā faman yujīru l-kāfirīna min ʿadhābin alīmin","audioUrl":"/audio/7/067028.mp3","segments":[[0,1,30,350],[1,2,360,1510],[2,3,1520,1860],[3,4,1870,3050],[4,5,3060,3810],[5,6,3820,5180],[6,7,5190,5720],[7,8,5730,6090],[8,9,6100,7020],[9,10,7030,8390],[10,11,8400,9100],[11,12,9110,15740],[12,13,15750,16100],[13,14,16110,17220],[14,15,17230,19630]],"words":[{"position":1,"text":"قُلۡ","translation":"Say","transliteration":"qul"},{"position":2,"text":"أَرَءَيۡتُمۡ","translation":"Have you seen","transliteration":"ara-aytum"},{"position":3,"text":"إِنۡ","translation":"if","transliteration":"in"},{"position":4,"text":"أَهۡلَكَنِيَ","translation":"destroys me","transliteration":"ahlakaniya"},{"position":5,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":6,"text":"وَمَن","translation":"and whoever","transliteration":"waman"},{"position":7,"text":"مَّعِيَ","translation":"(is) with me","transliteration":"maʿiya"},{"position":8,"text":"أَوۡ","translation":"or","transliteration":"aw"},{"position":9,"text":"رَحِمَنَا","translation":"has mercy upon us","transliteration":"raḥimanā"},{"position":10,"text":"فَمَن","translation":"then who","transliteration":"faman"},{"position":11,"text":"يُجِيرُ","translation":"(can) protect","transliteration":"yujīru"},{"position":12,"text":"ٱلۡكَٰفِرِينَ","translation":"the disbelievers","transliteration":"l-kāfirīna"},{"position":13,"text":"مِنۡ","translation":"from","transliteration":"min"},{"position":14,"text":"عَذَابٍ","translation":"a punishment","transliteration":"ʿadhābin"},{"position":15,"text":"أَلِيمٖ","translation":"painful","transliteration":"alīmin"}]},{"id":5270,"verseKey":"67:29","verseNumber":29,"arabic":"قُلۡ هُوَ ٱلرَّحۡمَٰنُ ءَامَنَّا بِهِۦ وَعَلَيۡهِ تَوَكَّلۡنَاۖ فَسَتَعۡلَمُونَ مَنۡ هُوَ فِي ضَلَٰلٖ مُّبِينٖ","translation":"Say, \"He is the Most Merciful; we have believed in Him, and upon Him we have relied. And you will [come to] know who it is that is in clear error.\"","transliteration":"qul huwa l-raḥmānu āmannā bihi waʿalayhi tawakkalnā fasataʿlamūna man huwa fī ḍalālin mubīnin","audioUrl":"/audio/7/067029.mp3","segments":[[0,1,50,400],[1,2,410,760],[2,3,770,2020],[3,4,2030,3890],[4,5,3900,4550],[5,6,4560,5480],[6,7,5490,7530],[7,8,7540,9110],[8,9,9120,9480],[9,10,9490,9860],[10,11,9870,10290],[11,12,10300,11950],[12,13,11960,14590]],"words":[{"position":1,"text":"قُلۡ","translation":"Say","transliteration":"qul"},{"position":2,"text":"هُوَ","translation":"He","transliteration":"huwa"},{"position":3,"text":"ٱلرَّحۡمَٰنُ","translation":"(is) the Most Gracious","transliteration":"l-raḥmānu"},{"position":4,"text":"ءَامَنَّا","translation":"we believe","transliteration":"āmannā"},{"position":5,"text":"بِهِۦ","translation":"in Him","transliteration":"bihi"},{"position":6,"text":"وَعَلَيۡهِ","translation":"and upon Him","transliteration":"waʿalayhi"},{"position":7,"text":"تَوَكَّلۡنَاۖ","translation":"we put (our) trust","transliteration":"tawakkalnā"},{"position":8,"text":"فَسَتَعۡلَمُونَ","translation":"So you will know","transliteration":"fasataʿlamūna"},{"position":9,"text":"مَنۡ","translation":"who","transliteration":"man"},{"position":10,"text":"هُوَ","translation":"(is) it","transliteration":"huwa"},{"position":11,"text":"فِي","translation":"(that is) in","transliteration":"fī"},{"position":12,"text":"ضَلَٰلٖ","translation":"error","transliteration":"ḍalālin"},{"position":13,"text":"مُّبِينٖ","translation":"clear","transliteration":"mubīnin"}]},{"id":5271,"verseKey":"67:30","verseNumber":30,"arabic":"قُلۡ أَرَءَيۡتُمۡ إِنۡ أَصۡبَحَ مَآؤُكُمۡ غَوۡرٗا فَمَن يَأۡتِيكُم بِمَآءٖ مَّعِينِۭ","translation":"Say, \"Have you considered: if your water was to become sunken [into the earth], then who could bring you flowing water?\"","transliteration":"qul ara-aytum in aṣbaḥa māukum ghawran faman yatīkum bimāin maʿīnin","audioUrl":"/audio/7/067030.mp3","segments":[[0,1,30,350],[1,2,360,1500],[2,3,1510,1870],[3,4,1880,2670],[4,5,2680,5350],[5,6,5360,6700],[6,7,6710,8210],[7,8,8220,9960],[8,9,9970,12630],[9,10,12640,16070]],"words":[{"position":1,"text":"قُلۡ","translation":"Say","transliteration":"qul"},{"position":2,"text":"أَرَءَيۡتُمۡ","translation":"Have you seen","transliteration":"ara-aytum"},{"position":3,"text":"إِنۡ","translation":"if","transliteration":"in"},{"position":4,"text":"أَصۡبَحَ","translation":"becomes","transliteration":"aṣbaḥa"},{"position":5,"text":"مَآؤُكُمۡ","translation":"your water","transliteration":"māukum"},{"position":6,"text":"غَوۡرٗا","translation":"sunken","transliteration":"ghawran"},{"position":7,"text":"فَمَن","translation":"then who","transliteration":"faman"},{"position":8,"text":"يَأۡتِيكُم","translation":"could bring you","transliteration":"yatīkum"},{"position":9,"text":"بِمَآءٖ","translation":"water","transliteration":"bimāin"},{"position":10,"text":"مَّعِينِۭ","translation":"flowing","transliteration":"maʿīnin"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
