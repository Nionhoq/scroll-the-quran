er":5,"arabic":"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ","translation":"Peace it is until the emergence of dawn.","transliteration":"salāmun hiya ḥattā maṭlaʿi l-fajri","audioUrl":"/audio/7/097005.mp3","segments":[[0,1,200,1080],[1,2,1090,1530],[2,3,1540,2420],[3,4,2430,3380],[4,5,3390,4050]],"words":[{"position":1,"text":"سَلَٰمٌ","translation":"Peace","transliteration":"salāmun"},{"position":2,"text":"هِيَ","translation":"it (is)","transliteration":"hiya"},{"position":3,"text":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":4,"text":"مَطۡلَعِ","translation":"(the) emergence","transliteration":"maṭlaʿi"},{"position":5,"text":"ٱلۡفَجۡرِ","translation":"(of) the dawn","transliteration":"l-fajri"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
