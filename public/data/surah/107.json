{"chapter":{"id":107,"nameSimple":"Al-Ma'un","nameArabic":"الماعون","translatedName":"The Small kindnesses","versesCount":7,"revelationPlace":"makkah"},"verses":[{"id":6198,"verseKey":"107:1","verseNumber":1,"arabic":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","translation":"Have you seen the one who denies the Recompense?","transliteration":"ara-ayta alladhī yukadhibu bil-dīni","audioUrl":"/audio/7/107001.mp3","segments":[[0,1,150,1020],[1,2,1030,1810],[2,3,1820,2930],[3,4,2940,5710]],"words":[{"position":1,"text":"أَرَءَيْتَ","translation":"Have you seen","transliteration":"ara-ayta"},{"position":2,"text":"ٱلَّذِى","translation":"the one who","transliteration":"alladhī"},{"position":3,"text":"يُكَذِّبُ","translation":"denies","transliteration":"yukadhibu"},{"position":4,"text":"بِٱلدِّينِ","translation":"the Judgment","transliteration":"bil-dīni"}]},{"id":6199,"verseKey":"107:2","verseNumber":2,"arabic":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","translation":"For that is the one who drives away the orphan","transliteration":"fadhālika alladhī yaduʿʿu l-yatīma","audioUrl":"/audio/7/107002.mp3","segments":[[0,1,30,1060],[1,2,1070,1920],[2,3,1930,2760],[3,4,2770,5890]],"words":[{"position":1,"text":"فَذَٰلِكَ","translation":"Then that","transliteration":"fadhālika"},{"position":2,"text":"ٱلَّذِى","translation":"(is) the one who","transliteration":"alladhī"},{"position":3,"text":"يَدُعُّ","translation":"repulses","transliteration":"yaduʿʿu"},{"position":4,"text":"ٱلْيَتِيمَ","translation":"the orphan","transliteration":"l-yatīma"}]},{"id":6200,"verseKey":"107:3","verseNumber":3,"arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translation":"And does not encourage the feeding of the poor.","transliteration":"walā yaḥuḍḍu ʿalā ṭaʿāmi l-mis'kīni","audioUrl":"/audio/7/107003.mp3","segments":[[0,1,150,710],[1,2,720,1560],[2,3,1570,2200],[3,4,2210,3140],[4,5,3150,6570]],"words":[{"position":1,"text":"وَلَا","translation":"And (does) not","transliteration":"walā"},{"position