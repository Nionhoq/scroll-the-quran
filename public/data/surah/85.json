,"transliteration":"mā"},{"position":4,"text":"يَفۡعَلُونَ","translation":"they were doing","transliteration":"yafʿalūna"},{"position":5,"text":"بِٱلۡمُؤۡمِنِينَ","translation":"to the believers","transliteration":"bil-mu'minīna"},{"position":6,"text":"شُهُودٞ","translation":"witnesses","transliteration":"shuhūdun"}]},{"id":5917,"verseKey":"85:8","verseNumber":8,"arabic":"وَمَا نَقَمُواْ مِنۡهُمۡ إِلَّآ أَن يُؤۡمِنُواْ بِٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ","translation":"And they resented them not except because they believed in Allāh, the Exalted in Might, the Praiseworthy,","transliteration":"wamā naqamū min'hum illā an yu'minū bil-lahi l-ʿazīzi l-ḥamīdi","audioUrl":"/audio/7/085008.mp3","segments":[[0,1,30,610],[1,2,620,1420],[2,3,1430,2210],[3,4,2220,4480],[4,5,4490,5800],[5,6,5810,6690],[6,7,6700,7780],[7,8,7790,8880],[8,9,8890,11800]],"words":[{"position":1,"text":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"text":"نَقَمُواْ","translation":"they resented","transliteration":"naqamū"},{"position":3,"text":"مِنۡهُمۡ","translation":"[of] them","transliteration":"min'hum"},{"position":4,"text":"إِلَّآ","translation":"except","transliteration":"illā"},{"position":5,"text":"أَن","translation":"that","transliteration":"an"},{"position":6,"text":"يُؤۡمِنُواْ","translation":"they believed","transliteration":"yu'minū"},{"position":7,"text":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":8,"text":"ٱلۡعَزِيزِ","translation":"the All-Mighty","transliteration":"l-ʿazīzi"},{"position":9,"text":"ٱلۡحَمِيدِ","translation":"the Praiseworthy","transliteration":"l-ḥamīdi"}]},{"id":5918,"verseKey":"85:9","verseNumber":9,"arabic":"ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٌ","translation":"To whom belongs the dominion of the heavens and the earth. And Allāh, over all things, is Witness.","transliteration":"alladhī lahu mul'ku l-samāwāti wal-arḍi wal-lahu ʿalā kulli shayin shahīdun","audioUrl":"/audio/7/085009.mp3","segments":[[0,1,30,960],[1,2,970,1550],[2,3,1560,2230],[3,4,2240,3730],[4,5,3740,5160],[5,6,5170,6150],[6,7,6160,6800],[7,8,6810,7430],[8,9,7440,9580],[9,10,9590,12730]],"words":[{"position":1,"text":"ٱلَّذِي","translation":"The One Who","transliteration":"alladhī"},{"position":2,"text":"لَهُۥ","translation":"for Him","transliteration":"lahu"},{"position":3,"text":"مُلۡكُ","translation":"(is) the dominion","transliteration":"mul'ku"},{"position":4,"text":"ٱلسَّمَٰوَٰتِ","translation":"(of) the heavens","transliteration":"l-samāwāti"},{"position":5,"text":"وَٱلۡأَرۡضِۚ","translation":"and the earth","transliteration":"wal-arḍi"},{"position":6,"text":"وَٱللَّهُ","translation":"and Allah","transliteration":"wal-lahu"},{"position":7,"text":"عَلَىٰ","translation":"on","transliteration":"ʿalā"},{"position":8,"text":"كُلِّ","translation":"every","transliteration":"kulli"},{"position":9,"text":"شَيۡءٖ","translation":"thing","transliteration":"shayin"},{"position":10,"text":"شَهِيدٌ","translation":"(is) a Witness","transliteration":"shahīdun"}]},{"id":5919,"verseKey":"85:10","verseNumber":10,"arabic":"إِنَّ ٱلَّذِينَ فَتَنُواْ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ ثُمَّ لَمۡ يَتُوبُواْ فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ ٱلۡحَرِيقِ","translation":"Indeed, those who have tortured the believing men and believing women and then have not repented will have the punishment of Hell, and they will have the punishment of the Burning Fire.","transliteration":"inna alladhīna fatanū l-mu'minīna wal-mu'mināti thumma lam yatūbū falahum ʿadhābu jahannama walahum ʿadhābu l-ḥarīqi","audioUrl":"/audio/7/085010.mp3","segments":[[0,1,30,1340],[1,2,1350,2340],[2,3,2350,2960],[3,4,2970,4390],[4,5,4400,6000],[5,6,6010,7480],[6,7,7490,7830],[7,8,7840,8850],[8,9,8860,9650],[9,10,9660,10530],[10,11,10540,12250],[11,12,12260,13030],[12,13,13040,13950],[13,14,13960,17180]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":