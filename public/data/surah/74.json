],[8,9,7590,8210]],"words":[{"position":1,"text":"بَلْ","translation":"Nay","transliteration":"bal"},{"position":2,"text":"يُرِيدُ","translation":"Desires","transliteration":"yurīdu"},{"position":3,"text":"كُلُّ","translation":"every","transliteration":"kullu"},{"position":4,"text":"ٱمْرِئٍۢ","translation":"person","transliteration":"im'ri-in"},{"position":5,"text":"مِّنْهُمْ","translation":"of them","transliteration":"min'hum"},{"position":6,"text":"أَن","translation":"that","transliteration":"an"},{"position":7,"text":"يُؤْتَىٰ","translation":"he may be given","transliteration":"yu'tā"},{"position":8,"text":"صُحُفًۭا","translation":"pages","transliteration":"ṣuḥufan"},{"position":9,"text":"مُّنَشَّرَةًۭ","translation":"spread out","transliteration":"munasharatan"}]},{"id":5548,"verseKey":"74:53","verseNumber":53,"arabic":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْـَٔاخِرَةَ","translation":"No! But they do not fear the Hereafter.","transliteration":"kallā bal lā yakhāfūna l-ākhirata","audioUrl":"/audio/7/074053.mp3","segments":[[0,1,30,1330],[1,2,1340,1770],[2,3,1780,2090],[3,4,2100,3280],[4,5,3290,4350]],"words":[{"position":1,"text":"كَلَّا ۖ","translation":"Nay","transliteration":"kallā"},{"position":2,"text":"بَل","translation":"But","transliteration":"bal"},{"position":3,"text":"لَّا","translation":"not","transliteration":"lā"},{"position":4,"text":"يَخَافُونَ","translation":"they fear","transliteration":"yakhāfūna"},{"position":5,"text":"ٱلْـَٔاخِرَةَ","translation":"the Hereafter","transliteration":"l-ākhirata"}]},{"id":5549,"verseKey":"74:54","verseNumber":54,"arabic":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌ","translation":"No! Indeed, it [i.e., the Qur’ān] is a reminder.","transliteration":"kallā innahu tadhkiratun","audioUrl":"/audio/7/074054.mp3","segments":[[0,1,30,1030],[1,2,1040,3500],[2,3,3510,4470]],"words":[{"position":1,"text":"كَلَّآ","translation":"Nay","transliteration":"kallā"},{"position":2,"text":"إِنَّهُۥ","translation":"Indeed, it","transliteration":"innahu"},{"position":3,"text":"تَذْكِرَةٌۭ","translation":"(is) a Reminder","transliteration":"tadhkiratun"}]},{"id":5550,"verseKey":"74:55","verseNumber":55,"arabic":"فَمَن شَآءَ ذَكَرَهُۥ","translation":"Then whoever wills will remember it.","transliteration":"faman shāa dhakarahu","audioUrl":"/audio/7/074055.mp3","segments":[[0,1,30,1120],[1,2,1130,3270],[2,3,3280,3930]],"words":[{"position":1,"text":"فَمَن","translation":"So whoever","transliteration":"faman"},{"position":2,"text":"شَآءَ","translation":"wills","transliteration":"shāa"},{"position":3,"text":"ذَكَرَهُۥ","translation":"(may) pay heed to it","transliteration":"dhakarahu"}]},{"id":5551,"verseKey":"74:56","verseNumber":56,"arabic":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ","translation":"And they will not remember except that Allāh wills. He is worthy of fear and adequate for [granting] forgiveness.","transliteration":"wamā yadhkurūna illā an yashāa l-lahu huwa ahlu l-taqwā wa-ahlu l-maghfirati","audioUrl":"/audio/7/074056.mp3","segments":[[0,1,30,530],[1,2,540,1750],[2,3,1760,3900],[3,4,3910,4940],[4,5,4950,6800],[5,6,6810,10390],[6,7,10400,10770],[7,8,10780,11350],[8,9,11360,12520],[9,10,12530,13380],[10,11,13390,14660]],"words":[{"position":1,"text":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"text":"يَذْكُرُونَ","translation":"will pay heed","transliteration":"yadhkurūna"},{"position":3,"text":"إِلَّآ","translation":"except","transliteration":"illā"},{"position":4,"text":"أَن","translation":"that","transliteration":"an"},{"position":5,"text":"يَشَآءَ","translation":"wills","transliteration":"yashāa"},{"position":6,"text":"ٱللَّهُ ۚ","translation":"Allah","transliteration":"l-lahu"},{"position":7,"text":"هُوَ","translation":"He","transliteration":"huwa"},{"position":8,"text":"أَهْلُ","translation":"(is) worthy","transliteration":"ahlu"},{"position":9,"text":"ٱلتَّقْوَىٰ","translation":"to be feared","transliteration":"l-t