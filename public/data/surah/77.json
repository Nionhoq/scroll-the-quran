oe, that Day, to the deniers.","transliteration":"waylun yawma-idhin lil'mukadhibīna","audioUrl":"/audio/7/077028.mp3","segments":[[0,1,30,1370],[1,2,1380,2440],[2,3,2450,5550]],"words":[{"position":1,"text":"وَيْلٌۭ","translation":"Woe","transliteration":"waylun"},{"position":2,"text":"يَوْمَئِذٍۢ","translation":"that Day","transliteration":"yawma-idhin"},{"position":3,"text":"لِّلْمُكَذِّبِينَ","translation":"to the deniers","transliteration":"lil'mukadhibīna"}]},{"id":5651,"verseKey":"77:29","verseNumber":29,"arabic":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","translation":"[They will be told], \"Proceed to that which you used to deny.","transliteration":"inṭaliqū ilā mā kuntum bihi tukadhibūna","audioUrl":"/audio/7/077029.mp3","segments":[[0,1,270,3740],[1,2,3750,4300],[2,3,4310,4640],[3,4,4650,6940],[4,5,6950,7550],[5,6,7560,10660]],"words":[{"position":1,"text":"ٱنطَلِقُوٓا۟","translation":"Proceed","transliteration":"inṭaliqū"},{"position":2,"text":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":3,"text":"مَا","translation":"what","transliteration":"mā"},{"position":4,"text":"كُنتُم","translation":"you used to","transliteration":"kuntum"},{"position":5,"text":"بِهِۦ","translation":"in it","transliteration":"bihi"},{"position":6,"text":"تُكَذِّبُونَ","translation":"deny","transliteration":"tukadhibūna"}]},{"id":5652,"verseKey":"77:30","verseNumber":30,"arabic":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ","translation":"Proceed to a shadow [of smoke] having three columns.","transliteration":"inṭaliqū ilā ẓillin dhī thalāthi shuʿabin","audioUrl":"/audio/7/077030.mp3","segments":[[0,1,30,3780],[1,2,3790,4380],[2,3,4390,5860],[3,4,5870,6240],[4,5,6250,7080],[5,6,7090,7660]],"words":[{"position":1,"text":"ٱنطَلِقُوٓا۟","translation":"Proceed","transliteration":"inṭaliqū"},{"position":2,"text":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":3,"text":"ظِلٍّۢ","translation":"a shadow","transliteration":"ẓillin"},{"position