id":5773,"verseKey":"80:15","verseNumber":15,"arabic":"بِأَيْدِى سَفَرَةٍ","translation":"[Carried] by the hands of messenger-angels,","transliteration":"bi-aydī safaratin","audioUrl":"/audio/7/080015.mp3","segments":[[0,1,30,980],[1,2,990,1790]],"words":[{"position":1,"text":"بِأَيْدِى","translation":"In (the) hands","transliteration":"bi-aydī"},{"position":2,"text":"سَفَرَةٍۢ","translation":"(of) scribes","transliteration":"safaratin"}]},{"id":5774,"verseKey":"80:16","verseNumber":16,"arabic":"كِرَامٍۭ بَرَرَةٍ","translation":"Noble and dutiful.","transliteration":"kirāmin bararatin","audioUrl":"/audio/7/080016.mp3","segments":[[0,1,30,1070],[1,2,1080,2874]],"words":[{"position":1,"text":"كِرَامٍۭ","translation":"Noble","transliteration":"kirāmin"},{"position":2,"text":"بَرَرَةٍۢ","translation":"dutiful","transliteration":"bararatin"}]},{"id":5775,"verseKey":"80:17","verseNumber":17,"arabic":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","translation":"Destroyed [i.e., cursed] is man; how disbelieving is he.","transliteration":"qutila l-insānu mā akfarahu","audioUrl":"/audio/7/080017.mp3","segments":[[0,1,30,560],[1,2,570,2750],[2,3,2760,4440],[3,4,4450,5370]],"words":[{"position":1,"text":"قُتِلَ","translation":"Is destroyed","transliteration":"qutila"},{"position":2,"text":"ٱلْإِنسَـٰنُ","translation":"[the] man","transliteration":"l-insānu"},{"position":3,"text":"مَآ","translation":"how","transliteration":"mā"},{"position":4,"text":"أَكْفَرَهُۥ","translation":"ungrateful is he","transliteration":"akfarahu"}]},{"id":5776,"verseKey":"80:18","verseNumber":18,"arabic":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","translation":"From what thing [i.e., substance] did He create him?","transliteration":"min ayyi shayin khalaqahu","audioUrl":"/audio/7/080018.mp3","segments":[[0,1,50,360],[1,2,370,1020],[2,3,1030,1890],[3,4,1900,2740]],"words":[{"position":1,"text":"مِنْ","translation":"From","transliteration":"min"},{"position":2,"text":"أَىِّ","translation":"what","transliteration":"ayyi"},{