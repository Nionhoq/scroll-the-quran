{"chapter":{"id":80,"nameSimple":"'Abasa","nameArabic":"عبس","translatedName":"He Frowned","versesCount":42,"revelationPlace":"makkah"},"verses":[{"id":5759,"verseKey":"80:1","verseNumber":1,"arabic":" عَبَسَ وَتَوَلَّىٰٓ","translation":"He [i.e., the Prophet (ﷺ) ] frowned and turned away","transliteration":"ʿabasa watawallā","audioUrl":"/audio/7/080001.mp3","segments":[[0,1,30,700],[1,2,710,2320]],"words":[{"position":1,"text":"عَبَسَ","translation":"He frowned","transliteration":"ʿabasa"},{"position":2,"text":"وَتَوَلَّىٰٓ","translation":"and turned away","transliteration":"watawallā"}]},{"id":5760,"verseKey":"80:2","verseNumber":2,"arabic":"أَن جَآءَهُ ٱلْأَعْمَىٰ","translation":"Because there came to him the blind man, [interrupting].","transliteration":"an jāahu l-aʿmā","audioUrl":"/audio/7/080002.mp3","segments":[[0,1,30,1260],[1,2,1270,3490],[2,3,3500,4620]],"words":[{"position":1,"text":"أَن","translation":"Because","transliteration":"an"},{"position":2,"text":"جَآءَهُ","translation":"came to him","transliteration":"jāahu"},{"position":3,"text":"ٱلْأَعْمَىٰ","translation":"the blind man","transliteration":"l-aʿmā"}]},{"id":5761,"verseKey":"80:3","verseNumber":3,"arabic":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","translation":"But what would make you perceive, [O Muḥammad], that perhaps he might be purified","transliteration":"wamā yud'rīka laʿallahu yazzakkā","audioUrl":"/audio/7/080003.mp3","segments":[[0,1,30,640],[1,2,650,1700],[2,3,1710,2970],[3,4,2980,4630]],"words":[{"position":1,"text":"وَمَا","translation":"But what","transliteration":"wamā"},{"position":2,"text":"يُدْرِيكَ","translation":"would make you know","transliteration":"yud'rīka"},{"position":3,"text":"لَعَلَّهُۥ","translation":"that he might","transliteration":"laʿallahu"},{"position":4,"text":"يَزَّكَّىٰٓ","translation":"purify himself","transliteration":"yazzakkā"}]},{"id":5762,"verseKey":"80:4","verseNumber":4,"arabic":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","translation":"Or be reminded and the remembrance would benefit him?","transliteration":"aw yadhakkaru fatanfaʿahu l-dhik'rā","audioUrl":"/audio/7/080004.mp3","segments":[[0,1,30,400],[1,2,410,1610],[2,3,1620,3510],[3,4,3520,4800]],"words":[{"position":1,"text":"أَوْ","translation":"Or","transliteration":"aw"},{"position":2,"text":"يَذَّكَّرُ","translation":"be reminded","transliteration":"yadhakkaru"},{"position":3,"text":"فَتَنفَعَهُ","translation":"so would benefit him","transliteration":"fatanfaʿahu"},{"position":4,"text":"ٱلذِّكْرَىٰٓ","translation":"the reminder","transliteration":"l-dhik'rā"}]},{"id":5763,"verseKey":"80:5","verseNumber":5,"arabic":"أَمَّا مَنِ ٱسْتَغْنَىٰ","translation":"As for he who thinks himself without need,","transliteration":"ammā mani is'taghnā","audioUrl":"/audio/7/080005.mp3","segments":[[0,1,30,1420],[1,2,1430,1760],[2,3,1770,3090]],"words":[{"position":1,"text":"أَمَّا","translation":"As for","transliteration":"ammā"},{"position":2,"text":"مَنِ","translation":"(him) who","transliteration":"mani"},{"position":3,"text":"ٱسْتَغْنَىٰ","translation":"considers himself free from need","transliteration":"is'taghnā"}]},{"id":5764,"verseKey":"80:6","verseNumber":6,"arabic":"فَأَنتَ لَهُۥ تَصَدَّىٰ","translation":"To him you give attention.","transliteration":"fa-anta lahu taṣaddā","audioUrl":"/audio/7/080006.mp3","segments":[[0,1,30,1470],[1,2,1480,2060],[2,3,2070,3490]],"words":[{"position":1,"text":"فَأَنتَ","translation":"So you","transliteration":"fa-anta"},{"position":2,"text":"لَهُۥ","translation":"to him","transliteration":"lahu"},{"position":3,"text":"تَصَدَّىٰ","translation":"give attention","transliteration":"taṣaddā"}]},{"id":5765,"verseKey":"80:7","verseNumber":7,"arabic":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","translation":"And not upon you [is any blame] if he will not be purified.","transliteration":"wamā ʿalayka allā yazzakkā","audioUrl":"/audio/7/080007.mp3","segments":[[0,1,30,540],[1,2,550,1510],[2,3,1520,2360],[3,4,2370,3910]],"words":[{"position":