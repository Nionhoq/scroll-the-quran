{"chapter":{"id":75,"nameSimple":"Al-Qiyamah","nameArabic":"القيامة","translatedName":"The Resurrection","versesCount":40,"revelationPlace":"makkah"},"verses":[{"id":5552,"verseKey":"75:1","verseNumber":1,"arabic":" لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ","translation":"I swear by the Day of Resurrection","transliteration":"lā uq'simu biyawmi l-qiyāmati","audioUrl":"/audio/7/075001.mp3","segments":[[0,1,50,1070],[1,2,1080,3330],[2,3,3340,4210],[3,4,4220,5410]],"words":[{"position":1,"text":"لَآ","translation":"Nay","transliteration":"lā"},{"position":2,"text":"أُقْسِمُ","translation":"I swear","transliteration":"uq'simu"},{"position":3,"text":"بِيَوْمِ","translation":"by (the) Day","transliteration":"biyawmi"},{"position":4,"text":"ٱلْقِيَـٰمَةِ","translation":"(of) the Resurrection","transliteration":"l-qiyāmati"}]},{"id":5553,"verseKey":"75:2","verseNumber":2,"arabic":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","translation":"And I swear by the reproaching soul [to the certainty of resurrection].","transliteration":"walā uq'simu bil-nafsi l-lawāmati","audioUrl":"/audio/7/075002.mp3","segments":[[0,1,30,2250],[1,2,2260,3210],[2,3,3220,5280],[3,4,5290,6580]],"words":[{"position":1,"text":"وَلَآ","translation":"And nay","transliteration":"walā"},{"position":2,"text":"أُقْسِمُ","translation":"I swear","transliteration":"uq'simu"},{"position":3,"text":"بِٱلنَّفْسِ","translation":"by the soul","transliteration":"bil-nafsi"},{"position":4,"text":"ٱللَّوَّامَةِ","translation":"self-accusing","transliteration":"l-lawāmati"}]},{"id":5554,"verseKey":"75:3","verseNumber":3,"arabic":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","translation":"Does man think that We will not assemble his bones?","transliteration":"ayaḥsabu l-insānu allan najmaʿa ʿiẓāmahu","audioUrl":"/audio/7/075003.mp3","segments":[[0,1,30,1060],[1,2,1070,3140],[2,3,3150,4760],[3,4,4770,5490],[4,5,5500,6470]],"words":[{"position":1,"text":"أَيَحْسَبُ","translation":"Does think","transliteration":"ayaḥsabu"},{"position":2,"text":"ٱلْإِنسَـٰنُ","translation":"[the] man","transliteration":"l-insānu"},{"position":3,"text":"أَلَّن","translation":"that not","transliteration":"allan"},{"position":4,"text":"نَّجْمَعَ","translation":"We will assemble","transliteration":"najmaʿa"},{"position":5,"text":"عِظَامَهُۥ","translation":"his bones","transliteration":"ʿiẓāmahu"}]},{"id":5555,"verseKey":"75:4","verseNumber":4,"arabic":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","translation":"Yes. [We are] Able [even] to proportion his fingertips.","transliteration":"balā qādirīna ʿalā an nusawwiya banānahu","audioUrl":"/audio/7/075004.mp3","segments":[[0,1,50,640],[1,2,650,1860],[2,3,1870,2200],[3,4,2210,4870],[4,5,4880,5720],[5,6,5730,6590]],"words":[{"position":1,"text":"بَلَىٰ","translation":"Nay","transliteration":"balā"},{"position":2,"text":"قَـٰدِرِينَ","translation":"(We are) Able","transliteration":"qādirīna"},{"position":3,"text":"عَلَىٰٓ","translation":"on","transliteration":"ʿalā"},{"position":4,"text":"أَن","translation":"that","transliteration":"an"},{"position":5,"text":"نُّسَوِّىَ","translation":"We can restore","transliteration":"nusawwiya"},{"position":6,"text":"بَنَانَهُۥ","translation":"his fingertips","transliteration":"banānahu"}]},{"id":5556,"verseKey":"75:5","verseNumber":5,"arabic":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ","translation":"But man desires to continue in sin.","transliteration":"bal yurīdu l-insānu liyafjura amāmahu","audioUrl":"/audio/7/075005.mp3","segments":[[0,1,40,400],[1,2,410,1170],[2,3,1180,3060],[3,4,3070,4110],[4,5,4120,5010]],"words":[{"position":1,"text":"بَلْ","translation":"Nay","transliteration":"bal"},{"position":2,"text":"يُرِيدُ","translation":"Desires","transliteration":"yurīdu"},{"position":3,"text":"ٱلْإِنسَـٰنُ","translation":"[the] man","transliteration":"l-insānu"},{"position":4,"text":"لِيَفْجُرَ","translation":"to give (the) lie","transliteration":"liyafjura"},{"position":5,"text":"أَمَامَهُۥ","translation":"(to) what is before him","transliteration":"amāmahu"}]},{"id":5557,"verseKey":"75:6","verseNumber":6,"arabic":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ","translation":"He asks, \"When is the Day of Resurrection?\"","transliteration":"yasalu ayyāna yawmu l-qiyāmati","audioUrl":"/audio/7/075006.mp3","segments":[[0,1,100,840],[1,2,850,1810],[2,3,1820,2510],[3,4,2520,3690]],"words":[{"position":1,"text":"يَسْـَٔلُ","translation":"He asks","transliteration":"yasalu"},{"position":2,"text":"أَيَّانَ","translation":"When","transliteration":"ayyāna"},{"position":3,"text":"يَوْمُ","translation":"(is the) Day","transliteration":"yawmu"},{"position":4,"text":"ٱلْقِيَـٰمَةِ","translation":"(of) the Resurrection","transliteration":"l-qiyāmati"}]},{"id":5558,"verseKey":"75:7","verseNumber":7,"arabic":"فَإِذَا بَرِقَ ٱلْبَصَرُ","translation":"So when vision is dazzled.","transliteration":"fa-idhā bariqa l-baṣaru","audioUrl":"/audio/7/075007.mp3","segments":[[0,1,30,830],[1,2,840,1470],[2,3,1480,2400]],"words":[{"position":1,"text":"فَإِذَا","translation":"So when","transliteration":"fa-idhā"},{"position":2,"text":"بَرِقَ","translation":"is dazzled","transliteration":"bariqa"},{"position":3,"text":"ٱلْبَصَرُ","translation":"the vision","transliteration":"l-baṣaru"}]},{"id":5559,"verseKey":"75:8","verseNumber":8,"arabic":"وَخَسَفَ ٱلْقَمَرُ","translation":"And the moon darkens.","transliteration":"wakhasafa l-qamaru","audioUrl":"/audio/7/075008.mp3","segments":[[0,1,60,840],[1,2,850,1680]],"words":[{"position":1,"text":"وَخَسَفَ","translation":"And becomes dark","transliteration":"wakhasafa"},{"position":2,"text":"ٱلْقَمَرُ","translation":"the moon","transliteration":"l-qamaru"}]},{"id":5560,"verseKey":"75:9","verseNumber":9,"arabic":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","translation":"And the sun and the moon are joined,","transliteration":"wajumiʿa l-shamsu wal-qamaru","audioUrl":"/audio/7/075009.mp3","segments":[[0,1,30,790],[1,2,800,1620],[2,3,1630,2710]],"words":[{"position":1,"text":"وَجُمِعَ","translation":"And are joined","transliteration":"wajumiʿa"},{"position":2,"text":"ٱلشَّمْسُ","translation":"the sun","transliteration":"l-shamsu"},{"position":3,"text":"وَٱلْقَمَرُ","translation":"and the moon","transliteration":"wal-qamaru"}]},{"id":5561,"verseKey":"75:10","verseNumber":10,"arabic":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","translation":"Man will say on that Day, \"Where is the [place of] escape?\"","transliteration":"yaqūlu l-insānu yawma-idhin ayna l-mafaru","audioUrl":"/audio/7/075010.mp3","segments":[[0,1,70,800],[1,2,810,2820],[2,3,2830,4060],[3,4,4070,4650],[4,5,4660,5570]],"words":[{"position":1,"text":"يَقُولُ","translation":"Will say","transliteration":"yaqūlu"},{"position":2,"text":"ٱلْإِنسَـٰنُ","translation":"[the] man","transliteration":"l-insānu"},{"position":3,"text":"يَوْمَئِذٍ","translation":"that Day","transliteration":"yawma-idhin"},{"position":4,"text":"أَيْنَ","translation":"Where","transliteration":"ayna"},{"position":5,"text":"ٱلْمَفَرُّ","translation":"(is) the escape","transliteration":"l-mafaru"}]},{"id":5562,"verseKey":"75:11","verseNumber":11,"arabic":"كَلَّا لَا وَزَرَ","translation":"No! There is no refuge.","transliteration":"kallā lā wazara","audioUrl":"/audio/7/075011.mp3","segments":[[0,1,30,1420],[1,2,1430,1800],[2,3,1810,2480]],"words":[{"position":1,"text":"كَلَّا","translation":"By no means","transliteration":"kallā"},{"position":2,"text":"لَا","translation":"(There is) no","transliteration":"lā"},{"position":3,"text":"وَزَرَ","translation":"refuge","transliteration":"wazara"}]},{"id":5563,"verseKey":"75:12","verseNumber":12,"arabic":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","translation":"To your Lord, that Day, is the [place of] permanence.","transliteration":"ilā rabbika yawma-idhin l-mus'taqaru","audioUrl":"/audio/7/075012.mp3","segments":[[0,1,30,620],[1,2,630,1410],[2,3,1420,2570],[3,4,2580,4150]],"words":[{"position":1,"text":"إِلَىٰ","translation":"To","transliteration":"ilā"},{"position":2,"text":"رَبِّكَ","translation":"your Lord","transliteration":"rabbika"},{"position":3,"text":"يَوْمَئِذٍ","translation":"that Day","transliteration":"yawma-idhin"},{"position":4,"text":"ٱلْمُسْتَقَرُّ","translation":"(is) the place of rest","transliteration":"l-mus'taqaru"}]},{"id":5564,"verseKey":"75:13","verseNumber":13,"arabic":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","translation":"Man will be informed that Day of what he sent ahead and kept back.","transliteration":"yunabba-u l-insānu yawma-idhin bimā qaddama wa-akhara","audioUrl":"/audio/7/075013.mp3","segments":[[0,1,40,1000],[1,2,1010,2980],[2,3,2990,4840],[3,4,4850,5450],[4,5,5460,6320],[5,6,6330,7340]],"words":[{"position":1,"text":"يُنَبَّؤُا۟","translation":"Will be informed","transliteration":"yunabba-u"},{"position":2,"text":"ٱلْإِنسَـٰنُ","translation":"[the] man","transliteration":"l-insānu"},{"position":3,"text":"يَوْمَئِذٍۭ","translation":"that Day","transliteration":"yawma-idhin"},{"position":4,"text":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":5,"text":"قَدَّمَ","translation":"he sent forth","transliteration":"qaddama"},{"position":6,"text":"وَأَخَّرَ","translation":"and kept back","transliteration":"wa-akhara"}]},{"id":5565,"verseKey":"75:14","verseNumber":14,"arabic":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ","translation":"Rather, man, against himself, will be a witness,","transliteration":"bali l-insānu ʿalā nafsihi baṣīratun","audioUrl":"/audio/7/075014.mp3","segments":[[0,1,30,410],[1,2,420,2230],[2,3,2240,2890],[3,4,2900,3850],[4,5,3860,4770]],"words":[{"position":1,"text":"بَلِ","translation":"Nay","transliteration":"bali"},{"position":2,"text":"ٱلْإِنسَـٰنُ","translation":"[The] man","transliteration":"l-insānu"},{"position":3,"text":"عَلَىٰ","translation":"against","transliteration":"ʿalā"},{"position":4,"text":"نَفْسِهِۦ","translation":"himself","transliteration":"nafsihi"},{"position":5,"text":"بَصِيرَةٌۭ","translation":"(will be) a witness","transliteration":"baṣīratun"}]},{"id":5566,"verseKey":"75:15","verseNumber":15,"arabic":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","translation":"Even if he presents his excuses.","transliteration":"walaw alqā maʿādhīrahu","audioUrl":"/audio/7/075015.mp3","segments":[[0,1,30,610],[1,2,620,1410],[2,3,1420,2860]],"words":[{"position":1,"text":"وَلَوْ","translation":"Even if","transliteration":"walaw"},{"position":2,"text":"أَلْقَىٰ","translation":"he presents","transliteration":"alqā"},{"position":3,"text":"مَعَاذِيرَهُۥ","translation":"his excuses","transliteration":"maʿādhīrahu"}]},{"id":5567,"verseKey":"75:16","verseNumber":16,"arabic":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","translation":"Move not your tongue with it, [O Muḥammad], to hasten with it [i.e., recitation of the Qur’ān].","transliteration":"lā tuḥarrik bihi lisānaka litaʿjala bihi","audioUrl":"/audio/7/075016.mp3","segments":[[0,1,40,360],[1,2,370,1390],[2,3,1400,2020],[3,4,2030,3070],[4,5,3080,4050],[5,6,4060,4410]],"words":[{"position":1,"text":"لَا","translation":"Not","transliteration":"lā"},{"position":2,"text":"تُحَرِّكْ","translation":"move","transliteration":"tuḥarrik"},{"position":3,"text":"بِهِۦ","translation":"with it","transliteration":"bihi"},{"position":4,"text":"لِسَانَكَ","translation":"your tongue","transliteration":"lisānaka"},{"position":5,"text":"لِتَعْجَلَ","translation":"to hasten","transliteration":"litaʿjala"},{"position":6,"text":"بِهِۦٓ","translation":"with it","transliteration":"bihi"}]},{"id":5568,"verseKey":"75:17","verseNumber":17,"arabic":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","translation":"Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation.","transliteration":"inna ʿalaynā jamʿahu waqur'ānahu","audioUrl":"/audio/7/075017.mp3","segments":[[0,1,30,1180],[1,2,1190,2240],[2,3,2250,3310],[3,4,3320,4620]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"عَلَيْنَا","translation":"upon Us","transliteration":"ʿalaynā"},{"position":3,"text":"جَمْعَهُۥ","translation":"(is) its collection","transliteration":"jamʿahu"},{"position":4,"text":"وَقُرْءَانَهُۥ","translation":"and its recitation","transliteration":"waqur'ānahu"}]},{"id":5569,"verseKey":"75:18","verseNumber":18,"arabic":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","translation":"So when We have recited it [through Gabriel], then follow its recitation.","transliteration":"fa-idhā qaranāhu fa-ittabiʿ qur'ānahu","audioUrl":"/audio/7/075018.mp3","segments":[[0,1,30,760],[1,2,770,2010],[2,3,2020,2960],[3,4,2970,4370]],"words":[{"position":1,"text":"فَإِذَا","translation":"And when","transliteration":"fa-idhā"},{"position":2,"text":"قَرَأْنَـٰهُ","translation":"We have recited it","transliteration":"qaranāhu"},{"position":3,"text":"فَٱتَّبِعْ","translation":"then follow","transliteration":"fa-ittabiʿ"},{"position":4,"text":"قُرْءَانَهُۥ","translation":"its recitation","transliteration":"qur'ānahu"}]},{"id":5570,"verseKey":"75:19","verseNumber":19,"arabic":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","translation":"Then upon Us is its clarification [to you].","transliteration":"thumma inna ʿalaynā bayānahu","audioUrl":"/audio/7/075019.mp3","segments":[[0,1,30,1160],[1,2,1170,2230],[2,3,2240,3300],[3,4,3310,4230]],"words":[{"position":1,"text":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"text":"إِنَّ","translation":"indeed","transliteration":"inna"},{"position":3,"text":"عَلَيْنَا","translation":"upon Us","transliteration":"ʿalaynā"},{"position":4,"text":"بَيَانَهُۥ","translation":"(is) its explanation","transliteration":"bayānahu"}]},{"id":5571,"verseKey":"75:20","verseNumber":20,"arabic":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","translation":"No! But you [i.e., mankind] love the immediate","transliteration":"kallā bal tuḥibbūna l-ʿājilata","audioUrl":"/audio/7/075020.mp3","segments":[[0,1,30,770],[1,2,780,1120],[2,3,1130,2370],[3,4,2380,3550]],"w