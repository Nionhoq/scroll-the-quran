{"chapter":{"id":94,"nameSimple":"Ash-Sharh","nameArabic":"الشرح","translatedName":"The Relief","versesCount":8,"revelationPlace":"makkah"},"verses":[{"id":6091,"verseKey":"94:1","verseNumber":1,"arabic":" أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","translation":"Did We not expand for you, [O Muḥammad], your breast?","transliteration":"alam nashraḥ laka ṣadraka","audioUrl":"/audio/7/094001.mp3","segments":[[0,1,150,600],[1,2,610,1460],[2,3,1470,1860],[3,4,1870,2890]],"words":[{"position":1,"text":"أَلَمْ","translation":"Have not","transliteration":"alam"},{"position":2,"text":"نَشْرَحْ","translation":"We expanded","transliteration":"nashraḥ"},{"position":3,"text":"لَكَ","translation":"for you","transliteration":"laka"},{"position":4,"text":"صَدْرَكَ","translation":"your breast","transliteration":"ṣadraka"}]},{"id":6092,"verseKey":"94:2","verseNumber":2,"arabic":"وَوَضَعْنَا عَنكَ وِزْرَكَ","translation":"And We removed from you your burden","transliteration":"wawaḍaʿnā ʿanka wiz'raka","audioUrl":"/audio/7/094002.mp3","segments":[[0,1,30,1260],[1,2,1270,2880],[2,3,2890,3830]],"words":[{"position":1,"text":"وَوَضَعْنَا","translation":"And We removed","transliteration":"wawaḍaʿnā"},{"position":2,"text":"عَنكَ","translation":"from you","transliteration":"ʿanka"},{"position":3,"text":"وِزْرَكَ","translation":"your burden","transliteration":"wiz'raka"}]},{"id":6093,"verseKey":"94:3","verseNumber":3,"arabic":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","translation":"Which had weighed upon your back","transliteration":"alladhī anqaḍa ẓahraka","audioUrl":"/audio/7/094003.mp3","segments":[[0,1,30,2630],[1,2,2640,4160],[2,3,4170,5030]],"words":[{"position":1,"text":"ٱلَّذِىٓ","translation":"Which","transliteration":"alladhī"},{"position":2,"text":"أَنقَضَ","translation":"weighed upon","transliteration":"anqaḍa"},{"position":3,"text":"ظَهْرَكَ","translation":"your back","transliteration":"ẓahraka"}]},{"id":6094,"verseKey":"94:4","verseNumber":4,"arabic":"وَرَفَعْنَا لَكَ ذِكْرَكَ","translation":"And raise