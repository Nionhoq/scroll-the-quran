s?","transliteration":"waqad khalaqakum aṭwāran","audioUrl":"/audio/7/071014.mp3","segments":[[0,1,30,450],[1,2,460,1540],[2,3,1550,2860]],"words":[{"position":1,"text":"وَقَدْ","translation":"And indeed","transliteration":"waqad"},{"position":2,"text":"خَلَقَكُمْ","translation":"He created you","transliteration":"khalaqakum"},{"position":3,"text":"أَطْوَارًا","translation":"(in) stages","transliteration":"aṭwāran"}]},{"id":5434,"verseKey":"71:15","verseNumber":15,"arabic":"أَلَمْ تَرَوْا۟ كَيْفَ خَلَقَ ٱللَّهُ سَبْعَ سَمَـٰوَٰتٍ طِبَاقًا","translation":"Do you not consider how Allāh has created seven heavens in layers","transliteration":"alam taraw kayfa khalaqa l-lahu sabʿa samāwātin ṭibāqan","audioUrl":"/audio/7/071015.mp3","segments":[[0,1,30,500],[1,2,510,1080],[2,3,1090,1650],[3,4,1660,2250],[4,5,2260,2990],[5,6,3000,3570],[6,7,3580,5650],[7,8,5660,6830]],"words":[{"position":1,"text":"أَلَمْ","translation":"Do not","transliteration":"alam"},{"position":2,"text":"تَرَوْا۟","translation":"you see","transliteration":"taraw"},{"position":3,"text":"كَيْفَ","translation":"how","transliteration":"kayfa"},{"position":4,"text":"خَلَقَ","translation":"did create","transliteration":"khalaqa"},{"position":5,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":6,"text":"سَبْعَ","translation":"(the) seven","transliteration":"sabʿa"},{"position":7,"text":"سَمَـٰوَٰتٍۢ","translation":"heavens","transliteration":"samāwātin"},{"position":8,"text":"طِبَاقًۭا","translation":"(in) layers","transliteration":"ṭibāqan"}]},{"id":5435,"verseKey":"71:16","verseNumber":16,"arabic":"وَجَعَلَ ٱلْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ ٱلشَّمْسَ سِرَاجًا","translation":"And made the moon therein a [reflected] light and made the sun a burning lamp?","transliteration":"wajaʿala l-qamara fīhinna nūran wajaʿala l-shamsa sirājan","audioUrl":"/audio/7/071016.mp3","segments":[[0,1,30,690],[1,2,700,1480],[2,3,1490,2910],[3,4,2920,3440],[4,5,3450,4990],[5,6,5000,5730],[6,7,5740,6970]],"words":[{"position":1,"text":"وَجَعَلَ","translation":"And made","transliteration":"wajaʿala"},{"position":2,"text":"ٱلْقَمَرَ","translation":"the moon","transliteration":"l-qamara"},{"position":3,"text":"فِيهِنَّ","translation":"therein","transliteration":"fīhinna"},{"position":4,"text":"نُورًۭا","translation":"a light","transliteration":"nūran"},{"position":5,"text":"وَجَعَلَ","translation":"and made","transliteration":"wajaʿala"},{"position":6,"text":"ٱلشَّمْسَ","translation":"the sun","transliteration":"l-shamsa"},{"position":7,"text":"سِرَاجًۭا","translation":"a lamp","transliteration":"sirājan"}]},{"id":5436,"verseKey":"71:17","verseNumber":17,"arabic":"وَٱللَّهُ أَنۢبَتَكُم مِّنَ ٱلْأَرْضِ نَبَاتًا","translation":"And Allāh has caused you to grow from the earth a [progressive] growth.","transliteration":"wal-lahu anbatakum mina l-arḍi nabātan","audioUrl":"/audio/7/071017.mp3","segments":[[0,1,30,930],[1,2,940,3690],[2,3,3700,3940],[3,4,3950,4740],[4,5,4750,5870]],"words":[{"position":1,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":2,"text":"أَنۢبَتَكُم","translation":"has caused you to grow","transliteration":"anbatakum"},{"position":3,"text":"مِّنَ","translation":"from","transliteration":"mina"},{"position":4,"text":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":5,"text":"نَبَاتًۭا","translation":"(as) a growth","transliteration":"nabātan"}]},{"id":5437,"verseKey":"71:18","verseNumber":18,"arabic":"ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا","translation":"Then He will return you into it and extract you [another] extraction.","transliteration":"thumma yuʿīdukum fīhā wayukh'rijukum ikh'rājan","audioUrl":"/audio/7/071018.mp3","segments":[[0,1,30,970],[1,2,980,2140],[2,3,2150,2980],[3,4,2990,4360],[4,5,4370,5720]],"words":[{"position":1,"text":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"text":"يُعِيدُكُمْ","translation":"He will return you","transli