{"chapter":{"id":71,"nameSimple":"Nuh","nameArabic":"نوح","translatedName":"Noah","versesCount":28,"revelationPlace":"makkah"},"verses":[{"id":5420,"verseKey":"71:1","verseNumber":1,"arabic":" إِنَّآ أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِۦٓ أَنْ أَنذِرْ قَوْمَكَ مِن قَبْلِ أَن يَأْتِيَهُمْ عَذَابٌ أَلِيمٌ","translation":"Indeed, We sent Noah to his people, [saying], \"Warn your people before there comes to them a painful punishment.\"","transliteration":"innā arsalnā nūḥan ilā qawmihi an andhir qawmaka min qabli an yatiyahum ʿadhābun alīmun","audioUrl":"/audio/7/071001.mp3","segments":[[0,1,150,2730],[1,2,2740,3850],[2,3,3860,4560],[3,4,4570,5060],[4,5,5070,7130],[5,6,7140,7490],[6,7,7500,8740],[7,8,8750,9520],[8,9,9530,10550],[9,10,10560,11160],[10,11,11170,12110],[11,12,12120,13140],[12,13,13150,14100],[13,14,14110,16140]],"words":[{"position":1,"text":"إِنَّآ","translation":"Indeed, We","transliteration":"innā"},{"position":2,"text":"أَرْسَلْنَا","translation":"[We] sent","transliteration":"arsalnā"},{"position":3,"text":"نُوحًا","translation":"Nuh","transliteration":"nūḥan"},{"position":4,"text":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":5,"text":"قَوْمِهِۦٓ","translation":"his people","transliteration":"qawmihi"},{"position":6,"text":"أَنْ","translation":"that","transliteration":"an"},{"position":7,"text":"أَنذِرْ","translation":"Warn","transliteration":"andhir"},{"position":8,"text":"قَوْمَكَ","translation":"your people","transliteration":"qawmaka"},{"position":9,"text":"مِن","translation":"from","transliteration":"min"},{"position":10,"text":"قَبْلِ","translation":"before","transliteration":"qabli"},{"position":11,"text":"أَن","translation":"[that]","transliteration":"an"},{"position":12,"text":"يَأْتِيَهُمْ","translation":"comes to them","transliteration":"yatiyahum"},{"position":13,"text":"عَذَابٌ","translation":"a punishment","transliteration":"ʿadhābun"},{"position":14,"text":"أَلِيمٌۭ","translation":"painful","transliteration":"alīmun"}]},{"id":5421,"verseKey":"71:2","verseNumber":2,"arabic":"قَالَ يَـٰقَوْمِ إِنِّى لَكُمْ نَذِيرٌ مُّبِينٌ","translation":"He said, \"O my people, indeed I am to you a clear warner -","transliteration":"qāla yāqawmi innī lakum nadhīrun mubīnun","audioUrl":"/audio/7/071002.mp3","segments":[[0,1,30,500],[1,2,510,1420],[2,3,1430,2830],[3,4,2840,3360],[4,5,3370,5030],[5,6,5040,7260]],"words":[{"position":1,"text":"قَالَ","translation":"He said","transliteration":"qāla"},{"position":2,"text":"يَـٰقَوْمِ","translation":"O my people","transliteration":"yāqawmi"},{"position":3,"text":"إِنِّى","translation":"Indeed, I am","transliteration":"innī"},{"position":4,"text":"لَكُمْ","translation":"to you","transliteration":"lakum"},{"position":5,"text":"نَذِيرٌۭ","translation":"a warner","transliteration":"nadhīrun"},{"position":6,"text":"مُّبِينٌ","translation":"clear","transliteration":"mubīnun"}]},{"id":5422,"verseKey":"71:3","verseNumber":3,"arabic":"أَنِ ٱعْبُدُوا۟ ٱللَّهَ وَٱتَّقُوهُ وَأَطِيعُونِ","translation":"To worship Allāh, fear Him and obey me.","transliteration":"ani uʿ'budū l-laha wa-ittaqūhu wa-aṭīʿūni","audioUrl":"/audio/7/071003.mp3","segments":[[0,1,30,230],[1,2,240,860],[2,3,870,1590],[3,4,1600,2740],[4,5,2750,5290]],"words":[{"position":1,"text":"أَنِ","translation":"That","transliteration":"ani"},{"position":2,"text":"ٱعْبُدُوا۟","translation":"Worship","transliteration":"uʿ'budū"},{"position":3,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":4,"text":"وَٱتَّقُوهُ","translation":"and fear Him","transliteration":"wa-ittaqūhu"},{"position":5,"text":"وَأَطِيعُونِ","translation":"and obey me","transliteration":"wa-aṭīʿūni"}]},{"id":5423,"verseKey":"71:4","verseNumber":4,"arabic":"يَغْفِرْ لَكُم مِّن ذُنُوبِكُمْ وَيُؤَخِّرْكُمْ إِلَىٰٓ أَجَلٍ مُّسَمًّى ۚ إِنَّ أَجَلَ ٱللَّهِ إِذَا جَآءَ لَا يُؤَخَّرُ ۖ لَوْ كُنتُمْ تَعْلَمُونَ","translation":"He [i.e., Allāh] will forgive you of your sins and delay you for a specified term. Indeed, the time [set by] Allāh, when it comes, will not be delayed, if you only knew.\"","transliteration":"yaghfir lakum min dhunūbikum wayu-akhir'kum ilā ajalin musamman inna ajala l-lahi idhā jāa lā yu-akharu law kuntum taʿlamūna","audioUrl":"/audio/7/071004.mp3","segments":[[0,1,100,700],[1,2,710,1920],[2,3,1930,2620],[3,4,2630,3810],[4,5,3820,5280],[5,6,5290,6950],[6,7,6960,8580],[7,8,8590,10750],[8,9,10760,12020],[9,10,12030,12580],[10,11,12590,13400],[11,12,13410,13940],[12,13,13950,15950],[13,14,15960,16280],[14,15,16290,17300],[15,16,17310,17610],[16,17,17620,19100],[17,18,19110,21670]],"words":[{"position":1,"text":"يَغْفِرْ","translation":"He will forgive","transliteration":"yaghfir"},{"position":2,"text":"لَكُم","translation":"for you","transliteration":"lakum"},{"position":3,"text":"مِّن","translation":"[of]","transliteration":"min"},{"position":4,"text":"ذُنُوبِكُمْ","translation":"your sins","transliteration":"dhunūbikum"},{"position":5,"text":"وَيُؤَخِّرْكُمْ","translation":"and give you respite","transliteration":"wayu-akhir'kum"},{"position":6,"text":"إِلَىٰٓ","translation":"for","transliteration":"ilā"},{"position":7,"text":"أَجَلٍۢ","translation":"a term","transliteration":"ajalin"},{"position":8,"text":"مُّسَمًّى ۚ","translation":"specified","transliteration":"musamman"},{"position":9,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":10,"text":"أَجَلَ","translation":"(the) term","transliteration":"ajala"},{"position":11,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":12,"text":"إِذَا","translation":"when","transliteration":"idhā"},{"position":13,"text":"جَآءَ","translation":"it comes","transliteration":"jāa"},{"position":14,"text":"لَا","translation":"not","transliteration":"lā"},{"position":15,"text":"يُؤَخَّرُ ۖ","translation":"is delayed","transliteration":"yu-akharu"},{"position":16,"text":"لَوْ","translation":"if","transliteration":"law"},{"position":17,"text":"كُنتُمْ","translation":"you","transliteration":"kuntum"},{"position":18,"text":"تَعْلَمُونَ","translation":"know","transliteration":"taʿlamūna"}]},{"id":5424,"verseKey":"71:5","verseNumber":5,"arabic":"قَالَ رَبِّ إِنِّى دَعَوْتُ قَوْمِى لَيْلًا وَنَهَارًا","translation":"He said, \"My Lord, indeed I invited my people [to truth] night and day.","transliteration":"qāla rabbi innī daʿawtu qawmī laylan wanahāran","audioUrl":"/audio/7/071005.mp3","segments":[[0,1,30,480],[1,2,490,1160],[2,3,1170,2480],[3,4,2490,3270],[4,5,3280,4070],[5,6,4080,4670],[6,7,4680,6890]],"words":[{"position":1,"text":"قَالَ","translation":"He said","transliteration":"qāla"},{"position":2,"text":"رَبِّ","translation":"My Lord","transliteration":"rabbi"},{"position":3,"text":"إِنِّى","translation":"Indeed, I","transliteration":"innī"},{"position":4,"text":"دَعَوْتُ","translation":"invited","transliteration":"daʿawtu"},{"position":5,"text":"قَوْمِى","translation":"my people","transliteration":"qawmī"},{"position":6,"text":"لَيْلًۭا","translation":"night","transliteration":"laylan"},{"position":7,"text":"وَنَهَارًۭا","translation":"and day","transliteration":"wanahāran"}]},{"id":5425,"verseKey":"71:6","verseNumber":6,"arabic":"فَلَمْ يَزِدْهُمْ دُعَآءِىٓ إِلَّا فِرَارًا","translation":"But my invitation increased them not except in flight [i.e., aversion].","transliteration":"falam yazid'hum duʿāī illā firāran","audioUrl":"/audio/7/071006.mp3","segments":[[0,1,30,440],[1,2,450,1370],[2,3,1380,5680],[3,4,5690,6410],[4,5,6420,7610]],"words":[{"position":1,"text":"فَلَمْ","translation":"But not","transliteration":"falam"},{"position":2,"text":"يَزِدْهُمْ","translation":"increased them","transliteration":"yazid'hum"},{"position":3,"text":"دُعَآءِىٓ","translation":"my invitation","transliteration":"duʿāī"},{"position":4,"text":"إِلَّا","translation":"except","transliteration":"illā"},{"position":5,"text":"فِرَارًۭا","translation":"(in) flight","transliteration":"firāran"}]},{"id":5426,"verseKey":"71:7","verseNumber":7,"ar