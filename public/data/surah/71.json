d, indeed they have disobeyed me and followed him whose wealth and children will not increase him except in loss.","transliteration":"qāla nūḥun rabbi innahum ʿaṣawnī wa-ittabaʿū man lam yazid'hu māluhu wawaladuhu illā khasāran","audioUrl":"/audio/7/071021.mp3","segments":[[0,1,30,580],[1,2,590,1170],[2,3,1180,1900],[3,4,1910,3440],[4,5,3450,4540],[5,6,4550,5660],[6,7,5670,5880],[7,8,5890,6370],[8,9,6380,7180],[9,10,7190,8140],[10,11,8150,10720],[11,12,10730,11360],[12,13,11370,12580]],"words":[{"position":1,"text":"قَالَ","translation":"Said","transliteration":"qāla"},{"position":2,"text":"نُوحٌۭ","translation":"Nuh","transliteration":"nūḥun"},{"position":3,"text":"رَّبِّ","translation":"My Lord","transliteration":"rabbi"},{"position":4,"text":"إِنَّهُمْ","translation":"Indeed, they","transliteration":"innahum"},{"position":5,"text":"عَصَوْنِى","translation":"disobeyed me","transliteration":"ʿaṣawnī"},{"position":6,"text":"وَٱتَّبَعُوا۟","translation":"and followed","transliteration":"wa-ittabaʿū"},{"position":7,"text":"مَن","translation":"(the one) who","transliteration":"man"},{"position":8,"text":"لَّمْ","translation":"(did) not","transliteration":"lam"},{"position":9,"text":"يَزِدْهُ","translation":"increase him","transliteration":"yazid'hu"},{"position":10,"text":"مَالُهُۥ","translation":"his wealth","transliteration":"māluhu"},{"position":11,"text":"وَوَلَدُهُۥٓ","translation":"and his children","transliteration":"wawaladuhu"},{"position":12,"text":"إِلَّا","translation":"except","transliteration":"illā"},{"position":13,"text":"خَسَارًۭا","translation":"(in) loss","transliteration":"khasāran"}]},{"id":5441,"verseKey":"71:22","verseNumber":22,"arabic":"وَمَكَرُوا۟ مَكْرًا كُبَّارًا","translation":"And they conspired an immense conspiracy","transliteration":"wamakarū makran kubbāran","audioUrl":"/audio/7/071022.mp3","segments":[[0,1,30,970],[1,2,980,2440],[2,3,2450,3800]],"words":[{"position":1,"text":"وَمَكَرُوا۟","translation":"And they have planned","transliteration":"wamakarū"},{"position":2,"text":"مَكْرًۭا","translation":"a plan","transliteration":"makran"},{"position":3,"text":"كُبَّارًۭا","translation":"great","transliteration":"kubbāran"}]},{"id":5442,"verseKey":"71:23","verseNumber":23,"arabic":"وَقَالُوا۟ لَا تَذَرُنَّ ءَالِهَتَكُمْ وَلَا تَذَرُنَّ وَدًّا وَلَا سُوَاعًا وَلَا يَغُوثَ وَيَعُوقَ وَنَسْرًا","translation":"And said, 'Never leave your gods and never leave Wadd or Suwāʿ or Yaghūth and Yaʿūq and Nasr.'","transliteration":"waqālū lā tadharunna ālihatakum walā tadharunna waddan walā suwāʿan walā yaghūtha wayaʿūqa wanasran","audioUrl":"/audio/7/071023.mp3","segments":[[0,1,30,930],[1,2,940,1240],[2,3,1250,2830],[3,4,2840,4150],[4,5,4160,4680],[5,6,4690,6110],[6,7,6120,6690],[7,8,6700,7860],[8,9,7870,8760],[9,10,8770,9930],[10,11,9940,10800],[11,12,10810,11750],[12,13,11760,12920]],"words":[{"position":1,"text":"وَقَالُوا۟","translation":"And they said","transliteration":"waqālū"},{"position":2,"text":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":3,"text":"تَذَرُنَّ","translation":"leave","transliteration":"tadharunna"},{"position":4,"text":"ءَالِهَتَكُمْ","translation":"your gods","transliteration":"ālihatakum"},{"position":5,"text":"وَلَا","translation":"and (do) not","transliteration":"walā"},{"position":6,"text":"تَذَرُنَّ","translation":"leave","transliteration":"tadharunna"},{"position":7,"text":"وَدًّۭا","translation":"Wadd","transliteration":"waddan"},{"position":8,"text":"وَلَا","translation":"and not","transliteration":"walā"},{"position":9,"text":"سُوَاعًۭا","translation":"Suwa","transliteration":"suwāʿan"},{"position":10,"text":"وَلَا","translation":"and not","transliteration":"walā"},{"position":11,"text":"يَغُوثَ","translation":"Yaguth","transliteration":"yaghūtha"},{"position":12,"text":"وَيَعُوقَ","translation":"and Yauq","transliteration":"wayaʿūqa"},{"position":13,"text":"وَنَسْرًۭا","translation":"and Nasr","transliteration":"wanasran"}]},{"id":5443,"verseKey":"71:24","verseNumber":24,"arabic":"وَقَدْ أَضَلُّوا۟ كَثِيرًا ۖ وَلَا تَزِدِ ٱلظَّـٰلِمِينَ إِلَّا ضَلَـٰلًا","translation":"And already they have misled many. And, [my Lord], do not increase the wrongdoers except in error.\"","transliteration":"waqad aḍallū kathīran walā tazidi l-ẓālimīna illā ḍalālan","audioUrl":"/audio/7/071024.mp3","segments":[[0,1,30,520],[1,2,530,1460],[2,3,1470,2980],[3,4,2990,3520],[4,5,3530,4120],[5,6,4130,5520],[6,7,5530,6270],[7,8,6280,7650]],"words":[{"position":1,"text":"وَقَدْ","translation":"And indeed","transliteration":"waqad"},{"position":2,"text":"أَضَلُّوا۟","translation":"they have led astray","transliteration":"aḍallū"},{"position":3,"text":"كَثِيرًۭا ۖ","translation":"many","transliteration":"kathīran"},{"position":4,"text":"وَلَا","translation":"And not","transliteration":"walā"},{"position":5,"text":"تَزِدِ","translation":"increase","transliteration":"tazidi"},{"position":6,"text":"ٱلظَّـٰلِمِينَ","translation":"the wrongdoers","transliteration":"l-ẓālimīna"},{"position":7,"text":"إِلَّا","translation":"except","transliteration":"illā"},{"position":8,"text":"ضَلَـٰلًۭا","translation":"(in) error","transliteration":"ḍalālan"}]},{"id":5444,"verseKey":"71:25","verseNumber":25,"arabic":"مِّمَّا خَطِيٓـَٔـٰتِهِمْ أُغْرِقُوا۟ فَأُدْخِلُوا۟ نَارًا فَلَمْ يَجِدُوا۟ لَهُم مِّن دُونِ ٱللَّهِ أَنصَارًا","translation":"Because of their sins they were drowned and put into the Fire, and they found not for themselves besides Allāh [any] helpers.","transliteration":"mimmā khaṭīātihim ugh'riqū fa-ud'khilū nāran falam yajidū lahum min dūni l-lahi anṣāran","audioUrl":"/audio/7/071025.mp3","segments":[[0,1,40,1660],[1,2,1670,4800],[2,3,4810,5730],[3,4,5740,6900],[4,5,6910,8300],[5,6,8310,8860],[6,7,8870,9700],[7,8,9710,13310],[8,9,13320,14340],[9,10,14350,15030],[10,11,15040,15580],[11,12,15590,17690]],"words":[{"position":1,"text":"مِّمَّا","translation":"Because of","transliteration":"mimmā"},{"position":2,"text":"خَطِيٓـَٔـٰتِهِمْ","translation":"their sins","transliteration":"khaṭīātihim"},{"position":3,"text":"أُغْرِقُوا۟","translation":"they were drowned","transliteration":"ugh'riqū"},{"position":4,"text":"فَأُدْخِلُوا۟","translation":"then made to enter","transliteration":"fa-ud'khilū"},{"position":5,"text":"نَارًۭا","translation":"(the) Fire","transliteration":"nāran"},{"position":6,"text":"فَلَمْ","translation":"and not","transliteration":"falam"},{"position":7,"text":"يَجِدُوا۟","translation":"they found","transliteration":"yajidū"},{"position":8,"text":"لَهُم","translation":"for themselves","transliteration":"lahum"},{"position":9,"text":"مِّن","translation":"from","transliteration":"min"},{"position":10,"text":"دُونِ","translation":"besides","transliteration":"dūni"},{"position":11,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":12,"text":"أَنصَارًۭا","translation":"any helpers","transliteration":"anṣāran"}]},{"id":5445,"verseKey":"71:26","verseNumber":26,"arabic":"وَقَالَ نُوحٌ رَّبِّ لَا تَذَرْ عَلَى ٱلْأَرْضِ مِنَ ٱلْكَـٰفِرِينَ دَيَّارًا","translation":"And Noah said, \"My Lord, do not leave upon the earth from among the disbelievers an inhabitant.","transliteration":"waqāla nūḥun rabbi lā tadhar ʿalā l-arḍi mina l-kāfirīna dayyāran","audioUrl":"/audio/7/071026.mp3","segments":[[0,1,30,770],[1,2,780,1300],[2,3,1310,2070],[3,4,2080,2380],[4,5,2390,2980],[5,6,2990,3380],[6,7,3390,4220],[7,8,4230,4550],[8,9,4560,5880],[9,10,5890,7340]],"words":[{"position":1,"text":"وَقَالَ","translation":"And said","transliteration":"waqāla"},{"position":2,"text":"نُوحٌۭ","translation":"Nuh","transliteration":"nūḥun"},{"position":3,"text":"رَّبِّ","translation":"My Lord","transliteration":"rabbi"},{"position":4,"text":"لَا","translation":"(Do) not","transliteration":"lā"},{"position":5,"text":"تَذَرْ","translation":"leave","transliteration":"tadhar"},{"position":6,"text":"عَلَى","translation":"on","transliteration":"ʿalā"},{"position":7,"text":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":8,"text":"مِنَ","translation":"any","transliteration":"mina"},{"position":9,"text":"ٱلْكَـٰفِرِينَ","translation":"(of) the disbelievers","transliteration":"l-kāfirīna"},{"position":10,"text":"دَيَّارًا","translation":"(as) an inhabitant","transliteration":"dayyāran"}]},{"id":5446,"verseKey":"71:27","verseNumber":27,"arabic":"إِنَّكَ إِن تَذَرْهُمْ يُضِلُّوا۟ عِبَادَكَ وَلَا يَلِدُوٓا۟ إِلَّا فَاجِرًا كَفَّارًا","translation":"Indeed, if You leave them, they will mislead Your servants and not beget except [every] wicked one and [confirmed] disbeliever.","transliteration":"innaka in tadharhum yuḍillū ʿibādaka walā yalidū illā fājiran kaffāran","audioUrl":"/audio/7/071027.mp3","segments":[[0,1,30,1350],[1,2,1360,2280],[2,3,2290,3280],[3,4,3290,4240],[4,5,4250,5320],[5,6,5330,5860],[6,7,5870,7980],[7,8,7990,8730],[8,9,8740,10410],[9,10,10420,11840]],"words":[{"position":1,"text":"إِنَّكَ","translation":"Indeed, You","transliteration":"innaka"},{"position":2,"text":"إِن","translation":"if","transliteration":"in"},{"position":3,"text":"تَذَرْهُمْ","translation":"You leave them","transliteration":"tadharhum"},{"position":4,"text":"يُضِلُّوا۟","translation":"they will mislead","transliteration":"yuḍillū"},{"position":5,"text":"عِبَادَكَ","translation":"Your slaves","transliteration":"ʿibādaka"},{"position":6,"text":"وَلَا","translation":"and not","transliteration":"walā"},{"position":7,"text":"يَلِدُوٓا۟","translation":"they will beget","transliteration":"yalidū"},{"position":8,"text":"إِلَّا","translation":"except","transliteration":"illā"},{"position":9,"text":"فَاجِرًۭا","translation":"a wicked","transliteration":"fājiran"},{"position":10,"text":"كَفَّارًۭا","translation":"a disbeliever","transliteration":"kaffāran"}]},{"id":5447,"verseKey":"71:28","verseNumber":28,"arabic":"رَّبِّ ٱغْفِرْ لِى وَلِوَٰلِدَىَّ وَلِمَن دَخَلَ بَيْتِىَ مُؤْمِنًا وَلِلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ وَلَا تَزِدِ ٱلظَّـٰلِمِينَ إِلَّا تَبَارًۢا","translation":"My Lord, forgive me and my parents and whoever enters my house a believer and the believing men and believing women. And do not increase the wrongdoers except in destruction.\"","transliteration":"rabbi igh'fir lī waliwālidayya waliman dakhala baytiya mu'minan walil'mu'minīna wal-mu'mināti walā tazidi l-ẓālimīna illā tabāran","audioUrl":"/audio/7/071028.mp3","segments":[[0,1,40,590],[1,2,600,1050],[2,3,1060,1630],[3,4,1640,3210],[4,5,3220,4760],[5,6,4770,5360],[6,7,5370,6140],[7,8,6150,6860],[8,9,6870,9270],[9,10,9280,10870],[10,11,10880,11410],[11,12,11420,12070],[12,13,12080,13680],[13,14,13690,14530],[14,15,14540,16100]],"words":[{"position":1,"text":"رَّبِّ","translation":"My Lord","transliteration":"rabbi"},{"position":2,"text":"ٱغْفِرْ","translation":"Forgive","transliteration":"igh'fir"},{"position":3,"text":"لِى","translation":"me","transliteration":"lī"},{"position":4,"text":"وَلِوَٰلِدَىَّ","translation":"and my parents","transliteration":"waliwālidayya"},{"position":5,"text":"وَلِمَن","translation":"and whoever","transliteration":"waliman"},{"position":6,"text":"دَخَلَ","translation":"enters","transliteration":"dakhala"},{"position":7,"text":"بَيْتِىَ","translation":"my house ","transliteration":"baytiya"},{"position":8,"text":"مُؤْمِنًۭا","translation":"a believer","transliteration":"mu'minan"},{"position":9,"text":"وَلِلْمُؤْمِنِينَ","translation":"and the believing men","transliteration":"walil'mu'minīna"},{"position":10,"text":"وَٱلْمُؤْمِنَـٰتِ","translation":"and the believing women","transliteration":"wal-mu'mināti"},{"position":11,"text":"وَلَا","translation":"And (do) not","transliteration":"walā"},{"position":12,"text":"تَزِدِ","translation":"increase","transliteration":"tazidi"},{"position":13,"text":"ٱلظَّـٰلِمِينَ","translation":"the wrongdoers","transliteration":"l-ẓālimīna"},{"position":14,"text":"إِلَّا","translation":"except","transliteration":"illā"},{"position":15,"text":"تَبَارًۢا","translation":"(in) destruction","transliteratio