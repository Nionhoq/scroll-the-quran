,1910,2750],[3,4,2760,3790],[4,5,3800,5100],[5,6,5110,5940],[6,7,5950,7030],[7,8,7040,8050]],"words":[{"position":1,"text":"فَكَيۡفَ","translation":"Then how","transliteration":"fakayfa"},{"position":2,"text":"تَتَّقُونَ","translation":"will you guard yourselves","transliteration":"tattaqūna"},{"position":3,"text":"إِن","translation":"if","transliteration":"in"},{"position":4,"text":"كَفَرۡتُمۡ","translation":"you disbelieve","transliteration":"kafartum"},{"position":5,"text":"يَوۡمٗا","translation":"a Day","transliteration":"yawman"},{"position":6,"text":"يَجۡعَلُ","translation":"(that) will make","transliteration":"yajʿalu"},{"position":7,"text":"ٱلۡوِلۡدَٰنَ","translation":"the children","transliteration":"l-wil'dāna"},{"position":8,"text":"شِيبًا","translation":"gray-haired","transliteration":"shīban"}]},{"id":5493,"verseKey":"73:18","verseNumber":18,"arabic":"ٱلسَّمَآءُ مُنفَطِرُۢ بِهِۦۚ كَانَ وَعۡدُهُۥ مَفۡعُولًا","translation":"The heaven will break apart therefrom; ever is His promise fulfilled.","transliteration":"al-samāu munfaṭirun bihi kāna waʿduhu mafʿūlan","audioUrl":"/audio/7/073018.mp3","segments":[[0,1,30,2800],[1,2,2810,5460],[2,3,5470,6440],[3,4,6450,7020],[4,5,7030,7960],[5,6,7970,9290]],"words":[{"position":1,"text":"ٱلسَّمَآءُ","translation":"The heaven","transliteration":"al-samāu"},{"position":2,"text":"مُنفَطِرُۢ","translation":"(will) break apart","transliteration":"munfaṭirun"},{"position":3,"text":"بِهِۦۚ","translation":"therefrom","transliteration":"bihi"},{"position":4,"text":"كَانَ","translation":"is","transliteration":"kāna"},{"position":5,"text":"وَعۡدُهُۥ","translation":"His Promise","transliteration":"waʿduhu"},{"position":6,"text":"مَفۡعُولًا","translation":"to be fulfilled","transliteration":"mafʿūlan"}]},{"id":5494,"verseKey":"73:19","verseNumber":19,"arabic":"إِنَّ هَٰذِهِۦ تَذۡكِرَةٞۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا","translation":"Indeed, this is a reminder, so whoever wills may take to his Lord a way.","tran