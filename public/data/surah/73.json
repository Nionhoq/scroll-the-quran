{"chapter":{"id":73,"nameSimple":"Al-Muzzammil","nameArabic":"المزمل","translatedName":"The Enshrouded One","versesCount":20,"revelationPlace":"makkah"},"verses":[{"id":5476,"verseKey":"73:1","verseNumber":1,"arabic":"يَٰٓأَيُّهَا ٱلۡمُزَّمِّلُ","translation":"O you who wraps himself [in clothing]","transliteration":"yāayyuhā l-muzamilu","audioUrl":"/audio/7/073001.mp3","segments":[[0,1,50,2800],[1,2,2810,4990]],"words":[{"position":1,"text":"يَٰٓأَيُّهَا","translation":"O you","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلۡمُزَّمِّلُ","translation":"who wraps himself","transliteration":"l-muzamilu"}]},{"id":5477,"verseKey":"73:2","verseNumber":2,"arabic":"قُمِ ٱلَّيۡلَ إِلَّا قَلِيلٗا","translation":"Arise [to pray] the night, except for a little -","transliteration":"qumi al-layla illā qalīlan","audioUrl":"/audio/7/073002.mp3","segments":[[0,1,30,420],[1,2,430,1130],[2,3,1140,1890],[3,4,1900,2870]],"words":[{"position":1,"text":"قُمِ","translation":"Stand","transliteration":"qumi"},{"position":2,"text":"ٱلَّيۡلَ","translation":"(in) the night","transliteration":"al-layla"},{"position":3,"text":"إِلَّا","translation":"except","transliteration":"illā"},{"position":4,"text":"قَلِيلٗا","translation":"a little","transliteration":"qalīlan"}]},{"id":5478,"verseKey":"73:3","verseNumber":3,"arabic":"نِّصۡفَهُۥٓ أَوِ ٱنقُصۡ مِنۡهُ قَلِيلًا","translation":"Half of it - or subtract from it a little","transliteration":"niṣ'fahu awi unquṣ min'hu qalīlan","audioUrl":"/audio/7/073003.mp3","segments":[[0,1,90,2270],[1,2,2280,2690],[2,3,2700,3820],[3,4,3830,4350],[4,5,4360,5530]],"words":[{"position":1,"text":"نِّصۡفَهُۥٓ","translation":"Half of it","transliteration":"niṣ'fahu"},{"position":2,"text":"أَوِ","translation":"or","transliteration":"awi"},{"position":3,"text":"ٱنقُصۡ","translation":"lessen","transliteration":"unquṣ"},{"position":4,"text":"مِنۡهُ","translation":"from it","transliteration":"min'hu"},{"position":5,"text":"قَلِيلًا","translation":"a little","transliteration":"qalīlan"}]},{"id":5479,"verseKey":"73:4","verseNumber":4,"arabic":"أَوۡ زِدۡ عَلَيۡهِ وَرَتِّلِ ٱلۡقُرۡءَانَ تَرۡتِيلًا","translation":"Or add to it, and recite the Qur’ān with measured recitation.","transliteration":"aw zid ʿalayhi warattili l-qur'āna tartīlan","audioUrl":"/audio/7/073004.mp3","segments":[[0,1,90,400],[1,2,410,770],[2,3,780,1690],[3,4,1700,2650],[4,5,2660,3780],[5,6,3790,5200]],"words":[{"position":1,"text":"أَوۡ","translation":"Or","transliteration":"aw"},{"position":2,"text":"زِدۡ","translation":"add","transliteration":"zid"},{"position":3,"text":"عَلَيۡهِ","translation":"to it","transliteration":"ʿalayhi"},{"position":4,"text":"وَرَتِّلِ","translation":"and recite","transliteration":"warattili"},{"position":5,"text":"ٱلۡقُرۡءَانَ","translation":"the Quran","transliteration":"l-qur'āna"},{"position":6,"text":"تَرۡتِيلًا","translation":"(with) measured rhythmic recitation","transliteration":"tartīlan"}]},{"id":5480,"verseKey":"73:5","verseNumber":5,"arabic":"إِنَّا سَنُلۡقِي عَلَيۡكَ قَوۡلٗا ثَقِيلًا","translation":"Indeed, We will cast upon you a heavy word.","transliteration":"innā sanul'qī ʿalayka qawlan thaqīlan","audioUrl":"/audio/7/073005.mp3","segments":[[0,1,30,1450],[1,2,1460,2400],[2,3,2410,3270],[3,4,3280,4580],[4,5,4590,5900]],"words":[{"position":1,"text":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"text":"سَنُلۡقِي","translation":"will cast","transliteration":"sanul'qī"},{"position":3,"text":"عَلَيۡكَ","translation":"upon you","transliteration":"ʿalayka"},{"position":4,"text":"قَوۡلٗا","translation":"a Word","transliteration":"qawlan"},{"position":5,"text":"ثَقِيلًا","translation":"heavy","transliteration":"thaqīlan"}]},{"id":5481,"verseKey":"73:6","verseNumber":6,"arabic":"إِنَّ نَاشِئَةَ ٱلَّيۡلِ هِيَ أَشَدُّ وَطۡـٔٗا وَأَقۡوَمُ قِيلًا","translation":"Indeed, the hours of the night are more effective for concurrence [of heart and tongue] and more suitable for words.","transliteration":"inna nāshi-ata al-layli hiya ashaddu waṭan wa-aqwamu qīlan","audioUrl":"/audio/7/073006.mp3","segments":[[0,1,30,1050],[1,2,1060,1960],[2,3,1970,2730],[3,4,2740,3100],[4,5,3110,3890],[5,6,3900,4450],[6,7,4460,6100],[7,8,6110,7060]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"نَاشِئَةَ","translation":"(the) rising","transliteration":"nāshi-ata"},{"position":3,"text":"ٱلَّيۡلِ","translation":"(at) the night","transliteration":"al-layli"},{"position":4,"text":"هِيَ","translation":"it","transliteration":"hiya"},{"position":5,"text":"أَشَدُّ","translation":"(is) very hard","transliteration":"ashaddu"},{"position":6,"text":"وَطۡـٔٗا","translation":"and most potent","transliteration":"waṭan"},{"position":7,"text":"وَأَقۡوَمُ","translation":"and more suitable","transliteration":"wa-aqwamu"},{"position":8,"text":"قِيلًا","translation":"(for) Word","transliteration":"qīlan"}]},{"id":5482,"verseKey":"73:7","verseNumber":7,"arabic":"إِنَّ لَكَ فِي ٱلنَّهَارِ سَبۡحٗا طَوِيلٗا","translation":"Indeed, for you by day is prolonged occupation.","transliteration":"inna laka fī l-nahāri sabḥan ṭawīlan","audioUrl":"/audio/7/073007.mp3","segments":[[0,1,30,980],[1,2,990,1340],[2,3,1350,1600],[3,4,1610,3220],[4,5,3230,3940],[5,6,3950,5830]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"لَكَ","translation":"for you","transliteration":"laka"},{"position":3,"text":"فِي","translation":"in","transliteration":"fī"},{"position":4,"text":"ٱلنَّهَارِ","translation":"the day","transliteration":"l-nahāri"},{"position":5,"text":"سَبۡحٗا","translation":"(is) occupation","transliteration":"sabḥan"},{"position":6,"text":"طَوِيلٗا","translation":"prolonged","transliteration":"ṭawīlan"}]},{"id":5483,"verseKey":"73:8","verseNumber":8,"arabic":"وَٱذۡكُرِ ٱسۡمَ رَبِّكَ وَتَبَتَّلۡ إِلَيۡهِ تَبۡتِيلٗا","translation":"And remember the name of your Lord and devote yourself to Him with [complete] devotion.","transliteration":"wa-udh'kuri is'ma rabbika watabattal ilayhi tabtīlan","audioUrl":"/audio/7/073008.mp3","segments":[[0,1,40,730],[1,2,740,1180],[2,3,1190,1970],[3,4,1980,3150],[4,5,3160,3830],[5,6,3840,5170]],"words":[{"position":1,"text":"وَٱذۡكُرِ","translation":"And remember","transliteration":"wa-udh'kuri"},{"position":2,"text":"ٱسۡمَ","translation":"(the) name","transliteration":"is'ma"},{"position":3,"text":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"text":"وَتَبَتَّلۡ","translation":"and devote yourself","transliteration":"watabattal"},{"position":5,"text":"إِلَيۡهِ","translation":"to Him","transliteration":"ilayhi"},{"position":6,"text":"تَبۡتِيلٗا","translation":"(with) devotion","transliteration":"tabtīlan"}]},{"id":5484,"verseKey":"73:9","verseNumber":9,"arabic":"رَّبُّ ٱلۡمَشۡرِقِ وَٱلۡمَغۡرِبِ لَآ إِلَٰهَ إِلَّا هُوَ فَٱتَّخِذۡهُ وَكِيلٗا","translation":"[He is] the Lord of the East and the West; there is no deity except Him, so take Him as Disposer of [your] affairs.","transliteration":"rabbu l-mashriqi wal-maghribi lā ilāha illā huwa fa-ittakhidh'hu wakīlan","audioUrl":"/audio/7/073009.mp3","segments":[[0,1,50,610],[1,2,620,1570],[2,3,1580,2740],[3,4,2750,2790],[4,5,2800,5020],[5,6,5030,5740],[6,7,5750,6120],[7,8,6130,7330],[8,9,7340,8450]],"words":[{"position":1,"text":"رَّبُّ","translation":"(The) Lord","transliteration":"rabbu"},{"position":2,"text":"ٱلۡمَشۡرِقِ","translation":"(of) the east","transliteration":"l-mashriqi"},{"position":3,"text":"وَٱلۡمَغۡرِبِ","translation":"and the west","transliteration":"wal-maghribi"},{"position":4,"text":"لَآ","translation":"(there is) no","transliteration":"lā"},{"position":5,"text":"إِلَٰهَ","translation":"god","transliteration":"ilāha"},{"position":6,"text":"إِلَّا","translation":"except","transliteration":"illā"},{"position":7,"text":"هُوَ","translation":"Him","transliteration":"huwa"},{"position":8,"text":"فَٱتَّخِذۡهُ","translation":"so take Him","transliteration":"fa-ittakhidh'hu"},{"position":9,"text":"وَكِيلٗا","translation":"(as) Disposer of Affairs","transliteration":"wakīlan"}]},{"id":5485,"verseKey":"73:10","verseNumber":10,"arabic":"وَٱصۡبِرۡ عَلَىٰ مَا يَقُولُونَ وَٱهۡجُرۡهُمۡ هَجۡرٗا جَمِيلٗا","translation":"And be patient over what they say and avoid them with gracious avoidance.","transliteration":"wa-iṣ'bir ʿalā mā yaqūlūna wa-uh'jur'hum hajran jamīlan","audioUrl":"/audio/7/073010.mp3","segments":[[0,1,30,680],[1,2,690,1380],[2,3,1390,1690],[3,4,1700,2880],[4,5,2890,3960],[5,6,3970,5650],[6,7,5660,6830]],"words":[{"position":1,"text":"وَٱصۡبِرۡ","translation":"And be patient","transliteration":"wa-iṣ'bir"},{"position":2,"text":"عَلَىٰ","translation":"over","transliteration":"ʿalā"},{"position":3,"text":"مَا","translation":"what","transliteration":"mā"},{"position":4,"text":"يَقُولُونَ","translation":"they say","transliteration":"yaqūlūna"},{"position":5,"text":"وَٱهۡجُرۡهُمۡ","translation":"and avoid them","transliteration":"wa-uh'jur'hum"},{"position":6,"text":"هَجۡرٗا","translation":"an avoidance","transliteration":"hajran"},{"position":7,"text":"جَمِيلٗا","translation":"gracious","transliteration":"jamīlan"}]},{"id":5486,"verseKey":"73:11","verseNumber":11,"arabic":"وَذَرۡنِي وَٱلۡمُكَذِّبِينَ أُوْلِي ٱلنَّعۡمَةِ وَمَهِّلۡهُمۡ قَلِيلًا","translation":"And leave Me with [the matter of] the deniers, those of ease [in life], and allow them respite a little.","transliteration":"wadharnī wal-mukadhibīna ulī l-naʿmati wamahhil'hum qalīlan","audioUrl":"/audio/7/073011.mp3","segments":[[0,1,30,990],[1,2,1000,2660],[2,3,2670,3070],[3,4,3080,4530],[4,5,4540,5800],[5,6,5810,6940]],"words":[{"position":1,"text":"وَذَرۡنِي","translation":"And leave Me","transliteration":"wadharnī"},{"position":2,"text":"وَٱلۡمُكَذِّبِينَ","translation":"and the deniers","transliteration":"wal-mukadhibīna"},{"position":3,"text":"أُوْلِي","translation":"possessors","transliteration":"ulī"},{"position":4,"text":"ٱلنَّعۡمَةِ","translation":"(of) the ease","transliteration":"l-naʿmati"},{"position":5,"text":"وَمَهِّلۡهُمۡ","translation":"and allow them respite ","transliteration":"wamahhil'hum"},{"position":6,"text":"قَلِيلًا","translation":"a little","transliteration":"qalīlan"}]},{"id":5487,"verseKey":"73:12","verseNumber":12,"arabic":"إِنَّ لَدَيۡنَآ أَنكَالٗا وَجَحِيمٗا","translation":"Indeed, with Us [for them] are shackles and burning fire.","transliteration":"inna ladaynā ankālan wajaḥīman","audioUrl":"/audio/7/073012.mp3","segments":[[0,1,30,1250],[1,2,1260,2960],[2,3,2970,5320],[3,4,5330,7520]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"لَدَيۡنَآ","translation":"with Us","transliteration":"ladaynā"},{"position":3,"text":"أَنكَالٗا","translation":"(are) shackles","transliteration":"ankālan"},{"position":4,"text":"وَجَحِيمٗا","translation":"and burning fire","transliteration":"wajaḥīman"}]},{"id":5488,"verseKey":"73:13","verseNumber":13,"arabic":"وَطَعَامٗا ذَا غُصَّةٖ وَعَذَابًا أَلِيمٗا","translation":"And food that chokes and a painful punishment -","transliteration":"waṭaʿāman dhā ghuṣṣatin waʿadhāban alīman","audioUrl":"/audio/7/073013.mp3","segments":[[0,1,30,1810],[1,2,1820,2200],[2,3,2210,3200],[3,4,3210,5070],[4,5,5080,6240]],"words":[{"position":1,"text":"وَطَعَامٗا","translation":"And food","transliteration":"waṭaʿāman"},{"position":2,"text":"ذَا","translation":"that","transliteration":"dhā"},{"position":3,"text":"غُصَّةٖ","translation":"chokes","transliteration":"ghuṣṣatin"},{"position":4,"text":"وَعَذَابًا","translation":"and a punishment","transliteration":"waʿadhāban"},{"position":5,"text":"أَلِيمٗا","translation":"painful","transliteration":"alīman"}]},{"id":5489,"verseKey":"73:14","verseNumber":14,"arabic":"يَوۡمَ تَرۡجُفُ ٱلۡأَرۡضُ وَٱلۡجِبَالُ وَكَانَتِ ٱلۡجِبَالُ كَثِيبٗا مَّهِيلًا","translation":"On the Day the earth and the mountains will convulse and the mountains will become a heap of 