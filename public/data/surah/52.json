","translation":"And if","transliteration":"wa-in"},{"position":2,"text":"يَرَوْا۟","translation":"they were to see","transliteration":"yaraw"},{"position":3,"text":"كِسْفًۭا","translation":"a portion","transliteration":"kis'fan"},{"position":4,"text":"مِّنَ","translation":"from","transliteration":"mina"},{"position":5,"text":"ٱلسَّمَآءِ","translation":"the sky","transliteration":"l-samāi"},{"position":6,"text":"سَاقِطًۭا","translation":"falling","transliteration":"sāqiṭan"},{"position":7,"text":"يَقُولُوا۟","translation":"they will say","transliteration":"yaqūlū"},{"position":8,"text":"سَحَابٌۭ","translation":"Clouds","transliteration":"saḥābun"},{"position":9,"text":"مَّرْكُومٌۭ","translation":"heaped up","transliteration":"markūmun"}]},{"id":4780,"verseKey":"52:45","verseNumber":45,"arabic":"فَذَرْهُمْ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى فِيهِ يُصْعَقُونَ","translation":"So leave them until they meet their Day in which they will be struck insensible -","transliteration":"fadharhum ḥattā yulāqū yawmahumu alladhī fīhi yuṣ'ʿaqūna","audioUrl":"/audio/7/052045.mp3","segments":[[0,1,30,1110],[1,2,1120,1960],[2,3,1970,3140],[3,4,3150,4250],[4,5,4260,5130],[5,6,5140,5910],[6,7,5920,8780]],"words":[{"position":1,"text":"فَذَرْهُمْ","translation":"So leave them","transliteration":"fadharhum"},{"position":2,"text":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":3,"text":"يُلَـٰقُوا۟","translation":"they meet","transliteration":"yulāqū"},{"position":4,"text":"يَوْمَهُمُ","translation":"their Day","transliteration":"yawmahumu"},{"position":5,"text":"ٱلَّذِى","translation":"which","transliteration":"alladhī"},{"position":6,"text":"فِيهِ","translation":"in it","transliteration":"fīhi"},{"position":7,"text":"يُصْعَقُونَ","translation":"they will faint","transliteration":"yuṣ'ʿaqūna"}]},{"id":4781,"verseKey":"52:46","verseNumber":46,"arabic":"يَوْمَ لَا يُغْنِى عَنْهُمْ كَيْدُهُمْ شَيْـًٔا وَلَا هُمْ يُنصَرُونَ","translation":"The Day their plan will not avail them at all, nor will they be helped.","transliteration":"yawma lā yugh'nī ʿanhum kayduhum shayan walā hum yunṣarūna","audioUrl":"/audio/7/052046.mp3","segments":[[0,1,80,760],[1,2,770,1140],[2,3,1150,2040],[3,4,2050,2960],[4,5,2970,4060],[5,6,4070,4770],[6,7,4780,6160],[7,8,6170,6620],[8,9,6630,10480]],"words":[{"position":1,"text":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"text":"لَا","translation":"not","transliteration":"lā"},{"position":3,"text":"يُغْنِى","translation":"will avail","transliteration":"yugh'nī"},{"position":4,"text":"عَنْهُمْ","translation":"to them","transliteration":"ʿanhum"},{"position":5,"text":"كَيْدُهُمْ","translation":"their plotting","transliteration":"kayduhum"},{"position":6,"text":"شَيْـًۭٔا","translation":"(in) anything","transliteration":"shayan"},{"position":7,"text":"وَلَا","translation":"and not","transliteration":"walā"},{"position":8,"text":"هُمْ","translation":"they","transliteration":"hum"},{"position":9,"text":"يُنصَرُونَ","translation":"will be helped","transliteration":"yunṣarūna"}]},{"id":4782,"verseKey":"52:47","verseNumber":47,"arabic":"وَإِنَّ لِلَّذِينَ ظَلَمُوا۟ عَذَابًا دُونَ ذَٰلِكَ وَلَـٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ","translation":"And indeed, for those who have wronged is a punishment before that, but most of them do not know.","transliteration":"wa-inna lilladhīna ẓalamū ʿadhāban dūna dhālika walākinna aktharahum lā yaʿlamūna","audioUrl":"/audio/7/052047.mp3","segments":[[0,1,60,1690],[1,2,1700,3010],[2,3,3020,3870],[3,4,3880,5710],[4,5,5720,6430],[5,6,6440,7370],[6,7,7380,9380],[7,8,9390,10720],[8,9,10730,11170],[9,10,11180,14140]],"words":[{"position":1,"text":"وَإِنَّ","translation":"And indeed","transliteration":"wa-inna"},{"position":2,"text":"لِلَّذِينَ","translation":"for those who","transliteration":"lilladhīna"},{"position":3,"text":"ظَلَمُوا۟","translation":"do wrong","transliteration":"ẓalamū"},{"position":4,"text":"عَذَابًۭا","translation":"(is) a punishment","transliteration":"ʿadhāban"},{"position":5,"text":"دُونَ","translation":"before","transliteration":"dūna"},{"position":6,"text":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":7,"text":"وَلَـٰكِنَّ","translation":"but","transliteration":"walākinna"},{"position":8,"text":"أَكْثَرَهُمْ","translation":"most of them","transliteration":"aktharahum"},{"position":9,"text":"لَا","translation":"(do) not","transliteration":"lā"},{"position":10,"text":"يَعْلَمُونَ","translation":"know","transliteration":"yaʿlamūna"}]},{"id":4783,"verseKey":"52:48","verseNumber":48,"arabic":"وَٱصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا ۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُ","translation":"And be patient, [O Muḥammad], for the decision of your Lord, for indeed, you are in Our eyes [i.e., sight]. And exalt [Allāh] with praise of your Lord when you arise","transliteration":"wa-iṣ'bir liḥuk'mi rabbika fa-innaka bi-aʿyuninā wasabbiḥ biḥamdi rabbika ḥīna taqūmu","audioUrl":"/audio/7/052048.mp3","segments":[[0,1,50,860],[1,2,870,1760],[2,3,1770,2670],[3,4,2680,4810],[4,5,4820,7000],[5,6,7010,8010],[6,7,8020,8890],[7,8,8900,9880],[8,9,9890,10580],[9,10,10590,13490]],"words":[{"position":1,"text":"وَٱصْبِرْ","translation":"So be patient","transliteration":"wa-iṣ'bir"},{"position":2,"text":"لِحُكْمِ","translation":"for (the) Command","transliteration":"liḥuk'mi"},{"position":3,"text":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"text":"فَإِنَّكَ","translation":"for indeed, you","transliteration":"fa-innaka"},{"position":5,"text":"بِأَعْيُنِنَا ۖ","translation":"(are) in Our Eyes","transliteration":"bi-aʿyuninā"},{"position":6,"text":"وَسَبِّحْ","translation":"And glorify","transliteration":"wasabbiḥ"},{"position":7,"text":"بِحَمْدِ","translation":"(the) praise","transliteration":"biḥamdi"},{"position":8,"text":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":9,"text":"حِينَ","translation":"when","transliteration":"ḥīna"},{"position":10,"text":"تَقُومُ","translation":"you arise","transliteration":"taqūmu"}]},{"id":4784,"verseKey":"52:49","verseNumber":49,"arabic":"وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَإِدْبَـٰرَ ٱلنُّجُومِ","translation":"And in a part of the night exalt Him and after [the setting of] the stars.","transliteration":"wamina al-layli fasabbiḥ'hu wa-id'bāra l-nujūmi","audioUrl":"/audio/7/052049.mp3","segments":[[0,1,30,670],[1,2,680,1630],[2,3,1640,3130],[3,4,3140,4750],[4,5,4760,8710]],"words":[{"position":1,"text":"وَمِنَ","translation":"And of","transliteration":"wamina"},{"position":2,"text":"ٱلَّيْلِ","translation":"the night","transliteration":"al-layli"},{"position":3,"text":"فَسَبِّحْهُ","translation":"glorify Him","transliteration":"fasabbiḥ'hu"},{"position":4,"text":"وَإِدْبَـٰرَ","translation":"and after","transliteration":"wa-id'bāra"},{"position":5,"text":"ٱلنُّجُومِ","translation":"the stars","transliteration":"l-nujūmi"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
