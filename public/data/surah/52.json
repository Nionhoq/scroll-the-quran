lation":"This","transliteration":"hādhihi"},{"position":2,"text":"ٱلنَّارُ","translation":"(is) the Fire","transliteration":"l-nāru"},{"position":3,"text":"ٱلَّتِى","translation":"which","transliteration":"allatī"},{"position":4,"text":"كُنتُم","translation":"you used to","transliteration":"kuntum"},{"position":5,"text":"بِهَا","translation":"[of it]","transliteration":"bihā"},{"position":6,"text":"تُكَذِّبُونَ","translation":"deny","transliteration":"tukadhibūna"}]},{"id":4750,"verseKey":"52:15","verseNumber":15,"arabic":"أَفَسِحْرٌ هَـٰذَآ أَمْ أَنتُمْ لَا تُبْصِرُونَ","translation":"Then is this magic, or do you not see?","transliteration":"afasiḥ'run hādhā am antum lā tub'ṣirūna","audioUrl":"/audio/7/052015.mp3","segments":[[0,1,30,1240],[1,2,1250,1780],[2,3,1790,3920],[3,4,3930,5520],[4,5,5530,5950],[5,6,5960,9150]],"words":[{"position":1,"text":"أَفَسِحْرٌ","translation":"Then is this magic","transliteration":"afasiḥ'run"},{"position":2,"text":"هَـٰذَآ","translation":"Then is this magic","transliteration":"hādhā"},{"position":3,"text":"أَمْ","translation":"or","transliteration":"am"},{"position":4,"text":"أَنتُمْ","translation":"you","transliteration":"antum"},{"position":5,"text":"لَا","translation":"(do) not","transliteration":"lā"},{"position":6,"text":"تُبْصِرُونَ","translation":"see","transliteration":"tub'ṣirūna"}]},{"id":4751,"verseKey":"52:16","verseNumber":16,"arabic":"ٱصْلَوْهَا فَٱصْبِرُوٓا۟ أَوْ لَا تَصْبِرُوا۟ سَوَآءٌ عَلَيْكُمْ ۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ","translation":"[Enter to] burn therein; then be patient or impatient - it is all the same for you. You are only being recompensed [for] what you used to do.\"","transliteration":"iṣ'lawhā fa-iṣ'birū aw lā taṣbirū sawāon ʿalaykum innamā tuj'zawna mā kuntum taʿmalūna","audioUrl":"/audio/7/052016.mp3","segments":[[0,1,30,1260],[1,2,1270,4080],[2,3,4090,4480],[3,4,4490,4870],[4,5,4880,5970],[5,6,5980,8520],[6,7,8530,10120],[7,8,10130,11970],[8,9,11980,13130],[9,10,13140,13590],