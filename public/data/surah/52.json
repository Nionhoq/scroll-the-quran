fīhi"},{"position":6,"text":"فَلْيَأْتِ","translation":"Then let bring","transliteration":"falyati"},{"position":7,"text":"مُسْتَمِعُهُم","translation":"their listener","transliteration":"mus'tamiʿuhum"},{"position":8,"text":"بِسُلْطَـٰنٍۢ","translation":"an authority","transliteration":"bisul'ṭānin"},{"position":9,"text":"مُّبِينٍ","translation":"clear","transliteration":"mubīnin"}]},{"id":4774,"verseKey":"52:39","verseNumber":39,"arabic":"أَمْ لَهُ ٱلْبَنَـٰتُ وَلَكُمُ ٱلْبَنُونَ","translation":"Or has He daughters while you have sons?","transliteration":"am lahu l-banātu walakumu l-banūna","audioUrl":"/audio/7/052039.mp3","segments":[[0,1,40,390],[1,2,400,860],[2,3,870,2050],[3,4,2060,2920],[4,5,2930,5790]],"words":[{"position":1,"text":"أَمْ","translation":"Or","transliteration":"am"},{"position":2,"text":"لَهُ","translation":"for Him","transliteration":"lahu"},{"position":3,"text":"ٱلْبَنَـٰتُ","translation":"(are) daughters","transliteration":"l-banātu"},{"position":4,"text":"وَلَكُمُ","translation":"while for you","transliteration":"walakumu"},{"position":5,"text":"ٱلْبَنُونَ","translation":"(are) sons","transliteration":"l-banūna"}]},{"id":4775,"verseKey":"52:40","verseNumber":40,"arabic":"أَمْ تَسْـَٔلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ","translation":"Or do you, [O Muḥammad], ask of them a payment, so they are by debt burdened down?","transliteration":"am tasaluhum ajran fahum min maghramin muth'qalūna","audioUrl":"/audio/7/052040.mp3","segments":[[0,1,80,480],[1,2,490,1760],[2,3,1770,3360],[3,4,3370,4950],[4,5,4960,5900],[5,6,5910,7980],[6,7,7990,10730]],"words":[{"position":1,"text":"أَمْ","translation":"Or","transliteration":"am"},{"position":2,"text":"تَسْـَٔلُهُمْ","translation":"(do) you ask from them","transliteration":"tasaluhum"},{"position":3,"text":"أَجْرًۭا","translation":"a payment","transliteration":"ajran"},{"position":4,"text":"فَهُم","translation":"so they","transliteration":"fahum"},{"position":5,"text":"مِّن","translation":"f