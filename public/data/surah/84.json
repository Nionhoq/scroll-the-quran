{"chapter":{"id":84,"nameSimple":"Al-Inshiqaq","nameArabic":"الإنشقاق","translatedName":"The Sundering","versesCount":25,"revelationPlace":"makkah"},"verses":[{"id":5885,"verseKey":"84:1","verseNumber":1,"arabic":" إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","translation":"When the sky has split [open]","transliteration":"idhā l-samāu inshaqqat","audioUrl":"/audio/7/084001.mp3","segments":[[0,1,30,350],[1,2,360,3260],[2,3,3270,5030]],"words":[{"position":1,"text":"إِذَا","translation":"When","transliteration":"idhā"},{"position":2,"text":"ٱلسَّمَآءُ","translation":"the sky","transliteration":"l-samāu"},{"position":3,"text":"ٱنشَقَّتْ","translation":"is split asunder","transliteration":"inshaqqat"}]},{"id":5886,"verseKey":"84:2","verseNumber":2,"arabic":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","translation":"And has listened [i.e., responded] to its Lord and was obligated [to do so]","transliteration":"wa-adhinat lirabbihā waḥuqqat","audioUrl":"/audio/7/084002.mp3","segments":[[0,1,30,960],[1,2,970,2160],[2,3,2170,3250]],"words":[{"position":1,"text":"وَأَذِنَتْ","translation":"And has listened","transliteration":"wa-adhinat"},{"position":2,"text":"لِرَبِّهَا","translation":"to its Lord","transliteration":"lirabbihā"},{"position":3,"text":"وَحُقَّتْ","translation":"and was obligated","transliteration":"waḥuqqat"}]},{"id":5887,"verseKey":"84:3","verseNumber":3,"arabic":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","translation":"And when the earth has been extended","transliteration":"wa-idhā l-arḍu muddat","audioUrl":"/audio/7/084003.mp3","segments":[[0,1,30,590],[1,2,600,1460],[2,3,1470,2300]],"words":[{"position":1,"text":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"text":"ٱلْأَرْضُ","translation":"the earth","transliteration":"l-arḍu"},{"position":3,"text":"مُدَّتْ","translation":"is spread","transliteration":"muddat"}]},{"id":5888,"verseKey":"84:4","verseNumber":4,"arabic":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","translation":"And has cast out that within it and relinquis