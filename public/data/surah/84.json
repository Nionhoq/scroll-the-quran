urn to his people in happiness.","transliteration":"wayanqalibu ilā ahlihi masrūran","audioUrl":"/audio/7/084009.mp3","segments":[[0,1,30,1960],[1,2,1970,3780],[2,3,3790,4840],[3,4,4850,6200]],"words":[{"position":1,"text":"وَيَنقَلِبُ","translation":"And he will return","transliteration":"wayanqalibu"},{"position":2,"text":"إِلَىٰٓ","translation":"to","transliteration":"ilā"},{"position":3,"text":"أَهْلِهِۦ","translation":"his people","transliteration":"ahlihi"},{"position":4,"text":"مَسْرُورًۭا","translation":"happily","transliteration":"masrūran"}]},{"id":5894,"verseKey":"84:10","verseNumber":10,"arabic":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","translation":"But as for he who is given his record behind his back,","transliteration":"wa-ammā man ūtiya kitābahu warāa ẓahrihi","audioUrl":"/audio/7/084010.mp3","segments":[[0,1,30,1870],[1,2,1880,2270],[2,3,2280,3060],[3,4,3070,4360],[4,5,4370,6740],[5,6,6750,7580]],"words":[{"position":1,"text":"وَأَمَّا","translation":"But as for","transliteration":"wa-ammā"},{"position":2,"text":"مَنْ","translation":"(him) who","transliteration":"man"},{"position":3,"text":"أُوتِىَ","translation":"is given","transliteration":"ūtiya"},{"position":4,"text":"كِتَـٰبَهُۥ","translation":"his record","transliteration":"kitābahu"},{"position":5,"text":"وَرَآءَ","translation":"behind","transliteration":"warāa"},{"position":6,"text":"ظَهْرِهِۦ","translation":"his back","transliteration":"ẓahrihi"}]},{"id":5895,"verseKey":"84:11","verseNumber":11,"arabic":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا","translation":"He will cry out for destruction","transliteration":"fasawfa yadʿū thubūran","audioUrl":"/audio/7/084011.mp3","segments":[[0,1,30,710],[1,2,720,1540],[2,3,1550,2770]],"words":[{"position":1,"text":"فَسَوْفَ","translation":"Then soon","transliteration":"fasawfa"},{"position":2,"text":"يَدْعُوا۟","translation":"he will call","transliteration":"yadʿū"},{"position":3,"text":"ثُبُورًۭا","translation":"(for) destruction","transliteration":"thubūran"}]},{"id":5896,"verseKey":"84:12","verseNumber":12,"arabic":"وَيَصْلَىٰ سَعِيرًا","translation":"And [enter to] burn in a Blaze.","transliteration":"wayaṣlā saʿīran","audioUrl":"/audio/7/084012.mp3","segments":[[0,1,50,930],[1,2,940,2220]],"words":[{"position":1,"text":"وَيَصْلَىٰ","translation":"And he will burn","transliteration":"wayaṣlā"},{"position":2,"text":"سَعِيرًا","translation":"(in) a Blaze","transliteration":"saʿīran"}]},{"id":5897,"verseKey":"84:13","verseNumber":13,"arabic":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","translation":"Indeed, he had [once] been among his people in happiness;","transliteration":"innahu kāna fī ahlihi masrūran","audioUrl":"/audio/7/084013.mp3","segments":[[0,1,30,1660],[1,2,1670,2330],[2,3,2340,3970],[3,4,3980,5000],[4,5,5010,6380]],"words":[{"position":1,"text":"إِنَّهُۥ","translation":"Indeed, he","transliteration":"innahu"},{"position":2,"text":"كَانَ","translation":"had been","transliteration":"kāna"},{"position":3,"text":"فِىٓ","translation":"among","transliteration":"fī"},{"position":4,"text":"أَهْلِهِۦ","translation":"his people","transliteration":"ahlihi"},{"position":5,"text":"مَسْرُورًا","translation":"happy","transliteration":"masrūran"}]},{"id":5898,"verseKey":"84:14","verseNumber":14,"arabic":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","translation":"Indeed, he had thought he would never return [to Allāh].","transliteration":"innahu ẓanna an lan yaḥūra","audioUrl":"/audio/7/084014.mp3","segments":[[0,1,30,1540],[1,2,1550,3100],[2,3,3110,3320],[3,4,3330,4830],[4,5,4840,7460]],"words":[{"position":1,"text":"إِنَّهُۥ","translation":"Indeed, he","transliteration":"innahu"},{"position":2,"text":"ظَنَّ","translation":"(had) thought","transliteration":"ẓanna"},{"position":3,"text":"أَن","translation":"that","transliteration":"an"},{"position":4,"text":"لَّن","translation":"never","transliteration":"lan"},{"position":5,"text":"يَحُورَ","translation":"he would return","transliteration":"yaḥūra"}]},{"id":5899,"verseKey":"84:15","verseNumber":15,"arabic":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا","translation":"But yes! Indeed, his Lord was ever, of him, Seeing.","transliteration":"balā inna rabbahu kāna bihi baṣīran","audioUrl":"/audio/7/084015.mp3","segments":[[0,1,30,1280],[1,2,1290,2400],[2,3,2410,3420],[3,4,3430,4070],[4,5,4080,4720],[5,6,4730,5950]],"words":[{"position":1,"text":"بَلَىٰٓ","translation":"Yes","transliteration":"balā"},{"position":2,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":3,"text":"رَبَّهُۥ","translation":"his Lord","transliteration":"rabbahu"},{"position":4,"text":"كَانَ","translation":"was","transliteration":"kāna"},{"position":5,"text":"بِهِۦ","translation":"of him","transliteration":"bihi"},{"position":6,"text":"بَصِيرًۭا","translation":"All-Seer","transliteration":"baṣīran"}]},{"id":5900,"verseKey":"84:16","verseNumber":16,"arabic":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","translation":"So I swear by the twilight glow","transliteration":"falā uq'simu bil-shafaqi","audioUrl":"/audio/7/084016.mp3","segments":[[0,1,30,1380],[1,2,1390,2810],[2,3,2820,3780]],"words":[{"position":1,"text":"فَلَآ","translation":"But nay","transliteration":"falā"},{"position":2,"text":"أُقْسِمُ","translation":"I swear","transliteration":"uq'simu"},{"position":3,"text":"بِٱلشَّفَقِ","translation":"by the twilight glow","transliteration":"bil-shafaqi"}]},{"id":5901,"verseKey":"84:17","verseNumber":17,"arabic":"وَٱلَّيْلِ وَمَا وَسَقَ","translation":"And [by] the night and what it envelops","transliteration":"wa-al-layli wamā wasaqa","audioUrl":"/audio/7/084017.mp3","segments":[[0,1,30,1040],[1,2,1050,1640],[2,3,1650,2270]],"words":[{"position":1,"text":"وَٱلَّيْلِ","translation":"And the night","transliteration":"wa-al-layli"},{"position":2,"text":"وَمَا","translation":"and what","transliteration":"wamā"},{"position":3,"text":"وَسَقَ","translation":"it envelops","transliteration":"wasaqa"}]},{"id":5902,"verseKey":"84:18","verseNumber":18,"arabic":"وَٱلْقَ