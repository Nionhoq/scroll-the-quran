ation":"wamā hum ʿanhā bighāibīna","audioUrl":"/audio/7/082016.mp3","segments":[[0,1,30,610],[1,2,620,980],[2,3,990,1850],[3,4,1860,6280]],"words":[{"position":1,"text":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"text":"هُمْ","translation":"they","transliteration":"hum"},{"position":3,"text":"عَنْهَا","translation":"from it","transliteration":"ʿanhā"},{"position":4,"text":"بِغَآئِبِينَ","translation":"(will be) absent","transliteration":"bighāibīna"}]},{"id":5846,"verseKey":"82:17","verseNumber":17,"arabic":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","translation":"And what can make you know what is the Day of Recompense?","transliteration":"wamā adrāka mā yawmu l-dīni","audioUrl":"/audio/7/082017.mp3","segments":[[0,1,80,1700],[1,2,1710,2630],[2,3,2640,3100],[3,4,3110,3710],[4,5,3720,5930]],"words":[{"position":1,"text":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"text":"أَدْرَىٰكَ","translation":"can make you know","transliteration":"adrāka"},{"position":3,"text":"مَا","translation":"what","transliteration":"mā"},{"position":4,"text":"يَوْمُ","translation":"(is the) Day","transliteration":"yawmu"},{"position":5,"text":"ٱلدِّينِ","translation":"(of) the Judgment","transliteration":"l-dīni"}]},{"id":5847,"verseKey":"82:18","verseNumber":18,"arabic":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","translation":"Then, what can make you know what is the Day of Recompense?","transliteration":"thumma mā adrāka mā yawmu l-dīni","audioUrl":"/audio/7/082018.mp3","segments":[[0,1,30,980],[1,2,990,2270],[2,3,2280,3370],[3,4,3380,3810],[4,5,3820,4480],[5,6,4490,6790]],"words":[{"position":1,"text":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"text":"مَآ","translation":"what","transliteration":"mā"},{"position":3,"text":"أَدْرَىٰكَ","translation":"can make you know","transliteration":"adrāka"},{"position":4,"text":"مَا","translation":"what","transliteration":"mā"},{"position":5,"text":"يَوْمُ","translation":"(is the) Day","transliteration":"yawmu"},{"position":6,"text":"ٱلدِّينِ","translation":"(of) the Judgment","transliteration":"l-dīni"}]},{"id":5848,"verseKey":"82:19","verseNumber":19,"arabic":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ","translation":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allāh.","transliteration":"yawma lā tamliku nafsun linafsin shayan wal-amru yawma-idhin lillahi","audioUrl":"/audio/7/082019.mp3","segments":[[0,1,50,660],[1,2,670,1040],[2,3,1050,2010],[3,4,2020,2790],[4,5,2800,4510],[5,6,4520,6370],[6,7,6380,7480],[7,8,7490,9550],[8,9,9560,11550]],"words":[{"position":1,"text":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"text":"لَا","translation":"not","transliteration":"lā"},{"position":3,"text":"تَمْلِكُ","translation":"will have power","transliteration":"tamliku"},{"position":4,"text":"نَفْسٌۭ","translation":"a soul","transliteration":"nafsun"},{"position":5,"text":"لِّنَفْسٍۢ","translation":"for a soul","transliteration":"linafsin"},{"position":6,"text":"شَيْـًۭٔا ۖ","translation":"anything","transliteration":"shayan"},{"position":7,"text":"وَٱلْأَمْرُ","translation":"and the Command","transliteration":"wal-amru"},{"position":8,"text":"يَوْمَئِذٍۢ","translation":"that Day","transliteration":"yawma-idhin"},{"position":9,"text":"لِّلَّهِ","translation":"(will be) with Allah","transliteration":"lillahi"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
