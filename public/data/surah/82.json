{"chapter":{"id":82,"nameSimple":"Al-Infitar","nameArabic":"الإنفطار","translatedName":"The Cleaving","versesCount":19,"revelationPlace":"makkah"},"verses":[{"id":5830,"verseKey":"82:1","verseNumber":1,"arabic":" إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","translation":"When the sky breaks apart","transliteration":"idhā l-samāu infaṭarat","audioUrl":"/audio/7/082001.mp3","segments":[[0,1,30,360],[1,2,370,3140],[2,3,3150,4780]],"words":[{"position":1,"text":"إِذَا","translation":"When","transliteration":"idhā"},{"position":2,"text":"ٱلسَّمَآءُ","translation":"the sky","transliteration":"l-samāu"},{"position":3,"text":"ٱنفَطَرَتْ","translation":"(is) cleft asunder","transliteration":"infaṭarat"}]},{"id":5831,"verseKey":"82:2","verseNumber":2,"arabic":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","translation":"And when the stars fall, scattering,","transliteration":"wa-idhā l-kawākibu intatharat","audioUrl":"/audio/7/082002.mp3","segments":[[0,1,130,640],[1,2,650,1910],[2,3,1920,3860]],"words":[{"position":1,"text":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"text":"ٱلْكَوَاكِبُ","translation":"the stars","transliteration":"l-kawākibu"},{"position":3,"text":"ٱنتَثَرَتْ","translation":"scatter","transliteration":"intatharat"}]},{"id":5832,"verseKey":"82:3","verseNumber":3,"arabic":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","translation":"And when the seas are erupted","transliteration":"wa-idhā l-biḥāru fujjirat","audioUrl":"/audio/7/082003.mp3","segments":[[0,1,70,560],[1,2,570,1610],[2,3,1620,2600]],"words":[{"position":1,"text":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"text":"ٱلْبِحَارُ","translation":"the seas","transliteration":"l-biḥāru"},{"position":3,"text":"فُجِّرَتْ","translation":"are made to gush forth","transliteration":"fujjirat"}]},{"id":5833,"verseKey":"82:4","verseNumber":4,"arabic":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","translation":"And when the [contents of] graves are scattered [i.e., exposed],","transliteration":"wa-idhā l-qubūru buʿ'thirat","audioUrl":"/audio/7/082004.mp3","segments":[[0,1,100,660],[1,2,670,1760],[2,3,1770,2820]],"words":[{"position":1,"text":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"text":"ٱلْقُبُورُ","translation":"the graves","transliteration":"l-qubūru"},{"position":3,"text":"بُعْثِرَتْ","translation":"are overturned","transliteration":"buʿ'thirat"}]},{"id":5834,"verseKey":"82:5","verseNumber":5,"arabic":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","translation":"A soul will [then] know what it has put forth and kept back.","transliteration":"ʿalimat nafsun mā qaddamat wa-akharat","audioUrl":"/audio/7/082005.mp3","segments":[[0,1,30,800],[1,2,810,2360],[2,3,2370,2670],[3,4,2680,3780],[4,5,3790,5050]],"words":[{"position":1,"text":"عَلِمَتْ","translation":"Will know","transliteration":"ʿalimat"},{"position":2,"text":"نَفْسٌۭ","translation":"a soul","transliteration":"nafsun"},{"position":3,"text":"مَّا","translation":"what","transliteration":"mā"},{"position":4,"text":"قَدَّمَتْ","translation":"it has sent forth","transliteration":"qaddamat"},{"position":5,"text":"وَأَخَّرَتْ","translation":"and left behind","transliteration":"wa-akharat"}]},{"id":5835,"verseKey":"82:6","verseNumber":6,"arabic":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","translation":"O mankind, what has deceived you concerning your Lord, the Generous,","transliteration":"yāayyuhā l-insānu mā gharraka birabbika l-karīmi","audioUrl":"/audio/7/082006.mp3","segments":[[0,1,30,2650],[1,2,2660,4500],[2,3,4510,4820],[3,4,4830,5790],[4,5,5800,6820],[5,6,6830,8910]],"words":[{"position":1,"text":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلْإِنسَـٰنُ","translation":"man","transliteration":"l-insānu"},{"position":3,"text":"مَا","translation":"What","transliteration":"mā"},{"position":4,"text":"غَرَّكَ","translation":"has deceived you","transliteration":"gharraka"},{"position":5,"text":"بِرَبِّكَ","transla