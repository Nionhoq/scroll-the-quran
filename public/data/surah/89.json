{"chapter":{"id":89,"nameSimple":"Al-Fajr","nameArabic":"الفجر","translatedName":"The Dawn","versesCount":30,"revelationPlace":"makkah"},"verses":[{"id":5994,"verseKey":"89:1","verseNumber":1,"arabic":"وَٱلۡفَجۡرِ","translation":"By the dawn","transliteration":"wal-fajri","audioUrl":"/audio/7/089001.mp3","segments":[[0,1,30,790]],"words":[{"position":1,"text":"وَٱلۡفَجۡرِ","translation":"By the dawn","transliteration":"wal-fajri"}]},{"id":5995,"verseKey":"89:2","verseNumber":2,"arabic":"وَلَيَالٍ عَشۡرٖ","translation":"And [by] ten nights","transliteration":"walayālin ʿashrin","audioUrl":"/audio/7/089002.mp3","segments":[[0,1,30,1230],[1,2,1240,1850]],"words":[{"position":1,"text":"وَلَيَالٍ","translation":"And the nights","transliteration":"walayālin"},{"position":2,"text":"عَشۡرٖ","translation":"ten","transliteration":"ʿashrin"}]},{"id":5996,"verseKey":"89:3","verseNumber":3,"arabic":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ","translation":"And [by] the even [number] and the odd","transliteration":"wal-shafʿi wal-watri","audioUrl":"/audio/7/089003.mp3","segments":[[0,1,30,1040],[1,2,1050,1810]],"words":[{"position":1,"text":"وَٱلشَّفۡعِ","translation":"And the even","transliteration":"wal-shafʿi"},{"position":2,"text":"وَٱلۡوَتۡرِ","translation":"and the odd","transliteration":"wal-watri"}]},{"id":5997,"verseKey":"89:4","verseNumber":4,"arabic":"وَٱلَّيۡلِ إِذَا يَسۡرِ","translation":"And [by] the night when it passes,","transliteration":"wa-al-layli idhā yasri","audioUrl":"/audio/7/089004.mp3","segments":[[0,1,30,1080],[1,2,1090,1690],[2,3,1700,2270]],"words":[{"position":1,"text":"وَٱلَّيۡلِ","translation":"And the night","transliteration":"wa-al-layli"},{"position":2,"text":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"text":"يَسۡرِ","translation":"it passes","transliteration":"yasri"}]},{"id":5998,"verseKey":"89:5","verseNumber":5,"arabic":"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ","translation":"Is there [not] in [all] that an oath [sufficient] for one of perception?","transliteration":"hal fī dhālika qasamun lidhī ḥij'rin","audioUrl":"/audio/7/089005.mp3","segments":[[0,1,100,390],[1,2,400,890],[2,3,900,1700],[3,4,1710,2660],[4,5,2670,3190],[5,6,3200,3690]],"words":[{"position":1,"text":"هَلۡ","translation":"Is","transliteration":"hal"},{"position":2,"text":"فِي","translation":"in","transliteration":"fī"},{"position":3,"text":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":4,"text":"قَسَمٞ","translation":"(not) an oath","transliteration":"qasamun"},{"position":5,"text":"لِّذِي","translation":"for those","transliteration":"lidhī"},{"position":6,"text":"حِجۡرٍ","translation":"who understand","transliteration":"ḥij'rin"}]},{"id":5999,"verseKey":"89:6","verseNumber":6,"arabic":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ","translation":"Have you not considered how your Lord dealt with ʿAad -","transliteration":"alam tara kayfa faʿala rabbuka biʿādin","audioUrl":"/audio/7/089006.mp3","segments":[[0,1,30,530],[1,2,540,960],[2,3,970,1600],[3,4,1610,2290],[4,5,2300,3130],[5,6,3140,5330]],"words":[{"position":1,"text":"أَلَمۡ","translation":"Did not","transliteration":"alam"},{"position":2,"text":"تَرَ","translation":"you see","transliteration":"tara"},{"position":3,"text":"كَيۡفَ","translation":"how","transliteration":"kayfa"},{"position":4,"text":"فَعَلَ","translation":"dealt","transliteration":"faʿala"},{"position":5,"text":"رَبُّكَ","translation":"your Lord","transliteration":"rabbuka"},{"position":6,"text":"بِعَادٍ","translation":"with Aad","transliteration":"biʿādin"}]},{"id":6000,"verseKey":"89:7","verseNumber":7,"arabic":"إِرَمَ ذَاتِ ٱلۡعِمَادِ","translation":"[With] Iram - who had lofty pillars,","transliteration":"irama dhāti l-ʿimādi","audioUrl":"/audio/7/089007.mp3","segments":[[0,1,30,540],[1,2,550,1240],[2,3,1250,1900]],"words":[{"position":1,"text":"إِرَمَ","translation":"Iram","transliteration":"irama"},{"position":2,"text":"ذَاتِ","translation":"possessors (of)","transliteration":"dhāti"},{"position":3,"text":"ٱلۡعِمَادِ","translation":"lofty pillars","transliteration":"l-ʿimādi"}]},{"id":6001,"verseKey":"89:8","verseNumber":8,"arabic":"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ","translation":"The likes of whom had never been created in the land?","transliteration":"allatī lam yukh'laq mith'luhā fī l-bilādi","audioUrl":"/audio/7/089008.mp3","segments":[[0,1,30,1060],[1,2,1070,1470],[2,3,1480,2390],[3,4,2400,3370],[4,5,3380,3630],[5,6,3640,6130]],"words":[{"position":1,"text":"ٱلَّتِي","translation":"Which","transliteration":"allatī"},{"position":2,"text":"لَمۡ","translation":"not","transliteration":"lam"},{"position":3,"text":"يُخۡلَقۡ","translation":"had been created","transliteration":"yukh'laq"},{"position":4,"text":"مِثۡلُهَا","translation":"like them","transliteration":"mith'luhā"},{"position":5,"text":"فِي","translation":"in","transliteration":"fī"},{"position":6,"text":"ٱلۡبِلَٰدِ","translation":"the cities","transliteration":"l-bilādi"}]},{"id":6002,"verseKey":"89:9","verseNumber":9,"arabic":"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ","translation":"And [with] Thamūd, who carved out the rocks in the valley?","transliteration":"wathamūda alladhīna jābū l-ṣakhra bil-wādi","audioUrl":"/audio/7/089009.mp3","segments":[[0,1,30,1050],[1,2,1060,2170],[2,3,2180,2810],[3,4,2820,3680],[4,5,3690,4860]],"words":[{"position":1,"text":"وَثَمُودَ","translation":"And Thamud","transliteration":"wathamūda"},{"position":2,"text":"ٱلَّذِينَ","translation":"who","transliteration":"alladhīna"},{"position":3,"text":"جَابُواْ","translation":"carved out","transliteration":"jābū"},{"position":4,"text":"ٱلصَّخۡرَ","translation":"the rocks","transliteration":"l-ṣakhra"},{"position":5,"text":"بِٱلۡوَادِ","translation":"in the valley","transliteration":"bil-wādi"}]},{"id":6003,"verseKey":"89:10","verseNumber":10,"arabic":"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ","translation":"And [with] Pharaoh, owner of the stakes?","transliteration":"wafir'ʿawna dhī l-awtādi","audioUrl":"/audio/7/089010.mp3","segments":[[0,1,30,1200],[1,2,1210,1470],[2,3,1480,2450]],"words":[{"position":1,"text":"وَفِرۡعَوۡنَ","translation":"And Firaun","transliteration":"wafir'ʿawna"},{"position":2,"text":"ذِي","translation":"owner of","transliteration":"dhī"},{"position":3,"text":"ٱلۡأَوۡتَادِ","translation":"stakes","transliteration":"l-awtādi"}]},{"id":6004,"verseKey":"89:11","verseNumber":11,"arabic":"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ","translation":"[All of] whom oppressed within the lands","transliteration":"alladhīna ṭaghaw fī l-bilādi","audioUrl":"/audio/7/089011.mp3","segments":[[0,1,30,1130],[1,2,1140,1760],[2,3,1770,2290],[3,4,2300,4860]],"words":[{"position":1,"text":"ٱلَّذِينَ","translation":"Who","transliteration":"alladhīna"},{"position":2,"text":"طَغَوۡاْ","translation":"transgressed","transliteration":"ṭaghaw"},{"position":3,"text":"فِي","translation":"in","transliteration":"fī"},{"position":4,"text":"ٱلۡبِلَٰدِ","translation":"the lands","transliteration":"l-bilādi"}]},{"id":6005,"verseKey":"89:12","verseNumber":12,"arabic":"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ","translation":"And increased therein the corruption.","transliteration":"fa-aktharū fīhā l-fasāda","audioUrl":"/audio/7/089012.mp3","segments":[[0,1,30,1190],[1,2,1200,1820],[2,3,1830,2450]],"words":[{"position":1,"text":"فَأَكۡثَرُواْ","translation":"And (made) much","transliteration":"fa-aktharū"},{"position":2,"text":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":3,"text":"ٱلۡفَسَادَ","translation":"corruption","transliteration":"l-fasāda"}]},{"id":6006,"verseKey":"89:13","verseNumber":13,"arabic":"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ","translation":"So your Lord poured upon them a scourge of punishment.","transliteration":"faṣabba ʿalayhim rabbuka sawṭa ʿadhābin","audioUrl":"/audio/7/089013.mp3","segments":[[0,1,30,820],[1,2,830,1840],[2,3,1850,2690],[3,4,2700,3360],[4,5,3370,6030]],"words":[{"position":1,"text":"فَصَبَّ","translation":"So poured","transliteration":"faṣabba"},{"position":2,"text":"عَلَيۡهِمۡ","translation":"on them","transliteration":"ʿalayhim"},{"position":3,"text":"رَبُّكَ","translation":"your Lord","transliteration":"rabbuka"},{"position":4,"text":"سَوۡطَ","translation":"scourge","transliteration":"sawṭa"},{"position":5,"text":"عَذَابٍ","translation":"(of) punishment","transliteration":"ʿadhābin"}]},{"id":6007,"verseKey":"89:14","verseNumber":14,"arabic":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ","translation":"Indeed, your Lord is in observation.","transliteration":"inna rabbaka labil-mir'ṣādi","audioUrl":"/audio/7/089014.mp3","segments":[[0,1,30,1250],[1,2,1260,2130],[2,3,2140,3430]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"رَبَّكَ","translation":"your Lord","transliteration":"rabbaka"},{"position":3,"text":"لَبِٱلۡمِرۡصَادِ","translation":"(is) surely Ever Watchful","transliteration":"labil-mir'ṣādi"}]},{"id":6008,"verseKey":"89:15","verseNumber":15,"arabic":"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ","translation":"And as for man, when his Lord tries him and [thus] is generous to him and favors him, he says, \"My Lord has honored me.\"","transliteration":"fa-ammā l-insānu idhā mā ib'talāhu rabbuhu fa-akramahu wanaʿʿamahu fayaqūlu rabbī akramani","audioUrl":"/audio/7/089015.mp3","segments":[[0,1,30,1550],[1,2,1560,3570],[2,3,3580,4230],[3,4,4240,4370],[4,5,4380,5540],[5,6,5550,6530],[6,7,6540,8060],[7,8,8070,9500],[8,9,9510,10640],[9,10,10650,13200],[10,11,13210,14230]],"words":[{"position":1,"text":"فَأَمَّا","translation":"And as for","transliteration":"fa-ammā"},{"position":2,"text":"ٱلۡإِنسَٰنُ","translation":"man","transliteration":"l-insānu"},{"position":3,"text":"إِذَا","translation":"when","transliteration":"idhā"},{"position":4,"text":"مَا","translation":"does","transliteration":"mā"},{"position":5,"text":"ٱبۡتَلَىٰهُ","translation":"try him","transliteration":"ib'talāhu"},{"position":6,"text":"رَبُّهُۥ","translation":"his Lord","transliteration":"rabbuhu"},{"position":7,"text":"فَأَكۡرَمَهُۥ","translation":"and is generous to him","transliteration":"fa-akramahu"},{"position":8,"text":"وَنَعَّمَهُۥ","translation":"and favors him","transliteration":"wanaʿʿamahu"},{"position":9,"text":"فَيَقُولُ","translation":"he says","transliteration":"fayaqūlu"},{"position":10,"text":"رَبِّيٓ","translation":"My Lord","transliteration":"rabbī"},{"position":11,"text":"أَكۡرَمَنِ","translation":"has honored me","transliteration":"akramani"}]},{"id":6009,"verseKey":"89:16","verseNumber":16,"arabic":"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ","translation":"But when He tries him and restricts his provision, he says, \"My Lord has humiliated me.\"","transliteration":"wa-ammā idhā mā ib'talāhu faqadara ʿalayhi riz'qahu fayaqūlu rabbī ahānani","audioUrl":"/audio/7/089016.mp3","segments":[[0,1,30,1550],[1,2,1560,3740],[2,3,3750,3880],[3,4,3890,4970],[4,5,4980,5870],[5,6,5880,6740],[6,7,6750,7770],[7,8,7780,8880],[8,9,8890,11030],[9,10,11040,12080]],"words":[{"position":1,"text":"وَأَمَّآ","translation":"But","transliteration":"wa-ammā"},{"position":2,"text":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"text":"مَا","translation":"does","transliteration":"mā"},{"position":4,"text":"ٱبۡتَلَىٰهُ","translation":"He try him","transliteration":"ib'talāhu"},{"position":5,"text":"فَقَدَرَ","translation":"and restricts","transliteration":"faqadara"},{"position":6,"text":"عَلَيۡهِ","translation":"for him","transliteration":"ʿalayhi"},{"position":7,"text":"رِزۡقَهُۥ","translation":"his provision","transliteration":"riz'qahu"},{"position":8,"text":"فَيَقُولُ","translation":"then he says","transliteration":"fayaqūlu"},{"position":9,"text":"رَبِّيٓ","translation":"My Lord","transliteration":"rabbī"},{"position":10,"text":"أَهَٰنَنِ","translation":"(has) humiliated me","transliteration":"ahānani"}]},{"id":6010,"verseKey":"89:17","verseNumber":17,"arabic":"كـَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ","translation":"No! But you do not honor the orphan","transliteration":"kallā bal lā tuk'rimūna l-yatīma","audioUrl":"/audio/7/089017.mp3","segments":[[0,1,30,1240],[1,2,1250,1730],[2,3,1740,2010],[3,4,2020,3350],[4,5,3360,6510]],"words":[{"position":1,"text":"كـَلَّاۖ","translation":"Nay","transliteration":"kallā"},{"position":2,"text":"بَل","translation":"But","transliteration":"bal"},{"position":3,"text":"لَّا","translation":"not","transliteration":"lā"},{"position":4,"text":"تُكۡرِمُونَ","translation":"you honor","transliteration":"tuk'rimūna"},{"position":5,"text":"ٱلۡيَتِيمَ","translation":"the orphan","transliteration":"l-yatīma"}]},{"id":6011,"verseKey":"89:18","verseNumber":18,"arabic":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","translation":"And you do not encourage one another to feed the poor.","transliteration":"walā taḥāḍḍūna ʿalā ṭaʿāmi l-mis'kīni","audioUrl":"/audio/7/089018.mp3","segments":[[0,1,30,590],[1,2,600,4260],[2,3,4270,4950],[3,4,4960,5840],[4,5,5850,9050]],"words":[{"position":1,"text":"وَلَا","translation":"And not","transliteration":"walā"},{"position":2,"text":"تَحَٰٓضُّونَ","translation":"you feel the urge","transliteration":"taḥāḍḍūna"},{"position":3,"text":"عَلَىٰ","translation":"to","transliteration":"ʿalā"},{"position":4,"text":"طَعَامِ","translation":"feed","transliteration":"ṭaʿāmi"},{"position":5,"text":"ٱلۡمِسۡكِينِ","translation":"the poor","transliteration":"l-mis'kīni"}]},{"id":6012,"verseKey":"89:19","verseNumber":19,"arabic":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا","translation":"And you consume inheritance, devouring [it] altogether,","transliteration":"watakulūna l-turātha aklan lamman","audioUrl":"/audio/7/089019.mp3","segments":[[0,1,30,1420],[1,2,1430,2460],[2,3,2470,2880],[3,4,2890,5100]],"words":[{"position":1,"text":"وَتَأۡكُلُونَ","translation":"And you consume","transliteration":"watakulūna"},{"position":2,"text":"ٱلتُّرَاثَ","translation":"the inheritance","transliteration":"l-turātha"},{"position":3,"text":"أَكۡلٗا","translation":"devouring","transliteration":"aklan"},{"position":4,"text":"لَّمّٗا","translation":"altogether","transliteration":"lamman"}]},{"id":6013,"verseKey":"89:20","verseNumber":20,"arabic":"وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا","translation":"And you love wealth with immense love.","transliteration":"watuḥibbūna l-māla ḥubban jamman","audioUrl":"/audio/7/089020.mp3","segments":[[0,1,30,1400],[1,2,1410,2240],[2,3,2250,2980],[3,4,2990,4120]],"words":[{"position":1,"text":"وَتُحِبُّونَ","translation":"And you love","transliteration":"watuḥibbūna"},{"position":2,"text":"ٱلۡمَالَ","translation":"wealth","transliteration":"l-māla"},{"position":3,"text":"حُبّٗا","translation":"(with) love","transliteration":"ḥubban"},{"position":4,"text":"جَمّٗا","translation":"immense","transliteration":"jamman"}]},{"id":6014,"verseKey":"89:21","verseNumber":21,"arabic":"كـَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا","translation":"No! When the earth has been leveled - pounded and crushed","transliteration":"kallā idhā dukkati l-arḍu dakkan dakkan","audioUrl":"/audio/7/089021.mp3","segments":[[0,1,30,1420],[1,2,1430,1940],[2,3,1950,2810],[3,4,2820,3640],[4,5,3650,5340],[5,6,5350,6400]],"words":[{"position":1,"text":"كـَلَّآۖ","translation":"Nay","transliteration":"kallā"},{"position":2,"text":"إِذَا","translation":"When","transliteration":"idhā"},{"position":3,"text":"دُكَّتِ","translation":"is leveled","transliteration":"dukkati"},{"position":4,"text":"ٱلۡأَرۡضُ","translation":"the earth","transliteration":"l-arḍu"},{"position":5,"text":"دَكّٗا","translation":"pounded","transliteration":"dakkan"},{"position":6,"text":"دَكّٗا","translation":"(and) crushed","transliteration":"dakkan"}]},{"id":6015,"verseKey":"89:22","verseNumber":22,"arabic":"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا","translation":"And your Lord has come and the angels, rank upon rank,","transliteration":"wajāa rabbuka wal-malaku ṣaffan ṣaffan","audioUrl":"/audio/7/089022.mp3","segments":[[0,1,30,2200],[1,2,2210,3170],[2,3,3180,4200],[3,4,4210,5880],[4,5,5890,6930]],"words":[{"position":1,"text":"وَجَآءَ","translation":"And comes","transliteration":"wajāa"},{"position":2,"text":"رَبُّكَ","translation":"your Lord","transliteration":"rabbuka"},{"position":3,"text":"وَٱلۡمَلَكُ","translation":"and the Angels","transliteration":"wal-malaku"},{"position":4,"text":"صَفّٗا","translation":"rank","transliteration":"ṣaffan"},{"position":5,"text":"صَفّٗا","translation":"(upon) rank","transliteration":"ṣaffan"}]},{"id":6016,"verseKey":"89:23","verseNumber":23,"arabic":"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ","translation":"And brought [within view], that Day, is Hell - that Day, man will remember, but how [i.e., what good] to him will be the remembrance?","transliteration":"wajīa yawma-idhin bijahannama yawma-idhin yatadhakkaru l-insānu wa-annā lahu l-dhik'rā","audioUrl":"/audio/7/089023.mp3","segments":[[0,1,30,2330],[1,2,2340,4400],[2,3,4410,7370],[3,4,7380,9300],[4,5,9310,10510],[5,6,10520,12640],[6,7,12650,14430],[7,8,14440,14880],[8,9,14890,16260]],"words":[{"position":1,"text":"وَجِاْيٓءَ","translation":"And is brought","transliteration":"wajīa"},{"position":2,"text":"يَوۡمَئِذِۭ","translation":"that Day","transliteration":"yawma-idhin"},{"position":3,"text":"بِجَهَنَّمَۚ","translation":"Hell","transliteration":"bijahannama"},{"position":4,"text":"يَوۡمَئِذٖ","translation":"That Day","transliteration":"yawma-idhin"},{"position":5,"text":"يَتَذَكَّرُ","translation":"will remember","transliteration":"yatadhakkaru"},{"position":6,"text":"ٱلۡإِنسَٰنُ","translation":"man","transliteration":"l-insānu"},{"position":7,"text":"وَأَنَّىٰ","translation":"but how","transliteration":"wa-annā"},{"position":8,"text":"لَهُ","translation":"(will be) for him","transliteration":"lahu"},{"position":9,"text":"ٱلذِّكۡرَىٰ","translation":"the remembrance","transliteration":"l-dhik'rā"}]},{"id":6017,"verseKey":"89:24","verseNumber":24,"arabic":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي","translation":"He will say, \"Oh, I wish I had sent ahead [some good] for my life.\"","transliteration":"yaqūlu yālaytanī qaddamtu liḥayātī","audioUrl":"/audio/7/089024.mp3","segments":[[0,1,60,900],[1,2,910,2400],[2,3,2410,3470],[3,4,3480,4930]],"words":[{"position":1,"text":"يَقُولُ","translation":"He will say","transliteration":"yaqūlu"},{"position":2,"text":"يَٰلَيۡتَنِي","translation":"O I wish","transliteration":"yālaytanī"},{"position":3,"text":"قَدَّمۡتُ","translation":"I had sent forth","transliteration":"qaddamtu"},{"position":4,"text":"لِحَيَاتِي","translation":"for my life","transliteration":"liḥayātī"}]},{"id":6018,"verseKey":"89:25","verseNumber":25,"arabic":"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ","translation":"So on that Day, none will punish [as severely] as His punishment,","transliteration":"fayawma-idhin lā yuʿadhibu ʿadhābahu aḥadun","audioUrl":"/audio/7/089025.mp3","segments":[[0,1,30,1310],[1,2,1320,1850],[2,3,1860,2920],[3,4,2930,5850],[4,5,5860,6480]],"words":[{"position":1,"text":"فَيَوۡمَئِذٖ","translation":"So that Day","transliteration":"fayawma-idhin"},{"position":2,"text":"لَّا","translation":"not","transliteration":"lā"},{"position":3,"text":"يُعَذِّبُ","translation":"will punish","transliteration":"yuʿadhibu"},{"position":4,"text":"عَذَابَهُۥٓ","translation":"(as) His punishment","transliteration":"ʿadhābahu"},{"position":5,"text":"أَحَدٞ","translation":"anyone","transliteration":"aḥadun"}]},{"id":6019,"verseKey":"89:26","verseNumber":26,"arabic":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ","translation":"And none will bind [as severely] as His binding [of the evildoers].","transliteration":"walā yūthiqu wathāqahu aḥadun","audioUrl":"/audio/7/089026.mp3","segments":[[0,1,30,590],[1,2,600,1510],[2,3,1520,4180],[3,4,4190,4790]],"words":[{"position":1,"text":"وَلَا","translation":"And not","transliteration":"walā"},{"position":2,"text":"يُوثِقُ","translation":"will bind","transliteration":"yūthiqu"},{"position":3,"text":"وَثَاقَهُۥٓ","translation":"(as) His binding","transliteration":"wathāqahu"},{"position":4,"text":"أَحَدٞ","translation":"anyone","transliteration":"aḥadun"}]},{"id":6020,"verseKey":"89:27","verseNumber":27,"arabic":"يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ","translation":"[To the righteous it will be said], \"O reassured soul,","transliteration":"yāayyatuhā l-nafsu l-muṭ'ma-inatu","audioUrl":"/audio/7/089027.mp3","segments":[[0,1,40,3080],[1,2,3090,4760],[2,3,4770,7410]],"words":[{"position":1,"text":"يَٰٓأَيَّتُهَا","translation":"O","transliteration":"yāayyatuhā"},{"position":2,"text":"ٱلنَّفۡسُ","translation":"soul","transliteration":"l-nafsu"},{"position":3,"text":"ٱلۡمُطۡمَئِنَّةُ","translation":"who is satisfied","transliteration":"l-muṭ'ma-inatu"}]},{"id":6021,"verseKey":"89:28","verseNumber":28,"arabic":"ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ","translation":"Return to your Lord, well-pleased and pleasing [to Him],","transliteration":"ir'jiʿī ilā rabbiki rāḍiyatan marḍiyyatan","audioUrl":"/audio/7/089028.mp3","segments":[[0,1,30,2380],[1,2,2390,3020],[2,3,3030,3800],[3,4,3810,5880],[4,5,5890,7000]],"words":[{"position":1,"text":"ٱرۡجِعِيٓ","translation":"Return","transliteration":"ir'jiʿī"},{"position":2,"text":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":3,"text":"رَبِّكِ","translation":"your Lord","transliteration":"rabbiki"},{"position":4,"text":"رَاضِيَةٗ","translation":"well pleased","transliteration":"rāḍiyatan"},{"position":5,"text":"مَّرۡضِيَّةٗ","translation":"and pleasing","transliteration":"marḍiyyatan"}]},{"id":6022,"verseKey":"89:29","verseNumber":29,"arabic":"فَٱدۡخُلِي فِي عِبَٰدِي","translation":"And enter among My [righteous] servants","transliteration":"fa-ud'khulī fī ʿibādī","audioUrl":"/audio/7/089029.mp3","segments":[[0,1,30,970],[1,2,980,1440],[2,3,1450,2630]],"words":[{"position":1,"text":"فَٱدۡخُلِي","translation":"So enter","transliteration":"fa-ud'khulī"},{"position":2,"text":"فِي","translation":"among","transliteration":"fī"},{"position":3,"text":"عِبَٰدِي","translation":"My slaves","transliteration":"ʿibādī"}]},{"id":6023,"verseKey":"89:30","verseNumber":30,"arabic":"وَٱدۡخُلِي جَنَّتِي","translation":"And enter My Paradise.\"","transliteration":"wa-ud'khulī jannatī","audioUrl":"/audio/7/089030.mp3","segments":[[0,1,30,1040],[1,2,1050,3260]],"words":[{"position":1,"text":"وَٱدۡخُلِي","translation":"And enter","transliteration":"wa-ud'khulī"},{"position":2,"text":"جَنَّتِي","translation":"My Paradise","transliteration":"jannatī"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
