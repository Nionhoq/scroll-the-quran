,[6,7,5480,7040],[7,8,7050,7500],[8,9,7510,8100],[9,10,8110,10170],[10,11,10180,11440],[11,12,11450,13050],[12,13,13060,15400],[13,14,15410,15720],[14,15,15730,16370],[15,16,16380,17650]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"text":"كَفَرُواْ","translation":"disbelieve","transliteration":"kafarū"},{"position":4,"text":"مِنۡ","translation":"from","transliteration":"min"},{"position":5,"text":"أَهۡلِ","translation":"(the) People","transliteration":"ahli"},{"position":6,"text":"ٱلۡكِتَٰبِ","translation":"(of) the Book","transliteration":"l-kitābi"},{"position":7,"text":"وَٱلۡمُشۡرِكِينَ","translation":"and the polytheists","transliteration":"wal-mush'rikīna"},{"position":8,"text":"فِي","translation":"(will be) in","transliteration":"fī"},{"position":9,"text":"نَارِ","translation":"(the) Fire","transliteration":"nāri"},{"position":10,"text":"جَهَنَّمَ","translation":"(of) Hell","transliteration":"jahannama"},{"position":11,"text":"خَٰلِدِينَ","translation":"abiding eternally","transliteration":"khālidīna"},{"position":12,"text":"فِيهَآۚ","translation":"therein","transliteration":"fīhā"},{"position":13,"text":"أُوْلَٰٓئِكَ","translation":"Those ","transliteration":"ulāika"},{"position":14,"text":"هُمۡ","translation":"they","transliteration":"hum"},{"position":15,"text":"شَرُّ","translation":"(are the) worst","transliteration":"sharru"},{"position":16,"text":"ٱلۡبَرِيَّةِ","translation":"(of) the creatures","transliteration":"l-bariyati"}]},{"id":6137,"verseKey":"98:7","verseNumber":7,"arabic":"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ أُوْلَٰٓئِكَ هُمۡ خَيۡرُ ٱلۡبَرِيَّةِ","translation":"Indeed, they who have believed and done righteous deeds - those are the best of creatures.","transliteration":"inna alladhīna āmanū waʿamilū l-ṣāliḥāti ulāika hum khayru l-bariyati","audioUrl":"/audio/7/098007.mp3","segments