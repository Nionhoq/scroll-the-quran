200,23900],[20,21,23910,24630]],"words":[{"position":1,"text":"جَزَآؤُهُمۡ","translation":"Their reward","transliteration":"jazāuhum"},{"position":2,"text":"عِندَ","translation":"(is) with","transliteration":"ʿinda"},{"position":3,"text":"رَبِّهِمۡ","translation":"their Lord ","transliteration":"rabbihim"},{"position":4,"text":"جَنَّٰتُ","translation":"Gardens","transliteration":"jannātu"},{"position":5,"text":"عَدۡنٖ","translation":"(of) Eternity","transliteration":"ʿadnin"},{"position":6,"text":"تَجۡرِي","translation":"flow","transliteration":"tajrī"},{"position":7,"text":"مِن","translation":"from","transliteration":"min"},{"position":8,"text":"تَحۡتِهَا","translation":"underneath them","transliteration":"taḥtihā"},{"position":9,"text":"ٱلۡأَنۡهَٰرُ","translation":"the rivers","transliteration":"l-anhāru"},{"position":10,"text":"خَٰلِدِينَ","translation":"will abide","transliteration":"khālidīna"},{"position":11,"text":"فِيهَآ","translation":"therein","transliteration":"fīhā"},{"position":12,"text":"أَبَدٗاۖ","translation":"forever","transliteration":"abadan"},{"position":13,"text":"رَّضِيَ","translation":"(will be) pleased","transliteration":"raḍiya"},{"position":14,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":15,"text":"عَنۡهُمۡ","translation":"with them","transliteration":"ʿanhum"},{"position":16,"text":"وَرَضُواْ","translation":"and they (will be) pleased","transliteration":"waraḍū"},{"position":17,"text":"عَنۡهُۚ","translation":"with Him","transliteration":"ʿanhu"},{"position":18,"text":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":19,"text":"لِمَنۡ","translation":"(is) for whoever","transliteration":"liman"},{"position":20,"text":"خَشِيَ","translation":"feared","transliteration":"khashiya"},{"position":21,"text":"رَبَّهُۥ","translation":"his Lord","transliteration":"rabbahu"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
