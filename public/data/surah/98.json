{"chapter":{"id":98,"nameSimple":"Al-Bayyinah","nameArabic":"البينة","translatedName":"The Clear Proof","versesCount":8,"revelationPlace":"madinah"},"verses":[{"id":6131,"verseKey":"98:1","verseNumber":1,"arabic":"لَمۡ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ وَٱلۡمُشۡرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأۡتِيَهُمُ ٱلۡبَيِّنَةُ","translation":"Those who disbelieved among the People of the Scripture and the polytheists were not to be parted [from misbelief] until there came to them clear evidence","transliteration":"lam yakuni alladhīna kafarū min ahli l-kitābi wal-mush'rikīna munfakkīna ḥattā tatiyahumu l-bayinatu","audioUrl":"/audio/7/098001.mp3","segments":[[0,1,300,590],[1,2,600,1200],[2,3,1210,2120],[3,4,2130,2950],[4,5,2960,3340],[5,6,3350,3960],[6,7,3970,4940],[7,8,4950,6510],[8,9,6520,8730],[9,10,8740,9540],[10,11,9550,10800],[11,12,10810,11860]],"words":[{"position":1,"text":"لَمۡ","translation":"Not","transliteration":"lam"},{"position":2,"text":"يَكُنِ","translation":"were","transliteration":"yakuni"},{"position":3,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":4,"text":"كَفَرُواْ","translation":"disbelieved","transliteration":"kafarū"},{"position":5,"text":"مِنۡ","translation":"from","transliteration":"min"},{"position":6,"text":"أَهۡلِ","translation":"(the) People","transliteration":"ahli"},{"position":7,"text":"ٱلۡكِتَٰبِ","translation":"of the Book","transliteration":"l-kitābi"},{"position":8,"text":"وَٱلۡمُشۡرِكِينَ","translation":"and the polytheists","transliteration":"wal-mush'rikīna"},{"position":9,"text":"مُنفَكِّينَ","translation":"to be abandoned","transliteration":"munfakkīna"},{"position":10,"text":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":11,"text":"تَأۡتِيَهُمُ","translation":"(there) comes to them","transliteration":"tatiyahumu"},{"position":12,"text":"ٱلۡبَيِّنَةُ","translation":"the clear evidence","transliteration":"l-bayinatu"}]},{"id":6132,"verseKey":"98:2","verseNumber":2,"arabic":"رَسُولٞ مِّنَ ٱللَّهِ يَتۡلُواْ صُحُفٗا مُّطَهَّرَةٗ","translation":"A Messenger from Allāh, reciting purified scriptures","transliteration":"rasūlun mina l-lahi yatlū ṣuḥufan muṭahharatan","audioUrl":"/audio/7/098002.mp3","segments":[[0,1,150,1980],[1,2,1990,2290],[2,3,2300,3110],[3,4,3120,3800],[4,5,3810,5520],[5,6,5530,6520]],"words":[{"position":1,"text":"رَسُولٞ","translation":"A Messenger","transliteration":"rasūlun"},{"position":2,"text":"مِّنَ","translation":"from","transliteration":"mina"},{"position":3,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":4,"text":"يَتۡلُواْ","translation":"reciting","transliteration":"yatlū"},{"position":5,"text":"صُحُفٗا","translation":"pages","transliteration":"ṣuḥufan"},{"position":6,"text":"مُّطَهَّرَةٗ","translation":"purified","transliteration":"muṭahharatan"}]},{"id":6133,"verseKey":"98:3","verseNumber":3,"arabic":"فِيهَا كُتُبٞ قَيِّمَةٞ","translation":"Within which are correct writings [i.e., rulings and laws].","transliteration":"fīhā kutubun qayyimatun","audioUrl":"/audio/7/098003.mp3","segments":[[0,1,30,770],[1,2,780,2400],[2,3,2410,3460]],"words":[{"position":1,"text":"فِيهَا","translation":"Wherein","transliteration":"fīhā"},{"position":2,"text":"كُتُبٞ","translation":"(are) writings","transliteration":"kutubun"},{"position":3,"text":"قَيِّمَةٞ","translation":"correct","transliteration":"qayyimatun"}]},{"id":6134,"verseKey":"98:4","verseNumber":4,"arabic":"وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ إِلَّا مِنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَةُ","translation":"Nor did those who were given the Scripture become divided until after there had come to them clear evidence.","transliteration":"wamā tafarraqa alladhīna ūtū l-kitāba illā min baʿdi mā jāathumu l-bayinatu","audioUrl":"/audio/7/098004.mp3","segments":[[0,1,200,690],[1,2,700,1710],[2,3,1720,2730],[3,4,2740,3310],[4,5,3320,4330],[5,6,4340,5150],[6,7,5160,6190],[7,8,6200,6860],[8,9,6870,7190],[9,10,7200,9910],[10,11,9920,11030]],"words":[{"position":1,"text":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"text":"تَفَرَّقَ","translation":"became divided","transliteration":"tafarraqa"},{"position":3,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":4,"text":"أُوتُواْ","translation":"were given","transliteration":"ūtū"},{"position":5,"text":"ٱلۡكِتَٰبَ","translation":"the Book","transliteration":"l-kitāba"},{"position":6,"text":"إِلَّا","translation":"until","transliteration":"illā"},{"position":7,"text":"مِنۢ","translation":"from","transliteration":"min"},{"position":8,"text":"بَعۡدِ","translation":"after","transliteration":"baʿdi"},{"position":9,"text":"مَا","translation":"what","transliteration":"mā"},{"position":10,"text":"جَآءَتۡهُمُ","translation":"came (to) them","transliteration":"jāathumu"},{"position":11,"text":"ٱلۡبَيِّنَةُ","translation":"(of) the clear evidence","transliteration":"l-bayinatu"}]},{"id":6135,"verseKey":"98:5","verseNumber":5,"arabic":"وَمَآ أُمِرُوٓاْ إِلَّا لِيَعۡبُدُواْ ٱللَّهَ مُخۡلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُواْ ٱلصَّلَوٰةَ وَيُؤۡتُواْ ٱلزَّكَوٰةَۚ وَذَٰلِكَ دِينُ ٱلۡقَيِّمَةِ","translation":"And they were not commanded except to worship Allāh, [being] sincere to Him in religion, inclining to truth, and to establish prayer and to give zakāh. And that is the correct religion.","transliteration":"wamā umirū illā liyaʿbudū l-laha mukh'liṣīna lahu l-dīna ḥunafāa wayuqīmū l-ṣalata wayu'tū l-zakata wadhālika dīnu l-qayimati","audioUrl":"/audio/7/098005.mp3","segments":[[0,1,200,1860],[1,2,1870,3860],[2,3,3870,4620],[3,4,4630,5660],[4,5,5670,6440],[5,6,6450,7680],[6,7,7690,8040],[7,8,8050,8810],[8,9,8820,11320],[9,10,11330,12310],[10,11,12320,13390],[11,12,13400,14180],[12,13,14190,17160],[13,14,17170,18180],[14,15,18190,18820],[15,16,18830,19860]],"words":[{"position":1,"text":"وَمَآ","translation":"And not","transliteration":"wamā"},{"position":2,"text":"أُمِرُوٓاْ"