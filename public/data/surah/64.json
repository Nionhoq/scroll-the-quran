{"chapter":{"id":64,"nameSimple":"At-Taghabun","nameArabic":"التغابن","translatedName":"The Mutual Disillusion","versesCount":18,"revelationPlace":"madinah"},"verses":[{"id":5200,"verseKey":"64:1","verseNumber":1,"arabic":" يُسَبِّحُ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۖ لَهُ ٱلْمُلْكُ وَلَهُ ٱلْحَمْدُ ۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","translation":"Whatever is in the heavens and whatever is on the earth is exalting Allāh. To Him belongs dominion, and to Him belongs [all] praise, and He is over all things competent.","transliteration":"yusabbiḥu lillahi mā fī l-samāwāti wamā fī l-arḍi lahu l-mul'ku walahu l-ḥamdu wahuwa ʿalā kulli shayin qadīrun","audioUrl":"/audio/7/064001.mp3","segments":[[0,1,30,1000],[1,2,1010,2030],[2,3,2040,2340],[3,4,2350,2560],[4,5,2570,4070],[5,6,4080,4640],[6,7,4650,4910],[7,8,4920,5740],[8,9,5750,6130],[9,10,6140,6980],[10,11,6990,7560],[11,12,7570,8440],[12,13,8450,9050],[13,14,9060,9630],[14,15,9640,10290],[15,16,10300,12020],[16,17,12030,14280]],"words":[{"position":1,"text":"يُسَبِّحُ","translation":"Glorifies","transliteration":"yusabbiḥu"},{"position":2,"text":"لِلَّهِ","translation":"[to] Allah","transliteration":"lillahi"},{"position":3,"text":"مَا","translation":"whatever","transliteration":"mā"},{"position":4,"text":"فِى","translation":"(is) in","transliteration":"fī"},{"position":5,"text":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":6,"text":"وَمَا","translation":"and whatever","transliteration":"wamā"},{"position":7,"text":"فِى","translation":"(is) in","transliteration":"fī"},{"position":8,"text":"ٱلْأَرْضِ ۖ","translation":"the earth","transliteration":"l-arḍi"},{"position":9,"text":"لَهُ","translation":"For Him","transliteration":"lahu"},{"position":10,"text":"ٱلْمُلْكُ","translation":"(is the) dominion","transliteration":"l-mul'ku"},{"position":11,"text":"وَلَهُ","translation":"and for Him","transliteration":"walahu"},{"position":12,"text":"ٱلْحَمْدُ ۖ","translation":"(is) the praise","transliteration":"l-ḥamdu"},{"position":13,"text":"وَهُوَ","translation":"And He","transliteration":"wahuwa"},{"position":14,"text":"عَلَىٰ","translation":"(is) on","transliteration":"ʿalā"},{"position":15,"text":"كُلِّ","translation":"every","transliteration":"kulli"},{"position":16,"text":"شَىْءٍۢ","translation":"thing","transliteration":"shayin"},{"position":17,"text":"قَدِيرٌ","translation":"All-Powerful","transliteration":"qadīrun"}]},{"id":5201,"verseKey":"64:2","verseNumber":2,"arabic":"هُوَ ٱلَّذِى خَلَقَكُمْ فَمِنكُمْ كَافِرٌ وَمِنكُم مُّؤْمِنٌ ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","translation":"It is He who created you, and among you is the disbeliever, and among you is the believer. And Allāh, of what you do, is Seeing.","transliteration":"huwa alladhī khalaqakum faminkum kāfirun waminkum mu'minun wal-lahu bimā taʿmalūna baṣīrun","audioUrl":"/audio/7/064002.mp3","segments":[[0,1,30,320],[1,2,330,1120],[2,3,1130,2150],[3,4,2160,4020],[4,5,4030,5630],[5,6,5640,8310],[6,7,8320,9520],[7,8,9530,10550],[8,9,10560,11130],[9,10,11140,12420],[10,11,12430,14420]],"words":[{"position":1,"text":"هُوَ","translation":"He","transliteration":"huwa"},{"position":2,"text":"ٱلَّذِى","translation":"(is) the One Who","transliteration":"alladhī"},{"position":3,"text":"خَلَقَكُمْ","translation":"created you","transliteration":"khalaqakum"},{"position":4,"text":"فَمِنكُمْ","translation":"and among you","transliteration":"faminkum"},{"position":5,"text":"كَافِرٌۭ","translation":"(is) a disbeliever","transliteration":"kāfirun"},{"position":6,"text":"وَمِنكُم","translation":"and among you","transliteration":"waminkum"},{"position":7,"text":"مُّؤْمِنٌۭ ۚ","translation":"(is) a believer","transliteration":"mu'minun"},{"position":8,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":9,"text":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":10,"text":"تَعْمَلُونَ","translation":"you do","transliteration":"taʿmalūna"},{"position":11,"text":"بَصِيرٌ","translation":"(is) All-Seer","transliteration":"baṣīrun"}]},{"id":5202,"verseKey":"64:3","verseNumber":3,"arabic":"خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ ۖ وَإِلَيْهِ ٱلْمَصِيرُ","translation":"He created the heavens and earth in truth and formed you and perfected your forms; and to Him is the [final] destination.","transliteration":"khalaqa l-samāwāti wal-arḍa bil-ḥaqi waṣawwarakum fa-aḥsana ṣuwarakum wa-ilayhi l-maṣīru","audioUrl":"/audio/7/064003.mp3","segments":[[0,1,150,650],[1,2,660,2090],[2,3,2100,3050],[3,4,3060,4060],[4,5,4070,5450],[5,6,5460,6420],[6,7,6430,7550],[7,8,7560,8560],[8,9,8570,10800]],"words":[{"position":1,"text":"خَلَقَ","translation":"He created","transliteration":"khalaqa"},{"position":2,"text":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":3,"text":"وَٱلْأَرْضَ","translation":"and the earth","transliteration":"wal-arḍa"},{"position":4,"text":"بِٱلْحَقِّ","translation":"with truth","transliteration":"bil-ḥaqi"},{"position":5,"text":"وَصَوَّرَكُمْ","translation":"and He formed you","transliteration":"waṣawwarakum"},{"position":6,"text":"فَأَحْسَنَ","translation":"and made good","transliteration":"fa-aḥsana"},{"position":7,"text":"صُوَرَكُمْ ۖ","translation":"your forms","transliteration":"ṣuwarakum"},{"position":8,"text":"وَإِلَيْهِ","translation":"and to Him","transliteration":"wa-ilayhi"},{"position":9,"text":"ٱلْمَصِيرُ","translation":"(is) the final return","transliteration":"l-maṣīru"}]},{"id":5203,"verseKey":"64:4","verseNumber":4,"arabic":"يَعْلَمُ مَا فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَيَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَ ۚ وَٱللَّهُ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ","translation":"He knows what is within the heavens and earth and knows what you conceal and what you declare. And Allāh is Knowing of that within the breasts.","transliteration":"yaʿlamu mā fī l-samāwāti wal-arḍi wayaʿlamu mā tusirrūna wamā tuʿ'linūna wal-lahu ʿalīmun bidhāti l-ṣudūri","audioUrl":"/audio/7/064004.mp3","segments":[[0,1,140,1020],[1,2,1030,1270],[2,3,1280,1490],[3,4,1500,2940],[4,5,2950,3940],[5,6,3950,5020],[6,7,5030,5270],[7,8,5280,6570],[8,9,6580,7120],[9,10,7130,10070],[10,11,10080,11050],[11,12,11060,12800],[12,13,12810,13600],[13,14,13610,15960]],"words":[{"position":1,"text":"يَعْلَمُ","translation":"He knows","transliteration":"yaʿlamu"},{"position":2,"text":"مَا","translation":"what","transliteration":"mā"},{"position":3,"text":"فِى","translation":"(is) in","transliteration":"fī"},{"position":4,"text":"ٱلسَّمَـٰوَٰتِ","translation":"the heavens","transliteration":"l-samāwāti"},{"position":5,"text":"وَٱلْأَرْضِ","translation":"and the earth","transliteration":"wal-arḍi"},{"position":6,"text":"وَيَعْلَمُ","translation":"and He knows","transliteration":"wayaʿlamu"},{"position":7,"text":"مَا","translation":"what","transliteration":"mā"},{"position":8,"text":"تُسِرُّونَ","translation":"you conceal","transliteration":"tusirrūna"},{"position":9,"text":"وَمَا","translation":"and what","transliteration":"wamā"},{"position":10,"text":"تُعْلِنُونَ ۚ","translation":"you declare","transliteration":"tuʿ'linūna"},{"position":11,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":12,"text":"عَلِيمٌۢ","translation":"(is) All-Knowing","transliteration":"ʿalīmun"},{"position":13,"text":"بِذَاتِ","translation":"of what","transliteration":"bidhāti"},{"position":14,"text":"ٱلصُّدُورِ","translation":"(is in) the breasts","transliteration":"l-ṣudūri"}]},{"id":5204,"verseKey":"64:5","verseNumber":5,"arabic":"أَلَمْ يَأْتِكُمْ نَبَؤُا۟ ٱلَّذِينَ كَفَرُوا۟ مِن قَبْلُ فَذَاقُوا۟ وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ","translation":"Has there not come to you the news of those who disbelieved before? So they tasted the bad consequence of their affair, and they will have a painful punishment.","transliteration":"alam yatikum naba-u alladhīna kafarū min qablu fadhāqū wabāla amrihim walahum ʿadhābun alīmun","audioUrl":"/audio/7/064005.mp3","segments":[[0,1,30,540],[1,2,550,1530],[2,3,1540,2140],[3,4,2150,3120],[4,5,3130,3930],[5,6,3940,4940],[6,7,4950,5520],[7,8,5530,6540],[8,9,6550,7340],[9,10,7350,8310],[10,11,8320,9080],[11,12,9090,10160],[12,13,10170,12410]],"words":[{"position":1,"text":"أَلَمْ","translation":"Has not","transliteration":"alam"},{"position":2,"text":"يَأْتِكُمْ","translation":"come to you","transliteration":"yatikum"},{"position":3,"text":"نَبَؤُا۟","translation":"(the) news","transliteration":"naba-u"},{"position":4,"text":"ٱلَّذِينَ","translation":"(of) those who","transliteration":"alladhīna"},{"position":5,"text":"كَفَرُوا۟","translation":"disbelieved","transliteration":"kafarū"},{"position":6,"text":"مِن","translation":"from","transliteration":"min"},{"position":7,"text":"قَبْلُ","translation":"before","transliteration":"qablu"},{"position":8,"text":"فَذَاقُوا۟","translation":"So they tasted","transliteration":"fadhāqū"},{"position":9,"text":"وَبَالَ","translation":"(the bad) consequence","transliteration":"wabāla"},{"position":10,"text":"أَمْرِهِمْ","translation":"(of) their affair","transliteration":"amrihim"},{"position":11,"text":"وَلَهُمْ","translation":"and for them","transliteration":"walahum"},{"position":12,"text":"عَذَابٌ","translation":"(is) a punishment","transliteration":"ʿadhābun"},{"position":13,"text":"أَلِيمٌۭ","translation":"painful","transliteration":"alīmun"}]},{"id":5205,"verseKey":"64:6","verseNumber":6,"arabic":"ذَٰلِكَ بِأَنَّهُۥ كَانَت تَّأْتِيهِمْ رُسُلُهُم بِٱلْبَيِّنَـٰتِ فَقَالُوٓا۟ أَبَشَرٌ يَهْدُونَنَا فَكَفَرُوا۟ وَتَوَلَّوا۟ ۚ وَّٱسْتَغْنَى ٱللَّهُ ۚ وَٱللَّهُ غَنِىٌّ حَمِيدٌ","translation":"That is because their messengers used to come to them with clear evidences, but they said, \"Shall human beings guide us?\" and disbelieved and turned away. And Allāh dispensed [with them]; and Allāh is Free of need and Praiseworthy.","transliteration":"dhālika bi-annahu kānat tatīhim rusuluhum bil-bayināti faqālū abasharun yahdūnanā fakafarū watawallaw wa-is'taghnā l-lahu wal-lahu ghaniyyun ḥamīdun","audioUrl":"/audio/7/064006.mp3","segments":[[0,1,30,840],[1,2,850,2530],[2,3,2540,3410],[3,4,3420,4590],[4,5,4600,6110],[5,6,6120,7720],[6,7,7730,11910],[7,8,11920,13500],[8,9,13510,14830],[9,10,14840,15930],[10,11,15940,17450],[11,12,17460,18450],[12,13,18460,21840],[13,14,21850,22820],[14,15,22830,23790],[15,16,23800,26180]],"words":[{"position":1,"text":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":2,"text":"بِأَنَّهُۥ","translation":"(is) because","transliteration":"bi-annahu"},{"position":3,"text":"كَانَت","translation":"had","transliteration":"kānat"},{"position":4,"text":"تَّأْتِيهِمْ","translation":"come to them","transliteration":"tatīhim"},{"position":5,"text":"رُسُلُهُم","translation":"their Messengers","transliteration":"rusuluhum"},{"position":6,"text":"بِٱلْبَيِّنَـٰتِ","translation":"with clear proofs","transliteration":"bil-bayināti"},{"position":7,"text":"فَقَالُوٓا۟","translation":"but they said","transliteration":"faqālū"},{"position":8,"text":"أَبَشَرٌۭ","translation":"Shall human beings","transliteration":"abasharun"},{"position":9,"text":"يَهْدُونَنَا","translation":"guide us","transliteration":"yahdūnanā"},{"position":10,"text":"فَكَفَرُوا۟","translation":"So they disbelieved","transliteration":"fakafarū"},{"position":11,"text":"وَتَوَلَّوا۟ ۚ","translation":"and turned away","transliteration":"watawallaw"},{"position":12,"text":"وَّٱسْتَغْنَى","translation":"And can do without them","transliteration":"wa-is'taghnā"},{"position":13,"text":"ٱللَّهُ ۚ","translation":"Allah","transliteration":"l-lahu"},{"position":14,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":15,"text":"غَنِىٌّ","translation":"(is) Self-sufficient","transliteration":"ghaniyyun"},{"position":16,"text":"حَمِيدٌۭ","translation":"Praiseworthy","transliteration":"ḥamīdun"}]},{"id":5206,"verseKey":"64:7","verseNumber":7,"arabic":"زَعَمَ ٱلَّذِينَ كَفَرُوٓا۟ أَن لَّن يُبْعَثُوا۟ ۚ قُلْ بَلَىٰ وَرَبِّى لَتُبْعَثُنَّ ثُمَّ لَتُنَبَّؤُنَّ بِمَا عَمِلْتُمْ ۚ وَذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٌ","translation":"Those who disbelieve have claimed that they will never be resurrected. Say, \"Yes, by my Lord, you will surely be resurrected; then you will surely be informed of what you did. And that, for Allāh, is easy.\"","transliteration":"zaʿama alladhīna kafarū an lan yub'ʿathū qul balā warabbī latub'ʿathunna thumma latunabba-unna bimā ʿamil'tum wadhālika ʿalā l-lahi yasīrun","audioUrl":"/audio/7/064007.mp3","segments":[[0,1,30,600],[1,2,610,1580],[2,3,1590,3880],[3,4,3890,4070],[4,5,4080,5670],[5,6,5680,7100],[6,7,7110,7480],[7,8,7490,8130],[8,9,8140,9070],[9,10,9080,11130],[10,11,11140,12420],[11,12,12430,14980],[12,13,14990,15520],[13,14,15530,17070],[14,15,17080,18050],[15,16,18060,18620],[16,17,18630,19340],[17,18,19350,21980]],"words":[{"position":1,"text":"زَعَمَ","translation":"Claim","transliteration":"zaʿama"},{"position":2,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"text":"كَفَرُوٓا۟","translation":"disbelieve","transliteration":"kafarū"},{"position":4,"text":"أَن","translation":"that","transliteration":"an"},{"position":5,"text":"لَّن","translation":"never","transliteration":"lan"},{"position":6,"text":"يُبْعَثُوا۟ ۚ","translation":"will they be raised","transliteration":"yub'ʿathū"},{"position":7,"text":"قُلْ","translation":"Say","transliteration":"qul"},{"position":8,"text":"بَلَىٰ","translation":"Yes","transliteration":"balā"},{"position":9,"text":"وَرَبِّى","translation":"by my Lord","transliteration":"warabbī"},{"position":10,"text":"لَتُبْعَثُنَّ","translation":"surely you will be raised","transliteration":"latub'ʿathunna"},{"position":11,"text":"ثُمَّ","translation":"then","transliteration":"thumma"},{"position":12,"text":"لَتُنَبَّؤُنَّ","translation":"surely you will be informed","transliteration":"latunabba-unna"},{"position":13,"text":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":14,"text":"عَمِلْتُمْ ۚ","translation":"you did","transliteration":"ʿamil'tum"},{"position":15,"text":"وَذَٰلِكَ","translation":"And that","transliteration":"wadhālika"},{"position":16,"text":"عَلَى","translation":"for","transliteration":"ʿalā"},{"position":17,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":18,"text":"يَسِيرٌۭ","translation":"(is) easy","transliteration":"yasīrun"}]},{"id":5207,"verseKey":"64:8","verseNumber":8,"arabic":"فَـَٔامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَٱلنُّورِ ٱلَّذِىٓ أَنزَلْنَا ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","translation":"So believe in Allāh and His Messenger and the light [i.e., the Qur’ān] which We have sent down. And Allāh is Aware of what you do.","transliteration":"faāminū bil-lahi warasūlihi wal-nūri alladhī anzalnā wal-lahu bimā taʿmalūna khabīrun","audioUrl":"/audio/7/064008.mp3","segments":[[0,1,30,1180],[1,2,1190,2240],[2,3,2250,3640],[3,4,3650,5220],[4,5,5230,7230],[5,6,7240,9900],[6,7,9910,10850],[7,8,10860,11420],[8,9,11430,12610],[9,10,12620,15120]],"words":[{"position":1,"text":"فَـَٔامِنُوا۟","translation":"So believe","transliteration":"faāminū"},{"position":2,"text":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":3,"text":"وَرَسُولِهِۦ","translation":"and His Messenger","transliteration":"warasūlihi"},{"position":4,"text":"وَٱلنُّورِ","translation":"and the Light","transliteration":"wal-nūri"},{"position":5,"text":"ٱلَّذِىٓ","translation":"which","transliteration":"alladhī"},{"position":6,"text":"أَنزَلْنَا ۚ","translation":"We have sent down","transliteration":"anzalnā"},{"position":7,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":8,"text":"بِمَا","translation":"of what","transliteration":"bimā"},{"position":9,"text":"تَعْمَلُونَ","translation":"you do","transliteration":"taʿmalūna"},{"position":10,"text":"خَبِيرٌۭ","translation":"(is) All-Aware","transliteration":"khabīrun"}]},{"id":5208,"verseKey":"64:9","verseNumber":9,"arabic":"يَوْمَ يَجْمَعُكُمْ لِيَوْمِ ٱلْجَمْعِ ۖ ذَٰلِكَ يَوْمُ ٱلتَّغَابُنِ ۗ وَمَن يُؤْمِنۢ بِٱللَّهِ وَيَعْمَلْ صَـٰلِحًا يُكَفِّرْ عَنْهُ سَيِّـَٔاتِهِۦ وَيُدْخِلْهُ جَنَّـٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًا ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ","translation":"The Day He will assemble you for the Day of Assembly - that is the Day of Deprivation. And whoever believes in Allāh and does righteousness - He will remove from him his misdeeds and admit him to gardens beneath which rivers flow, wherein they will abide forever. That is the great attainment.","transliteration":"yawma yajmaʿukum liyawmi l-jamʿi dhālika yawmu l-taghābuni waman yu'min bil-lahi wayaʿmal ṣāliḥan yukaffir ʿanhu sayyiātihi wayud'khil'hu jannātin tajrī min taḥtihā l-anhāru khālidīna fīhā abadan dhālika l-fawzu l-ʿaẓīmu","audioUrl":"/audio/7/064009.mp3","segments":[[0,1,150,640],[1,2,650,1880],[2,3,1890,2720],[3,4,2730,3560],[4,5,3570,4370],[5,6,4380,5010],[6,7,5020,6780],[7,8,6790,8130],[8,9,8140,9610],[9,10,9620,10610],[10,11,10620,11490],[11,12,11500,12400],[12,13,12410,14280],[13,14,14290,14900],[14,15,14910,16550],[15,16,16560,17710],[16,17,17720,25470],[17,18,25480,26310],[18,19,26320,27290],[19,20,27300,28080],[20,21,28090,29270],[21,22,29280,30530],[22,23,30540,32840],[23,24,32850,34410],[24,25,34420,35190],[25,26,35200,36030],[26,27,36040,38630]],"words":[{"position":1,"text":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"text":"يَجْمَعُكُمْ","translation":"He will assemble you","transliteration":"yajmaʿukum"},{"position":3,"text":"لِيَوْمِ","translation":"for (the) Day","transliteration":"liyawmi"},{"position":4,"text":"ٱلْجَمْعِ ۖ","translation":"(of) the Assembly","transliteration":"l-jamʿi"},{"position":5,"text":"ذَٰلِكَ","translation":"that","transliteration":"dhālika"},{"position":6,"text":"يَوْمُ","translation":"(will be the) Day","transliteration":"yawmu"},{"position":7,"text":"ٱلتَّغَابُنِ ۗ","translation":"(of) mutual loss and gain","transliteration":"l-taghābuni"},{"position":8,"text":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":9,"text":"يُؤْمِنۢ","translation":"believes","transliteration":"yu'min"},{"position":10,"text":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":11,"text":"وَيَعْمَلْ","translation":"and does","transliteration":"wayaʿmal"},{"position":12,"text":"صَـٰلِحًۭا","translation":"righteous deeds","transliteration":"ṣāliḥan"},{"position":13,"text":"يُكَفِّرْ","translation":"He will remove","transliteration":"yukaffir"},{"position":14,"text":"عَنْهُ","translation":"from him","transliteration":"ʿanhu"},{"position":15,"text":"سَيِّـَٔاتِهِۦ","translation":"his evil deeds","transliteration":"sayyiātihi"},{"position":16,"text":"وَيُدْخِلْهُ","translation":"and He will admit him","transliteration":"wayud'khil'hu"},{"position":17,"text":"جَنَّـٰتٍۢ","translation":"(to) Gardens","transliteration":"jannātin"},{"position":18,"text":"تَجْرِى","translation":"flow","transliteration":"tajrī"},{"position":19,"text":"مِن","translation":"from","transliteration":"min"},{"position":20,"text":"تَحْتِهَا","translation":"underneath it","transliteration":"taḥtihā"},{"position":21,"text":"ٱلْأَنْهَـٰرُ","translation":"the rivers","transliteration":"l-anhāru"},{"position":22,"text":"خَـٰلِدِينَ","translation":"abiding","transliteration":"khālidīna"},{"position":23,"text":"فِيهَآ","translation":"therein","transliteration":"fīhā"},{"position":24,"text":"أَبَدًۭا ۚ","translation":"forever","transliteration":"abadan"},{"position":25,"text":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":26,"text":"ٱلْفَوْزُ","translation":"(is) the success","transliteration":"l-fawzu"},{"position":27,"text":"ٱلْعَظِيمُ","translation":"the great","transliteration":"l-ʿaẓīmu"}]},{"id":5209,"verseKey":"64:10","verseNumber":10,"arabic":"وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ خَـٰلِدِينَ فِيهَا ۖ وَبِئْسَ ٱلْمَصِيرُ","translation":"But the ones who disbelieved and denied Our verses - those are the companions of the Fire, abiding eternally therein; and wretched is the destination.","transliteration":"wa-alladhīna kafarū wakadhabū biāyātinā ulāika aṣḥābu l-nāri khālidīna fīhā wabi'sa l-maṣīru","audioUrl":"/audio/7/064010.mp3","segments":[[0,1,100,1170],[1,2,1180,2040],[2,3,2050,3110],[3,4,3120,4440],[4,5,4450,8400],[5,6,8410,9350],[6,7,9360,10810],[7,8,10820,12000],[8,9,12010,13370],[9,10,13380,14150],[10,11,14160,16510]],"words":[{"position":1,"text":"وَٱلَّذِينَ","translation":"But those who","transliteration":"wa-alladhīna"},{"position":2,"text":"كَفَرُوا۟","translation":"disbelieved","transliteration":"kafarū"},{"position":3,"text":"وَكَذَّبُوا۟","translation":"and denied","transliteration":"wakadhabū"},{"position":4,"text":"بِـَٔايَـٰتِنَآ","translation":"[in] Our Verses","transliteration":"biāyātinā"},{"position":5,"text":"أُو۟لَـٰٓئِكَ","translation":"those","transliteration":"ulāika"},{"position":6,"text":"أَصْحَـٰبُ","translation":"(are the) companions","transliteration":"aṣḥābu"},{"position":7,"text":"ٱلنَّارِ","translation":"(of) the Fire","transliteration":"l-nāri"},{"position":8,"text":"خَـٰلِدِينَ","translation":"abiding forever","transliteration":"khālidīna"},{"position":9,"text":"فِيهَا ۖ","translation":"therein","transliteration":"fīhā"},{"position":10,"text":"وَبِئْسَ","translation":"And wretched is","transliteration":"wabi'sa"},{"position":11,"text":"ٱلْمَصِيرُ","translation":"the destination","transliteration":"l-maṣīru"}]},{"id":5210,"verseKey":"64:11","verseNumber":11,"arabic":"مَآ أَصَابَ مِن مُّصِيبَةٍ إِلَّا بِإِذْنِ ٱللَّهِ ۗ وَمَن يُؤْمِنۢ بِٱللَّهِ يَهْدِ قَلْبَهُۥ ۚ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌ","translation":"No disaster strikes except by permission of Allāh. And whoever believes in Allāh - He will guide his heart. And Allāh is Knowing of all things.","transliteration":"mā aṣāba min muṣībatin illā bi-idh'ni l-lahi waman yu'min bil-lahi yahdi qalbahu wal-lahu bikulli shayin ʿalīmun","audioUrl":"/audio/7/064011.mp3","segments":[[0,1,100,1880],[1,2,1890,2700],[2,3,2710,3810],[3,4,3820,4920],[4,5,4930,5700],[5,6,5710,6570],[6,7,6580,8890],[7,8,8900,10080],[8,9,10090,11700],[9,10,11710,12700],[10,11,12710,13280],[11,12,13290,14540],[12,13,14550,15540],[13,14,15550,16330],[14,15,16340,17170],[15,16,17180,19370]],"words":[{"position":1,"text":"مَآ","translation":"Not","transliteration":"mā"},{"position":2,"text":"أَصَابَ","translation":"strikes","transliteration":"aṣāba"},{"position":3,"text":"مِن","translation":"any","transliteration":"min"},{"position":4,"text":"مُّصِيبَةٍ","translation":"disaster","transliteration":"muṣībatin"},{"position":5,"text":"إِلَّا","translation":"except","transliteration":"illā"},{"position":6,"text":"بِإِذْنِ","translation":"by (the) permission","transliteration":"bi-idh'ni"},{"position":7,"text":"ٱللَّهِ ۗ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":8,"text":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":9,"text":"يُؤْمِنۢ","translation":"believes","transliteration":"yu'min"},{"position":10,"text":"بِٱللَّهِ","translation":"in Allah","transliteration":"bil-lahi"},{"position":11,"text":"يَهْدِ","translation":"He guides","transliteration":"yahdi"},{"position":12,"text":"قَلْبَهُۥ ۚ","translation":"his heart","transliteration":"qalbahu"},{"position":13,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":14,"text":"بِكُلِّ","translation":"of every","transliteration":"bikulli"},{"position":15,"text":"شَىْءٍ","translation":"thing","transliteration":"shayin"},{"position":16,"text":"عَلِيمٌۭ","translation":"(is) All-Knowing","transliteration":"ʿalīmun"}]},{"id":5211,"verseKey":"64:12","verseNumber":12,"arabic":"وَأَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ ۚ فَإِن تَوَلَّيْتُمْ فَإِنَّمَا عَلَىٰ رَسُولِنَا ٱلْبَلَـٰغُ ٱلْمُبِينُ","translation":"And obey Allāh and obey the Messenger; but if you turn away - then upon Our Messenger is only [the duty of] clear notification.","transliteration":"wa-aṭīʿū l-laha wa-aṭīʿū l-rasūla fa-in tawallaytum fa-innamā ʿalā rasūlinā l-balāghu l-mubīnu","audioUrl":"/audio/7/064012.mp3","segments":[[0,1,30,990],[1,2,1000,1780],[2,3,1790,2800],[3,4,2810,4960],[4,5,4970,6060],[5,6,6070,7410],[6,7,7420,9120],[7,8,9130,9780],[8,9,9790,10760],[9,10,10770,11790],[10,11,11800,14210]],"words":[{"position":1,"text":"وَأَطِيعُوا۟","translation":"So obey","transliteration":"wa-aṭīʿū"},{"position":2,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":3,"text":"وَأَطِيعُوا۟","translation":"and obey","transliteration":"wa-aṭīʿū"},{"position":4,"text":"ٱلرَّسُولَ ۚ","translation":"the Messenger","transliteration":"l-rasūla"},{"position":5,"text":"فَإِن","translation":"but if","transliteration":"fa-in"},{"position":6,"text":"تَوَلَّيْتُمْ","translation":"you turn away","transliteration":"tawallaytum"},{"position":7,"text":"فَإِنَّمَا","translation":"then only","transliteration":"fa-innamā"},{"position":8,"text":"عَلَىٰ","translation":"upon","transliteration":"ʿalā"},{"position":9,"text":"رَسُولِنَا","translation":"Our Messenger","transliteration":"rasūlinā"},{"position":10,"text":"ٱلْبَلَـٰغُ","translation":"(is) the conveyance","transliteration":"l-balāghu"},{"position":11,"text":"ٱلْمُبِينُ","translation":"clear","transliteration":"l-mubīnu"}]},{"id":5212,"verseKey":"64:13","verseNumber":13,"arabic":"ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ ۚ وَعَلَى ٱللَّهِ فَلْيَتَوَكَّلِ ٱلْمُؤْمِنُونَ","translation":"Allāh - there is no deity except Him. And upon Allāh let the believers rely.","transliteration":"al-lahu lā ilāha illā huwa waʿalā l-lahi falyatawakkali l-mu'minūna","audioUrl":"/audio/7/064013.mp3","segments":[[0,1,60,1030],[1,2,1040,3130],[2,3,3140,3910],[3,4,3920,4660],[4,5,4670,5690],[5,6,5700,6330],[6,7,6340,7200],[7,8,7210,8990],[8,9,9000,12610]],"words":[{"position":1,"text":"ٱللَّهُ","translation":"Allah","transliteration":"al-lahu"},{"position":2,"text":"لَآ","translation":"(there is) no","transliteration":"lā"},{"position":3,"text":"إِلَـٰهَ","translation":"god","transliteration":"ilāha"},{"position":4,"text":"إِلَّا","translation":"except","transliteration":"illā"},{"position":5,"text":"هُوَ ۚ","translation":"Him","transliteration":"huwa"},{"position":6,"text":"وَعَلَى","translation":"And upon","transliteration":"waʿalā"},{"position":7,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":8,"text":"فَلْيَتَوَكَّلِ","translation":"let put (their) trust","transliteration":"falyatawakkali"},{"position":9,"text":"ٱلْمُؤْمِنُونَ","translation":"the believers","transliteration":"l-mu'minūna"}]},{"id":5213,"verseKey":"64:14","verseNumber":14,"arabic":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّ مِنْ أَزْوَٰجِكُمْ وَأَوْلَـٰدِكُمْ عَدُوًّا لَّكُمْ فَٱحْذَرُوهُمْ ۚ وَإِن تَعْفُوا۟ وَتَصْفَحُوا۟ وَتَغْفِرُوا۟ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ","translation":"O you who have believed, indeed, among your spouses and your children are enemies to you, so beware of them. But if you pardon and overlook and forgive - then indeed, Allāh is Forgiving and Merciful.","transliteration":"yāayyuhā alladhīna āmanū inna min azwājikum wa-awlādikum ʿaduwwan lakum fa-iḥ'dharūhum wa-in taʿfū wataṣfaḥū wataghfirū fa-inna l-laha ghafūrun raḥīmun","audioUrl":"/audio/7/064014.mp3","segments":[[0,1,40,2710],[1,2,2720,3650],[2,3,3660,5970],[3,4,5980,7030],[4,5,7040,7390],[5,6,7400,8750],[6,7,8760,10210],[7,8,10220,11290],[8,9,11300,11770],[9,10,11780,13500],[10,11,13510,14780],[11,12,14790,15610],[12,13,15620,16720],[13,14,16730,17770],[14,15,17780,19210],[15,16,19220,19920],[16,17,19930,21020],[17,18,21030,23090]],"words":[{"position":1,"text":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلَّذِينَ","translation":"(you) who","transliteration":"alladhīna"},{"position":3,"text":"ءَامَنُوٓا۟","translation":"believe","transliteration":"āmanū"},{"position":4,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":5,"text":"مِنْ","translation":"from","transliteration":"min"},{"position":6,"text":"أَزْوَٰجِكُمْ","translation":"your spouses","transliteration":"azwājikum"},{"position":7,"text":"وَأَوْلَـٰدِكُمْ","translation":"and your children","transliteration":"wa-awlādikum"},{"position":8,"text":"عَدُوًّۭا","translation":"(are) enemies","transliteration":"ʿaduwwan"},{"position":9,"text":"لَّكُمْ","translation":"to you","transliteration":"lakum"},{"position":10,"text":"فَٱحْذَرُوهُمْ ۚ","translation":"so beware of them","transliteration":"fa-iḥ'dharūhum"},{"position":11,"text":"وَإِن","translation":"But if","transliteration":"wa-in"},{"position":12,"text":"تَعْفُوا۟","translation":"you pardon","transliteration":"taʿfū"},{"position":13,"text":"وَتَصْفَحُوا۟","translation":"and overlook","transliteration":"wataṣfaḥū"},{"position":14,"text":"وَتَغْفِرُوا۟","translation":"and forgive","transliteration":"wataghfirū"},{"position":15,"text":"فَإِنَّ","translation":"then indeed","transliteration":"fa-inna"},{"position":16,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":17,"text":"غَفُورٌۭ","translation":"(is) Oft-Forgiving","transliteration":"ghafūrun"},{"position":18,"text":"رَّحِيمٌ","translation":"Most Merciful","transliteration":"raḥīmun"}]},{"id":5214,"verseKey":"64:15","verseNumber":15,"arabic":"إِنَّمَآ أَمْوَٰلُكُمْ وَأَوْلَـٰدُكُمْ فِتْنَةٌ ۚ وَٱللَّهُ عِندَهُۥٓ أَجْرٌ عَظِيمٌ","translation":"Your wealth and your children are but a trial, and Allāh has with Him a great reward.","transliteration":"innamā amwālukum wa-awlādukum fit'natun wal-lahu ʿindahu ajrun ʿaẓīmun","audioUrl":"/audio/7/064015.mp3","segments":[[0,1,70,3280],[1,2,3290,4680],[2,3,4690,6180],[3,4,6190,7460],[4,5,7470,8360],[5,6,8370,11440],[6,7,11450,12120],[7,8,12130,14330]],"words":[{"position":1,"text":"إِنَّمَآ","translation":"Only","transliteration":"innamā"},{"position":2,"text":"أَمْوَٰلُكُمْ","translation":"your wealth","transliteration":"amwālukum"},{"position":3,"text":"وَأَوْلَـٰدُكُمْ","translation":"and your children","transliteration":"wa-awlādukum"},{"position":4,"text":"فِتْنَةٌۭ ۚ","translation":"(are) a trial","transliteration":"fit'natun"},{"position":5,"text":"وَٱللَّهُ","translation":"and Allah ","transliteration":"wal-lahu"},{"position":6,"text":"عِندَهُۥٓ","translation":"with Him","transliteration":"ʿindahu"},{"position":7,"text":"أَجْرٌ","translation":"(is) a reward","transliteration":"ajrun"},{"position":8,"text":"عَظِيمٌۭ","translation":"great","transliteration":"ʿaẓīmun"}]},{"id":5215,"verseKey":"64:16","verseNumber":16,"arabic":"فَٱتَّقُوا۟ ٱللَّهَ مَا ٱسْتَطَعْتُمْ وَٱسْمَعُوا۟ وَأَطِيعُوا۟ وَأَنفِقُوا۟ خَيْرًا لِّأَنفُسِكُمْ ۗ وَمَن يُوقَ شُحَّ نَفْسِهِۦ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ","translation":"So fear Allāh as much as you are able and listen and obey and spend [in the way of Allāh]; it is better for your selves. And whoever is protected from the stinginess of his soul - it is those who will be the successful.","transliteration":"fa-ittaqū l-laha mā is'taṭaʿtum wa-is'maʿū wa-aṭīʿū wa-anfiqū khayran li-anfusikum waman yūqa shuḥḥa nafsihi fa-ulāika humu l-muf'liḥūna","audioUrl":"/audio/7/064016.mp3","segments":[[0,1,30,830],[1,2,840,1510],[2,3,1520,1630],[3,4,1640,2810],[4,5,2820,3780],[5,6,3790,4920],[6,7,4930,6810],[7,8,6820,7320],[8,9,7330,10220],[9,10,10230,11680],[10,11,11690,11860],[11,12,11870,12450],[12,13,12460,13400],[13,14,13410,15890],[14,15,15900,16290],[15,16,16300,19060]],"words":[{"position":1,"text":"فَٱتَّقُوا۟","translation":"So fear","transliteration":"fa-ittaqū"},{"position":2,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":3,"text":"مَا","translation":"what","transliteration":"mā"},{"position":4,"text":"ٱسْتَطَعْتُمْ","translation":"you are able","transliteration":"is'taṭaʿtum"},{"position":5,"text":"وَٱسْمَعُوا۟","translation":"and listen","transliteration":"wa-is'maʿū"},{"position":6,"text":"وَأَطِيعُوا۟","translation":"and obey","transliteration":"wa-aṭīʿū"},{"position":7,"text":"وَأَنفِقُوا۟","translation":"and spend","transliteration":"wa-anfiqū"},{"position":8,"text":"خَيْرًۭا","translation":"(it is) better","transliteration":"khayran"},{"position":9,"text":"لِّأَنفُسِكُمْ ۗ","translation":"for yourselves","transliteration":"li-anfusikum"},{"position":10,"text":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":11,"text":"يُوقَ","translation":"is saved","transliteration":"yūqa"},{"position":12,"text":"شُحَّ","translation":"(from the) greediness","transliteration":"shuḥḥa"},{"position":13,"text":"نَفْسِهِۦ","translation":"(of) his soul","transliteration":"nafsihi"},{"position":14,"text":"فَأُو۟لَـٰٓئِكَ","translation":"then those","transliteration":"fa-ulāika"},{"position":15,"text":"هُمُ","translation":"[they]","transliteration":"humu"},{"position":16,"text":"ٱلْمُفْلِحُونَ","translation":"(are) the successful ones","transliteration":"l-muf'liḥūna"}]},{"id":5216,"verseKey":"64:17","verseNumber":17,"arabic":"إِن تُقْرِضُوا۟ ٱللَّهَ قَرْضًا حَسَنًا يُضَـٰعِفْهُ لَكُمْ وَيَغْفِرْ لَكُمْ ۚ وَٱللَّهُ شَكُورٌ حَلِيمٌ","translation":"If you loan Allāh a goodly loan, He will multiply it for you and forgive you. And Allāh is [most] Appreciative and Forbearing,","transliteration":"in tuq'riḍū l-laha qarḍan ḥasanan yuḍāʿif'hu lakum wayaghfir lakum wal-lahu shakūrun ḥalīmun","audioUrl":"/audio/7/064017.mp3","segments":[[0,1,30,1210],[1,2,1220,2030],[2,3,2040,2750],[3,4,2760,3470],[4,5,3480,4070],[5,6,4080,5870],[6,7,5880,6440],[7,8,6450,7400],[8,9,7410,8360],[9,10,8370,9300],[10,11,9310,10270],[11,12,10280,12630]],"words":[{"position":1,"text":"إِن","translation":"If","transliteration":"in"},{"position":2,"text":"تُقْرِضُوا۟","translation":"you loan","transliteration":"tuq'riḍū"},{"position":3,"text":"ٱللَّهَ","translation":"(to) Allah","transliteration":"l-laha"},{"position":4,"text":"قَرْضًا","translation":"a loan","transliteration":"qarḍan"},{"position":5,"text":"حَسَنًۭا","translation":"goodly","transliteration":"ḥasanan"},{"position":6,"text":"يُضَـٰعِفْهُ","translation":"He will multiply it","transliteration":"yuḍāʿif'hu"},{"position":7,"text":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":8,"text":"وَيَغْفِرْ","translation":"and will forgive","transliteration":"wayaghfir"},{"position":9,"text":"لَكُمْ ۚ","translation":"you","transliteration":"lakum"},{"position":10,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":11,"text":"شَكُورٌ","translation":"(is) Most Appreciative","transliteration":"shakūrun"},{"position":12,"text":"حَلِيمٌ","translation":"Most Forbearing","transliteration":"ḥalīmun"}]},{"id":5217,"verseKey":"64:18","verseNumber":18,"arabic":"عَـٰلِمُ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ ٱلْعَزِيزُ ٱلْحَكِيمُ","translation":"Knower of the unseen and the witnessed, the Exalted in Might, the Wise.","transliteration":"ʿālimu l-ghaybi wal-shahādati l-ʿazīzu l-ḥakīmu","audioUrl":"/audio/7/064018.mp3","segments":[[0,1,30,880],[1,2,890,1650],[2,3,1660,3090],[3,4,3100,4220],[4,5,4230,7110]],"words":[{"position":1,"text":"عَـٰلِمُ","translation":"(The) Knower","transliteration":"ʿālimu"},{"position":2,"text":"ٱلْغَيْبِ","translation":"(of) the unseen","transliteration":"l-ghaybi"},{"position":3,"text":"وَٱلشَّهَـٰدَةِ","translation":"and the witnessed","transliteration":"wal-shahādati"},{"position":4,"text":"ٱلْعَزِيزُ","translation":"the All-Mighty","transliteration":"l-ʿazīzu"},{"position":5,"text":"ٱلْحَكِيمُ","translation":"the All-Wise","transliteration":"l-ḥakīmu"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
