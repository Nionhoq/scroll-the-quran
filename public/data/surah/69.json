ition":2,"text":"أُقۡسِمُ","translation":"I swear","transliteration":"uq'simu"},{"position":3,"text":"بِمَا","translation":"by what","transliteration":"bimā"},{"position":4,"text":"تُبۡصِرُونَ","translation":"you see","transliteration":"tub'ṣirūna"}]},{"id":5362,"verseKey":"69:39","verseNumber":39,"arabic":"وَمَا لَا تُبۡصِرُونَ","translation":"And what you do not see","transliteration":"wamā lā tub'ṣirūna","audioUrl":"/audio/7/069039.mp3","segments":[[0,1,30,650],[1,2,660,1050],[2,3,1060,3990]],"words":[{"position":1,"text":"وَمَا","translation":"And what","transliteration":"wamā"},{"position":2,"text":"لَا","translation":"not","transliteration":"lā"},{"position":3,"text":"تُبۡصِرُونَ","translation":"you see","transliteration":"tub'ṣirūna"}]},{"id":5363,"verseKey":"69:40","verseNumber":40,"arabic":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ","translation":"[That] indeed, it [i.e., the Qur’ān] is the word of a noble Messenger.","transliteration":"innahu laqawlu rasūlin karīmin","audioUrl":"/audio/7/069040.mp3","segments":[[0,1,40,1790],[1,2,1800,2570],[2,3,2580,4600],[3,4,4610,7710]],"words":[{"position":1,"text":"إِنَّهُۥ","translation":"Indeed, it (is)","transliteration":"innahu"},{"position":2,"text":"لَقَوۡلُ","translation":"surely (the) Word","transliteration":"laqawlu"},{"position":3,"text":"رَسُولٖ","translation":"(of) a Messenger","transliteration":"rasūlin"},{"position":4,"text":"كَرِيمٖ","translation":"noble","transliteration":"karīmin"}]},{"id":5364,"verseKey":"69:41","verseNumber":41,"arabic":"وَمَا هُوَ بِقَوۡلِ شَاعِرٖۚ قَلِيلٗا مَّا تُؤۡمِنُونَ","translation":"And it is not the word of a poet; little do you believe.","transliteration":"wamā huwa biqawli shāʿirin qalīlan mā tu'minūna","audioUrl":"/audio/7/069041.mp3","segments":[[0,1,30,630],[1,2,640,1090],[2,3,1100,1940],[3,4,1950,2850],[4,5,2860,4020],[5,6,4030,5340],[6,7,5350,8460]],"words":[{"position":1,"text":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"text":"هُوَ","translation":"it","transliteration":"huwa"},{"position":3,"text":"بِقَوۡلِ","translation":"(is the) word","transliteration":"biqawli"},{"position":4,"text":"شَاعِرٖۚ","translation":"(of) a poet","transliteration":"shāʿirin"},{"position":5,"text":"قَلِيلٗا","translation":"little","transliteration":"qalīlan"},{"position":6,"text":"مَّا","translation":"(is) what","transliteration":"mā"},{"position":7,"text":"تُؤۡمِنُونَ","translation":"you believe","transliteration":"tu'minūna"}]},{"id":5365,"verseKey":"69:42","verseNumber":42,"arabic":"وَلَا بِقَوۡلِ كَاهِنٖۚ قَلِيلٗا مَّا تَذَكَّرُونَ","translation":"Nor the word of a soothsayer; little do you remember.","transliteration":"walā biqawli kāhinin qalīlan mā tadhakkarūna","audioUrl":"/audio/7/069042.mp3","segments":[[0,1,30,590],[1,2,600,1460],[2,3,1470,2700],[3,4,2710,3510],[4,5,3520,4750],[5,6,4760,8400]],"words":[{"position":1,"text":"وَلَا","translation":"And not","transliteration":"walā"},{"position":2,"text":"بِقَوۡلِ","translation":"(it is the) word","transliteration":"biqawli"},{"position":3,"text":"كَاهِنٖۚ","translation":"(of) a soothsayer","transliteration":"kāhinin"},{"position":4,"text":"قَلِيلٗا","translation":"little","transliteration":"qalīlan"},{"position":5,"text":"مَّا","translation":"(is) what","transliteration":"mā"},{"position":6,"text":"تَذَكَّرُونَ","translation":"you take heed","transliteration":"tadhakkarūna"}]},{"id":5366,"verseKey":"69:43","verseNumber":43,"arabic":"تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ","translation":"[It is] a revelation from the Lord of the worlds.","transliteration":"tanzīlun min rabbi l-ʿālamīna","audioUrl":"/audio/7/069043.mp3","segments":[[0,1,30,3010],[1,2,3020,3060],[2,3,3070,3990],[3,4,4000,6810]],"words":[{"position":1,"text":"تَنزِيلٞ","translation":"(It is) a revelation","transliteration":"tanzīlun"},{"position":2,"text":"مِّن","translation":"from","transliteration":"min"},{"position":3,"text":"رَّبِّ","translation":"(the) Lord","transliteration":"rabbi"},{"position":4,"text":"ٱلۡعَٰلَمِينَ","translation":"(of) the worlds","transliteration":"l-ʿālamīna"}]},{"id":5367,"verseKey":"69:44","verseNumber":44,"arabic":"وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ","translation":"And if he [i.e., Muḥammad] had made up about Us some [false] sayings,","transliteration":"walaw taqawwala ʿalaynā baʿḍa l-aqāwīli","audioUrl":"/audio/7/069044.mp3","segments":[[0,1,30,560],[1,2,570,1600],[2,3,1610,2680],[3,4,2690,3310],[4,5,3320,6560]],"words":[{"position":1,"text":"وَلَوۡ","translation":"And if","transliteration":"walaw"},{"position":2,"text":"تَقَوَّلَ","translation":"he (had) fabricated","transliteration":"taqawwala"},{"position":3,"text":"عَلَيۡنَا","translation":"against Us","transliteration":"ʿalaynā"},{"position":4,"text":"بَعۡضَ","translation":"some","transliteration":"baʿḍa"},{"position":5,"text":"ٱلۡأَقَاوِيلِ","translation":"sayings","transliteration":"l-aqāwīli"}]},{"id":5368,"verseKey":"69:45","verseNumber":45,"arabic":"لَأَخَذۡنَا مِنۡهُ بِٱلۡيَمِينِ","translation":"We would have seized him by the right hand;","transliteration":"la-akhadhnā min'hu bil-yamīni","audioUrl":"/audio/7/069045.mp3","segments":[[0,1,80,1290],[1,2,1300,1880],[2,3,1890,4690]],"words":[{"position":1,"text":"لَأَخَذۡنَا","translation":"Certainly We (would) have seized","transliteration":"la-akhadhnā"},{"position":2,"text":"مِنۡهُ","translation":"him","transliteration":"min'hu"},{"position":3,"text":"بِٱلۡيَمِينِ","translation":"by the right hand","transliteration":"bil-yamīni"}]},{"id":5369,"verseKey":"69:46","verseNumber":46,"arabic":"ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِينَ","translation":"Then We would have cut from him the aorta.","transliteration":"thumma laqaṭaʿnā min'hu l-watīna","audioUrl":"/audio/7/069046.mp3","segments":[[0,1,30,1010],[1,2,1020,2300],[2,3,2310,2920],[3,4,2930,6000]],"words":[{"position":1,"text":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"text":"لَقَطَعۡنَا","translation":"certainly We (would) have cut off","transliteration":"laqaṭaʿnā"},{"position":3,"text":"مِنۡهُ","translation":"from him","transliteration":"min'hu"},{"position":4,"text":"ٱلۡوَتِينَ","translation":"the aorta","transliteration":"l-watīna"}]},{"id":5370,"verseKey":"69:47","verseNumber":47,"arabic":"فَمَا مِنكُم مِّنۡ أَحَدٍ عَنۡهُ حَٰجِزِينَ","translation":"And there is no one of you who could prevent [Us] from him.","transliteration":"famā minkum min aḥadin ʿanhu ḥājizīna","audioUrl":"/audio/7/069047.mp3","segments":[[0,1,30,610],[1,2,620,2850],[2,3,2860,3150],[3,4,3160,3980],[4,5,3990,4620],[5,6,4630,8100]],"words":[{"position":1,"text":"فَمَا","translation":"And not","transliteration":"famā"},{"position":2,"text":"مِنكُم","translation":"from you","transliteration":"minkum"},{"position":3,"text":"مِّنۡ","translation":"any","transliteration":"min"},{"position":4,"text":"أَحَدٍ","translation":"one","transliteration":"aḥadin"},{"position":5,"text":"عَنۡهُ","translation":"[from him]","transliteration":"ʿanhu"},{"position":6,"text":"حَٰجِزِينَ","translation":"(who could) prevent (it)","transliteration":"ḥājizīna"}]},{"id":5371,"verseKey":"69:48","verseNumber":48,"arabic":"وَإِنَّهُۥ لَتَذۡكِرَةٞ لِّلۡمُتَّقِينَ","translation":"And indeed, it [i.e., the Qur’ān] is a reminder for the righteous.","transliteration":"wa-innahu latadhkiratun lil'muttaqīna","audioUrl":"/audio/7/069048.mp3","segments":[[0,1,30,1890],[1,2,1900,3200],[2,3,3210,7020]],"words":[{"position":1,"text":"وَإِنَّهُۥ","translation":"And indeed, it","transliteration":"wa-innahu"},{"position":2,"text":"لَتَذۡكِرَةٞ","translation":"(is) surely a reminder","transliteration":"latadhkiratun"},{"position":3,"text":"لِّلۡمُتَّقِينَ","translation":"for the Allah-fearing","transliteration":"lil'muttaqīna"}]},{"id":5372,"verseKey":"69:49","verseNumber":49,"arabic":"وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","translation":"And indeed, We know that among you are deniers.","transliteration":"wa-innā lanaʿlamu anna minkum mukadhibīna","audioUrl":"/audio/7/069049.mp3","segments":[[0,1,30,1600],[1,2,1610,2630],[2,3,2640,3730],[3,4,3740,5670],[4,5,5680,9100]],"words":[{"position":1,"text":"وَإِنَّا","translation":"And indeed, We","transliteration":"wa-innā"},{"position":2,"text":"لَنَعۡلَمُ","translation":"surely know","transliteration":"lanaʿlamu"},{"position":3,"text":"أَنَّ","translation":"that","transliteration":"anna"},{"position":4,"text":"مِنكُم","translation":"among you","transliteration":"minkum"},{"position":5,"text":"مُّكَذِّبِينَ","translation":"(are) deniers","transliteration":"mukadhibīna"}]},{"id":5373,"verseKey":"69:50","verseNumber":50,"arabic":"وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَٰفِرِينَ","translation":"And indeed, it will be [a cause of] regret upon the disbelievers.","transliteration":"wa-innahu laḥasratun ʿalā l-kāfirīna","audioUrl":"/audio/7/069050.mp3","segments":[[0,1,30,1720],[1,2,1730,2940],[2,3,2950,3470],[3,4,3480,6870]],"words":[{"position":1,"text":"وَإِنَّهُۥ","translation":"And indeed, it","transliteration":"wa-innahu"},{"position":2,"text":"لَحَسۡرَةٌ","translation":"(is) surely a regret","transliteration":"laḥasratun"},{"position":3,"text":"عَلَى","translation":"upon","transliteration":"ʿalā"},{"position":4,"text":"ٱلۡكَٰفِرِينَ","translation":"the disbelievers","transliteration":"l-kāfirīna"}]},{"id":5374,"verseKey":"69:51","verseNumber":51,"arabic":"وَإِنَّهُۥ لَحَقُّ ٱلۡيَقِينِ","translation":"And indeed, it is the truth of certainty.","transliteration":"wa-innahu laḥaqqu l-yaqīni","audioUrl":"/audio/7/069051.mp3","segments":[[0,1,30,1890],[1,2,1900,2710],[2,3,2720,6090]],"words":[{"position":1,"text":"وَإِنَّهُۥ","translation":"And indeed, it (is)","transliteration":"wa-innahu"},{"position":2,"text":"لَحَقُّ","translation":"surely (the) truth","transliteration":"laḥaqqu"},{"position":3,"text":"ٱلۡيَقِينِ","translation":"(of) certainty","transliteration":"l-yaqīni"}]},{"id":5375,"verseKey":"69:52","verseNumber":52,"arabic":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ","translation":"So exalt the name of your Lord, the Most Great.","transliteration":"fasabbiḥ bi-is'mi rabbika l-ʿaẓīmi","audioUrl":"/audio/7/069052.mp3","segments":[[0,1,30,1020],[1,2,1030,1510],[2,3,1520,2430],[3,4,2440,6350]],"words":[{"position":1,"text":"فَسَبِّحۡ","translation":"So glorify","transliteration":"fasabbiḥ"},{"position":2,"text":"بِٱسۡمِ","translation":"(the) name","transliteration":"bi-is'mi"},{"position":3,"text":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"text":"ٱلۡعَظِيمِ","translation":"the Most Great","transliteration":"l-ʿaẓīmi"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
