{"chapter":{"id":69,"nameSimple":"Al-Haqqah","nameArabic":"الحاقة","translatedName":"The Reality","versesCount":52,"revelationPlace":"makkah"},"verses":[{"id":5324,"verseKey":"69:1","verseNumber":1,"arabic":"ٱلۡحَآقَّةُ","translation":"The Inevitable Reality -","transliteration":"al-ḥāqatu","audioUrl":"/audio/7/069001.mp3","segments":[[0,1,80,4370]],"words":[{"position":1,"text":"ٱلۡحَآقَّةُ","translation":"The Inevitable Reality","transliteration":"al-ḥāqatu"}]},{"id":5325,"verseKey":"69:2","verseNumber":2,"arabic":"مَا ٱلۡحَآقَّةُ","translation":"What is the Inevitable Reality?","transliteration":"mā l-ḥāqatu","audioUrl":"/audio/7/069002.mp3","segments":[[0,1,50,480],[1,2,490,4660]],"words":[{"position":1,"text":"مَا","translation":"What","transliteration":"mā"},{"position":2,"text":"ٱلۡحَآقَّةُ","translation":"(is) the Inevitable Reality","transliteration":"l-ḥāqatu"}]},{"id":5326,"verseKey":"69:3","verseNumber":3,"arabic":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحَآقَّةُ","translation":"And what can make you know what is the Inevitable Reality?","transliteration":"wamā adrāka mā l-ḥāqatu","audioUrl":"/audio/7/069003.mp3","segments":[[0,1,30,2430],[1,2,2440,3600],[2,3,3610,3770],[3,4,3780,4750]],"words":[{"position":1,"text":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"text":"أَدۡرَىٰكَ","translation":"will make you know","transliteration":"adrāka"},{"position":3,"text":"مَا","translation":"what","transliteration":"mā"},{"position":4,"text":"ٱلۡحَآقَّةُ","translation":"(is) the Inevitable Reality","transliteration":"l-ḥāqatu"}]},{"id":5327,"verseKey":"69:4","verseNumber":4,"arabic":"كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ","translation":"Thamūd and ʿAad denied the Striking Calamity [i.e., the Resurrection].","transliteration":"kadhabat thamūdu waʿādun bil-qāriʿati","audioUrl":"/audio/7/069004.mp3","segments":[[0,1,30,980],[1,2,990,2020],[2,3,2030,3970],[3,4,3980,5650]],"words":[{"position":1,"text":"كَذَّبَتۡ","translation":"Denied","transliteration":"kadhabat"},{"position":2,"text":"ثَمُودُ","translation":"Thamud","transliteration":"thamūdu"},{"position":3,"text":"وَعَادُۢ","translation":"and Aad","transliteration":"waʿādun"},{"position":4,"text":"بِٱلۡقَارِعَةِ","translation":"the Striking Calamity","transliteration":"bil-qāriʿati"}]},{"id":5328,"verseKey":"69:5","verseNumber":5,"arabic":"فَأَمَّا ثَمُودُ فَأُهۡلِكُواْ بِٱلطَّاغِيَةِ","translation":"So as for Thamūd, they were destroyed by the overpowering [blast].","transliteration":"fa-ammā thamūdu fa-uh'likū bil-ṭāghiyati","audioUrl":"/audio/7/069005.mp3","segments":[[0,1,30,1780],[1,2,1790,2700],[2,3,2710,4090],[3,4,4100,5650]],"words":[{"position":1,"text":"فَأَمَّا","translation":"So as for","transliteration":"fa-ammā"},{"position":2,"text":"ثَمُودُ","translation":"Thamud","transliteration":"thamūdu"},{"position":3,"text":"فَأُهۡلِكُواْ","translation":"they were destroyed","transliteration":"fa-uh'likū"},{"position":4,"text":"بِٱلطَّاغِيَةِ","translation":"by the overpowering (blast)","transliteration":"bil-ṭāghiyati"}]},{"id":5329,"verseKey":"69:6","verseNumber":6,"arabic":"وَأَمَّا عَادٞ فَأُهۡلِكُواْ بِرِيحٖ صَرۡصَرٍ عَاتِيَةٖ","translation":"And as for ʿAad, they were destroyed by a screaming, violent wind","transliteration":"wa-ammā ʿādun fa-uh'likū birīḥin ṣarṣarin ʿātiyatin","audioUrl":"/audio/7/069006.mp3","segments":[[0,1,30,1550],[1,2,1560,3190],[2,3,3200,4590],[3,4,4600,6410],[4,5,6420,7570],[5,6,7580,8690]],"words":[{"position":1,"text":"وَأَمَّا","translation":"And as for","transliteration":"wa-ammā"},{"position":2,"text":"عَادٞ","translation":"Aad","transliteration":"ʿādun"},{"position":3,"text":"فَأُهۡلِكُواْ","translation":"they were destroyed","transliteration":"fa-uh'likū"},{"position":4,"text":"بِرِيحٖ","translation":"by a wind","transliteration":"birīḥin"},{"position":5,"text":"صَرۡصَرٍ","translation":"screaming","transliteration":"ṣarṣarin"},{"position":6,"text":"عَاتِيَةٖ","translation":"violent","transliteration":"ʿātiyatin"}]},{"id":5330,"verseKey":"69:7","verseNumber":7,"arabic":"سَخَّرَهَا عَلَيۡهِمۡ سَبۡعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومٗاۖ فَتَرَى ٱلۡقَوۡمَ فِيهَا صَرۡعَىٰ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٍ خَاوِيَةٖ","translation":"Which He [i.e., Allāh] imposed upon them for seven nights and eight days in succession, so you would see the people therein fallen as if they were hollow trunks of palm trees.","transliteration":"sakharahā ʿalayhim sabʿa layālin wathamāniyata ayyāmin ḥusūman fatarā l-qawma fīhā ṣarʿā ka-annahum aʿjāzu nakhlin khāwiyatin","audioUrl":"/audio/7/069007.mp3","segments":[[0,1,30,1360],[1,2,1370,2450],[2,3,2460,3200],[3,4,3210,4170],[4,5,4180,6790],[5,6,6800,8070],[6,7,8080,10080],[7,8,10090,10800],[8,9,10810,11690],[9,10,11700,12620],[10,11,12630,13590],[11,12,13600,15560],[12,13,15570,16720],[13,14,16730,17520],[14,15,17530,18620]],"words":[{"position":1,"text":"سَخَّرَهَا","translation":"Which He imposed","transliteration":"sakharahā"},{"position":2,"text":"عَلَيۡهِمۡ","translation":"upon them","transliteration":"ʿalayhim"},{"position":3,"text":"سَبۡعَ","translation":"(for) seven","transliteration":"sabʿa"},{"position":4,"text":"لَيَالٖ","translation":"nights","transliteration":"layālin"},{"position":5,"text":"وَثَمَٰنِيَةَ","translation":"and eight","transliteration":"wathamāniyata"},{"position":6,"text":"أَيَّامٍ","translation":"days","transliteration":"ayyāmin"},{"position":7,"text":"حُسُومٗاۖ","translation":"(in) succession","transliteration":"ḥusūman"},{"position":8,"text":"فَتَرَى","translation":"so you would see","transliteration":"fatarā"},{"position":9,"text":"ٱلۡقَوۡمَ","translation":"the people","transliteration":"l-qawma"},{"position":10,"text":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":11,"text":"صَرۡعَىٰ","translation":"fallen","transliteration":"ṣarʿā"},{"position":12,"text":"كَأَنَّهُمۡ","translation":"as if they were","transliteration":"ka-annahum"},{"position":13,"text":"أَعۡجَازُ","translation":"trunks","transliteration":"aʿjāzu"},{"position":14,"text":"نَخۡلٍ","translation":"(of) date-palms","transliteration":"nakhlin"},{"position":15,"text":"خَاوِيَةٖ","translation":"hollow","transliteration":"khāwiyatin"}]},{"id":5331,"verseKey":"69:8","verseNumber":8,"arabic":"فَهَلۡ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٖ","translation":"Then do you see of them any remains?","transliteration":"fahal tarā lahum min bāqiyatin","audioUrl":"/audio/7/069008.mp3","segments":[[0,1,30,620],[1,2,630,1370],[2,3,1380,2690],[3,4,2700,3710],[4,5,3720,4740]],"words":[{"position":1,"text":"فَهَلۡ","translation":"Then do","transliteration":"fahal"},{"position":2,"text":"تَرَىٰ","translation":"you see","transliteration":"tarā"},{"position":3,"text":"لَهُم","translation":"of them","transliteration":"lahum"},{"position":4,"text":"مِّنۢ","translation":"any","transliteration":"min"},{"position":5,"text":"بَاقِيَةٖ","translation":"remains","transliteration":"bāqiyatin"}]},{"id":5332,"verseKey":"69:9","verseNumber":9,"arabic":"وَجَآءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَٰتُ بِٱلۡخَاطِئَةِ","translation":"And there came Pharaoh and those before him and the overturned cities with sin.","transliteration":"wajāa fir'ʿawnu waman qablahu wal-mu'tafikātu bil-khāṭi-ati","audioUrl":"/audio/7/069009.mp3","segments":[[0,1,30,2380],[1,2,2390,3640],[2,3,3650,4930],[3,4,4940,6140],[4,5,6150,8170],[5,6,8180,9680]],"words":[{"position":1,"text":"وَجَآءَ","translation":"And came","transliteration":"wajāa"},{"position":2,"text":"فِرۡعَوۡنُ","translation":"Firaun","transliteration":"fir'ʿawnu"},{"position":3,"text":"وَمَن","translation":"and (those)","transliteration":"waman"},{"position":4,"text":"قَبۡلَهُۥ","translation":"before him","transliteration":"qablahu"},{"position":5,"text":"وَٱلۡمُؤۡتَفِكَٰتُ","translation":"and the overturned cities","transliteration":"wal-mu'tafikātu"},{"position":6,"text":"بِٱلۡخَاطِئَةِ","translation":"with sin","transliteration":"bil-khāṭi-ati"}]},{"id":5333,"verseKey":"69:10","verseNumber":10,"arabic":"فَعَصَوۡاْ رَسُولَ رَبِّهِمۡ فَأَخَذَهُمۡ أَخۡذَةٗ رَّابِيَةً","translation":"And they disobeyed the messenger of their Lord, so He seized them with a seizure exceeding [in severity].","transliteration":"faʿaṣaw rasūla rabbihim fa-akhadhahum akhdhatan rābiyatan","audioUrl":"/audio/7/069010.mp3","segments":[[0,1,30,900],[1,2,910,1810],[2,3,1820,2890],[3,4,2900,4290],[4,5,4300,5180],[5,6,5190,6520]],"words":[{"position":1,"text":"فَعَصَوۡاْ","translation":"And they disobeyed","transliteration":"faʿaṣaw"},{"position":2,"text":"رَسُولَ","translation":"(the) Messenger","transliteration":"rasūla"},{"position":3,"text":"رَبِّهِمۡ","translation":"(of) their Lord","transliteration":"rabbihim"},{"position":4,"text":"فَأَخَذَهُمۡ","translation":"so He seized them","transliteration":"fa-akhadhahum"},{"position":5,"text":"أَخۡذَةٗ","translation":"(with) a seizure","transliteration":"akhdhatan"},{"position":6,"text":"رَّابِيَةً","translation":"exceeding","transliteration":"rābiyatan"}]},{"id":5334,"verseKey":"69:11","verseNumber":11,"arabic":"إِنَّا لَمَّا طَغَا ٱلۡمَآءُ حَمَلۡنَٰكُمۡ فِي ٱلۡجَارِيَةِ","translation":"Indeed, when the water overflowed, We carried you [i.e., your ancestors] in the sailing ship","transliteration":"innā lammā ṭaghā l-māu ḥamalnākum fī l-jāriyati","audioUrl":"/audio/7/069011.mp3","segments":[[0,1,30,1620],[1,2,1630,3030],[2,3,3040,3550],[3,4,3560,5840],[4,5,5850,7430],[5,6,7440,7700],[6,7,7710,8920]],"words":[{"position":1,"text":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"text":"لَمَّا","translation":"when","transliteration":"lammā"},{"position":3,"text":"طَغَا","translation":"overflowed","transliteration":"ṭaghā"},{"position":4,"text":"ٱلۡمَآءُ","translation":"the water","transliteration":"l-māu"},{"position":5,"text":"حَمَلۡنَٰكُمۡ","translation":"We carried you","transliteration":"ḥamalnākum"},{"position":6,"text":"فِي","translation":"in","transliteration":"fī"},{"position":7,"text":"ٱلۡجَارِيَةِ","translation":"the sailing (ship)","transliteration":"l-jāriyati"}]},{"id":5335,"verseKey":"69:12","verseNumber":12,"arabic":"لِنَجۡعَلَهَا لَكُمۡ تَذۡكِرَةٗ وَتَعِيَهَآ أُذُنٞ وَٰعِيَةٞ","translation":"That We might make it for you a reminder and [that] a conscious ear would be conscious of it.","transliteration":"linajʿalahā lakum tadhkiratan wataʿiyahā udhunun wāʿiyatun","audioUrl":"/audio/7/069012.mp3","segments":[[0,1,60,1580],[1,2,1590,2210],[2,3,2220,3420],[3,4,3430,6360],[4,5,6370,9300],[5,6,9310,10320]],"words":[{"position":1,"text":"لِنَجۡعَلَهَا","translation":"That We might make it","transliteration":"linajʿalahā"},{"position":2,"text":"لَكُمۡ","translation":"for you","transliteration":"lakum"},{"position":3,"text":"تَذۡكِرَةٗ","translation":"a reminder","transliteration":"tadhkiratan"},{"position":4,"text":"وَتَعِيَهَآ","translation":"and would be conscious of it","transliteration":"wataʿiyahā"},{"position":5,"text":"أُذُنٞ","translation":"an ear","transliteration":"udhunun"},{"position":6,"text":"وَٰعِيَةٞ","translation":"conscious","transliteration":"wāʿiyatun"}]},{"id":5336,"verseKey":"69:13","verseNumber":13,"arabic":"فَإِذَا نُفِخَ فِي ٱلصُّورِ نَفۡخَةٞ وَٰحِدَةٞ","translation":"Then when the Horn is blown with one blast","transliteration":"fa-idhā nufikha fī l-ṣūri nafkhatun wāḥidatun","audioUrl":"/audio/7/069013.mp3","segments":[[0,1,30,900],[1,2,910,1510],[2,3,1520,1700],[3,4,1710,2680],[4,5,2690,4670],[5,6,4680,5850]],"words":[{"position":1,"text":"فَإِذَا","translation":"Then when","transliteration":"fa-idhā"},{"position":2,"text":"نُفِخَ","translation":"is blown","transliteration":"nufikha"},{"position":3,"text":"فِي","translation":"in","transliteration":"fī"},{"position":4,"text":"ٱلصُّورِ","translation":"the trumpet ","transliteration":"l-ṣūri"},{"position":5,"text":"نَفۡخَةٞ","translation":"a blast","transliteration":"nafkhatun"},{"position":6,"text":"وَٰحِدَةٞ","translation":"single","transliteration":"wāḥidatun"}]},{"id":5337,"verseKey":"69:14","verseNumber":14,"arabic":"وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ","translation":"And the earth and the mountains are lifted and leveled with one blow [i.e., stroke] -","transliteration":"waḥumilati l-arḍu wal-jibālu fadukkatā dakkatan wāḥidatan","audioUrl":"/audio/7/069014.mp3","segments":[[0,1,70,1140],[1,2,1150,1970],[2,3,1980,3290],[3,4,3300,4660],[4,5,4670,5590],[5,6,5600,7770]],"words":[{"position":1,"text":"وَحُمِلَتِ","translation":"And are lifted","transliteration":"waḥumilati"},{"position":2,"text":"ٱلۡأَرۡضُ","translation":"the earth","transliteration":"l-arḍu"},{"position":3,"text":"وَٱلۡجِبَالُ","translation":"and the mountains","transliteration":"wal-jibālu"},{"position":4,"text":"فَدُكَّتَا","translation":"and crushed","transliteration":"fadukkatā"},{"position":5,"text":"دَكَّةٗ","translation":"(with) a crushing","transliteration":"dakkatan"},{"position":6,"text":"وَٰحِدَةٗ","translation":"single","transliteration":"wāḥidatan"}]},{"id":5338,"verseKey":"69:15","verseNumber":15,"arabic":"فَيَوۡمَئِذٖ وَقَعَتِ ٱلۡوَاقِعَةُ","translation":"Then on that Day, the Occurrence [i.e., Resurrection] will occur,","transliteration":"fayawma-idhin waqaʿati l-wāqiʿatu","audioUrl":"/audio/7/069015.mp3","segments":[[0,1,30,1400],[1,2,1410,3290],[2,3,3300,4630]],"words":[{"position":1,"text":"فَيَوۡمَئِذٖ","translation":"Then (on) that Day","transliteration":"fayawma-idhin"},{"position":2,"text":"وَقَعَتِ","translation":"will occur","transliteration":"waqaʿati"},{"position":3,"text":"ٱلۡوَاقِعَةُ","translation":"the Occurrence","transliteration":"l-wāqiʿatu"}]},{"id":5339,"verseKey":"69:16","verseNumber":16,"arabic":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِيَ يَوۡمَئِذٖ وَاهِيَةٞ","translation":"And the heaven will split [open], for that Day it is infirm.","transliteration":"wa-inshaqqati l-samāu fahiya yawma-idhin wāhiyatun","audioUrl":"/audio/7/069016.mp3","segments":[[0,1,30,2000],[1,2,2010,4460],[2,3,4470,5140],[3,4,5150,6280],[4,5,6290,8290]],"words":[{"position":1,"text":"وَٱنشَقَّتِ","translation":"And will split","transliteration":"wa-inshaqqati"},{"position":2,"text":"ٱلسَّمَآءُ","translation":"the heaven","transliteration":"l-samāu"},{"position":3,"text":"فَهِيَ","translation":"so it","transliteration":"fahiya"},{"position":4,"text":"يَوۡمَئِذٖ","translation":"(is on) that Day","transliteration":"yawma-idhin"},{"position":5,"text":"وَاهِيَةٞ","translation":"frail","transliteration":"wāhiyatun"}]},{"id":5340,"verseKey":"69:17","verseNumber":17,"arabic":"وَٱلۡمَلَكُ عَلَىٰٓ أَرۡجَآئِهَاۚ وَيَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمۡ يَوۡمَئِذٖ ثَمَٰنِيَةٞ","translation":"And the angels are at its edges. And there will bear the Throne of your Lord above them, that Day, eight [of them].","transliteration":"wal-malaku ʿalā arjāihā wayaḥmilu ʿarsha rabbika fawqahum yawma-idhin thamāniyatun","audioUrl":"/audio/7/069017.mp3","segments":[[0,1,40,1090],[1,2,1100,1410],[2,3,1420,6870],[3,4,6880,7930],[4,5,7940,8610],[5,6,8620,9510],[6,7,9520,10650],[7,8,10660,12960],[8,9,12970,14220]],"words":[{"position":1,"text":"وَٱلۡمَلَكُ","translation":"And the Angels","transliteration":"wal-malaku"},{"position":2,"text":"عَلَىٰٓ","translation":"(will be) on","transliteration":"ʿalā"},{"position":3,"text":"أَرۡجَآئِهَاۚ","translation":"its edges","transliteration":"arjāihā"},{"position":4,"text":"وَيَحۡمِلُ","translation":"and will bear","transliteration":"wayaḥmilu"},{"position":5,"text":"عَرۡشَ","translation":"(the) Throne","transliteration":"ʿarsha"},{"position":6,"text":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":7,"text":"فَوۡقَهُمۡ","translation":"above them","transliteration":"fawqahum"},{"position":8,"text":"يَوۡمَئِذٖ","translation":"that Day","transliteration":"yawma-idhin"},{"position":9,"text":"ثَمَٰنِيَةٞ","translation":"eight","transliteration":"thamāniyatun"}]},{"id":5341,"verseKey":"69:18","verseNumber":18,"arabic":"يَوۡمَئِذٖ تُعۡرَضُونَ لَا تَخۡفَىٰ مِنكُمۡ خَافِيَةٞ","t