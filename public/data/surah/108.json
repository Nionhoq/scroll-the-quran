{"chapter":{"id":108,"nameSimple":"Al-Kawthar","nameArabic":"الكوثر","translatedName":"The Abundance","versesCount":3,"revelationPlace":"makkah"},"verses":[{"id":6205,"verseKey":"108:1","verseNumber":1,"arabic":" إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ","translation":"Indeed, We have granted you, [O Muḥammad], al-Kawthar.","transliteration":"innā aʿṭaynāka l-kawthara","audioUrl":"/audio/7/108001.mp3","segments":[[0,1,150,2120],[1,2,2130,4970],[2,3,4980,5900]],"words":[{"position":1,"text":"إِنَّآ","translation":"Indeed, We","transliteration":"innā"},{"position":2,"text":"أَعْطَيْنَـٰكَ","translation":"We have given you","transliteration":"aʿṭaynāka"},{"position":3,"text":"ٱلْكَوْثَرَ","translation":"Al-Kauthar","transliteration":"l-kawthara"}]},{"id":6206,"verseKey":"108:2","verseNumber":2,"arabic":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","translation":"So pray to your Lord and offer sacrifice [to Him alone].","transliteration":"faṣalli lirabbika wa-in'ḥar","audioUrl":"/audio/7/108002.mp3","segments":[[0,1,30,910],[1,2,920,1970],[2,3,1980,2790]],"words":[{"position":1,"text":"فَصَلِّ","translation":"So pray","transliteration":"faṣalli"},{"position":2,"text":"لِرَبِّكَ","translation":"to your Lord","transliteration":"lirabbika"},{"position":3,"text":"وَٱنْحَرْ","translation":"and sacrifice","transliteration":"wa-in'ḥar"}]},{"id":6207,"verseKey":"108:3","verseNumber":3,"arabic":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","translation":"Indeed, your enemy is the one cut off.","transliteration":"inna shāni-aka huwa l-abtaru","audioUrl":"/audio/7/108003.mp3","segments":[[0,1,30,1660],[1,2,1670,2750],[2,3,2760,3220],[3,4,3230,4250]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"شَانِئَكَ","translation":"your enemy ","transliteration":"shāni-aka"},{"position":3,"text":"هُوَ","translation":"he (is)","transliteration":"huwa"},{"position":4,"text":"ٱلْأَبْتَرُ","translation":"the one cut off","transliteration":"l-abtaru"}]}],"source":"Qur