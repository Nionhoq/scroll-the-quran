","transliteration":"im'ra-ata"},{"position":7,"text":"نُوحٍۢ","translation":"(of) Nuh","transliteration":"nūḥin"},{"position":8,"text":"وَٱمْرَأَتَ","translation":"(and the) wife","transliteration":"wa-im'ra-ata"},{"position":9,"text":"لُوطٍۢ ۖ","translation":"(of) Lut","transliteration":"lūṭin"},{"position":10,"text":"كَانَتَا","translation":"They were","transliteration":"kānatā"},{"position":11,"text":"تَحْتَ","translation":"under","transliteration":"taḥta"},{"position":12,"text":"عَبْدَيْنِ","translation":"two [slaves]","transliteration":"ʿabdayni"},{"position":13,"text":"مِنْ","translation":"of","transliteration":"min"},{"position":14,"text":"عِبَادِنَا","translation":"Our slaves","transliteration":"ʿibādinā"},{"position":15,"text":"صَـٰلِحَيْنِ","translation":"righteous","transliteration":"ṣāliḥayni"},{"position":16,"text":"فَخَانَتَاهُمَا","translation":"but they both betrayed them","transliteration":"fakhānatāhumā"},{"position":17,"text":"فَلَمْ","translation":"so not","transliteration":"falam"},{"position":18,"text":"يُغْنِيَا","translation":"they availed","transliteration":"yugh'niyā"},{"position":19,"text":"عَنْهُمَا","translation":"both of them","transliteration":"ʿanhumā"},{"position":20,"text":"مِنَ","translation":"from","transliteration":"mina"},{"position":21,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":22,"text":"شَيْـًۭٔا","translation":"(in) anything","transliteration":"shayan"},{"position":23,"text":"وَقِيلَ","translation":"and it was said","transliteration":"waqīla"},{"position":24,"text":"ٱدْخُلَا","translation":"Enter","transliteration":"ud'khulā"},{"position":25,"text":"ٱلنَّارَ","translation":"the Fire","transliteration":"l-nāra"},{"position":26,"text":"مَعَ","translation":"with","transliteration":"maʿa"},{"position":27,"text":"ٱلدَّٰخِلِينَ","translation":"those who enter","transliteration":"l-dākhilīna"}]},{"id":5240,"verseKey":"66:11","verseNumber":11,"arabic":"وَضَرَبَ ٱللَّهُ مَثَلًا لِّلَّذِينَ ءَامَنُ