{"chapter":{"id":66,"nameSimple":"At-Tahrim","nameArabic":"التحريم","translatedName":"The Prohibition","versesCount":12,"revelationPlace":"madinah"},"verses":[{"id":5230,"verseKey":"66:1","verseNumber":1,"arabic":" يَـٰٓأَيُّهَا ٱلنَّبِىُّ لِمَ تُحَرِّمُ مَآ أَحَلَّ ٱللَّهُ لَكَ ۖ تَبْتَغِى مَرْضَاتَ أَزْوَٰجِكَ ۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ","translation":"O Prophet, why do you prohibit [yourself from] what Allāh has made lawful for you, seeking the approval of your wives? And Allāh is Forgiving and Merciful.","transliteration":"yāayyuhā l-nabiyu lima tuḥarrimu mā aḥalla l-lahu laka tabtaghī marḍāta azwājika wal-lahu ghafūrun raḥīmun","audioUrl":"/audio/7/066001.mp3","segments":[[0,1,70,2760],[1,2,2770,4400],[2,3,4410,4760],[3,4,4770,5760],[4,5,5770,6490],[5,6,6500,8580],[6,7,8590,9410],[7,8,9420,10330],[8,9,10340,11300],[9,10,11310,12080],[10,11,12090,13720],[11,12,13730,14680],[12,13,14690,15750],[13,14,15760,17940]],"words":[{"position":1,"text":"يَـٰٓأَيُّهَا","translation":"O","transliteration":"yāayyuhā"},{"position":2,"text":"ٱلنَّبِىُّ","translation":"Prophet","transliteration":"l-nabiyu"},{"position":3,"text":"لِمَ","translation":"Why (do)","transliteration":"lima"},{"position":4,"text":"تُحَرِّمُ","translation":"you prohibit","transliteration":"tuḥarrimu"},{"position":5,"text":"مَآ","translation":"what","transliteration":"mā"},{"position":6,"text":"أَحَلَّ","translation":"has made lawful","transliteration":"aḥalla"},{"position":7,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":8,"text":"لَكَ ۖ","translation":"for you","transliteration":"laka"},{"position":9,"text":"تَبْتَغِى","translation":"seeking","transliteration":"tabtaghī"},{"position":10,"text":"مَرْضَاتَ","translation":"(to) please","transliteration":"marḍāta"},{"position":11,"text":"أَزْوَٰجِكَ ۚ","translation":"your wives","transliteration":"azwājika"},{"position":12,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":13,"text":"غَفُورٌۭ","translation":"(is) Oft-Forgiving","transliteration":"ghafūrun"},{"position":14,"text":"رَّحِيمٌۭ","translation":"Most Merciful","transliteration":"raḥīmun"}]},{"id":5231,"verseKey":"66:2","verseNumber":2,"arabic":"قَدْ فَرَضَ ٱللَّهُ لَكُمْ تَحِلَّةَ أَيْمَـٰنِكُمْ ۚ وَٱللَّهُ مَوْلَىٰكُمْ ۖ وَهُوَ ٱلْعَلِيمُ ٱلْحَكِيمُ","translation":"Allāh has already ordained for you [Muslims] the dissolution of your oaths. And Allāh is your protector, and He is the Knowing, the Wise.","transliteration":"qad faraḍa l-lahu lakum taḥillata aymānikum wal-lahu mawlākum wahuwa l-ʿalīmu l-ḥakīmu","audioUrl":"/audio/7/066002.mp3","segments":[[0,1,70,330],[1,2,340,950],[2,3,960,1760],[3,4,1770,2300],[4,5,2310,3330],[5,6,3340,5170],[6,7,5180,6140],[7,8,6150,7730],[8,9,7740,8310],[9,10,8320,9270],[10,11,9280,11750]],"words":[{"position":1,"text":"قَدْ","translation":"Indeed","transliteration":"qad"},{"position":2,"text":"فَرَضَ","translation":"has ordained","transliteration":"faraḍa"},{"position":3,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":4,"text":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":5,"text":"تَحِلَّةَ","translation":"(the) dissolution","transliteration":"taḥillata"},{"position":6,"text":"أَيْمَـٰنِكُمْ ۚ","translation":"(of) your oaths","transliteration":"aymānikum"},{"position":7,"text":"وَٱللَّهُ","translation":"And Allah","transliteration":"wal-lahu"},{"position":8,"text":"مَوْلَىٰكُمْ ۖ","translation":"(is) your Protector","transliteration":"mawlākum"},{"position":9,"text":"وَهُوَ","translation":"and He","transliteration":"wahuwa"},{"position":10,"text":"ٱلْعَلِيمُ","translation":"(is) the All-Knower","transliteration":"l-ʿalīmu"},{"position":11,"text":"ٱلْحَكِيمُ","translation":"the All-Wise","transliteration":"l-ḥakīmu"}]},{"id":5232,"verseKey":"66:3","verseNumber":3,"arabic":"وَإِذْ أَسَرَّ ٱلنَّبِىُّ إِلَىٰ بَعْضِ أَزْوَٰجِهِۦ حَدِيثًا فَلَمَّا نَبَّأَتْ بِهِۦ وَأَظْهَرَهُ ٱللَّهُ عَلَيْهِ عَرَّفَ بَعْضَهُۥ وَأَعْرَضَ عَنۢ بَعْضٍ ۖ فَلَمَّا نَبَّأَهَا بِهِۦ قَالَتْ مَنْ أَنۢبَأَكَ هَـٰذَا ۖ قَالَ نَبَّأَنِىَ ٱلْعَلِيمُ ٱلْخَبِيرُ","translation":"And [remember] when the Prophet confided to one of his wives a statement; and when she informed [another] of it and Allāh showed it to him, he made known part of it and ignored a part. And when he informed her about it, she said, \"Who told you this?\" He said, \"I was informed by the Knowing, the Aware.\"","transliteration":"wa-idh asarra l-nabiyu ilā baʿḍi azwājihi ḥadīthan falammā nabba-at bihi wa-aẓharahu l-lahu ʿalayhi ʿarrafa baʿḍahu wa-aʿraḍa ʿan baʿḍin falammā nabba-ahā bihi qālat man anba-aka hādhā qāla nabba-aniya l-ʿalīmu l-khabīru","audioUrl":"/audio/7/066003.mp3","segments":[[0,1,30,530],[1,2,540,1330],[2,3,1340,2850],[3,4,2860,3390],[4,5,3400,4010],[5,6,4020,5250],[6,7,5260,6890],[7,8,6900,8560],[8,9,8570,9440],[9,10,9450,10080],[10,11,10090,11390],[11,12,11400,11920],[12,13,11930,12700],[13,14,12710,13570],[14,15,13580,14520],[15,16,14530,15510],[16,17,15520,16720],[17,18,16730,18010],[18,19,18020,19430],[19,20,19440,20520],[20,21,20530,21110],[21,22,21120,21860],[22,23,21870,22240],[23,24,22250,23960],[24,25,23970,25410],[25,26,25420,25990],[26,27,26000,27100],[27,28,27110,28080],[28,29,28090,30540]],"words":[{"position":1,"text":"وَإِذْ","translation":"And when","transliteration":"wa-idh"},{"position":2,"text":"أَسَرَّ","translation":"confided","transliteration":"asarra"},{"position":3,"text":"ٱلنَّبِىُّ","translation":"the Prophet","transliteration":"l-nabiyu"},{"position":4,"text":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":5,"text":"بَعْضِ","translation":"one","transliteration":"baʿḍi"},{"position":6,"text":"أَزْوَٰجِهِۦ","translation":"(of) his wives","transliteration":"azwājihi"},{"position":7,"text":"حَدِيثًۭا","translation":"a statement","transliteration":"ḥadīthan"},{"position":8,"text":"فَلَمَّا","translation":"and when","transliteration":"falammā"},{"position":9,"text":"نَبَّأَتْ","translation":"she informed","transliteration":"nabba-at"},{"position":10,"text":"بِهِۦ","translation":"about it","transliteration":"bihi"},{"position":11,"text":"وَأَظْهَرَهُ","translation":"and made it apparent","transliteration":"wa-aẓharahu"},{"position":12,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":13,"text":"عَلَيْهِ","translation":"to him","transliteration":"ʿalayhi"},{"position":14,"text":"عَرَّفَ","translation":"he made known","transliteration":"ʿarrafa"},{"position":15,"text":"بَعْضَهُۥ","translation":"a part of it","transliteration":"baʿḍahu"},{"position":16,"text":"وَأَعْرَضَ","translation":"and avoided","transliteration":"wa-aʿraḍa"},{"position":17,"text":"عَنۢ","translation":"[of]","transliteration":"ʿan"},{"position":18,"text":"بَعْضٍۢ ۖ","translation":"a part","transliteration":"baʿḍin"},{"position":19,"text":"فَلَمَّا","translation":"Then when","transliteration":"falammā"},{"position":20,"text":"نَبَّأَهَا","translation":"he informed her","transliteration":"nabba-ahā"},{"position":21,"text":"بِهِۦ","translation":"about it","transliteration":"bihi"},{"position":22,"text":"قَالَتْ","translation":"she said","transliteration":"qālat"},{"position":23,"text":"مَنْ","translation":"Who","transliteration":"man"},{"position":24,"text":"أَنۢبَأَكَ","translation":"informed you","transliteration":"anba-aka"},{"position":25,"text":"هَـٰذَا ۖ","translation":"this","transliteration":"hādhā"},{"position":26,"text":"قَالَ","translation":"He said","transliteration":"qāla"},{"position":27,"text":"نَبَّأَنِىَ","translation":"Has informed me","transliteration":"nabba-aniya"},{"position":28,"text":"ٱلْعَلِيمُ","translation":"the All-Knower","transliteration":"l-ʿalīmu"},{"position":29,"text":"ٱلْخَبِيرُ","translation":"the All-Aware","transliteration":"l-khabīru"}]},{"id":5233,"verseKey":"66:4","verseNumber":4,"arabic":"إِن تَتُوبَآ إِلَى ٱللَّهِ فَقَدْ صَغَتْ قُلُوبُكُمَا ۖ وَإِن تَظَـٰهَرَا عَلَيْهِ فَإِنَّ ٱللَّهَ هُوَ مَ