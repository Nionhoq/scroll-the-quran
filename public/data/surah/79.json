ce","transliteration":"sabqan"}]},{"id":5717,"verseKey":"79:5","verseNumber":5,"arabic":"فَٱلْمُدَبِّرَٰتِ أَمْرًا","translation":"And those who arrange [each] matter,","transliteration":"fal-mudabirāti amran","audioUrl":"/audio/7/079005.mp3","segments":[[0,1,30,1930],[1,2,1940,2880]],"words":[{"position":1,"text":"فَٱلْمُدَبِّرَٰتِ","translation":"And those who arrange","transliteration":"fal-mudabirāti"},{"position":2,"text":"أَمْرًۭا","translation":"(the) matter","transliteration":"amran"}]},{"id":5718,"verseKey":"79:6","verseNumber":6,"arabic":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","translation":"On the Day the blast [of the Horn] will convulse [creation],","transliteration":"yawma tarjufu l-rājifatu","audioUrl":"/audio/7/079006.mp3","segments":[[0,1,50,640],[1,2,650,1580],[2,3,1590,2850]],"words":[{"position":1,"text":"يَوْمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"text":"تَرْجُفُ","translation":"will quake","transliteration":"tarjufu"},{"position":3,"text":"ٱلرَّاجِفَةُ","translation":"the quaking one","transliteration":"l-rājifatu"}]},{"id":5719,"verseKey":"79:7","verseNumber":7,"arabic":"تَتْبَعُهَا ٱلرَّادِفَةُ","translation":"There will follow it the subsequent [one].","transliteration":"tatbaʿuhā l-rādifatu","audioUrl":"/audio/7/079007.mp3","segments":[[0,1,30,1120],[1,2,1130,2460]],"words":[{"position":1,"text":"تَتْبَعُهَا","translation":"Follows it","transliteration":"tatbaʿuhā"},{"position":2,"text":"ٱلرَّادِفَةُ","translation":"the subsequent","transliteration":"l-rādifatu"}]},{"id":5720,"verseKey":"79:8","verseNumber":8,"arabic":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","translation":"Hearts, that Day, will tremble,","transliteration":"qulūbun yawma-idhin wājifatun","audioUrl":"/audio/7/079008.mp3","segments":[[0,1,30,1800],[1,2,1810,3900],[2,3,3910,4880]],"words":[{"position":1,"text":"قُلُوبٌۭ","translation":"Hearts","transliteration":"qulūbun"},{"position":2,"text":"يَوْمَئِذٍۢ","translation":"that Day","transliteration":"yawma-idhin"},