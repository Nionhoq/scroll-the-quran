ation":"laqad"},{"position":2,"text":"خَلَقۡنَا","translation":"We created","transliteration":"khalaqnā"},{"position":3,"text":"ٱلۡإِنسَٰنَ","translation":"man","transliteration":"l-insāna"},{"position":4,"text":"فِيٓ","translation":"in","transliteration":"fī"},{"position":5,"text":"أَحۡسَنِ","translation":"(the) best","transliteration":"aḥsani"},{"position":6,"text":"تَقۡوِيمٖ","translation":"mould","transliteration":"taqwīmin"}]},{"id":6103,"verseKey":"95:5","verseNumber":5,"arabic":"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ","translation":"Then We return him to the lowest of the low,","transliteration":"thumma radadnāhu asfala sāfilīna","audioUrl":"/audio/7/095005.mp3","segments":[[0,1,30,1310],[1,2,1320,2540],[2,3,2550,3290],[3,4,3300,6350]],"words":[{"position":1,"text":"ثُمَّ","translation":"Then","transliteration":"thumma"},{"position":2,"text":"رَدَدۡنَٰهُ","translation":"We returned him","transliteration":"radadnāhu"},{"position":3,"text":"أَسۡفَلَ","translation":"(to the) lowest","transliteration":"asfala"},{"position":4,"text":"سَٰفِلِينَ","translation":"(of the) low","transliteration":"sāfilīna"}]},{"id":6104,"verseKey":"95:6","verseNumber":6,"arabic":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ","translation":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","transliteration":"illā alladhīna āmanū waʿamilū l-ṣāliḥāti falahum ajrun ghayru mamnūnin","audioUrl":"/audio/7/095006.mp3","segments":[[0,1,30,550],[1,2,560,1560],[2,3,1570,2590],[3,4,2600,3360],[4,5,3370,4780],[5,6,4790,5630],[6,7,5640,6320],[7,8,6330,6950],[8,9,6960,10130]],"words":[{"position":1,"text":"إِلَّا","translation":"Except","transliteration":"illā"},{"position":2,"text":"ٱلَّذِينَ","translation":"those who","transliteration":"alladhīna"},{"position":3,"text":"ءَامَنُواْ","translation":"believe","transliteration":"āmanū"},{"position":4,"text":"وَعَمِلُواْ","translation":"and do","transliteration":"waʿ