{"chapter":{"id":72,"nameSimple":"Al-Jinn","nameArabic":"الجن","translatedName":"The Jinn","versesCount":28,"revelationPlace":"makkah"},"verses":[{"id":5448,"verseKey":"72:1","verseNumber":1,"arabic":" قُلْ أُوحِىَ إِلَىَّ أَنَّهُ ٱسْتَمَعَ نَفَرٌ مِّنَ ٱلْجِنِّ فَقَالُوٓا۟ إِنَّا سَمِعْنَا قُرْءَانًا عَجَبًا","translation":"Say, [O Muḥammad], \"It has been revealed to me that a group of the jinn listened and said, 'Indeed, we have heard an amazing Qur’ān [i.e., recitation].","transliteration":"qul ūḥiya ilayya annahu is'tamaʿa nafarun mina l-jini faqālū innā samiʿ'nā qur'ānan ʿajaban","audioUrl":"/audio/7/072001.mp3","segments":[[0,1,40,410],[1,2,420,1140],[2,3,1150,1890],[3,4,1900,3200],[4,5,3210,4010],[5,6,4020,5260],[6,7,5270,5510],[7,8,5520,6740],[8,9,6750,8970],[9,10,8980,10130],[10,11,10140,11140],[11,12,11150,12260],[12,13,12270,13280]],"words":[{"position":1,"text":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"text":"أُوحِىَ","translation":"It has been revealed","transliteration":"ūḥiya"},{"position":3,"text":"إِلَىَّ","translation":"to me","transliteration":"ilayya"},{"position":4,"text":"أَنَّهُ","translation":"that","transliteration":"annahu"},{"position":5,"text":"ٱسْتَمَعَ","translation":"listened","transliteration":"is'tamaʿa"},{"position":6,"text":"نَفَرٌۭ","translation":"a group","transliteration":"nafarun"},{"position":7,"text":"مِّنَ","translation":"of","transliteration":"mina"},{"position":8,"text":"ٱلْجِنِّ","translation":"the jinn","transliteration":"l-jini"},{"position":9,"text":"فَقَالُوٓا۟","translation":"and they said","transliteration":"faqālū"},{"position":10,"text":"إِنَّا","translation":"Indeed, we","transliteration":"innā"},{"position":11,"text":"سَمِعْنَا","translation":"heard","transliteration":"samiʿ'nā"},{"position":12,"text":"قُرْءَانًا","translation":"a Quran","transliteration":"qur'ānan"},{"position":13,"text":"عَجَبًۭا","translation":"amazing","transliteration":"ʿajaban"}]},{"id":5449,"verseKey":"72:2","verseNumber":2,"arabic":"يَهْدِىٓ إِلَى ٱلرُّشْدِ فَـَٔامَنَّا بِهِۦ ۖ وَلَن نُّشْرِكَ بِرَبِّنَآ أَحَدًا","translation":"It guides to the right course, and we have believed in it. And we will never associate with our Lord anyone.","transliteration":"yahdī ilā l-rush'di faāmannā bihi walan nush'rika birabbinā aḥadan","audioUrl":"/audio/7/072002.mp3","segments":[[0,1,100,2400],[1,2,2410,2700],[2,3,2710,3450],[3,4,3460,5430],[4,5,5440,6300],[5,6,6310,7480],[6,7,7490,8140],[7,8,8150,8910],[8,9,8920,10870]],"words":[{"position":1,"text":"يَهْدِىٓ","translation":"It guides","transliteration":"yahdī"},{"position":2,"text":"إِلَى","translation":"to","transliteration":"ilā"},{"position":3,"text":"ٱلرُّشْدِ","translation":"the right way","transliteration":"l-rush'di"},{"position":4,"text":"فَـَٔامَنَّا","translation":"so we believe","transliteration":"faāmannā"},{"position":5,"text":"بِهِۦ ۖ","translation":"in it","transliteration":"bihi"},{"position":6,"text":"وَلَن","translation":"and never","transliteration":"walan"},{"position":7,"text":"نُّشْرِكَ","translation":"we will associate","transliteration":"nush'rika"},{"position":8,"text":"بِرَبِّنَآ","translation":"with our Lord","transliteration":"birabbinā"},{"position":9,"text":"أَحَدًۭا","translation":"anyone","transliteration":"aḥadan"}]},{"id":5450,"verseKey":"72:3","verseNumber":3,"arabic":"وَأَنَّهُۥ تَعَـٰلَىٰ جَدُّ رَبِّنَا مَا ٱتَّخَذَ صَـٰحِبَةً وَلَا وَلَدًا","translation":"And [it teaches] that exalted is the nobleness of our Lord; He has not taken a wife or a son","transliteration":"wa-annahu taʿālā jaddu rabbinā mā ittakhadha ṣāḥibatan walā waladan","audioUrl":"/audio/7/072003.mp3","segments":[[0,1,30,1600],[1,2,1610,2570],[2,3,2580,3180],[3,4,3190,4150],[4,5,4160,4310],[5,6,4320,5050],[6,7,5060,6190],[7,8,6200,7610],[8,9,7620,8580]],"words":[{"position":1,"text":"وَأَنَّهُۥ","translation":"And that He ","transliteration":"wa-annahu"},{"position":2,"text":"تَعَـٰلَىٰ","translation":"Exalted is","transliteration":"taʿālā"},{"position":3,"text":"جَدُّ","translation":"(the) Majesty","transliteration":"jaddu"},{"position":4,"text":"رَبِّنَا","translation":"(of) our Lord ","transliteration":"rabbinā"},{"position":5,"text":"مَا","translation":"not","transliteration":"mā"},{"position":6,"text":"ٱتَّخَذَ","translation":"He has taken","transliteration":"ittakhadha"},{"position":7,"text":"صَـٰحِبَةًۭ","translation":"a wife","transliteration":"ṣāḥibatan"},{"position":8,"text":"وَلَا","translation":"and not","transliteration":"walā"},{"position":9,"text":"وَلَدًۭا","translation":"a son","transliteration":"waladan"}]},{"id":5451,"verseKey":"72:4","verseNumber":4,"arabic":"وَأَنَّهُۥ كَانَ يَقُولُ سَفِيهُنَا عَلَى ٱللَّهِ شَطَطًا","translation":"And that our foolish one [i.e., Iblees] has been saying about Allāh an excessive transgression.","transliteration":"wa-annahu kāna yaqūlu safīhunā ʿalā l-lahi shaṭaṭan","audioUrl":"/audio/7/072004.mp3","segments":[[0,1,30,1590],[1,2,1600,2190],[2,3,2200,2960],[3,4,2970,4000],[4,5,4010,4500],[5,6,4510,5230],[6,7,5240,6230]],"words":[{"position":1,"text":"وَأَنَّهُۥ","translation":"And that he","transliteration":"wa-annahu"},{"position":2,"text":"كَانَ","translation":"used to","transliteration":"kāna"},{"position":3,"text":"يَقُولُ","translation":"speak ","transliteration":"yaqūlu"},{"position":4,"text":"سَفِيهُنَا","translation":"the foolish among us","transliteration":"safīhunā"},{"position":5,"text":"عَلَى","translation":"against","transliteration":"ʿalā"},{"position":6,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":7,"text":"شَطَطًۭا","translation":"an excessive transgression","transliteration":"shaṭaṭan"}]},{"id":5452,"verseKey":"72:5","verseNumber":5,"arabic":"وَأَنَّا ظَنَنَّآ أَن لَّن تَقُولَ ٱلْإِنسُ وَٱلْجِنُّ عَلَى ٱللَّهِ كَذِبًا","translation":"And we had thought that mankind and the jinn would never speak about Allāh a lie.","transliteration":"wa-annā ẓanannā an lan taqūla l-insu wal-jinu ʿalā l-lahi kadhiban","audioUrl":"/audio/7/072005.mp3","segments":[[0,1,50,1440],[1,2,1450,4180],[2,3,4190,4800],[3,4,4810,5780],[4,5,5790,6560],[5,6,6570,7980],[6,7,7990,9290],[7,8,9300,9710],[8,9,9720,10480],[9,10,10490,11450]],"words":[{"position":1,"text":"وَأَنَّا","translation":"And that we","transliteration":"wa-annā"},{"position":2,"text":"ظَنَنَّآ","translation":"thought","transliteration":"ẓanannā"},{"position":3,"text":"أَن","translation":"that","transliteration":"an"},{"position":4,"text":"لَّن","translation":"never","transliteration":"lan"},{"position":5,"text":"تَقُولَ","translation":"will say","transliteration":"taqūla"},{"position":6,"text":"ٱلْإِنسُ","translation":"the men","transliteration":"l-insu"},{"position":7,"text":"وَٱلْجِنُّ","translation":"and the jinn","transliteration":"wal-jinu"},{"position":8,"text":"عَلَى","translation":"against","transliteration":"ʿalā"},{"position":9,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":10,"text":"كَذِبًۭا","translation":"any lie","transliteration":"kadhiban"}]},{"id":5453,"verseKey":"72:6","verseNumber":6,"arabic":"وَأَنَّهُۥ كَانَ رِجَالٌ مِّنَ ٱلْإِنسِ يَعُوذُونَ بِرِجَالٍ مِّنَ ٱلْجِنِّ فَزَادُوهُمْ رَهَقًا","translation":"And there were men from mankind who sought refuge in men from the jinn, so they [only] increased them in burden [i.e., sin].","transliteration":"wa-annahu kāna rijālun mina l-insi yaʿūdhūna birijālin mina l-jini fazādūhum rahaqan","audioUrl":"/audio/7/072006.mp3","segments":[[0,1,30,1750],[1,2,1760,2380],[2,3,2390,3810],[3,4,3820,4060],[4,5,4070,5580],[5,6,5590,6720],[6,7,6730,8360],[7,8,8370,8640],[8,9,8650,9830],[9,10,9840,11200],[10,11,11210,12170]],"words":[{"position":1,"text":"وَأَنَّهُۥ","translation":"And that","transliteration":"wa-annahu"},{"position":2,"text":"كَانَ","translation":"(there) were","transliteration":"kāna"},{"position":3,"text":"رِجَالٌۭ","translation":"men","transliteration":"rijālun"},{"position":4,"text":"مِّنَ","translation":"among","transliteration":"mina"},{"position":5,"text":"ٱلْإِنسِ","translation":"mankind","transliteration":"l-insi"},{"position":6,"text":"يَعُوذُونَ","translation":"who sought refuge","transliteration":"yaʿūdhūna"},{"position":7,"text":"بِرِجَالٍۢ","translation":"in (the) men","transliteration":"birijālin"},{"position":8,"text":"مِّنَ","translation":"from","transliteration":"mina"},{"position":9,"text":"ٱلْجِنِّ","translation":"the jinn","transliteration":"l-jini"},{"position":10,"text":"فَزَادُوهُمْ","translation":"so they increased them","transliteration":"fazādūhum"},{"position":11,"text":"رَهَقًۭا","translation":"(in) burden","transliteration":"rahaqan"}]},{"id":5454,"verseKey":"72:7","verseNumber":7,"arabic":"وَأَنَّهُمْ ظَنُّوا۟ كَمَا ظَنَنتُمْ أَن لَّن يَبْعَثَ ٱللَّهُ أَحَدًا","translation":"And they had thought, as you thought, that Allāh would never send anyone [as a messenger].","transliteration":"wa-annahum ẓannū kamā ẓanantum an lan yabʿatha l-lahu aḥadan","audioUrl":"/audio/7/072007.mp3","segments":[[0,1,40,1810],[1,2,1820,3160],[2,3,3170,3750],[3,4,3760,5220],[4,5,5230,5380],[5,6,5390,6560],[6,7,6570,7230],[7,8,7240,8010],[8,9,8020,8910]],"words":[{"position":1,"text":"وَأَنَّهُمْ","translation":"And that they","transliteration":"wa-annahum"},{"position":2,"text":"ظَنُّوا۟","translation":"thought","transliteration":"ẓannū"},{"position":3,"text":"كَمَا","translation":"as","transliteration":"kamā"},{"position":4,"text":"ظَنَنتُمْ","translation":"you thought","transliteration":"ẓanantum"},{"position":5,"text":"أَن","translation":"that","transliteration":"an"},{"position":6,"text":"لَّن","translation":"never","transliteration":"lan"},{"position":7,"text":"يَبْعَثَ","translation":"will raise","transliteration":"yabʿatha"},{"position":8,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":9,"text":"أَحَدًۭا","translation":"anyone","transliteration":"aḥadan"}]},{"id":5455,"verseKey":"72:8","verseNumber":8,"arabic":"وَأَنَّا لَمَسْنَا ٱلسَّمَآءَ فَوَجَدْنَـٰهَا مُلِئَتْ حَرَسًا شَدِيدًا وَشُهُبًا","translation":"And we have sought [to reach] the heaven but found it filled with powerful guards and burning flames.","transliteration":"wa-annā lamasnā l-samāa fawajadnāhā muli-at ḥarasan shadīdan washuhuban","audioUrl":"/audio/7/072008.mp3","segments":[[0,1,30,1480],[1,2,1490,2190],[2,3,2200,4510],[3,4,4520,6050],[4,5,6060,6720],[5,6,6730,8170],[6,7,8180,8990],[7,8,9000,11110]],"words":[{"position":1,"text":"وَأَنَّا","translation":"And that we","transliteration":"wa-annā"},{"position":2,"text":"لَمَسْنَا","translation":"sought to touch","transliteration":"lamasnā"},{"position":3,"text":"ٱلسَّمَآءَ","translation":"the heaven","transliteration":"l-samāa"},{"position":4,"text":"فَوَجَدْنَـٰهَا","translation":"but we found it","transliteration":"fawajadnāhā"},{"position":5,"text":"مُلِئَتْ","translation":"filled (with)","transliteration":"muli-at"},{"position":6,"text":"حَرَسًۭا","translation":"guards","transliteration":"ḥarasan"},{"position":7,"text":"شَدِيدًۭا","translation":"severe","transliteration":"shadīdan"},{"position":8,"text":"وَشُهُبًۭا","translation":"and flaming fires","transliteration":"washuhuban"}]},{"id":5456,"verseKey":"72:9","verseNumber":9,"arabic":"وَأَنَّا كُنَّا نَقْعُدُ مِنْهَا مَقَـٰعِدَ لِلسَّمْعِ ۖ فَمَن يَسْتَمِعِ ٱلْـَٔانَ يَجِدْ لَهُۥ شِهَابًا رَّصَدًا","translation":"And we used to sit therein in positions for hearing, but whoever listens now will find a burning flame lying in wait for him.","transliteration":"wa-annā kunnā naqʿudu min'hā maqāʿida lilssamʿi faman yastamiʿi l-āna yajid lahu shihāban raṣadan","audioUrl":"/audio/7/072009.mp3","segments":[[0,1,30,1540],[1,2,1550,2930],[2,3,2940,3700],[3,4,3710,4430],[4,5,4440,5470],[5,6,5480,6810],[6,7,6820,8150],[7,8,8160,8910],[8,9,8920,9610],[9,10,9620,10240],[10,11,10250,10820],[11,12,10830,11570],[12,13,11580,12800]],"words":[{"position":1,"text":"وَأَنَّا","translation":"And that we","transliteration":"wa-annā"},{"position":2,"text":"كُنَّا","translation":"used to","transliteration":"kunnā"},{"position":3,"text":"نَقْعُدُ","translation":"sit","transliteration":"naqʿudu"},{"position":4,"text":"مِنْهَا","translation":"there in","transliteration":"min'hā"},{"position":5,"text":"مَقَـٰعِدَ","translation":"positions","transliteration":"maqāʿida"},{"position":6,"text":"لِلسَّمْعِ ۖ","translation":"for hearing","transliteration":"lilssamʿi"},{"position":7,"text":"فَمَن","translation":"but (he) who","transliteration":"faman"},{"position":8,"text":"يَسْتَمِعِ","translation":"listens","transliteration":"yastamiʿi"},{"position":9,"text":"ٱلْـَٔانَ","translation":"now","transliteration":"l-āna"},{"position":10,"text":"يَجِدْ","translation":"will find","transliteration":"yajid"},{"position":11,"text":"لَهُۥ","translation":"for him","transliteration":"lahu"},{"position":12,"text":"شِهَابًۭا","translation":"a flaming fire","transliteration":"shihāban"},{"position":13,"text":"رَّصَدًۭا","translation":"waiting","transliteration":"raṣadan"}]},{"id":5457,"verseKey":"72:10","verseNumber":10,"arabic":"وَأَنَّا لَا نَدْرِىٓ أَشَرٌّ أُرِيدَ بِمَن فِى ٱلْأَرْضِ أَمْ أَرَادَ بِهِمْ رَبُّهُمْ رَشَدًا","translation":"And we do not know [therefore] whether evil is intended for those on earth or whether their Lord intends for them a right course.","transliteration":"wa-annā lā nadrī asharrun urīda biman fī l-arḍi am arāda bihim rabbuhum rashadan","audioUrl":"/audio/7/072010.mp3","segments":[[0,1,30,1610],[1,2,1620,1990],[2,3,2000,4070],[3,4,4080,5070],[4,5,5080,5770],[5,6,5780,6960],[6,7,6970,7220],[7,8,7230,7980],[8,9,7990,8320],[9,10,8330,9100],[10,11,9110,9650],[11,12,9660,10630],[12,13,10640,11590]],"words":[{"position":1,"text":"وَأَنَّا","translation":"And that we ","transliteration":"wa-annā"},{"position":2,"text":"لَا","translation":"not","transliteration":"lā"},{"position":3,"text":"نَدْرِىٓ","translation":"we know","transliteration":"nadrī"},{"position":4,"text":"أَشَرٌّ","translation":"whether evil","transliteration":"asharrun"},{"position":5,"text":"أُرِيدَ","translation":"is intended","transliteration":"urīda"},{"position":6,"text":"بِمَن","translation":"for (those) who","transliteration":"biman"},{"position":7,"text":"فِى","translation":"(are) in","transliteration":"fī"},{"position":8,"text":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":9,"text":"أَمْ","translation":"or","transliteration":"am"},{"position":10,"text":"أَرَادَ","translation":"intends","transliteration":"arāda"},{"position":11,"text":"بِهِمْ","translation":"for them","transliteration":"bihim"},{"position":12,"text":"رَبُّهُمْ","translation":"their Lord","transliteration":"rabbuhum"},{"position":13,"text":"رَشَدًۭا","translation":"a right path","transliteration":"rashadan"}]},{"id":5458,"verseKey":"72:11","verseNumber":11,"arabic":"وَأَنَّا مِنَّا ٱلصَّـٰلِحُونَ وَمِنَّا دُونَ ذَٰلِكَ ۖ كُنَّا طَرَآئِقَ قِدَدًا","translation":"And among us are the righteous, and among us are [others] not so; we were [of] divided ways.","transliteration":"wa-annā minnā l-ṣāliḥūna waminnā dūna dhālika kunnā ṭarāiqa qidadan","audioUrl":"/audio/7/072011.mp3","segments":[[0,1,30,1550],[1,2,1560,2530],[2,3,2540,3920],[3,4,3930,5380],[4,5,5390,5950],[5,6,5960,7180],[6,7,7190,8350],[7,8,8360,11090],[8,9,11100,12030]],"words":[{"position":1,"text":"وَأَنَّا","translation":"And that [we]","transliteration":"wa-annā"},{"position":2,"text":"مِنَّا","translation":"among us","transliteration":"minnā"},{"position":3,"text":"ٱلصَّـٰلِحُونَ","translation":"(are) the righteous","transliteration":"l-ṣāliḥūna"},{"position":4,"text":"وَمِنَّا","translation":"and among us","transliteration":"waminnā"},{"position":5,"text":"دُونَ","translation":"(are) other than","transliteration":"dūna"},{"position":6,"text":"ذَٰلِكَ ۖ","translation":"that","transliteration":"dhālika"},{"position":7,"text":"كُنَّا","translation":"We","transliteration":"kunnā"},{"position":8,"text":"طَرَآئِقَ","translation":"(are on) ways","transliteration":"ṭarāiqa"},{"position":9,"text":"قِدَدًۭا","translation":"different","transliteration":"qidadan"}]},{"id":5459,"verseKey":"72:12","verseNumber":12,"arabic":"وَأَنَّا ظَنَنَّآ أَن لَّن نُّعْجِزَ ٱللَّهَ فِى ٱلْأَرْضِ وَلَن نُّعْجِزَهُۥ هَرَبًا","translation":"And we have become certain that we will never cause failure to Allāh upon earth, nor can we escape Him by flight.","transliteration":"wa-annā ẓanannā an lan nuʿ'jiza l-laha fī l-arḍi walan nuʿ'jizahu haraban","audioUrl":"/audio/7/072012.mp3","segments":[[0,1,30,1480],[1,2,1490,4580],[2,3,4590,4750],[3,4,4760,5790],[4,5,5800,6520],[5,6,6530,7290],[6,7,7300,7530],[7,8,7540,8290],[8,9,8300,9370],[9,10,9380,10500],[10,11,10510,11400]],"words":[{"position":1,"text":"وَأَنَّا","translation":"And that we","transliteration":"wa-annā"},{"position":2,"text":"ظَنَنَّآ","translation":"[we] have become certain","transliteration":"ẓanannā"},{"position":3,"text":"أَن","translation":"that","transliteration":"an"},{"position":4,"text":"لَّن","translation":"never","transliteration":"lan"},{"position":5,"text":"نُّعْجِزَ","translation":"we will cause failure","transliteration":"nuʿ'jiza"},{"position":6,"text":"ٱللَّهَ","translation":"(to) Allah","transliteration":"l-laha"},{"position":7,"text":"فِى","translation":"in","transliteration":"fī"},{"position":8,"text":"ٱلْأَرْضِ","translation":"the earth","transliteration":"l-arḍi"},{"position":9,"text":"وَلَن","translation":"and never","transliteration":"walan"},{"position":10,"text":"نُّعْجِزَهُۥ","translation":"we can escape Him","transliteration":"nuʿ'jizahu"},{"position":11,"text":"هَرَبًۭا","translation":"(by) flight","transliteration":"haraban"}]},{"id":5460,"verseKey":"72:13","verseNumber":13,"arabic":"وَأَنَّا لَمَّا سَمِعْنَا ٱلْهُدَىٰٓ ءَامَنَّا بِهِۦ ۖ فَمَن يُؤْمِنۢ بِرَبِّهِۦ فَلَا يَخَافُ بَخْسًا وَلَا رَهَقًا","translation":"And when we heard the guidance [i.e., the Qur’ān], we believed in it. And whoever believes in his Lord will not fear deprivation or burden.","transliteration":"wa-annā lammā samiʿ'nā l-hudā āmannā bihi faman yu'min birabbihi falā yakhāfu bakhsan walā rahaqan","audioUrl":"/audio/7/072013.mp3","segments":[[0,1,30,1520],[1,2,1530,2720],[2,3,2730,3570],[3,4,3580,5930],[4,5,5940,7750],[5,6,7760,8700],[6,7,8710,9770],[7,8,9780,11000],[8,9,11010,12180],[9,10,12190,12760],[10,11,12770,13630],[11,12,13640,14250],[12,13,14260,15540],[13,14,15550,16610]],"words":[{"position":1,"text":"وَأَنَّا","translation":"And that [we]","transliteration":"wa-annā"},{"position":2,"text":"لَمَّا","translation":"when","transliteration":"lammā"},{"position":3,"text":"سَمِعْنَا","translation":"we heard","transliteration":"samiʿ'nā"},{"position":4,"text":"ٱلْهُدَىٰٓ","translation":"the Guidance","transliteration":"l-hudā"},{"position":5,"text":"ءَامَنَّا","translation":"we believed","transliteration":"āmannā"},{"position":6,"text":"بِهِۦ ۖ","translation":"in it","transliteration":"bihi"},{"position":7,"text":"فَمَن","translation":"And whoever","transliteration":"faman"},{"position":8,"text":"يُؤْمِنۢ","translation":"believes","transliteration":"yu'min"},{"position":9,"text":"بِرَبِّهِۦ","translation":"in his Lord","transliteration":"birabbihi"},{"position":10,"text":"فَلَا","translation":"then not","transliteration":"falā"},{"position":11,"text":"يَخَافُ","translation":"he will fear","transliteration":"yakhāfu"},{"position":12,"text":"بَخْسًۭا","translation":"any loss","transliteration":"bakhsan"},{"position":13,"text":"وَلَا","translation":"and not","transliteration":"walā"},{"position":14,"text":"رَهَقًۭا","translation":"any burden","transliteration":"rahaqan"}]},{"id":5461,"verseKey":"72:14","verseNumber":14,"arabic":"وَأَنَّا مِنَّا ٱلْمُسْلِمُونَ وَمِنَّا ٱلْقَـٰسِطُونَ ۖ فَمَنْ أَسْلَمَ فَأُو۟لَـٰٓئِكَ تَحَرَّوْا۟ رَشَدًا","translation":"And among us are Muslims [in submission to Allāh], and among us are the unjust. And whoever has become Muslim - those have sought out the right course.","transliteration":"wa-annā minnā l-mus'limūna waminnā l-qāsiṭūna faman aslama fa-ulāika taḥarraw rashadan","audioUrl":"/audio/7/072014.mp3","segments":[[0,1,40,1500],[1,2,1510,2540],[2,3,2550,3950],[3,4,3960,5570],[4,5,5580,8870],[5,6,8880,9410],[6,7,9420,10160],[7,8,10170,12650],[8,9,12660,13690],[9,10,13700,14610]],"words":[{"position":1,"text":"وَأَنَّا","translation":"And that we","transliteration":"wa-annā"},{"position":2,"text":"مِنَّا","translation":"among us","transliteration":"minnā"},{"position":3,"text":"ٱلْمُسْلِمُونَ","translation":"(are) Muslims","transliteration":"l-mus'limūna"},{"position":4,"text":"وَمِنَّا","translation":"and among us","transliteration":"waminnā"},{"position":5,"text":"ٱلْقَـٰسِطُونَ ۖ","translation":"(are) unjust","transliteration":"l-qāsiṭūna"},{"position":6,"text":"فَمَنْ","translation":"And whoever","transliteration":"faman"},{"position":7,"text":"أَسْلَمَ","translation":"submits","transliteration":"aslama"},{"position":8,"text":"فَأُو۟لَـٰٓئِكَ","translation":"then those","transliteration":"fa-ulāika"},{"position":9,"text":"تَحَرَّوْا۟","translation":"have sought","transliteration":"taḥarraw"},{"position":10,"text":"رَشَدًۭا","translation":"(the) right path","transliteration":"rashadan"}]},{"id":5462,"verseKey":"72:15","verseNumber":15,"arabic":"وَأَمَّا ٱلْقَـٰسِطُونَ فَكَانُوا۟ لِجَهَنَّمَ حَطَبًا","translation":"But as for the unjust, they will be, for Hell, firewood.'","transliteration":"wa-ammā l-qāsiṭūna fakānū lijahannama ḥaṭaban","audioUrl":"/audio/7/072015.mp3","segments":[[0,1,30,1350],[1,2,1360,2710],[2,3,2720,3730],[3,4,3740,5480],[4,5,5490,6540]],"words":[{"position":1,"text":"وَأَمَّا","translation":"And as for","transliteration":"wa-ammā"},{"position":2,"text":"ٱلْقَـٰسِطُونَ","translation":"the unjust","transliteration":"l-qāsiṭūna"},{"position":3,"text":"فَكَانُوا۟","translation":"they will be","transliteration":"fakānū"},{"position":4,"text":"لِجَهَنَّمَ","translation":"for Hell","transliteration":"lijahannama"},{"position":5,"text":"حَطَبًۭا","translation":"firewood","transliteration":"ḥaṭaban"}]},{"id":5463,"verseKey":"72:16","verseNumber":16,"arabic":"وَأَلَّوِ ٱسْتَقَـٰمُوا۟ عَلَى ٱلطَّرِيقَةِ لَأَسْقَيْنَـٰهُم مَّآءً غَدَقًا","translation":"And [Allāh revealed] that if they had remained straight on the way, We would have given them abundant rain [i.e., provision].","transliteration":"wa-allawi is'taqāmū ʿalā l-ṭarīqati la-asqaynāhum māan ghadaqan","audioUrl":"/audio/7/072016.mp3","segments":[[0,1,30,920],[1,2,930,2230],[2,3,2240,2550],[3,4,2560,3750],[4,5,3760,6420],[5,6,6430,8620],[6,7,8630,9620]],"words":[{"position":1,"text":"وَأَلَّوِ","translation":"And that if","transliteration":"wa-allawi"},{"position":2,"text":"ٱسْتَقَـٰمُوا۟","translation":"they had remained","transliteration":"is'taqāmū"},{"position":3,"text":"عَلَى","translation":"on","transliteration":"ʿalā"},{"position":4,"text":"ٱلطَّرِيقَةِ","translation":"the Way","transliteration":"l-ṭarīqati"},{"position":5,"text":"لَأَسْقَيْنَـٰهُم","translation":"surely We (would) have given them to drink","transliteration":"la-asqaynāhum"},{"position":6,"text":"مَّآءً","translation":"water","transliteration":"māan"},{"position":7,"text":"غَدَقًۭا","translation":"(in) abundance","transliteration":"ghadaqan"}]},{"id":5464,"verseKey":"72:17","verseNumber":17,"arabic":"لِّنَفْتِنَهُمْ فِيهِ ۚ وَمَن يُعْرِضْ عَن ذِكْرِ رَبِّهِۦ يَسْلُكْهُ عَذَابًا صَعَدًا","translation":"So We might test them therein. And whoever turns away from the remembrance of his Lord He will put into arduous punishment.","transliteration":"linaftinahum fīhi waman yuʿ'riḍ ʿan dhik'ri rabbihi yasluk'hu ʿadhāban ṣaʿadan","audioUrl":"/audio/7/072017.mp3","segments":[[0,1,30,1250],[1,2,1260,3590],[2,3,3600,5000],[3,4,5010,5660],[4,5,5670,6590],[5,6,6600,7100],[6,7,7110,8080],[7,8,8090,8990],[8,9,9000,10580],[9,10,10590,11560]],"words":[{"position":1,"text":"لِّنَفْتِنَهُمْ","translation":"That We might test them","transliteration":"linaftinahum"},{"position":2,"text":"فِيهِ ۚ","translation":"therein","transliteration":"fīhi"},{"position":3,"text":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":4,"text":"يُعْرِضْ","translation":"turns away","transliteration":"yuʿ'riḍ"},{"position":5,"text":"عَن","translation":"from","transliteration":"ʿan"},{"position":6,"text":"ذِكْرِ","translation":"the Remembrance","transliteration":"dhik'ri"},{"position":7,"text":"رَبِّهِۦ","translation":"(of) his Lord","transliteration":"rabbihi"},{"position":8,"text":"يَسْلُكْهُ","translation":"He will make him enter","transliteration":"yasluk'hu"},{"position":9,"text":"عَذَابًۭا","translation":"a punishment","transliteration":"ʿadhāban"},{"position":10,"text":"صَعَدًۭا","translation":"severe","transliteration":"ṣaʿadan"}]},{"id":5465,"verseKey":"72:18","verseNumber":18,"arabic":"وَأَنَّ ٱلْمَسَـٰجِدَ لِلَّهِ فَلَا تَدْعُوا۟ مَعَ ٱللَّهِ أَحَدًا","translation":"And [He revealed] that the masjids are for Allāh, so do not invoke with Allāh anyone.","transliteration":"wa-anna l-masājida lillahi falā tadʿū maʿa l-lahi aḥadan","audioUrl":"/audio/7/072018.mp3","segments":[[0,1,30,1370],[1,2,1380,2600],[2,3,2610,3520],[3,4,3530,4110],[4,5,4120,4940],[5,6,4950,5310],[6,7,5320,6060],[7,8,6070,7010]],"words":[{"position":1,"text":"وَأَنَّ","translation":"And that","transliteration":"wa-anna"},{"position":2,"text":"ٱلْمَسَـٰجِدَ","translation":"the masjids","transliteration":"l-masājida"},{"position":3,"text":"لِلَّهِ","translation":"(are) for Allah","transliteration":"lillahi"},{"position":4,"text":"فَلَا","translation":"so (do) not","transliteration":"falā"},{"position":5,"text":"تَدْعُوا۟","translation":"call","transliteration":"tadʿū"},{"position":6,"text":"مَعَ","translation":"with","transliteration":"maʿa"},{"position":7,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":8,"text":"أَحَدًۭا","translation":"anyone","transliteration":"aḥadan"}]},{"id":5466,"verseKey":"72:19","verseNumber":19,"arabic":"وَأَنَّهُۥ لَمَّا قَامَ عَبْدُ ٱللَّهِ يَدْعُوهُ كَادُوا۟ يَكُونُونَ عَلَيْهِ لِبَدًا","translation":"And that when the Servant [i.e., Prophet] of Allāh stood up supplicating Him, they almost became about him a compacted mass.\"","transliteration":"wa-annahu lammā qāma ʿabdu l-lahi yadʿūhu kādū yakūnūna ʿalayhi libadan","audioUrl":"/audio/7/072019.mp3","segments":[[0,1,30,1840],[1,2,1850,3010],[2,3,3020,3570],[3,4,3580,4270],[4,5,4280,4970],[5,6,4980,5880],[6,7,5890,6700],[7,8,6710,7780],[8,9,7790,8640],[9,10,8650,9550]],"words":[{"position":1,"text":"وَأَنَّهُۥ","translation":"And that","transliteration":"wa-annahu"},{"position":2,"text":"لَمَّا","translation":"when","transliteration":"lammā"},{"position":3,"text":"قَامَ","translation":"stood up","transliteration":"qāma"},{"position":4,"text":"عَبْدُ","translation":"(the) slave","transliteration":"ʿabdu"},{"position":5,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":6,"text":"يَدْعُوهُ","translation":"calling (upon) Him","transliteration":"yadʿūhu"},{"position":7,"text":"كَادُوا۟","translation":"they almost","transliteration":"kādū"},{"position":8,"text":"يَكُونُونَ","translation":"became","transliteration":"yakūnūna"},{"position":9,"text":"عَلَيْهِ","translation":"around him","transliteration":"ʿalayhi"},{"position":10,"text":"لِبَدًۭا","translation":"a compacted mass","transliteration":"libadan"}]},{"id":5467,"verseKey":"72:20","verseNumber":20,"arabic":"قُلْ إِنَّمَآ أَدْعُوا۟ رَبِّى وَلَآ أُشْرِكُ بِهِۦٓ أَحَدًا","translation":"Say, [O Muḥammad], \"I only invoke my Lord and do not associate with Him anyone.\"","transliteration":"qul innamā adʿū rabbī walā ush'riku bihi aḥadan","audioUrl":"/audio/7/072020.mp3","segments":[[0,1,30,350],[1,2,360,2830],[2,3,2840,4230],[3,4,4240,5040],[4,5,5050,6330],[5,6,6340,7550],[6,7,7560,9540],[7,8,9550,10520]],"words":[{"position":1,"text":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"text":"إِنَّمَآ","translation":"Only","transliteration":"innamā"},{"position":3,"text":"أَدْعُوا۟","translation":"I call upon","transliteration":"adʿū"},{"position":4,"text":"رَبِّى","translation":"my Lord","transliteration":"rabbī"},{"position":5,"text":"وَلَآ","translation":"and not","transliteration":"walā"},{"position":6,"text":"أُشْرِكُ","translation":"I associate","transliteration":"ush'riku"},{"position":7,"text":"بِهِۦٓ","translation":"with Him","transliteration":"bihi"},{"position":8,"text":"أَحَدًۭا","translation":"anyone","transliteration":"aḥadan"}]},{"id":5468,"verseKey":"72:21","verseNumber":21,"arabic":"قُلْ إِنِّى لَآ أَمْلِكُ لَكُمْ ضَرًّا وَلَا رَشَدًا","translation":"Say, \"Indeed, I do not possess for you [the power of] harm or right direction.\"","transliteration":"qul innī lā amliku lakum ḍarran walā rashadan","audioUrl":"/audio/7/072021.mp3","segments":[[0,1,30,360],[1,2,370,1830],[2,3,1840,3460],[3,4,3470,4240],[4,5,4250,4780],[5,6,4790,6350],[6,7,6360,6840],[7,8,6850,7840]],"words":[{"position":1,"text":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"text":"إِنِّى","translation":"Indeed, I","transliteration":"innī"},{"position":3,"text":"لَآ","translation":"(do) not","transliteration":"lā"},{"position":4,"text":"أَمْلِكُ","translation":"possess","transliteration":"amliku"},{"position":5,"text":"لَكُمْ","translation":"for you","transliteration":"lakum"},{"position":6,"text":"ضَرًّۭا","translation":"any harm","transliteration":"ḍarran"},{"position":7,"text":"وَلَا","translation":"and not","transliteration":"walā"},{"position":8,"text":"رَشَدًۭا","translation":"right path","transliteration":"rashadan"}]},{"id":5469,"verseKey":"72:22","verseNumber":22,"arabic":"قُلْ إِنِّى لَن يُجِيرَنِى مِنَ ٱللَّهِ أَحَدٌ وَلَنْ أَجِدَ مِن دُونِهِۦ مُلْتَحَدًا","translation":"Say, \"Indeed, there will never protect me from Allāh anyone [if I should disobey], nor will I find in other than Him a refuge.","transliteration":"qul innī lan yujīranī mina l-lahi aḥadun walan ajida min dūnihi mul'taḥadan","audioUrl":"/audio/7/072022.mp3","segments":[[0,1,30,340],[1,2,350,1550],[2,3,1560,2880],[3,4,2890,3860],[4,5,3870,4250],[5,6,4260,5040],[6,7,5050,6300],[7,8,6310,7040],[8,9,7050,7670],[9,10,7680,8550],[10,11,8560,9590],[11,12,9600,10920]],"words":[{"position":1,"text":"قُلْ","translation":"Say","transliteration":"qul"},{"position":2,"text":"إِنِّى","translation":"Indeed I","transliteration":"innī"},{"position":3,"text":"لَن","translation":"never","transliteration":"lan"},{"position":4,"text":"يُجِيرَنِى","translation":"can protect me","transliteration":"yujīranī"},{"position":5,"text":"مِنَ","translation":"from","transliteration":"mina"},{"position":6,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":7,"text":"أَحَدٌۭ","translation":"anyone","transliteration":"aḥadun"},{"position":8,"text":"وَلَنْ","translation":"and never","transliteration":"walan"},{"position":9,"text":"أَجِدَ","translation":"can I find","transliteration":"ajida"},{"position":10,"text":"مِن","translation":"from","transliteration":"min"},{"position":11,"text":"دُونِهِۦ","translation":"besides Him","transliteration":"dūnihi"},{"position":12,"text":"مُلْتَحَدًا","translation":"any refuge","transliteration":"mul'taḥadan"}]},{"id":5470,"verseKey":"72:23","verseNumber":23,"arabic":"إِلَّا بَلَـٰغًا مِّنَ ٱللَّهِ وَرِسَـٰلَـٰتِهِۦ ۚ وَمَن يَعْصِ ٱللَّهَ وَرَسُولَهُۥ فَإِنَّ لَهُۥ نَارَ جَهَنَّمَ خَـٰلِدِينَ فِيهَآ أَبَدًا","translation":"But [I have for you] only notification from Allāh, and His messages.\" And whoever disobeys Allāh and His Messenger - then indeed, for him is the fire of Hell; they will abide therein forever.","transliteration":"illā balāghan mina l-lahi warisālātihi waman yaʿṣi l-laha warasūlahu fa-inna lahu nāra jahannama khālidīna fīhā abadan","audioUrl":"/audio/7/072023.mp3","segments":[[0,1,30,750],[1,2,760,2630],[2,3,2640,2940],[3,4,2950,3770],[4,5,3780,5940],[5,6,5950,7310],[6,7,7320,7730],[7,8,7740,8540],[8,9,8550,9900],[9,10,9910,11280],[10,11,11290,11840],[11,12,11850,12400],[12,13,12410,18850],[13,14,18860,20030],[14,15,20040,22230],[15,16,22240,23210]],"words":[{"position":1,"text":"إِلَّا","translation":"But","transliteration":"illā"},{"position":2,"text":"بَلَـٰغًۭا","translation":"(the) notification","transliteration":"balāghan"},{"position":3,"text":"مِّنَ","translation":"from","transliteration":"mina"},{"position":4,"text":"ٱللَّهِ","translation":"Allah","transliteration":"l-lahi"},{"position":5,"text":"وَرِسَـٰلَـٰتِهِۦ ۚ","translation":"and His Messages","transliteration":"warisālātihi"},{"position":6,"text":"وَمَن","translation":"And whoever","transliteration":"waman"},{"position":7,"text":"يَعْصِ","translation":"disobeys","transliteration":"yaʿṣi"},{"position":8,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":9,"text":"وَرَسُولَهُۥ","translation":"and His Messenger","transliteration":"warasūlahu"},{"position":10,"text":"فَإِنَّ","translation":"then indeed","transliteration":"fa-inna"},{"position":11,"text":"لَهُۥ","translation":"for him","transliteration":"lahu"},{"position":12,"text":"نَارَ","translation":"(is the) Fire","transliteration":"nāra"},{"position":13,"text":"جَهَنَّمَ","translation":"(of) Hell","transliteration":"jahannama"},{"position":14,"text":"خَـٰلِدِينَ","translation":"(they will) abide","transliteration":"khālidīna"},{"position":15,"text":"فِيهَآ","translation":"therein","transliteration":"fīhā"},{"position":16,"text":"أَبَدًا","translation":"forever","transliteration":"abadan"}]},{"id":5471,"verseKey":"72:24","verseNumber":24,"arabic":"حَتَّىٰٓ إِذَا رَأَوْا۟ مَا يُوعَدُونَ فَسَيَعْلَمُونَ مَنْ أَضْعَفُ نَاصِرًا وَأَقَلُّ عَدَدًا","translation":"[The disbelievers continue] until, when they see that which they are promised, then they will know who is weaker in helpers and less in number.","transliteration":"ḥattā idhā ra-aw mā yūʿadūna fasayaʿlamūna man aḍʿafu nāṣiran wa-aqallu ʿadadan","audioUrl":"/audio/7/072024.mp3","segments"