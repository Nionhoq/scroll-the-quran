egments":[[0,1,40,990],[1,2,1000,2240],[2,3,2250,2620],[3,4,2630,3650],[4,5,3660,4800],[5,6,4810,5830],[6,7,5840,6840],[7,8,6850,7440],[8,9,7450,8460],[9,10,8470,9620],[10,11,9630,10270],[11,12,10280,11210],[12,13,11220,12370]],"words":[{"position":1,"text":"لِّيَعْلَمَ","translation":"That He may make evident","transliteration":"liyaʿlama"},{"position":2,"text":"أَن","translation":"that","transliteration":"an"},{"position":3,"text":"قَدْ","translation":"indeed","transliteration":"qad"},{"position":4,"text":"أَبْلَغُوا۟","translation":"they have conveyed","transliteration":"ablaghū"},{"position":5,"text":"رِسَـٰلَـٰتِ","translation":"(the) Messages","transliteration":"risālāti"},{"position":6,"text":"رَبِّهِمْ","translation":"(of) their Lord","transliteration":"rabbihim"},{"position":7,"text":"وَأَحَاطَ","translation":"and He has encompassed","transliteration":"wa-aḥāṭa"},{"position":8,"text":"بِمَا","translation":"what","transliteration":"bimā"},{"position":9,"text":"لَدَيْهِمْ","translation":"(is) with them","transliteration":"ladayhim"},{"position":10,"text":"وَأَحْصَىٰ","translation":"and He takes account","transliteration":"wa-aḥṣā"},{"position":11,"text":"كُلَّ","translation":"(of) all","transliteration":"kulla"},{"position":12,"text":"شَىْءٍ","translation":"things","transliteration":"shayin"},{"position":13,"text":"عَدَدًۢا","translation":"(in) number","transliteration":"ʿadadan"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
