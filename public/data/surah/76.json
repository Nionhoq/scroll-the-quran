:"(of) crystal","transliteration":"qawārīrā"}]},{"id":5607,"verseKey":"76:16","verseNumber":16,"arabic":"قَوَارِيرَاْ مِن فِضَّةٖ قَدَّرُوهَا تَقۡدِيرٗا","translation":"Clear glasses [made] from silver of which they have determined the measure.","transliteration":"qawārīrā min fiḍḍatin qaddarūhā taqdīran","audioUrl":"/audio/7/076016.mp3","segments":[[0,1,30,1160],[1,2,1170,2090],[2,3,2100,4370],[3,4,4380,5240],[4,5,5250,6640]],"words":[{"position":1,"text":"قَوَارِيرَاْ","translation":"Crystal-clear","transliteration":"qawārīrā"},{"position":2,"text":"مِن","translation":"of","transliteration":"min"},{"position":3,"text":"فِضَّةٖ","translation":"silver","transliteration":"fiḍḍatin"},{"position":4,"text":"قَدَّرُوهَا","translation":"They will determine its","transliteration":"qaddarūhā"},{"position":5,"text":"تَقۡدِيرٗا","translation":"measure","transliteration":"taqdīran"}]},{"id":5608,"verseKey":"76:17","verseNumber":17,"arabic":"وَيُسۡقَوۡنَ فِيهَا كَأۡسٗا كَانَ مِزَاجُهَا زَنجَبِيلًا","translation":"And they will be given to drink a cup [of wine] whose mixture is of ginger","transliteration":"wayus'qawna fīhā kasan kāna mizājuhā zanjabīlan","audioUrl":"/audio/7/076017.mp3","segments":[[0,1,30,1060],[1,2,1070,1820],[2,3,1830,2380],[3,4,2390,3840],[4,5,3850,5030],[5,6,5040,7180]],"words":[{"position":1,"text":"وَيُسۡقَوۡنَ","translation":"And they will be given to drink","transliteration":"wayus'qawna"},{"position":2,"text":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":3,"text":"كَأۡسٗا","translation":"a cup ","transliteration":"kasan"},{"position":4,"text":"كَانَ","translation":"is","transliteration":"kāna"},{"position":5,"text":"مِزَاجُهَا","translation":"its mixture","transliteration":"mizājuhā"},{"position":6,"text":"زَنجَبِيلًا","translation":"(of) Zanjabil","transliteration":"zanjabīlan"}]},{"id":5609,"verseKey":"76:18","verseNumber":18,"arabic":"عَيۡنٗا فِيهَا تُسَمَّىٰ سَلۡسَبِيلٗا","translation":"[From] a fountain within it [i.e., Paradise] named Salsabeel.","transliteration":"ʿaynan fīhā tusammā salsabīlan","audioUrl":"/audio/7/076018.mp3","segments":[[0,1,30,1480],[1,2,1490,2250],[2,3,2260,3660],[3,4,3670,5150]],"words":[{"position":1,"text":"عَيۡنٗا","translation":"A spring","transliteration":"ʿaynan"},{"position":2,"text":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":3,"text":"تُسَمَّىٰ","translation":"named","transliteration":"tusammā"},{"position":4,"text":"سَلۡسَبِيلٗا","translation":"Salsabil","transliteration":"salsabīlan"}]},{"id":5610,"verseKey":"76:19","verseNumber":19,"arabic":"۞ وَيَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ إِذَا رَأَيۡتَهُمۡ حَسِبۡتَهُمۡ لُؤۡلُؤٗا مَّنثُورٗا","translation":"There will circulate among them young boys made eternal. When you see them, you would think them [as beautiful as] scattered pearls.","transliteration":"wayaṭūfu ʿalayhim wil'dānun mukhalladūna idhā ra-aytahum ḥasib'tahum lu'lu-an manthūran","audioUrl":"/audio/7/076019.mp3","segments":[[0,1,30,880],[1,2,890,1880],[2,3,1890,3750],[3,4,3760,4950],[4,5,4960,5480],[5,6,5490,6590],[6,7,6600,7750],[7,8,7760,8540],[8,9,8550,11110]],"words":[{"position":1,"text":"۞ وَيَطُوفُ","translation":"And will circulate","transliteration":"wayaṭūfu"},{"position":2,"text":"عَلَيۡهِمۡ","translation":"among them","transliteration":"ʿalayhim"},{"position":3,"text":"وِلۡدَٰنٞ","translation":"young boys","transliteration":"wil'dānun"},{"position":4,"text":"مُّخَلَّدُونَ","translation":"made eternal","transliteration":"mukhalladūna"},{"position":5,"text":"إِذَا","translation":"When","transliteration":"idhā"},{"position":6,"text":"رَأَيۡتَهُمۡ","translation":"you see them","transliteration":"ra-aytahum"},{"position":7,"text":"حَسِبۡتَهُمۡ","translation":"you would think them","transliteration":"ḥasib'tahum"},{"position":8,"text":"لُؤۡلُؤٗا","translation":"(to be) pearls","transliteration":"lu'lu-an"},{"position":9,"text":"مَّنثُورٗا","translation":"scattered","transliteration":"manthūran"}]},{"id":5611,"verseKey":"76:20","verseNumber":20,"arabic":"وَإِذَا رَأَيۡتَ ثَمَّ رَأَيۡتَ نَعِيمٗا وَمُلۡكٗا كَبِيرًا","translation":"And when you look there [in Paradise], you will see pleasure and great dominion.","transliteration":"wa-idhā ra-ayta thamma ra-ayta naʿīman wamul'kan kabīran","audioUrl":"/audio/7/076020.mp3","segments":[[0,1,30,700],[1,2,710,1480],[2,3,1490,2560],[3,4,2570,3360],[4,5,3370,4090],[5,6,4100,6110],[6,7,6120,7300]],"words":[{"position":1,"text":"وَإِذَا","translation":"And when","transliteration":"wa-idhā"},{"position":2,"text":"رَأَيۡتَ","translation":"you look","transliteration":"ra-ayta"},{"position":3,"text":"ثَمَّ","translation":"then","transliteration":"thamma"},{"position":4,"text":"رَأَيۡتَ","translation":"you will see","transliteration":"ra-ayta"},{"position":5,"text":"نَعِيمٗا","translation":"blessings","transliteration":"naʿīman"},{"position":6,"text":"وَمُلۡكٗا","translation":"and a kingdom","transliteration":"wamul'kan"},{"position":7,"text":"كَبِيرًا","translation":"great","transliteration":"kabīran"}]},{"id":5612,"verseKey":"76:21","verseNumber":21,"arabic":"عَٰلِيَهُمۡ ثِيَابُ سُندُسٍ خُضۡرٞ وَإِسۡتَبۡرَقٞۖ وَحُلُّوٓاْ أَسَاوِرَ مِن فِضَّةٖ وَسَقَىٰهُمۡ رَبُّهُمۡ شَرَابٗا طَهُورًا","translation":"Upon them [i.e., the inhabitants] will be green garments of fine silk and brocade. And they will be adorned with bracelets of silver, and their Lord will give them a purifying drink.","transliteration":"ʿāliyahum thiyābu sundusin khuḍ'run wa-is'tabraqun waḥullū asāwira min fiḍḍatin wasaqāhum rabbuhum sharāban ṭahūran","audioUrl":"/audio/7/076021.mp3","segments":[[0,1,30,1120],[1,2,1130,1870],[2,3,1880,3450],[3,4,3460,4180],[4,5,4190,6830],[5,6,6840,9230],[6,7,9240,10210],[7,8,10220,10890],[8,9,10900,12520],[9,10,12530,13710],[10,11,13720,14630],[11,12,14640,15500],[12,13,15510,17410]],"words":[{"position":1,"text":"عَٰلِيَهُمۡ","translation":"Upon them","transliteration":"ʿāliyahum"},{"position":2,"text":"ثِيَابُ","translation":"(will be) garments","transliteration":"thiyābu"},{"position":3,"text":"سُندُسٍ","translation":"(of) fine silk","transliteration":"sundusin"},{"position":4,"text":"خُضۡرٞ","translation":"green","transliteration":"khuḍ'run"},{"position":5,"text":"وَإِسۡتَبۡرَقٞۖ","translation":"and heavy brocade","transliteration":"wa-is'tabraqun"},{"position":6,"text":"وَحُلُّوٓاْ","translation":"And they will be adorned","transliteration":"waḥullū"},{"position":7,"text":"أَسَاوِرَ","translation":"(with) bracelets","transliteration":"asāwira"},{"position":8,"text":"مِن","translation":"of","transliteration":"min"},{"position":9,"text":"فِضَّةٖ","translation":"silver","transliteration":"fiḍḍatin"},{"position":10,"text":"وَسَقَىٰهُمۡ","translation":"and will give them to drink","transliteration":"wasaqāhum"},{"position":11,"text":"رَبُّهُمۡ","translation":"their Lord","transliteration":"rabbuhum"},{"position":12,"text":"شَرَابٗا","translation":"a drink","transliteration":"sharāban"},{"position":13,"text":"طَهُورًا","translation":"pure","transliteration":"ṭahūran"}]},{"id":5613,"verseKey":"76:22","verseNumber":22,"arabic":"إِنَّ هَٰذَا كَانَ لَكُمۡ جَزَآءٗ وَكَانَ سَعۡيُكُم مَّشۡكُورًا","translation":"[And it will be said], \"Indeed, this is for you a reward, and your effort has been appreciated.\"","transliteration":"inna hādhā kāna lakum jazāan wakāna saʿyukum mashkūran","audioUrl":"/audio/7/076022.mp3","segments":[[0,1,30,1300],[1,2,1310,2040],[2,3,2050,2680],[3,4,2690,3210],[4,5,3220,5950],[5,6,5960,7330],[6,7,7340,9070],[7,8,9080,10270]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"هَٰذَا","translation":"this","transliteration":"hādhā"},{"position":3,"text":"كَانَ","translation":"is","transliteration":"kāna"},{"position":4,"text":"لَكُمۡ","translation":"for you","transliteration":"lakum"},{"position":5,"text":"جَزَآءٗ","translation":"a reward","transliteration":"jazāan"},{"position":6,"text":"وَكَانَ","translation":"and has been","transliteration":"wakāna"},{"position":7,"text":"سَعۡيُكُم","translation":"your effort","transliteration":"saʿyukum"},{"position":8,"text":"مَّشۡكُورًا","translation":"appreciated","transliteration":"mashkūran"}]},{"id":5614,"verseKey":"76:23","verseNumber":23,"arabic":"إِنَّا نَحۡنُ نَزَّلۡنَا عَلَيۡكَ ٱلۡقُرۡءَانَ تَنزِيلٗا","translation":"Indeed, it is We who have sent down to you, [O Muḥammad], the Qur’ān progressively.","transliteration":"innā naḥnu nazzalnā ʿalayka l-qur'āna tanzīlan","audioUrl":"/audio/7/076023.mp3","segments":[[0,1,30,1130],[1,2,1140,1730],[2,3,1740,2760],[3,4,2770,3590],[4,5,3600,4670],[5,6,4680,6560]],"words":[{"position":1,"text":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"text":"نَحۡنُ","translation":"[We]","transliteration":"naḥnu"},{"position":3,"text":"نَزَّلۡنَا","translation":"[We] revealed","transliteration":"nazzalnā"},{"position":4,"text":"عَلَيۡكَ","translation":"to you","transliteration":"ʿalayka"},{"position":5,"text":"ٱلۡقُرۡءَانَ","translation":"the Quran","transliteration":"l-qur'āna"},{"position":6,"text":"تَنزِيلٗا","translation":"progressively","transliteration":"tanzīlan"}]},{"id":5615,"verseKey":"76:24","verseNumber":24,"arabic":"فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تُطِعۡ مِنۡهُمۡ ءَاثِمًا أَوۡ كَفُورٗا","translation":"So be patient for the decision of your Lord and do not obey from among them a sinner or ungrateful [disbeliever].","transliteration":"fa-iṣ'bir liḥuk'mi rabbika walā tuṭiʿ min'hum āthiman aw kafūran","audioUrl":"/audio/7/076024.mp3","segments":[[0,1,30,680],[1,2,690,1360],[2,3,1370,2200],[3,4,2210,2700],[4,5,2710,3030],[5,6,3040,4070],[6,7,4080,5000],[7,8,5010,5300],[8,9,5310,6420]],"words":[{"position":1,"text":"فَٱصۡبِرۡ","translation":"So be patient","transliteration":"fa-iṣ'bir"},{"position":2,"text":"لِحُكۡمِ","translation":"for (the) Command","transliteration":"liḥuk'mi"},{"position":3,"text":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"text":"وَلَا","translation":"and (do) not","transliteration":"walā"},{"position":5,"text":"تُطِعۡ","translation":"obey","transliteration":"tuṭiʿ"},{"position":6,"text":"مِنۡهُمۡ","translation":"from them","transliteration":"min'hum"},{"position":7,"text":"ءَاثِمًا","translation":"any sinner","transliteration":"āthiman"},{"position":8,"text":"أَوۡ","translation":"or","transliteration":"aw"},{"position":9,"text":"كَفُورٗا","translation":"disbeliever","transliteration":"kafūran"}]},{"id":5616,"verseKey":"76:25","verseNumber":25,"arabic":"وَٱذۡكُرِ ٱسۡمَ رَبِّكَ بُكۡرَةٗ وَأَصِيلٗا","translation":"And mention the name of your Lord [in prayer] morning and evening","transliteration":"wa-udh'kuri is'ma rabbika buk'ratan wa-aṣīlan","audioUrl":"/audio/7/076025.mp3","segments":[[0,1,30,640],[1,2,650,1070],[2,3,1080,1860],[3,4,1870,2790],[4,5,2800,4930]],"words":[{"position":1,"text":"وَٱذۡكُرِ","translation":"And remember","transliteration":"wa-udh'kuri"},{"position":2,"text":"ٱسۡمَ","translation":"(the) name","transliteration":"is'ma"},{"position":3,"text":"رَبِّكَ","translation":"(of) your Lord","transliteration":"rabbika"},{"position":4,"text":"بُكۡرَةٗ","translation":"morning","transliteration":"buk'ratan"},{"position":5,"text":"وَأَصِيلٗا","translation":"and evening","transliteration":"wa-aṣīlan"}]},{"id":5617,"verseKey":"76:26","verseNumber":26,"arabic":"وَمِنَ ٱلَّيۡلِ فَٱسۡجُدۡ لَهُۥ وَسَبِّحۡهُ لَيۡلٗا طَوِيلًا","translation":"And during the night prostrate to Him and exalt [i.e., praise] Him a long [part of the] night.","transliteration":"wamina al-layli fa-us'jud lahu wasabbiḥ'hu laylan ṭawīlan","audioUrl":"/audio/7/076026.mp3","segments":[[0,1,30,560],[1,2,570,1260],[2,3,1270,2020],[3,4,2030,2580],[4,5,2590,3710],[5,6,3720,4410],[6,7,4420,6180]],"words":[{"position":1,"text":"وَمِنَ","translation":"And of","transliteration":"wamina"},{"position":2,"text":"ٱلَّيۡلِ","translation":"the night","transliteration":"al-layli"},{"position":3,"text":"فَٱسۡجُدۡ","translation":"prostrate","transliteration":"fa-us'jud"},{"position":4,"text":"لَهُۥ","translation":"to Him","transliteration":"lahu"},{"position":5,"text":"وَسَبِّحۡهُ","translation":"and glorify Him","transliteration":"wasabbiḥ'hu"},{"position":6,"text":"لَيۡلٗا","translation":"a night","transliteration":"laylan"},{"position":7,"text":"طَوِيلًا","translation":"long","transliteration":"ṭawīlan"}]},{"id":5618,"verseKey":"76:27","verseNumber":27,"arabic":"إِنَّ هَٰٓؤُلَآءِ يُحِبُّونَ ٱلۡعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمۡ يَوۡمٗا ثَقِيلٗا","translation":"Indeed, these [disbelievers] love the immediate and leave behind them a grave Day.","transliteration":"inna hāulāi yuḥibbūna l-ʿājilata wayadharūna warāahum yawman thaqīlan","audioUrl":"/audio/7/076027.mp3","segments":[[0,1,30,1180],[1,2,1190,5130],[2,3,5140,6270],[3,4,6280,7470],[4,5,7480,8610],[5,6,8620,11300],[6,7,11310,12650],[7,8,12660,13690]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"هَٰٓؤُلَآءِ","translation":"these","transliteration":"hāulāi"},{"position":3,"text":"يُحِبُّونَ","translation":"love","transliteration":"yuḥibbūna"},{"position":4,"text":"ٱلۡعَاجِلَةَ","translation":"the immediate","transliteration":"l-ʿājilata"},{"position":5,"text":"وَيَذَرُونَ","translation":"and leave","transliteration":"wayadharūna"},{"position":6,"text":"وَرَآءَهُمۡ","translation":"behind them","transliteration":"warāahum"},{"position":7,"text":"يَوۡمٗا","translation":"a Day","transliteration":"yawman"},{"position":8,"text":"ثَقِيلٗا","translation":"grave","transliteration":"thaqīlan"}]},{"id":5619,"verseKey":"76:28","verseNumber":28,"arabic":"نَّحۡنُ خَلَقۡنَٰهُمۡ وَشَدَدۡنَآ أَسۡرَهُمۡۖ وَإِذَا شِئۡنَا بَدَّلۡنَآ أَمۡثَٰلَهُمۡ تَبۡدِيلًا","translation":"We have created them and strengthened their forms, and when We will, We can change their likenesses with [complete] alteration.","transliteration":"naḥnu khalaqnāhum washadadnā asrahum wa-idhā shi'nā baddalnā amthālahum tabdīlan","audioUrl":"/audio/7/076028.mp3","segments":[[0,1,50,540],[1,2,550,1890],[2,3,1900,2680],[3,4,2690,6130],[4,5,6140,6870],[5,6,6880,7670],[6,7,7680,8480],[7,8,8490,11590],[8,9,11600,12790]],"words":[{"position":1,"text":"نَّحۡنُ","translation":"We","transliteration":"naḥnu"},{"position":2,"text":"خَلَقۡنَٰهُمۡ","translation":"created them","transliteration":"khalaqnāhum"},{"position":3,"text":"وَشَدَدۡنَآ","translation":"and We strengthened","transliteration":"washadadnā"},{"position":4,"text":"أَسۡرَهُمۡۖ","translation":"their forms","transliteration":"asrahum"},{"position":5,"text":"وَإِذَا","translation":"and when","transliteration":"wa-idhā"},{"position":6,"text":"شِئۡنَا","translation":"We will","transliteration":"shi'nā"},{"position":7,"text":"بَدَّلۡنَآ","translation":"We can change","transliteration":"baddalnā"},{"position":8,"text":"أَمۡثَٰلَهُمۡ","translation":"their likeness[es]","transliteration":"amthālahum"},{"position":9,"text":"تَبۡدِيلًا","translation":"(with) a change","transliteration":"tabdīlan"}]},{"id":5620,"verseKey":"76:29","verseNumber":29,"arabic":"إِنَّ هَٰذِهِۦ تَذۡكِرَةٞۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلٗا","translation":"Indeed, this is a reminder, so he who wills may take to his Lord a way.","transliteration":"inna hādhihi tadhkiratun faman shāa ittakhadha ilā rabbihi sabīlan","audioUrl":"/audio/7/076029.mp3","segments":[[0,1,30,1150],[1,2,1160,2140],[2,3,2150,3560],[3,4,3570,4770],[4,5,4780,6500],[5,6,6510,7420],[6,7,7430,7950],[7,8,7960,8890],[8,9,8900,10010]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"هَٰذِهِۦ","translation":"this","transliteration":"hādhihi"},{"position":3,"text":"تَذۡكِرَةٞۖ","translation":"(is) a reminder","transliteration":"tadhkiratun"},{"position":4,"text":"فَمَن","translation":"so whoever","transliteration":"faman"},{"position":5,"text":"شَآءَ","translation":"wills","transliteration":"shāa"},{"position":6,"text":"ٱتَّخَذَ","translation":"let him take","transliteration":"ittakhadha"},{"position":7,"text":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":8,"text":"رَبِّهِۦ","translation":"his Lord","transliteration":"rabbihi"},{"position":9,"text":"سَبِيلٗا","translation":"a way","transliteration":"sabīlan"}]},{"id":5621,"verseKey":"76:30","verseNumber":30,"arabic":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمٗا","translation":"And you do not will except that Allāh wills. Indeed, Allāh is ever Knowing and Wise.","transliteration":"wamā tashāūna illā an yashāa l-lahu inna l-laha kāna ʿalīman ḥakīman","audioUrl":"/audio/7/076030.mp3","segments":[[0,1,30,560],[1,2,570,3010],[2,3,3020,3490],[3,4,3500,6270],[4,5,6280,8700],[5,6,8710,11040],[6,7,11050,11980],[7,8,11990,12730],[8,9,12740,13300],[9,10,13310,14280],[10,11,14290,15430]],"words":[{"position":1,"text":"وَمَا","translation":"And not","transliteration":"wamā"},{"position":2,"text":"تَشَآءُونَ","translation":"you will","transliteration":"tashāūna"},{"position":3,"text":"إِلَّآ","translation":"except","transliteration":"illā"},{"position":4,"text":"أَن","translation":"that","transliteration":"an"},{"position":5,"text":"يَشَآءَ","translation":"wills","transliteration":"yashāa"},{"position":6,"text":"ٱللَّهُۚ","translation":"Allah","transliteration":"l-lahu"},{"position":7,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":8,"text":"ٱللَّهَ","translation":"Allah","transliteration":"l-laha"},{"position":9,"text":"كَانَ","translation":"is","transliteration":"kāna"},{"position":10,"text":"عَلِيمًا","translation":"All-Knower","transliteration":"ʿalīman"},{"position":11,"text":"حَكِيمٗا","translation":"All-Wise","transliteration":"ḥakīman"}]},{"id":5622,"verseKey":"76:31","verseNumber":31,"arabic":"يُدۡخِلُ مَن يَشَآءُ فِي رَحۡمَتِهِۦۚ وَٱلظَّٰلِمِينَ أَعَدَّ لَهُمۡ عَذَابًا أَلِيمَۢا","translation":"He admits whom He wills into His mercy; but the wrongdoers - He has prepared for them a painful punishment.","transliteration":"yud'khilu man yashāu fī raḥmatihi wal-ẓālimīna aʿadda lahum ʿadhāban alīman","audioUrl":"/audio/7/076031.mp3","segments":[[0,1,50,770],[1,2,780,1720],[2,3,1730,3660],[3,4,3670,4030],[4,5,4040,5510],[5,6,5520,7230],[6,7,7240,8160],[7,8,8170,8780],[8,9,8790,10060],[9,10,10070,11250]],"words":[{"position":1,"text":"يُدۡخِلُ","translation":"He admits","transliteration":"yud'khilu"},{"position":2,"text":"مَن","translation":"whom","transliteration":"man"},{"position":3,"text":"يَشَآءُ","translation":"He wills","transliteration":"yashāu"},{"position":4,"text":"فِي","translation":"into","transliteration":"fī"},{"position":5,"text":"رَحۡمَتِهِۦۚ","translation":"His mercy","transliteration":"raḥmatihi"},{"position":6,"text":"وَٱلظَّٰلِمِينَ","translation":"but (for) the wrongdoers","transliteration":"wal-ẓālimīna"},{"position":7,"text":"أَعَدَّ","translation":"He has prepared","transliteration":"aʿadda"},{"position":8,"text":"لَهُمۡ","translation":"for them","transliteration":"lahum"},{"position":9,"text":"عَذَابًا","translation":"a punishment","transliteration":"ʿadhāban"},{"position":10,"text":"أَلِيمَۢا","translation":"painful","transliteration":"alīman"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
