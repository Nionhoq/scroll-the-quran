{"chapter":{"id":76,"nameSimple":"Al-Insan","nameArabic":"الانسان","translatedName":"The Man","versesCount":31,"revelationPlace":"madinah"},"verses":[{"id":5592,"verseKey":"76:1","verseNumber":1,"arabic":"هَلۡ أَتَىٰ عَلَى ٱلۡإِنسَٰنِ حِينٞ مِّنَ ٱلدَّهۡرِ لَمۡ يَكُن شَيۡـٔٗا مَّذۡكُورًا","translation":"Has there [not] come upon man a period of time when he was not a thing [even] mentioned?","transliteration":"hal atā ʿalā l-insāni ḥīnun mina l-dahri lam yakun shayan madhkūran","audioUrl":"/audio/7/076001.mp3","segments":[[0,1,50,370],[1,2,380,850],[2,3,860,1480],[3,4,1490,3100],[4,5,3110,4700],[5,6,4710,4980],[6,7,4990,5790],[7,8,5800,6110],[8,9,6120,7270],[9,10,7280,7960],[10,11,7970,9880]],"words":[{"position":1,"text":"هَلۡ","translation":"Has","transliteration":"hal"},{"position":2,"text":"أَتَىٰ","translation":"(there) come","transliteration":"atā"},{"position":3,"text":"عَلَى","translation":"upon","transliteration":"ʿalā"},{"position":4,"text":"ٱلۡإِنسَٰنِ","translation":"man","transliteration":"l-insāni"},{"position":5,"text":"حِينٞ","translation":"a period","transliteration":"ḥīnun"},{"position":6,"text":"مِّنَ","translation":"of","transliteration":"mina"},{"position":7,"text":"ٱلدَّهۡرِ","translation":"time","transliteration":"l-dahri"},{"position":8,"text":"لَمۡ","translation":"not","transliteration":"lam"},{"position":9,"text":"يَكُن","translation":"he was","transliteration":"yakun"},{"position":10,"text":"شَيۡـٔٗا","translation":"a thing","transliteration":"shayan"},{"position":11,"text":"مَّذۡكُورًا","translation":"mentioned","transliteration":"madhkūran"}]},{"id":5593,"verseKey":"76:2","verseNumber":2,"arabic":"إِنَّا خَلَقۡنَا ٱلۡإِنسَٰنَ مِن نُّطۡفَةٍ أَمۡشَاجٖ نَّبۡتَلِيهِ فَجَعَلۡنَٰهُ سَمِيعَۢا بَصِيرًا","translation":"Indeed, We created man from a sperm-drop mixture that We may try him; and We made him hearing and seeing.","transliteration":"innā khalaqnā l-insāna min nuṭ'fatin amshājin nabtalīhi fajaʿalnāhu samīʿan baṣīran","audioUrl":"/audio/7/076002.mp3","segments":[[0,1,30,1440],[1,2,1450,2260],[2,3,2270,4140],[3,4,4150,5000],[4,5,5010,5900],[5,6,5910,7290],[6,7,7300,8790],[7,8,8800,10180],[8,9,10190,11860],[9,10,11870,12990]],"words":[{"position":1,"text":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"text":"خَلَقۡنَا","translation":"[We] created","transliteration":"khalaqnā"},{"position":3,"text":"ٱلۡإِنسَٰنَ","translation":"man","transliteration":"l-insāna"},{"position":4,"text":"مِن","translation":"from","transliteration":"min"},{"position":5,"text":"نُّطۡفَةٍ","translation":"a semen-drop","transliteration":"nuṭ'fatin"},{"position":6,"text":"أَمۡشَاجٖ","translation":"a mixture","transliteration":"amshājin"},{"position":7,"text":"نَّبۡتَلِيهِ","translation":"(that) We test him","transliteration":"nabtalīhi"},{"position":8,"text":"فَجَعَلۡنَٰهُ","translation":"so We made (for) him","transliteration":"fajaʿalnāhu"},{"position":9,"text":"سَمِيعَۢا","translation":"hearing","transliteration":"samīʿan"},{"position":10,"text":"بَصِيرًا","translation":"and sight","transliteration":"baṣīran"}]},{"id":5594,"verseKey":"76:3","verseNumber":3,"arabic":"إِنَّا هَدَيۡنَٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرٗا وَإِمَّا كَفُورًا","translation":"Indeed, We guided him to the way, be he grateful or be he ungrateful.","transliteration":"innā hadaynāhu l-sabīla immā shākiran wa-immā kafūran","audioUrl":"/audio/7/076003.mp3","segments":[[0,1,30,1410],[1,2,1420,2560],[2,3,2570,3480],[3,4,3490,5120],[4,5,5130,5930],[5,6,5940,8380],[6,7,8390,9610]],"words":[{"position":1,"text":"إِنَّا","translation":"Indeed, We","transliteration":"innā"},{"position":2,"text":"هَدَيۡنَٰهُ","translation":"guided him","transliteration":"hadaynāhu"},{"position":3,"text":"ٱلسَّبِيلَ","translation":"(to) the way","transliteration":"l-sabīla"},{"position":4,"text":"إِمَّا","translation":"whether","transliteration":"immā"},{"position":5,"text":"شَاكِرٗا","translation":"(he) be grateful","transliteration":"shākiran"},{"position":6,"text":"وَإِمَّا","translation":"and whether","transliteration":"wa-immā"},{"position":7,"text":"كَفُورًا","translation":"(he) be ungrateful","transliteration":"kafūran"}]},{"id":5595,"verseKey":"76:4","verseNumber":4,"arabic":"إِنَّآ أَعۡتَدۡنَا لِلۡكَٰفِرِينَ سَلَٰسِلَاْ وَأَغۡلَٰلٗا وَسَعِيرًا","translation":"Indeed, We have prepared for the disbelievers chains and shackles and a blaze.","transliteration":"innā aʿtadnā lil'kāfirīna salāsilā wa-aghlālan wasaʿīran","audioUrl":"/audio/7/076004.mp3","segments":[[0,1,30,2430],[1,2,2440,3640],[2,3,3650,5120],[3,4,5130,6160],[4,5,6170,7260],[5,6,7270,9370]],"words":[{"position":1,"text":"إِنَّآ","translation":"Indeed, We","transliteration":"innā"},{"position":2,"text":"أَعۡتَدۡنَا","translation":"[We] have prepared","transliteration":"aʿtadnā"},{"position":3,"text":"لِلۡكَٰفِرِينَ","translation":"for the disbelievers","transliteration":"lil'kāfirīna"},{"position":4,"text":"سَلَٰسِلَاْ","translation":"chains","transliteration":"salāsilā"},{"position":5,"text":"وَأَغۡلَٰلٗا","translation":"and shackles","transliteration":"wa-aghlālan"},{"position":6,"text":"وَسَعِيرًا","translation":"and a Blazing Fire","transliteration":"wasaʿīran"}]},{"id":5596,"verseKey":"76:5","verseNumber":5,"arabic":"إِنَّ ٱلۡأَبۡرَارَ يَشۡرَبُونَ مِن كَأۡسٖ كَانَ مِزَاجُهَا كَافُورًا","translation":"Indeed, the righteous will drink from a cup [of wine] whose mixture is of Kāfūr,","transliteration":"inna l-abrāra yashrabūna min kasin kāna mizājuhā kāfūran","audioUrl":"/audio/7/076005.mp3","segments":[[0,1,30,1200],[1,2,1210,2410],[2,3,2420,3510],[3,4,3520,4590],[4,5,4600,5940],[5,6,5950,6640],[6,7,6650,7790],[7,8,7800,9190]],"words":[{"position":1,"text":"إِنَّ","translation":"Indeed","transliteration":"inna"},{"position":2,"text":"ٱلۡأَبۡرَارَ","translation":"the righteous","transliteration":"l-abrāra"},{"position":3,"text":"يَشۡرَبُونَ","translation":"will drink","transliteration":"yashrabūna"},{"position":4,"text":"مِن","translation":"from","transliteration":"min"},{"position":5,"text":"كَأۡسٖ","translation":"a cup","transliteration":"kasin"},{"position":6,"text":"كَانَ","translation":"is","transliteration":"kāna"},{"position":7,"text":"مِزَاجُهَا","translation":"its mixture","transliteration":"mizājuhā"},{"position":8,"text":"كَافُورًا","translation":"(of) Kafur","transliteration":"kāfūran"}]},{"id":5597,"verseKey":"76:6","verseNumber":6,"arabic":"عَيۡنٗا يَشۡرَبُ بِهَا عِبَادُ ٱللَّهِ يُفَجِّرُونَهَا تَفۡجِيرٗا","translation":"A spring of which the [righteous] servants of Allāh will drink; they will make it gush forth in force [and abundance].","transliteration":"ʿaynan yashrabu bihā ʿibādu l-lahi yufajjirūnahā tafjīran","audioUrl":"/audio/7/076006.mp3","segments":[[0,1,80,1560],[1,2,1570,2330],[2,3,2340,2890],[3,4,2900,3760],[4,5,3770,4490],[5,6,4500,6300],[6,7,6310,7690]],"words":[{"position":1,"text":"عَيۡنٗا","translation":"A spring ","transliteration":"ʿaynan"},{"position":2,"text":"يَشۡرَبُ","translation":"will drink","transliteration":"yashrabu"},{"position":3,"text":"بِهَا","translation":"from it","transliteration":"bihā"},{"position":4,"text":"عِبَادُ","translation":"(the) slaves","transliteration":"ʿibādu"},{"position":5,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":6,"text":"يُفَجِّرُونَهَا","translation":"causing it to gush forth","transliteration":"yufajjirūnahā"},{"position":7,"text":"تَفۡجِيرٗا","translation":"abundantly","transliteration":"tafjīran"}]},{"id":5598,"verseKey":"76:7","verseNumber":7,"arabic":"يُوفُونَ بِٱلنَّذۡرِ وَيَخَافُونَ يَوۡمٗا كَانَ شَرُّهُۥ مُسۡتَطِيرٗا","translation":"They [are those who] fulfill [their] vows and fear a Day whose evil will be widespread.","transliteration":"yūfūna bil-nadhri wayakhāfūna yawman kāna sharruhu mus'taṭīran","audioUrl":"/audio/7/076007.mp3","segments":[[0,1,40,940],[1,2,950,2600],[2,3,2610,3900],[3,4,3910,4420],[4,5,4430,6040],[5,6,6050,7090],[6,7,7100,8640]],"words":[{"position":1,"text":"يُوفُونَ","translation":"They fulfill","transliteration":"yūfūna"},{"position":2,"text":"بِٱلنَّذۡرِ","translation":"the vows","transliteration":"bil-nadhri"},{"position":3,"text":"وَيَخَافُونَ","translation":"and fear","transliteration":"wayakhāfūna"},{"position":4,"text":"يَوۡمٗا","translation":"a Day ","transliteration":"yawman"},{"position":5,"text":"كَانَ","translation":"(which) is","transliteration":"kāna"},{"position":6,"text":"شَرُّهُۥ","translation":"its evil","transliteration":"sharruhu"},{"position":7,"text":"مُسۡتَطِيرٗا","translation":"widespread","transliteration":"mus'taṭīran"}]},{"id":5599,"verseKey":"76:8","verseNumber":8,"arabic":"وَيُطۡعِمُونَ ٱلطَّعَامَ عَلَىٰ حُبِّهِۦ مِسۡكِينٗا وَيَتِيمٗا وَأَسِيرًا","translation":"And they give food in spite of love for it to the needy, the orphan, and the captive,","transliteration":"wayuṭ'ʿimūna l-ṭaʿāma ʿalā ḥubbihi mis'kīnan wayatīman wa-asīran","audioUrl":"/audio/7/076008.mp3","segments":[[0,1,30,1360],[1,2,1370,2260],[2,3,2270,2880],[3,4,2890,3920],[4,5,3930,4840],[5,6,4850,6930],[6,7,6940,9080]],"words":[{"position":1,"text":"وَيُطۡعِمُونَ","translation":"And they feed","transliteration":"wayuṭ'ʿimūna"},{"position":2,"text":"ٱلطَّعَامَ","translation":"the food","transliteration":"l-ṭaʿāma"},{"position":3,"text":"عَلَىٰ","translation":"in spite of","transliteration":"ʿalā"},{"position":4,"text":"حُبِّهِۦ","translation":"love (for) it","transliteration":"ḥubbihi"},{"position":5,"text":"مِسۡكِينٗا","translation":"(to the) needy","transliteration":"mis'kīnan"},{"position":6,"text":"وَيَتِيمٗا","translation":"and (the) orphan","transliteration":"wayatīman"},{"position":7,"text":"وَأَسِيرًا","translation":"and (the) captive","transliteration":"wa-asīran"}]},{"id":5600,"verseKey":"76:9","verseNumber":9,"arabic":"إِنَّمَا نُطۡعِمُكُمۡ لِوَجۡهِ ٱللَّهِ لَا نُرِيدُ مِنكُمۡ جَزَآءٗ وَلَا شُكُورًا","translation":"[Saying], \"We feed you only for the face [i.e., approval] of Allāh. We wish not from you reward or gratitude.","transliteration":"innamā nuṭ'ʿimukum liwajhi l-lahi lā nurīdu minkum jazāan walā shukūran","audioUrl":"/audio/7/076009.mp3","segments":[[0,1,30,1650],[1,2,1660,2760],[2,3,2770,3600],[3,4,3610,4380],[4,5,4390,4740],[5,6,4750,5500],[6,7,5510,6790],[7,8,6800,8900],[8,9,8910,9980],[9,10,9990,11200]],"words":[{"position":1,"text":"إِنَّمَا","translation":"Only","transliteration":"innamā"},{"position":2,"text":"نُطۡعِمُكُمۡ","translation":"we feed you","transliteration":"nuṭ'ʿimukum"},{"position":3,"text":"لِوَجۡهِ","translation":"for (the) Countenance","transliteration":"liwajhi"},{"position":4,"text":"ٱللَّهِ","translation":"(of) Allah","transliteration":"l-lahi"},{"position":5,"text":"لَا","translation":"Not","transliteration":"lā"},{"position":6,"text":"نُرِيدُ","translation":"we desire","transliteration":"nurīdu"},{"position":7,"text":"مِنكُمۡ","translation":"from you","transliteration":"minkum"},{"position":8,"text":"جَزَآءٗ","translation":"any reward","transliteration":"jazāan"},{"position":9,"text":"وَلَا","translation":"and not","transliteration":"walā"},{"position":10,"text":"شُكُورًا","translation":"thanks","transliteration":"shukūran"}]},{"id":5601,"verseKey":"76:10","verseNumber":10,"arabic":"إِنَّا نَخَافُ مِن رَّبِّنَا يَوۡمًا عَبُوسٗا قَمۡطَرِيرٗا","translation":"Indeed, We fear from our Lord a Day austere and distressful.\"","transliteration":"innā nakhāfu min rabbinā yawman ʿabūsan qamṭarīran","audioUrl":"/audio/7/076010.mp3","segments":[[0,1,30,1330],[1,2,1340,2140],[2,3,2150,2240],[3,4,2250,3420],[4,5,3430,4160],[5,6,4170,4960],[6,7,4970,7310]],"words":[{"position":1,"text":"إِنَّا","translation":"Indeed, we","transliteration":"innā"},{"position":2,"text":"نَخَافُ","translation":"fear","transliteration":"nakhāfu"},{"position":3,"text":"مِن","translation":"from","transliteration":"min"},{"position":4,"text":"رَّبِّنَا","translation":"our Lord","transliteration":"rabbinā"},{"position":5,"text":"يَوۡمًا","translation":"a Day ","transliteration":"yawman"},{"position":6,"text":"عَبُوسٗا","translation":"harsh","transliteration":"ʿabūsan"},{"position":7,"text":"قَمۡطَرِيرٗا","translation":"and distressful","transliteration":"qamṭarīran"}]},{"id":5602,"verseKey":"76:11","verseNumber":11,"arabic":"فَوَقَىٰهُمُ ٱللَّهُ شَرَّ ذَٰلِكَ ٱلۡيَوۡمِ وَلَقَّىٰهُمۡ نَضۡرَةٗ وَسُرُورٗا","translation":"So Allāh will protect them from the evil of that Day and give them radiance and happiness","transliteration":"fawaqāhumu l-lahu sharra dhālika l-yawmi walaqqāhum naḍratan wasurūran","audioUrl":"/audio/7/076011.mp3","segments":[[0,1,30,1110],[1,2,1120,1860],[2,3,1870,2510],[3,4,2520,3300],[4,5,3310,4110],[5,6,4120,5370],[6,7,5380,6390],[7,8,6400,8570]],"words":[{"position":1,"text":"فَوَقَىٰهُمُ","translation":"But will protect them","transliteration":"fawaqāhumu"},{"position":2,"text":"ٱللَّهُ","translation":"Allah","transliteration":"l-lahu"},{"position":3,"text":"شَرَّ","translation":"(from the) evil","transliteration":"sharra"},{"position":4,"text":"ذَٰلِكَ","translation":"(of) that","transliteration":"dhālika"},{"position":5,"text":"ٱلۡيَوۡمِ","translation":"Day","transliteration":"l-yawmi"},{"position":6,"text":"وَلَقَّىٰهُمۡ","translation":"and will cause them to meet","transliteration":"walaqqāhum"},{"position":7,"text":"نَضۡرَةٗ","translation":"radiance","transliteration":"naḍratan"},{"position":8,"text":"وَسُرُورٗا","translation":"and happiness","transliteration":"wasurūran"}]},{"id":5603,"verseKey":"76:12","verseNumber":12,"arabic":"وَجَزَىٰهُم بِمَا صَبَرُواْ جَنَّةٗ وَحَرِيرٗا","translation":"And will reward them for what they patiently endured [with] a garden [in Paradise] and silk [garments].","transliteration":"wajazāhum bimā ṣabarū jannatan waḥarīran","audioUrl":"/audio/7/076012.mp3","segments":[[0,1,30,1590],[1,2,1600,2120],[2,3,2130,2920],[3,4,2930,4430],[4,5,4440,6450]],"words":[{"position":1,"text":"وَجَزَىٰهُم","translation":"And will reward them","transliteration":"wajazāhum"},{"position":2,"text":"بِمَا","translation":"because","transliteration":"bimā"},{"position":3,"text":"صَبَرُواْ","translation":"they were patient","transliteration":"ṣabarū"},{"position":4,"text":"جَنَّةٗ","translation":"(with) a Garden","transliteration":"jannatan"},{"position":5,"text":"وَحَرِيرٗا","translation":"and silk","transliteration":"waḥarīran"}]},{"id":5604,"verseKey":"76:13","verseNumber":13,"arabic":"مُّتَّكِـِٔينَ فِيهَا عَلَى ٱلۡأَرَآئِكِۖ لَا يَرَوۡنَ فِيهَا شَمۡسٗا وَلَا زَمۡهَرِيرٗا","translation":"[They will be] reclining therein on adorned couches. They will not see therein any [burning] sun or [freezing] cold.","transliteration":"muttakiīna fīhā ʿalā l-arāiki lā yarawna fīhā shamsan walā zamharīran","audioUrl":"/audio/7/076013.mp3","segments":[[0,1,50,1270],[1,2,1280,1970],[2,3,1980,2410],[3,4,2420,5490],[4,5,5500,5820],[5,6,5830,6560],[6,7,6570,7320],[7,8,7330,7950],[8,9,7960,9140],[9,10,9150,10670]],"words":[{"position":1,"text":"مُّتَّكِـِٔينَ","translation":"Reclining","transliteration":"muttakiīna"},{"position":2,"text":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":3,"text":"عَلَى","translation":"on","transliteration":"ʿalā"},{"position":4,"text":"ٱلۡأَرَآئِكِۖ","translation":"couches","transliteration":"l-arāiki"},{"position":5,"text":"لَا","translation":"Not","transliteration":"lā"},{"position":6,"text":"يَرَوۡنَ","translation":"they will see","transliteration":"yarawna"},{"position":7,"text":"فِيهَا","translation":"therein","transliteration":"fīhā"},{"position":8,"text":"شَمۡسٗا","translation":"sun","transliteration":"shamsan"},{"position":9,"text":"وَلَا","translation":"and not","transliteration":"walā"},{"position":10,"text":"زَمۡهَرِيرٗا","translation":"freezing cold","transliteration":"zamharīran"}]},{"id":5605,"verseKey":"76:14","verseNumber":14,"arabic":"وَدَانِيَةً عَلَيۡهِمۡ ظِلَٰلُهَا وَذُلِّلَتۡ قُطُوفُهَا تَذۡلِيلٗا","translation":"And near above them are its shades, and its [fruit] to be picked will be lowered in compliance.","tran