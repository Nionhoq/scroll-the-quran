{"chapter":{"id":101,"nameSimple":"Al-Qari'ah","nameArabic":"القارعة","translatedName":"The Calamity","versesCount":11,"revelationPlace":"makkah"},"verses":[{"id":6158,"verseKey":"101:1","verseNumber":1,"arabic":" ٱلْقَارِعَةُ","translation":"The Striking Calamity -","transliteration":"al-qāriʿatu","audioUrl":"/audio/7/101001.mp3","segments":[[0,1,150,1700]],"words":[{"position":1,"text":"ٱلْقَارِعَةُ","translation":"The Striking Calamity","transliteration":"al-qāriʿatu"}]},{"id":6159,"verseKey":"101:2","verseNumber":2,"arabic":"مَا ٱلْقَارِعَةُ","translation":"What is the Striking Calamity?","transliteration":"mā l-qāriʿatu","audioUrl":"/audio/7/101002.mp3","segments":[[0,1,40,240],[1,2,250,1640]],"words":[{"position":1,"text":"مَا","translation":"What","transliteration":"mā"},{"position":2,"text":"ٱلْقَارِعَةُ","translation":"(is) the Striking Calamity","transliteration":"l-qāriʿatu"}]},{"id":6160,"verseKey":"101:3","verseNumber":3,"arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","translation":"And what can make you know what is the Striking Calamity?","transliteration":"wamā adrāka mā l-qāriʿatu","audioUrl":"/audio/7/101003.mp3","segments":[[0,1,40,330],[1,2,340,3590],[2,3,3600,3730],[3,4,3740,4910]],"words":[{"position":1,"text":"وَمَآ","translation":"And what","transliteration":"wamā"},{"position":2,"text":"أَدْرَىٰكَ","translation":"will make you know","transliteration":"adrāka"},{"position":3,"text":"مَا","translation":"what","transliteration":"mā"},{"position":4,"text":"ٱلْقَارِعَةُ","translation":"(is) the Striking Calamity","transliteration":"l-qāriʿatu"}]},{"id":6161,"verseKey":"101:4","verseNumber":4,"arabic":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","translation":"It is the Day when people will be like moths, dispersed,","transliteration":"yawma yakūnu l-nāsu kal-farāshi l-mabthūthi","audioUrl":"/audio/7/101004.mp3","segments":[[0,1,90,610],[1,2,620,1530],[2,3,1540,3040],[3,4,3050,4410],[4,5,4420,7300]],"words":[{"position":1,"text":"يَوْمَ","tr