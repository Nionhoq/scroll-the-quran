/7/092020.mp3","segments":[[0,1,30,530],[1,2,540,3310],[2,3,3320,3910],[3,4,3920,4910],[4,5,4920,5970]],"words":[{"position":1,"text":"إِلَّا","translation":"Except","transliteration":"illā"},{"position":2,"text":"ٱبۡتِغَآءَ","translation":"seeking","transliteration":"ib'tighāa"},{"position":3,"text":"وَجۡهِ","translation":"(the) Countenance","transliteration":"wajhi"},{"position":4,"text":"رَبِّهِ","translation":"(of) his Lord","transliteration":"rabbihi"},{"position":5,"text":"ٱلۡأَعۡلَىٰ","translation":"the Most High","transliteration":"l-aʿlā"}]},{"id":6079,"verseKey":"92:21","verseNumber":21,"arabic":"وَلَسَوۡفَ يَرۡضَىٰ","translation":"And he is going to be satisfied.","transliteration":"walasawfa yarḍā","audioUrl":"/audio/7/092021.mp3","segments":[[0,1,30,1160],[1,2,1170,2480]],"words":[{"position":1,"text":"وَلَسَوۡفَ","translation":"And soon, surely","transliteration":"walasawfa"},{"position":2,"text":"يَرۡضَىٰ","translation":"he will be pleased","transliteration":"yarḍā"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
