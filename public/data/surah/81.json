":"And the dawn","transliteration":"wal-ṣub'ḥi"},{"position":2,"text":"إِذَا","translation":"when","transliteration":"idhā"},{"position":3,"text":"تَنَفَّسَ","translation":"it breathes","transliteration":"tanaffasa"}]},{"id":5819,"verseKey":"81:19","verseNumber":19,"arabic":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ","translation":"[That] indeed, it [i.e., the Qur’ān] is a word [conveyed by] a noble messenger [i.e., Gabriel]","transliteration":"innahu laqawlu rasūlin karīmin","audioUrl":"/audio/7/081019.mp3","segments":[[0,1,30,1610],[1,2,1620,2410],[2,3,2420,3980],[3,4,3990,5560]],"words":[{"position":1,"text":"إِنَّهُۥ","translation":"Indeed, it","transliteration":"innahu"},{"position":2,"text":"لَقَوۡلُ","translation":"(is) surely a word","transliteration":"laqawlu"},{"position":3,"text":"رَسُولٖ","translation":"(of) a Messenger","transliteration":"rasūlin"},{"position":4,"text":"كَرِيمٖ","translation":"noble","transliteration":"karīmin"}]},{"id":5820,"verseKey":"81:20","verseNumber":20,"arabic":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ","translation":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],","transliteration":"dhī quwwatin ʿinda dhī l-ʿarshi makīnin","audioUrl":"/audio/7/081020.mp3","segments":[[0,1,60,360],[1,2,370,1410],[2,3,1420,2370],[3,4,2380,2520],[4,5,2530,3440],[5,6,3450,5060]],"words":[{"position":1,"text":"ذِي","translation":"Possessor of","transliteration":"dhī"},{"position":2,"text":"قُوَّةٍ","translation":"power","transliteration":"quwwatin"},{"position":3,"text":"عِندَ","translation":"with","transliteration":"ʿinda"},{"position":4,"text":"ذِي","translation":"(the) Owner of","transliteration":"dhī"},{"position":5,"text":"ٱلۡعَرۡشِ","translation":"the Throne","transliteration":"l-ʿarshi"},{"position":6,"text":"مَكِينٖ","translation":"secure","transliteration":"makīnin"}]},{"id":5821,"verseKey":"81:21","verseNumber":21,"arabic":"مُّطَاعٖ ثَمَّ أَمِينٖ","translation":"Obeyed there [in the heavens] and trustworthy.","t