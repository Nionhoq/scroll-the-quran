":"l-lahi"},{"position":3,"text":"ذِي","translation":"Owner","transliteration":"dhī"},{"position":4,"text":"ٱلۡمَعَارِجِ","translation":"(of) the ways of ascent","transliteration":"l-maʿāriji"}]},{"id":5379,"verseKey":"70:4","verseNumber":4,"arabic":"تَعۡرُجُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيۡهِ فِي يَوۡمٖ كَانَ مِقۡدَارُهُۥ خَمۡسِينَ أَلۡفَ سَنَةٖ","translation":"The angels and the Spirit [i.e., Gabriel] will ascend to Him during a Day the extent of which is fifty thousand years.","transliteration":"taʿruju l-malāikatu wal-rūḥu ilayhi fī yawmin kāna miq'dāruhu khamsīna alfa sanatin","audioUrl":"/audio/7/070004.mp3","segments":[[0,1,30,860],[1,2,870,3880],[2,3,3890,4920],[3,4,4930,5670],[4,5,5680,6140],[5,6,6150,7760],[6,7,7770,8430],[7,8,8440,9860],[8,9,9870,11010],[9,10,11020,11520],[10,11,11530,12070]],"words":[{"position":1,"text":"تَعۡرُجُ","translation":"Ascend","transliteration":"taʿruju"},{"position":2,"text":"ٱلۡمَلَٰٓئِكَةُ","translation":"the Angels","transliteration":"l-malāikatu"},{"position":3,"text":"وَٱلرُّوحُ","translation":"and the Spirit","transliteration":"wal-rūḥu"},{"position":4,"text":"إِلَيۡهِ","translation":"to Him","transliteration":"ilayhi"},{"position":5,"text":"فِي","translation":"in","transliteration":"fī"},{"position":6,"text":"يَوۡمٖ","translation":"a Day","transliteration":"yawmin"},{"position":7,"text":"كَانَ","translation":"[is]","transliteration":"kāna"},{"position":8,"text":"مِقۡدَارُهُۥ","translation":"its measure","transliteration":"miq'dāruhu"},{"position":9,"text":"خَمۡسِينَ","translation":"(is) fifty","transliteration":"khamsīna"},{"position":10,"text":"أَلۡفَ","translation":"thousand","transliteration":"alfa"},{"position":11,"text":"سَنَةٖ","translation":"year(s)","transliteration":"sanatin"}]},{"id":5380,"verseKey":"70:5","verseNumber":5,"arabic":"فَٱصۡبِرۡ صَبۡرٗا جَمِيلًا","translation":"So be patient with gracious patience.","transliteration":"fa-iṣ'bir ṣabran jamīlan","audioUrl":"/audio/7/070005.mp3","segments":[[0,1,30