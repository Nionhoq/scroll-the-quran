600,5920],[5,6,5930,7390],[6,7,7400,10240]],"words":[{"position":1,"text":"فَلَآ","translation":"But nay","transliteration":"falā"},{"position":2,"text":"أُقۡسِمُ","translation":"I swear","transliteration":"uq'simu"},{"position":3,"text":"بِرَبِّ","translation":"by (the) Lord","transliteration":"birabbi"},{"position":4,"text":"ٱلۡمَشَٰرِقِ","translation":"(of) the risings","transliteration":"l-mashāriqi"},{"position":5,"text":"وَٱلۡمَغَٰرِبِ","translation":"and the settings","transliteration":"wal-maghāribi"},{"position":6,"text":"إِنَّا","translation":"that We","transliteration":"innā"},{"position":7,"text":"لَقَٰدِرُونَ","translation":"(are) surely Able","transliteration":"laqādirūna"}]},{"id":5416,"verseKey":"70:41","verseNumber":41,"arabic":"عَلَىٰٓ أَن نُّبَدِّلَ خَيۡرٗا مِّنۡهُمۡ وَمَا نَحۡنُ بِمَسۡبُوقِينَ","translation":"To replace them with better than them; and We are not to be outdone.","transliteration":"ʿalā an nubaddila khayran min'hum wamā naḥnu bimasbūqīna","audioUrl":"/audio/7/070041.mp3","segments":[[0,1,30,1880],[1,2,1890,2650],[2,3,2660,3810],[3,4,3820,4430],[4,5,4440,6150],[5,6,6160,6750],[6,7,6760,7300],[7,8,7310,10340]],"words":[{"position":1,"text":"عَلَىٰٓ","translation":"[On]","transliteration":"ʿalā"},{"position":2,"text":"أَن","translation":"to","transliteration":"an"},{"position":3,"text":"نُّبَدِّلَ","translation":"[We] replace","transliteration":"nubaddila"},{"position":4,"text":"خَيۡرٗا","translation":"(with) better","transliteration":"khayran"},{"position":5,"text":"مِّنۡهُمۡ","translation":"than them","transliteration":"min'hum"},{"position":6,"text":"وَمَا","translation":"and not","transliteration":"wamā"},{"position":7,"text":"نَحۡنُ","translation":"We","transliteration":"naḥnu"},{"position":8,"text":"بِمَسۡبُوقِينَ","translation":"(are) to be outrun","transliteration":"bimasbūqīna"}]},{"id":5417,"verseKey":"70:42","verseNumber":42,"arabic":"فَذَرۡهُمۡ يَخُوضُواْ وَيَلۡعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوۡمَهُمُ ٱلَّذِي يُوعَدُونَ","translation":"So leave them to converse vainly and amuse themselves until they meet their Day which they are promised -","transliteration":"fadharhum yakhūḍū wayalʿabū ḥattā yulāqū yawmahumu alladhī yūʿadūna","audioUrl":"/audio/7/070042.mp3","segments":[[0,1,50,960],[1,2,970,2040],[2,3,2050,3200],[3,4,3210,4030],[4,5,4040,5000],[5,6,5010,6050],[6,7,6060,6790],[7,8,6800,9650]],"words":[{"position":1,"text":"فَذَرۡهُمۡ","translation":"So leave them","transliteration":"fadharhum"},{"position":2,"text":"يَخُوضُواْ","translation":"(to) converse vainly","transliteration":"yakhūḍū"},{"position":3,"text":"وَيَلۡعَبُواْ","translation":"and amuse themselves","transliteration":"wayalʿabū"},{"position":4,"text":"حَتَّىٰ","translation":"until","transliteration":"ḥattā"},{"position":5,"text":"يُلَٰقُواْ","translation":"they meet","transliteration":"yulāqū"},{"position":6,"text":"يَوۡمَهُمُ","translation":"their Day","transliteration":"yawmahumu"},{"position":7,"text":"ٱلَّذِي","translation":"which","transliteration":"alladhī"},{"position":8,"text":"يُوعَدُونَ","translation":"they are promised","transliteration":"yūʿadūna"}]},{"id":5418,"verseKey":"70:43","verseNumber":43,"arabic":"يَوۡمَ يَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعٗا كَأَنَّهُمۡ إِلَىٰ نُصُبٖ يُوفِضُونَ","translation":"The Day they will emerge from the graves rapidly as if they were, toward an erected idol, hastening.","transliteration":"yawma yakhrujūna mina l-ajdāthi sirāʿan ka-annahum ilā nuṣubin yūfiḍūna","audioUrl":"/audio/7/070043.mp3","segments":[[0,1,30,590],[1,2,600,1780],[2,3,1790,2140],[3,4,2150,3310],[4,5,3320,4830],[5,6,4840,6860],[6,7,6870,7470],[7,8,7480,8880],[8,9,8890,11930]],"words":[{"position":1,"text":"يَوۡمَ","translation":"(The) Day","transliteration":"yawma"},{"position":2,"text":"يَخۡرُجُونَ","translation":"they will come out","transliteration":"yakhrujūna"},{"position":3,"text":"مِنَ","translation":"from","transliteration":"mina"},{"position":4,"text":"ٱلۡأَجۡدَاثِ","translation":"the graves","transliteration":"l-ajdāthi"},{"position":5,"text":"سِرَاعٗا","translation":"rapidly","transliteration":"sirāʿan"},{"position":6,"text":"كَأَنَّهُمۡ","translation":"as if they (were)","transliteration":"ka-annahum"},{"position":7,"text":"إِلَىٰ","translation":"to","transliteration":"ilā"},{"position":8,"text":"نُصُبٖ","translation":"a goal","transliteration":"nuṣubin"},{"position":9,"text":"يُوفِضُونَ","translation":"hastening","transliteration":"yūfiḍūna"}]},{"id":5419,"verseKey":"70:44","verseNumber":44,"arabic":"خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۚ ذَٰلِكَ ٱلۡيَوۡمُ ٱلَّذِي كَانُواْ يُوعَدُونَ","translation":"Their eyes humbled, humiliation will cover them. That is the Day which they had been promised.","transliteration":"khāshiʿatan abṣāruhum tarhaquhum dhillatun dhālika l-yawmu alladhī kānū yūʿadūna","audioUrl":"/audio/7/070044.mp3","segments":[[0,1,30,1210],[1,2,1220,2590],[2,3,2600,3770],[3,4,3780,5150],[4,5,5160,5990],[5,6,6000,6870],[6,7,6880,7740],[7,8,7750,8750],[8,9,8760,12360]],"words":[{"position":1,"text":"خَٰشِعَةً","translation":"Humbled","transliteration":"khāshiʿatan"},{"position":2,"text":"أَبۡصَٰرُهُمۡ","translation":"their eyesights","transliteration":"abṣāruhum"},{"position":3,"text":"تَرۡهَقُهُمۡ","translation":"will cover them","transliteration":"tarhaquhum"},{"position":4,"text":"ذِلَّةٞۚ","translation":"humiliation","transliteration":"dhillatun"},{"position":5,"text":"ذَٰلِكَ","translation":"That","transliteration":"dhālika"},{"position":6,"text":"ٱلۡيَوۡمُ","translation":"(is) the Day","transliteration":"l-yawmu"},{"position":7,"text":"ٱلَّذِي","translation":"which","transliteration":"alladhī"},{"position":8,"text":"كَانُواْ","translation":"they were","transliteration":"kānū"},{"position":9,"text":"يُوعَدُونَ","translation":"promised","transliteration":"yūʿadūna"}]}],"source":"Quran.com","translationName":"Sahih International","reciterName":"Mishary Rashid Alafasy"}
