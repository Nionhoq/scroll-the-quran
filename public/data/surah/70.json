umber":9,"arabic":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ","translation":"And the mountains will be like wool,","transliteration":"watakūnu l-jibālu kal-ʿih'ni","audioUrl":"/audio/7/070009.mp3","segments":[[0,1,30,1010],[1,2,1020,2070],[2,3,2080,3140]],"words":[{"position":1,"text":"وَتَكُونُ","translation":"And will be","transliteration":"watakūnu"},{"position":2,"text":"ٱلۡجِبَالُ","translation":"the mountains","transliteration":"l-jibālu"},{"position":3,"text":"كَٱلۡعِهۡنِ","translation":"like wool","transliteration":"kal-ʿih'ni"}]},{"id":5385,"verseKey":"70:10","verseNumber":10,"arabic":"وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمٗا","translation":"And no friend will ask [anything of] a friend,","transliteration":"walā yasalu ḥamīmun ḥamīman","audioUrl":"/audio/7/070010.mp3","segments":[[0,1,30,580],[1,2,590,1370],[2,3,1380,2390],[3,4,2400,3650]],"words":[{"position":1,"text":"وَلَا","translation":"And not","transliteration":"walā"},{"position":2,"text":"يَسۡـَٔلُ","translation":"will ask","transliteration":"yasalu"},{"position":3,"text":"حَمِيمٌ","translation":"a friend","transliteration":"ḥamīmun"},{"position":4,"text":"حَمِيمٗا","translation":"(about) a friend","transliteration":"ḥamīman"}]},{"id":5386,"verseKey":"70:11","verseNumber":11,"arabic":"يُبَصَّرُونَهُمۡۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِ","translation":"They will be shown each other. The criminal will wish that he could be ransomed from the punishment of that Day by his children.","transliteration":"yubaṣṣarūnahum yawaddu l-muj'rimu law yaftadī min ʿadhābi yawmi-idhin bibanīhi","audioUrl":"/audio/7/070011.mp3","segments":[[0,1,30,2530],[1,2,2540,3270],[2,3,3280,4290],[3,4,4300,4670],[4,5,4680,5720],[5,6,5730,6030],[6,7,6040,6970],[7,8,6980,8830],[8,9,8840,12020]],"words":[{"position":1,"text":"يُبَصَّرُونَهُمۡۚ","translation":"They will be made to see each other","transliteration":"yubaṣṣarūnahum"},{"position":2,"text":"يَوَدُّ","translation":"Would wish","transliteration":"yawaddu"},{"position":3,"text":"ٱلۡمُجۡرِمُ","translation":"the criminal","transliteration":"l-muj'rimu"},{"position":4,"text":"لَوۡ","translation":"if","transliteration":"law"},{"position":5,"text":"يَفۡتَدِي","translation":"he (could be) ransomed","transliteration":"yaftadī"},{"position":6,"text":"مِنۡ","translation":"from","transliteration":"min"},{"position":7,"text":"عَذَابِ","translation":"(the) punishment","transliteration":"ʿadhābi"},{"position":8,"text":"يَوۡمِئِذِۭ","translation":"(of) that Day","transliteration":"yawmi-idhin"},{"position":9,"text":"بِبَنِيهِ","translation":"by his children","transliteration":"bibanīhi"}]},{"id":5387,"verseKey":"70:12","verseNumber":12,"arabic":"وَصَٰحِبَتِهِۦ وَأَخِيهِ","translation":"And his wife and his brother","transliteration":"waṣāḥibatihi wa-akhīhi","audioUrl":"/audio/7/070012.mp3","segments":[[0,1,30,1690],[1,2,1700,4330]],"words":[{"position":1,"text":"وَصَٰحِبَتِهِۦ","translation":"And his spouse","transliteration":"waṣāḥibatihi"},{"position":2,"text":"وَأَخِيهِ","translation":"and his brother","transliteration":"wa-akhīhi"}]},{"id":5388,"verseKey":"70:13","verseNumber":13,"arabic":"وَفَصِيلَتِهِ ٱلَّتِي تُـٔۡوِيهِ","translation":"And his nearest kindred who shelter him.","transliteration":"wafaṣīlatihi allatī tu'wīhi","audioUrl":"/audio/7/070013.mp3","segments":[[0,1,30,1530],[1,2,1540,2360],[2,3,2370,4990]],"words":[{"position":1,"text":"وَفَصِيلَتِهِ","translation":"And his nearest kindred","transliteration":"wafaṣīlatihi"},{"position":2,"text":"ٱلَّتِي","translation":"who","transliteration":"allatī"},{"position":3,"text":"تُـٔۡوِيهِ","translation":"sheltered him","transliteration":"tu'wīhi"}]},{"id":5389,"verseKey":"70:14","verseNumber":14,"arabic":"وَمَن فِي ٱلۡأَرۡضِ جَمِيعٗا ثُمَّ يُنجِيهِ","translation":"And whoever is on earth entirely [so] then it could save him.","transliteration":"waman fī l-arḍi jamīʿan thumma yunjīhi","audioUrl":"/audio/7/070014.mp3","segments":[[0,1,30,1130],[1,2,1140,1400],[2,3,1410,222