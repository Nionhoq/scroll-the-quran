# All optional. The app runs with none of these set.

# Public address used in share links and preview tags, e.g. https://scrollquran.org
PUBLIC_ORIGIN=

# External donation page (must be https). The "Support Scroll Quran" link is hidden when empty.
SUPPORT_URL=

# Anonymous daily count storage. Default: a JSON file. Set DATABASE_URL to use MySQL instead.
COUNTS_FILE=data/daily-counts.json
DATABASE_URL=

# Where generated share-preview images are cached.
OG_CACHE_DIR=data/og-cache

# Quran Foundation API (server-only; only used for tafsir). Never expose through a VITE_ variable.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive
