# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Quran Foundation Content API (server-only, optional) ───────
QF_CLIENT_ID=             # Backend app client ID
QF_CLIENT_SECRET=         # Backend app client secret; never expose to the browser
QF_ENV=prelive            # prelive or production
